if oldGui then
	oldGui:Destroy()
end

local CONFIG = {
	Enabled = true,
	EnemyOnly = true,           -- Chỉ hiển thị kẻ địch, bỏ qua đồng đội
	MaxDistance = 2000,         -- Khoảng cách tối đa (studs)
	RefreshRate = 0.06,         -- Chu kỳ cập nhật vị trí & bộ đếm (giây)
	ScanInterval = 1.0,         -- Chu kỳ quét mục tiêu mới (giây)
	EnemyColor = Color3.fromRGB(255, 55, 55),
}

