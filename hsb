-- File: auto_duel_parry_counter.lua
-- Runtime: Roblox Luau (Client Executor - Mobile & PC supported)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Stats = game:GetService("Stats")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

-- Cấu hình thông số chiến đấu dựa trên nhịp độ thực tế trong trận (v8.6)
local Config = {
    Enabled = true,
    AutoCounter = true,
    StopOnEnemyBlock = true,
    AutoHeavyPunish = true,       -- Đánh Nặng khi đối thủ bị phá giáp (vỡ thanh trắng trên đầu)
    CombatRange = 16.5,           -- Khoảng cách nhận diện đòn chém (studs)
    ParryWindowPreempt = 0.045,   -- Bù trễ phản xạ (giây) cho mức ping ~80-100ms
    CounterDelay = 0.06,          -- Độ trễ từ lúc Chặn đòn thành công đến lúc vung kiếm trả đòn
    AttackCooldown = 0.22,        -- Nhịp ngắt giữa các đòn ÁNH SÁNG để không bị kẹt hoạt ảnh
}

-- Trạng thái nội bộ của máy trạng thái (State Machine)
local State = {
    Target = nil,
    EnemyIsAttacking = false,
    EnemyIsBlocking = false,
    EnemyStunned = false,
    WeAreBlocking = false,
    WeAreAttacking = false,
    HoldFireUntil = 0,
    LastParryTime = 0,
    LastAttackTime = 0,
    CachedButtons = {},
    KnownAttackAnims = {},
    KnownBlockAnims = {},
    Connections = {},
}

-- ============================================================================
-- 1. BỘ ĐỊNH TUYẾN NÚT BẤM (TỰ ĐỘNG BẮT NÚT CẢM ỨNG MOBILE & PHÍM CỨNG)
-- ============================================================================

local ButtonKeywords = {
    Block = { "chặn đòn", "chan don", "block", "parry", "defend", "guard" },
    Light = { "ánh sáng", "anh sang", "light", "attack", "slash", "m1" },
    Heavy = { "nặng", "nang", "heavy", "strong", "charge", "m2", "sơ cấp" },
    Dodge = { "né", "ne", "dodge", "dash", "roll" },
    Jump  = { "nhảy", "nhay", "jump" },
}

local function matchesKeyword(str, keywordList)
    if not str or str == "" then return false end
    local lower = string.lower(str)
    for _, kw in ipairs(keywordList) do
        if string.find(lower, kw, 1, true) then
            return true
        end
    end
    return false
end

local function scanTouchButtons()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return end

    table.clear(State.CachedButtons)

    for _, desc in ipairs(pg:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("TextButton") then
            local text = desc.Text
            local parentBtn = desc:IsA("GuiButton") and desc or desc:FindFirstAncestorWhichIsA("GuiButton")
            if parentBtn and parentBtn.Visible then
                for action, kwList in pairs(ButtonKeywords) do
                    if matchesKeyword(text, kwList) or matchesKeyword(parentBtn.Name, kwList) then
                        State.CachedButtons[action] = parentBtn
                    end
                end
            end
        elseif desc:IsA("ImageButton") and desc.Visible then
            for action, kwList in pairs(ButtonKeywords) do
                if matchesKeyword(desc.Name, kwList) then
                    State.CachedButtons[action] = desc
                end
            end
        end
    end
end

-- Kích hoạt nút GUI trên Mobile (ưu tiên firesignal, fallback sang toạ độ cảm ứng)
local function triggerGuiButton(actionName, pressState)
    local btn = State.CachedButtons[actionName]
    if not btn or not btn.Parent then
        scanTouchButtons()
        btn = State.CachedButtons[actionName]
    end

    if btn and btn.Visible then
        -- Executor có hỗ trợ firesignal trực tiếp lên sự kiện nút
        if typeof(firesignal) == "function" then
            pcall(function()
                if pressState == "Down" then
                    firesignal(btn.MouseButton1Down)
                    firesignal(btn.TouchTap)
                elseif pressState == "Up" then
                    firesignal(btn.MouseButton1Up)
                else
                    firesignal(btn.MouseButton1Down)
                    firesignal(btn.MouseButton1Click)
                    firesignal(btn.Activated)
                    task.delay(0.03, function()
                        firesignal(btn.MouseButton1Up)
                    end)
                end
            end)
            return true
        end

        -- Fallback: Giả lập chạm màn hình ngay tâm nút cảm ứng
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        local centerX = pos.X + (size.X * 0.5)
        local centerY = pos.Y + (size.Y * 0.5) + 36 -- Bù lệch thanh Topbar

        pcall(function()
            if pressState == "Down" then
                VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 1)
            elseif pressState == "Up" then
                VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 1)
            else
                VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 1)
                task.delay(0.03, function()
                    VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 1)
                end)
            end
        end)
        return true
    end

    -- Fallback cho PC nếu không bật giao diện nút Mobile
    pcall(function()
        if actionName == "Block" then
            local isDown = (pressState ~= "Up")
            VirtualInputManager:SendKeyEvent(isDown, Enum.KeyCode.F, false, game)
            if pressState == "Tap" then
                task.delay(0.05, function()
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                end)
            end
        elseif actionName == "Light" and pressState ~= "Up" then
            if typeof(mouse1click) == "function" then
                mouse1click()
            else
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                task.delay(0.03, function()
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                end)
            end
        elseif actionName == "Heavy" and pressState ~= "Up" then
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
            task.delay(0.04, function()
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
            end)
        elseif actionName == "Dodge" and pressState ~= "Up" then
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
            task.delay(0.04, function()
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
            end)
        end
    end)
    return false
end

