-- 5. EVALUATION & MULTI-PASS ALPHA-BETA SEARCH ENGINE
--------------------------------------------------------------------------------
function ChessEngine:Evaluate(aggressionBias)
    aggressionBias = aggressionBias or 1.0
    local score = 0
    local b = self.Board

    for sq = 1, 64 do
        local p = b[sq]
        if p ~= 0 then
            local side = (p > 0) and 1 or -1
            local absP = math.abs(p)
            local baseVal = PIECE_VALUES[absP]
            local f, r = IndexToFileRank(sq)

            -- Convert square to PST index (rank 8 at top = row 0)
            local pstRank = (side == 1) and (8 - r) or (r - 1)
            local pstIdx = pstRank * 8 + f
            local posBonus = PST[absP][pstIdx] or 0

            -- Center control & mobility aggression scaling
            local pieceTotal = baseVal + (posBonus * aggressionBias)
            score += side * pieceTotal
        end
    end

    return score * self.Turn
end

function ChessEngine:ScoreMove(m, ply)
    local score = 0
    if m.captured ~= 0 then
        -- MVV-LVA (Most Valuable Victim - Least Valuable Attacker)
        score += 10000 + (PIECE_VALUES[math.abs(m.captured)] * 10) - PIECE_VALUES[math.abs(m.piece)]
    end
    if m.promo then
        score += 9000
    end
    if self.KillerMoves[ply] and self.KillerMoves[ply] == m.uci then
        score += 5000
    end
    score += (self.HistoryTable[m.uci] or 0)
    return score
end

function ChessEngine:OrderMoves(moves, ply)
    table.sort(moves, function(a, b)
        return self:ScoreMove(a, ply) > self:ScoreMove(b, ply)
    end)
end

function ChessEngine:Quiescence(alpha, beta, qDepth, aggressionBias)
    self.NodesSearched += 1
    local standPat = self:Evaluate(aggressionBias)
    if standPat >= beta then return beta end
    if alpha < standPat then alpha = standPat end
    if qDepth <= 0 then return standPat end

    local captures = self:GetLegalMoves(self.Turn, true)
    self:OrderMoves(captures, 99)

    for _, m in ipairs(captures) do
        local saved = self:CloneState()
        self:MakeMove(m)
        local score = -self:Quiescence(-beta, -alpha, qDepth - 1, aggressionBias)
        self:RestoreState(saved)

        if score >= beta then return beta end
        if score > alpha then alpha = score end
    end

    return alpha
end

function ChessEngine:AlphaBeta(depth, alpha, beta, ply, aggressionBias)
    self.NodesSearched += 1
    if depth <= 0 then
        return self:Quiescence(alpha, beta, Config.MaxQuiescenceDepth, aggressionBias)
    end

    local legalMoves = self:GetLegalMoves(self.Turn, false)
    if #legalMoves == 0 then
        if self:IsInCheck(self.Turn) then
            return -19000 + ply -- Prefer faster checkmates
        end
        return -OpponentProfile.ContemptFactor -- Draw penalty based on opponent profile
    end

    self:OrderMoves(legalMoves, ply)

    for _, m in ipairs(legalMoves) do
        local saved = self:CloneState()
        self:MakeMove(m)
        local score = -self:AlphaBeta(depth - 1, -beta, -alpha, ply + 1, aggressionBias)
        self:RestoreState(saved)

        if score >= beta then
            if m.captured == 0 then
                self.KillerMoves[ply] = m.uci
                self.HistoryTable[m.uci] = (self.HistoryTable[m.uci] or 0) + (depth * depth)
            end
            return beta
        end
        if score > alpha then
            alpha = score
        end
    end

    return alpha
end

-- Multi-Simulation Master Decision:
-- Runs 1) Grandmaster Opening Book lookup, 2) Multiple simulation passes (Tactical, Positional, Aggressive)
-- and cross-votes the highest expected value move.
function ChessEngine:SelectBestMove(mySide)
    self.Turn = mySide
    local legalMoves = self:GetLegalMoves(mySide, false)
    if #legalMoves == 0 then return nil, 0 end
    if #legalMoves == 1 then return legalMoves[1], 0 end

    -- 1. Check Grandmaster Opening Book
    local historyKey = table.concat(self.MoveHistoryUCI, " ")
    local bookUCI = OpeningBook[historyKey]
    if bookUCI then
        for _, m in ipairs(legalMoves) do
            if m.uci == bookUCI then
                return m, 999, "GM Book (" .. bookUCI .. ")"
            end
        end
    end

    -- 2. Multi-Simulation Passes across Candidate Moves
    self.NodesSearched = 0
    local targetDepth = Config.BaseSearchDepth + OpponentProfile.DynamicDepthBonus
    local simulationBiases = { 0.9, 1.0, 1.2 } -- Positional, Balanced, Tactical Aggression
    local voteScores = {}

    for simIdx = 1, Config.SimulationsPerMove do
        local bias = simulationBiases[simIdx] or 1.0
        self:OrderMoves(legalMoves, 1)

        for _, m in ipairs(legalMoves) do
            local saved = self:CloneState()
            self:MakeMove(m)
            local val = -self:AlphaBeta(targetDepth - 1, -30000, 30000, 1, bias)
            self:RestoreState(saved)

            voteScores[m.uci] = (voteScores[m.uci] or 0) + val
        end
        RunService.Heartbeat:Wait() -- Keep client frame rate smooth during multi-simulation
    end

    local bestMove = legalMoves[1]
    local bestAvgScore = -999999
    for _, m in ipairs(legalMoves) do
        local avg = (voteScores[m.uci] or -99999) / Config.SimulationsPerMove
        if avg > bestAvgScore then
            bestAvgScore = avg
            bestMove = m
        end
    end

    return bestMove, math.floor(bestAvgScore), string.format("Sim x%d | Depth %d | %s", Config.SimulationsPerMove, targetDepth, OpponentProfile.Archetype)
end

--------------------------------------------------------------------------------
-- 6. SAN PARSER (READS ROCHESS MOVE LIST PANEL e.g. "1. e4 Na6 2. Bc4 Nb4")
--------------------------------------------------------------------------------
function ChessEngine:ParseSANMove(san, side)
    san = string.gsub(san, "[+#!?]", "")
    local legal = self:GetLegalMoves(side, false)

    if san == "O-O" or san == "0-0" then
        for _, m in ipairs(legal) do
            if m.isCastle == "WK" or m.isCastle == "BK" then return m end
        end
    elseif san == "O-O-O" or san == "0-0-0" then
        for _, m in ipairs(legal) do
            if m.isCastle == "WQ" or m.isCastle == "BQ" then return m end
        end
    end

    -- Promotion check (e.g. e8=Q)
    local promoPiece = nil
    if string.find(san, "=") then
        promoPiece = side * 5
        san = string.gsub(san, "=.[QRNB]?", "")
    end

    local destStr = string.sub(san, -2)
    local destSq = AlgebraicToIndex(destStr)
    if not destSq then return nil end

    local firstChar = string.sub(san, 1, 1)
    local pieceType = 1
    if firstChar == "N" then pieceType = 2
    elseif firstChar == "B" then pieceType = 3
    elseif firstChar == "R" then pieceType = 4
    elseif firstChar == "Q" then pieceType = 5
    elseif firstChar == "K" then pieceType = 6
    end

    local disambig = string.gsub(string.sub(san, 1, -3), "[NBRQKx]", "")

    for _, m in ipairs(legal) do
        if m.to == destSq and math.abs(m.piece) == pieceType then
            if not promoPiece or m.promo == promoPiece then
                if disambig == "" then
                    return m
                else
                    local fromAlg = IndexToAlgebraic(m.from)
                    if string.find(fromAlg, disambig, 1, true) then
                        return m
                    end
                end
            end
        end
    end
    return nil
end

