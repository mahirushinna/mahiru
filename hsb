local Running = true
_G.RoChessPureHookCleanup = function()
    Running = false
    if ScreenGui and ScreenGui.Parent then
        ScreenGui:Destroy()
    end
end

local LastSyncedSignature = ""
local IsExecuting = false

task.spawn(function()
    while Running and task.wait(0.18) do
        local boardFrame = GetBoardFrame()
        if boardFrame and not IsExecuting then
            local mySide = DetectPlayerColor(boardFrame)
            local sanList = ScrapeMoveListStrictlyBelowBoard(boardFrame)
            local currentSig = table.concat(sanList, " ")

            -- Replay valid move prefix so even a single noisy label never breaks the board state
            if currentSig ~= LastSyncedSignature then
                Engine:Reset()
                OpponentProfile:Reset()
                local appliedCount = 0

                for _, san in ipairs(sanList) do
                    local sideToMove = (appliedCount % 2 == 0) and 1 or -1
                    local evalBefore = Engine:Evaluate(1.0)
                    local parsed = Engine:ParseSANMove(san, sideToMove)
                    if parsed then
                        Engine:MakeMove(parsed)
                        table.insert(Engine.MoveHistoryUCI, parsed.uci)
                        appliedCount += 1
                        if sideToMove ~= mySide then
                            local evalAfter = -Engine:Evaluate(1.0)
                            local isAggro = (parsed.captured ~= 0) or Engine:IsInCheck(mySide)
                            OpponentProfile:RecordMove(evalBefore - evalAfter, isAggro)
                        end
                    end
                end
                LastSyncedSignature = currentSig
            end

            local badgeState = DetectTurnBadgeState(boardFrame)
            local isMyTurnByMoves = (Engine.Turn == mySide)
            local shouldPlay = isMyTurnByMoves and (badgeState ~= "OPPONENT_TURN")

            if Config.AutoPlay and shouldPlay then
                IsExecuting = true
                local bestMove, score, meta = Engine:SelectBestMove(mySide)
                if bestMove then
                    local lastTwoMoves = table.concat(sanList, " ", math.max(1, #sanList - 3), #sanList)
                    StatusLabel.Text = string.format(
                        "Side: %s | Hook: %s\nHistory (%d): %s\nOpponent: %s\nBest: %s (%+d) [%s | %d nodes]",
                        (mySide == 1) and "WHITE" or "BLACK",
                        HookState.LastHookMethod,
                        #Engine.MoveHistoryUCI,
                        (lastTwoMoves ~= "" and lastTwoMoves or "Start"),
                        OpponentProfile.Archetype,
                        bestMove.uci,
                        score,
                        meta,
                        Engine.NodesSearched
                    )
                    ExecuteMoveViaHook(bestMove, mySide)
                    task.wait(Config.PostMoveCooldown)
                end
                IsExecuting = false
            else
                local lastTwoMoves = table.concat(sanList, " ", math.max(1, #sanList - 3), #sanList)
                StatusLabel.Text = string.format(
                    "Side: %s | Hook: %s\nHistory (%d): %s\nOpponent: %s\nWaiting for opponent move...",
                    (mySide == 1) and "WHITE" or "BLACK",
                    HookState.LastHookMethod,
                    #Engine.MoveHistoryUCI,
                    (lastTwoMoves ~= "" and lastTwoMoves or "Start"),
                    OpponentProfile.Archetype
                )
            end
        end
    end
end)
