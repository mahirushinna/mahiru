-- 4. VÒNG LẶP XỬ LÝ PHẢN XẠ CHIẾN ĐẤU (MỖI FRAME)
-- ============================================================================

local function getClosestEnemy()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, 999 end

    local nearest = nil
    local minDist = 999

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local c = plr.Character
            local h = c:FindFirstChildOfClass("Humanoid")
            local r = c:FindFirstChild("HumanoidRootPart")
            if h and h.Health > 0 and r then
                local d = (r.Position - myRoot.Position).Magnitude
                if d < minDist then
                    minDist = d
                    nearest = c
                end
            end
        end
    end

    return nearest, minDist
end

local function combatLoop()
    if not Config.Enabled then
        State.StatusText = "Đã tắt [OFF]"
        return
    end

    local enemy, dist = getClosestEnemy()
    State.Target = enemy
    State.TargetDist = dist

    if not enemy then
        State.StatusText = "Đang tìm đối thủ..."
        return
    end

    local isBlocking, isAttacking, isStunned = detectEnemyState(enemy, dist)
    State.EnemyBlocking = isBlocking
    State.EnemyAttacking = isAttacking
    State.EnemyStunned = isStunned

    local now = os.clock()

    -- Cập nhật dòng trạng thái trực quan trên HUD để kiểm tra ngay trong trận
    local btnStatus = (State.Buttons.Block and State.Buttons.Light) and "Nút:OK" or "Nút:Auto"
    local enemyStateStr = isAttacking and "ĐỊCH CHÉM!" or (isBlocking and "ĐỊCH ĐỠ!" or (isStunned and "VỠ GIÁP!" or "Chờ nhịp"))
    State.StatusText = string.format("%s | %.1fm | %s", btnStatus, dist, enemyStateStr)

    if dist > Config.CombatRange then return end

    -- ========================================================================
    -- TRƯỜNG HỢP 1: KẺ ĐỊCH VUNG KIẾM -> LẬP TỨC ĐỠ ĐÒN (CHẶN ĐÒN) & ĐÁNH TRẢ
    -- ========================================================================
    if isAttacking then
        if now - State.LastParryClock >= 0.16 then
            State.LastParryClock = now
            State.IsParrying = true

            -- Ngắt nút đánh ngay lập tức để không bị khựng đòn khi đang cần đỡ
            performAction("Light", "Up")

            -- Bấm giữ Chặn đòn đón nhát chém của địch
            performAction("Block", "Tap")

            -- Ngay sau khi đỡ đòn xong -> Lập tức vung kiếm đánh trả (Counter-Attack)
            if Config.AutoCounter then
                task.delay(Config.HoldBlockTime + Config.CounterDelay, function()
                    State.IsParrying = false
                    if not Config.Enabled or not State.Target then return end

                    -- Nhả nút Chặn đòn ra trước khi chém trả
                    performAction("Block", "Up")

                    local stillBlock, stillAtk, stunnedNow = detectEnemyState(State.Target, State.TargetDist)
                    if stunnedNow and Config.AutoHeavyPunish then
                        performAction("Heavy", "Tap")
                        State.LastAttackClock = os.clock()
                    elseif not stillBlock or stillAtk then
                        -- Nhấp đánh trả 2 nhịp ÁNH SÁNG liên tiếp
                        performAction("Light", "Tap")
                        State.LastAttackClock = os.clock()
                        task.delay(0.18, function()
                            local b2, a2, _ = detectEnemyState(State.Target, State.TargetDist)
                            if not b2 and not a2 and State.TargetDist <= Config.CombatRange then
                                performAction("Light", "Tap")
                            end
                        end)
                    end
                end)
            else
                task.delay(Config.HoldBlockTime, function()
                    State.IsParrying = false
                    performAction("Block", "Up")
                end)
            end
        end
        return
    end

    -- ========================================================================
    -- TRƯỜNG HỢP 2: KẺ ĐỊCH ĐANG GIƠ KIẾM ĐỠ ĐÒN -> DỪNG ĐÁNH NGAY LẬP TỨC
    -- ========================================================================
    if isBlocking and Config.StopOnEnemyBlock then
        State.HoldAttackUntil = now + 0.15
        -- Nhả nút ÁNH SÁNG và nhấp nhẹ Chặn đòn để huỷ đòn chém dở (Feint), chờ địch đánh trả
        performAction("Light", "Up")
        if now - State.LastAttackClock < 0.3 then
            performAction("Block", "Down")
            task.delay(0.06, function()
                if not State.EnemyAttacking then
                    performAction("Block", "Up")
                end
            end)
        end
        return
    end

    -- ========================================================================
    -- TRƯỜNG HỢP 3: ĐỊCH BỊ CHOÁNG / HỞ SƯỜN TRONG TẦM KIẾM -> TỰ ĐỘNG CÔNG
    -- ========================================================================
    if not State.IsParrying and now >= State.HoldAttackUntil and dist <= 11.5 then
        if isStunned and Config.AutoHeavyPunish and (now - State.LastAttackClock >= 0.35) then
            State.LastAttackClock = now
            performAction("Heavy", "Tap")
        elseif not isBlocking and not isAttacking and (now - State.LastAttackClock >= 0.28) then
            State.LastAttackClock = now
            performAction("Light", "Tap")
        end
    end
end

