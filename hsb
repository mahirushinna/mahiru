local OurScreenGui = nil

-- Finds the 8x8 Board Container that actually has the most child squares/pieces
local function GetBoardFrame()
    local candidates = {}
    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if desc:IsA("GuiObject") and desc.Visible and (not OurScreenGui or not desc:IsDescendantOf(OurScreenGui)) then
            local sz = desc.AbsoluteSize
            if sz.X >= 220 and sz.Y >= 220 and math.abs(sz.X - sz.Y) <= 18 then
                local childGuiCount = 0
                for _, ch in ipairs(desc:GetDescendants()) do
                    if ch:IsA("GuiObject") then childGuiCount += 1 end
                end
                table.insert(candidates, { frame = desc, area = sz.X * sz.Y, children = childGuiCount })
            end
        end
    end

    table.sort(candidates, function(a, b)
        if a.children ~= b.children then
            return a.children > b.children
        end
        return a.area > b.area
    end)

    return candidates[1] and candidates[1].frame or nil
end

-- Detects which clock pill (Top vs Bottom) has the bright white active background or "to move" badge
-- In video_1.mp4 & video_2.mp4: Active clock pill is RGB(255,255,255), inactive clock is dark!
local function DetectTurnAndMatchState(boardFrame)
    if not boardFrame then return "NO_BOARD" end
    local boardCenterY = boardFrame.AbsolutePosition.Y + (boardFrame.AbsoluteSize.Y * 0.5)
    local boardTopY = boardFrame.AbsolutePosition.Y
    local boardBottomY = boardFrame.AbsolutePosition.Y + boardFrame.AbsoluteSize.Y

    -- Check if "Game Aborted" / "You Lost" / "You Won" modal is covering the board
    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible and (not OurScreenGui or not desc:IsDescendantOf(OurScreenGui)) then
            local t = string.lower(desc.Text)
            if t == "game aborted" or string.find(t, "you lost") or string.find(t, "you won") or string.find(t, "searching for opponent") then
                if desc.AbsolutePosition.Y < boardBottomY + 120 then
                    return "INACTIVE_OR_MODAL"
                end
            end
        end
    end

    -- 1. Check explicit "to move" badge
    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible and (not OurScreenGui or not desc:IsDescendantOf(OurScreenGui)) then
            local t = string.lower(desc.Text)
            if string.find(t, "to move") then
                if desc.AbsolutePosition.Y > boardCenterY then
                    return "MY_TURN"
                else
                    return "OPPONENT_TURN"
                end
            end
        end
    end

    -- 2. Check Bright White Clock Pill (e.g. "3:00", "2:57", "0:45") above vs below board
    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible and (not OurScreenGui or not desc:IsDescendantOf(OurScreenGui)) then
            local txt = string.gsub(desc.Text, "%s+", "")
            if string.match(txt, "^%d+:%d%d$") then
                -- Check background of the clock label or its parent pill Frame
                local pill = desc.BackgroundTransparency < 0.5 and desc or desc.Parent
                if pill and pill:IsA("GuiObject") and pill.BackgroundTransparency < 0.8 then
                    local col = pill.BackgroundColor3
                    if col.R > 0.75 and col.G > 0.75 and col.B > 0.75 then
                        if desc.AbsolutePosition.Y > boardCenterY then
                            return "MY_TURN"
                        elseif desc.AbsolutePosition.Y < boardTopY then
                            return "OPPONENT_TURN"
                        end
                    end
                end
            end
        end
    end

    return "UNKNOWN"
end

