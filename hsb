local function DetectPlayerColor(boardFrame)
    if not boardFrame then return 1 end
    local rank1Y, rank8Y = nil, nil
    for _, desc in ipairs(boardFrame:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible then
            local txt = string.gsub(desc.Text, "%s+", "")
            if txt == "1" and desc.AbsoluteSize.X < 40 then
                rank1Y = desc.AbsolutePosition.Y
            elseif txt == "8" and desc.AbsoluteSize.X < 40 then
                rank8Y = desc.AbsolutePosition.Y
            end
        end
    end
    if rank1Y and rank8Y then
        return (rank1Y > rank8Y) and 1 or -1
    end
    return 1
end

-- Strictly scrapes ONLY the move history panel below the board frame (ignores board labels!)
local function ScrapeMoveListStrictlyBelowBoard(boardFrame)
    if not boardFrame then return {} end
    local boardBottomY = boardFrame.AbsolutePosition.Y + boardFrame.AbsoluteSize.Y - 4
    local rawTokens = {}

    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and desc.Visible then
            local pos = desc.AbsolutePosition
            -- Must be strictly below the 8x8 board frame! (Fixes the bug where board square labels broke SAN parsing)
            if pos.Y >= boardBottomY and desc.AbsoluteSize.Y > 8 and desc.AbsoluteSize.Y < 45 then
                local clean = string.gsub(desc.Text, "<[^>]+>", "")
                clean = string.gsub(clean, "^%s*(.-)%s*$", "%1")

                -- Support both individual move labels ("e4", "g6", "Bg7") and combined row strings ("1. e4 g6")
                for token in string.gmatch(clean, "%S+") do
                    if not string.match(token, "^%d+%.+$") then
                        local stripped = string.gsub(token, "[+#!?]", "")
                        if
                            stripped == "O-O" or stripped == "O-O-O" or
                            string.match(stripped, "^[NBRQK]?[a-h]?[1-8]?x?[a-h][1-8]=?[QRNB]?$")
                        then
                            table.insert(rawTokens, {
                                san = stripped,
                                rowY = math.floor(pos.Y / 8) * 8,
                                colX = pos.X
                            })
                        end
                    end
                end
            end
        end
    end

    table.sort(rawTokens, function(a, b)
        if math.abs(a.rowY - b.rowY) > 10 then
            return a.rowY < b.rowY
        end
        return a.colX < b.colX
    end)

    -- Deduplicate overlapping TextButton + child TextLabel at the same screen position
    local deduped = {}
    for _, item in ipairs(rawTokens) do
        local prev = deduped[#deduped]
        if not prev or prev.san ~= item.san or math.abs(prev.colX - item.colX) > 15 or math.abs(prev.rowY - item.rowY) > 12 then
            table.insert(deduped, item)
        end
    end

    local result = {}
    for _, item in ipairs(deduped) do
        table.insert(result, item.san)
    end
    return result
end

-- Detects if the "Xs to move" badge in video_1.mp4 (00:00, 00:26, 00:40) is on our bottom bar or opponent's top bar
local function DetectTurnBadgeState(boardFrame)
    if not boardFrame then return nil end
    local boardCenterY = boardFrame.AbsolutePosition.Y + (boardFrame.AbsoluteSize.Y * 0.5)
    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible then
            local txt = string.lower(desc.Text)
            if string.find(txt, "to move") then
                if desc.AbsolutePosition.Y > boardCenterY then
                    return "MY_TURN"
                else
                    return "OPPONENT_TURN"
                end
            end
        end
    end
    return nil
end

