-- Phát hiện đòn đánh có màu sắc (Đỏ / Vàng / Tím / Xanh) -> Dùng nút Lướt (Né)
local function hasColoredSkillVisual(char)
    if not char then return false end

    for k, v in pairs(char:GetAttributes()) do
        if v == true then
            local name = string.lower(k)
            if string.find(name, "heavy") or string.find(name, "ult") or string.find(name, "skill") or string.find(name, "unblock") then
                return true
            end
        end
    end

    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("Highlight") and obj.Enabled and obj.FillTransparency < 0.95 then
            local fc = obj.FillColor
            local oc = obj.OutlineColor
            -- Loại trừ ánh trắng khi vừa bị đánh trúng; bắt màu Đỏ, Vàng cam, Tím, Xanh
            local isPureWhite = (fc.R > 0.82 and fc.G > 0.82 and fc.B > 0.82)
            if not isPureWhite then
                if (fc.R > 0.65 and fc.G < 0.42) or (oc.R > 0.65 and oc.G < 0.42)
                    or (fc.B > 0.65 and fc.R < 0.45) or (fc.R > 0.72 and fc.G > 0.50 and fc.B < 0.25) then
                    return true
                end
            end
        elseif (obj:IsA("Trail") or obj:IsA("Beam")) and obj.Enabled then
            local seq = obj.Color
            if seq and #seq.Keypoints > 0 then
                local c = seq.Keypoints[1].Value
                local diff = math.max(c.R, c.G, c.B) - math.min(c.R, c.G, c.B)
                if diff > 0.36 then
                    return true
                end
            end
        end
    end

    return false
end

-- Kiểm tra xem Track có phải là đòn vung kiếm tấn công hay không
local function isAttackAnimationTrack(track, dist)
    if not track or not track.IsPlaying then return false end
    local animId = track.Animation and track.Animation.AnimationId or ""
    if animId == "" then return false end

    local prio = track.Priority
    if prio == Enum.AnimationPriority.Core
        or prio == Enum.AnimationPriority.Idle
        or prio == Enum.AnimationPriority.Movement then
        return false
    end

    local tName = string.lower(track.Name or "")
    if string.find(tName, "idle") or string.find(tName, "walk") or string.find(tName, "run")
        or string.find(tName, "sprint") or string.find(tName, "jump") or string.find(tName, "fall")
        or string.find(tName, "block") or string.find(tName, "guard") or string.find(tName, "parry")
        or string.find(tName, "stun") or string.find(tName, "hit") or string.find(tName, "hurt")
        or string.find(tName, "dash") or string.find(tName, "dodge") then
        State.BaselineAnims[animId] = true
        return false
    end

    -- Nếu địch đang ở rất xa (> 22 studs) và hoạt ảnh lặp lại (Looped) hoặc dài > 2.2s -> đó là hoạt ảnh cầm kiếm chạy/đứng yên
    if dist > 22 and (track.Looped or track.Length > 2.2) then
        State.BaselineAnims[animId] = true
        return false
    end

    if State.BaselineAnims[animId] then return false end

    -- Đòn vung kiếm không lặp lại (not Looped), có độ dài từ 0.15s đến 2.1s, và tốc độ > 0.1
    if not track.Looped and track.Length >= 0.15 and track.Length <= 2.1 and track.Speed > 0.1 then
        return true
    end

    return false
end

-- Nhận diện khi địch đang giơ kiếm ĐỠ ĐÒN (Block) để dừng chém ngay lập tức
local function isEnemyHoldingBlock(enemyChar)
    if not enemyChar then return false end
    local hum = enemyChar:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    for k, v in pairs(enemyChar:GetAttributes()) do
        if v == true then
            local n = string.lower(k)
            if string.find(n, "block") or string.find(n, "guard") or string.find(n, "parry") then
                return true
            end
        end
    end

    for _, child in ipairs(enemyChar:GetChildren()) do
        if child:IsA("BoolValue") and child.Value == true then
            local n = string.lower(child.Name)
            if string.find(n, "block") or string.find(n, "guard") or string.find(n, "parry") then
                return true
            end
        end
    end

    local animator = hum:FindFirstChildOfClass("Animator") or hum
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if track.IsPlaying and track.WeightCurrent > 0.25 then
            local tName = string.lower(track.Name or "")
            local prio = track.Priority
            if string.find(tName, "block") or string.find(tName, "guard") or string.find(tName, "parry") then
                return true
            end
            -- Khi giữ kiếm đỡ đòn, hoạt ảnh ở tầng Action bị giữ đứng khung hình (Speed == 0) hoặc lặp lại khi đi chậm (WalkSpeed < 10)
            if (prio == Enum.AnimationPriority.Action or prio == Enum.AnimationPriority.Action2) then
                if track.Speed == 0 or (track.Looped and hum.WalkSpeed < 10.5) then
                    return true
                end
            end
        end
    end

    return false
end

-- Phản xạ tức thì (0ms) ngay khi phát hiện đối thủ vung kiếm hoặc dùng Skill màu sắc
local function reactToEnemyAttack(enemyChar, isColoredSkill)
    if not (Config.Mode1v1 or Config.Mode2v2) then return end
    if State.TargetDist > Config.ParryRange then return end

    local now = os.clock()
    -- Ngắt đòn chém của mình trong 0.22s để tập trung đỡ / né
    State.HoldAttackUntil = now + 0.22

    -- 1. NẾU LÀ SKILL CÓ MÀU SẮC -> BẤM NÚT LƯỚT (NÉ) CHỨ KHÔNG ĐỠ THƯỜNG
    if isColoredSkill then
        if now - State.LastDodgeClock >= 0.24 then
            State.LastDodgeClock = now
            triggerAction("Dodge", "Tap")
            -- Lướt né xong -> lập tức vung kiếm đánh trả
            task.delay(0.15, function()
                if (Config.Mode1v1 or Config.Mode2v2) and State.TargetDist <= Config.AttackRange then
                    triggerAction("Light", "Tap")
                    State.LastAttackClock = os.clock()
                end
            end)
        end
        return
    end

    -- 2. NẾU LÀ ĐÒN CHÉM THƯỜNG -> ĐỠ ĐÒN SIÊU CHUẨN 0MS & ĐÁNH TRẢ NGAY LẬP TỨC
    State.BlockReleaseClock = now + 0.20
    if now - State.LastParryClock >= 0.08 then
        State.LastParryClock = now
        triggerAction("Block", "Down")

        task.delay(0.19, function()
            if os.clock() >= State.BlockReleaseClock then
                triggerAction("Block", "Up")
                -- Ngay sau khi đỡ đòn -> vung kiếm đánh trả kẻ địch ngay
                if (Config.Mode1v1 or Config.Mode2v2) and State.Target and State.TargetDist <= Config.AttackRange then
                    if not isEnemyHoldingBlock(State.Target) then
                        triggerAction("Light", "Tap")
                        State.LastAttackClock = os.clock()
                    end
                end
            end
        end)
    end
end

-- Gắn sự kiện AnimationPlayed 0ms lên đối thủ
local function hookTargetAnimator(enemyChar)
    if not enemyChar then return end
    local hum = enemyChar:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator") or hum
    if State.HookedAnimators[animator] then return end
    State.HookedAnimators[animator] = true

    animator.AnimationPlayed:Connect(function(track)
        if not (Config.Mode1v1 or Config.Mode2v2) then return end
        if enemyChar ~= State.Target then return end
        if isAttackAnimationTrack(track, State.TargetDist) then
            local colored = hasColoredSkillVisual(enemyChar)
            reactToEnemyAttack(enemyChar, colored)
            if not colored then
                task.delay(0.025, function()
                    if hasColoredSkillVisual(enemyChar) then
                        reactToEnemyAttack(enemyChar, true)
                    end
                end)
            end
        end
    end)
end

-- ============================================================================
-- 4. VÒNG LẶP CHÍNH: TỰ ĐI ĐẾN ĐỊCH + ĐỠ 0MS + DỪNG KHI ĐỊCH ĐỠ + XẢ SIÊU CẤP
-- ============================================================================

local function masterCombatLoop()
    local isActive = Config.Mode1v1 or Config.Mode2v2
    if not isActive then
        if State.IsBlocking then triggerAction("Block", "Up") end
        State.StatusText = "Đang Tắt [OFF]"
        return
    end

    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHum or not myRoot or myHum.Health <= 0 then return end

    local enemy, dist = acquireTarget()
    if enemy ~= State.Target then
        State.Target = enemy
        State.LastEnemyHealth = nil
        if enemy then hookTargetAnimator(enemy) end
    end
    State.TargetDist = dist

    if not enemy then
        if State.IsBlocking then triggerAction("Block", "Up") end
        State.StatusText = Config.Mode1v1 and "1v1: Đang đợi đối thủ..." or "2v2: Đang tìm địch..."
        return
    end

    hookTargetAnimator(enemy)
    local enemyHum = enemy:FindFirstChildOfClass("Humanoid")
    local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
    if not enemyHum or not enemyRoot then return end

    local now = os.clock()

    -- ========================================================================
    -- QUY TẮC A: KHI ĐÁNH TRÚNG ĐỊCH 1 CÁI (ĐỊCH KHÔNG ĐỠ ĐƯỢC) -> DÙNG LUÔN SIÊU CẤP
    -- ========================================================================
    local currentHp = enemyHum.Health
    if State.LastEnemyHealth ~= nil then
        if currentHp < State.LastEnemyHealth and dist <= 14.0 then
            -- Địch vừa mất máu (trúng kiếm của ta) -> nếu có Siêu Cấp thì xả ngay lập tức!
            if isUltimateReady() and (now - State.LastUltClock > 0.45) then
                State.LastUltClock = now
                triggerAction("Block", "Up")
                triggerAction("Ultimate", "Tap")
            end
        end
    end
    State.LastEnemyHealth = currentHp

    -- ========================================================================
    -- QUY TẮC B: KIỂM TRA ĐỊCH DÙNG SKILL MÀU / VUNG KIẾM / ĐỠ ĐÒN MỖI FRAME
    -- ========================================================================
    local coloredSkillNow = hasColoredSkillVisual(enemy)
    local enemySwingingNow = false

    local animator = enemyHum:FindFirstChildOfClass("Animator") or enemyHum
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if isAttackAnimationTrack(track, dist) then
            local progress = (track.Length > 0) and (track.TimePosition / track.Length) or 0.3
            if progress <= 0.70 then
                enemySwingingNow = true
                break
            end
        end
    end

    if coloredSkillNow and dist <= Config.ParryRange then
        reactToEnemyAttack(enemy, true)
    elseif enemySwingingNow and dist <= Config.ParryRange then
        reactToEnemyAttack(enemy, false)
    elseif State.IsBlocking and now >= State.BlockReleaseClock then
        triggerAction("Block", "Up")
    end

    local enemyBlockingNow = (not enemySwingingNow) and isEnemyHoldingBlock(enemy)

    -- KHI ĐỊCH ĐANG ĐỠ ĐÒN -> NGAY LẬP TỨC DỪNG ĐÁNH, CHỜ ĐỊCH ĐÁNH TRẢ ĐỂ ĐỠ & PHẢN CÔNG
    if enemyBlockingNow then
        State.HoldAttackUntil = now + 0.16
    end

    -- ========================================================================
    -- QUY TẮC C: TỰ ĐI ĐẾN ĐỊCH & XOAY MẶT ĐÓN ĐỠ (KHÔNG ẢNH HƯỞNG ĐỠ ĐÒN)
    -- ========================================================================
    local enemyPos = enemyRoot.Position
    local myPos = myRoot.Position

    -- Xoay mặt nhân vật nhìn thẳng về phía đối thủ khi trong tầm 18m để Chặn đòn luôn trúng 100%
    if dist <= 18.0 and dist > 0.5 and (now - State.LastDodgeClock > 0.20) then
        local lookTarget = Vector3.new(enemyPos.X, myPos.Y, enemyPos.Z)
        pcall(function()
            myRoot.CFrame = CFrame.lookAt(myPos, lookTarget)
        end)
    end

    if now - State.LastMoveClock >= 0.06 then
        State.LastMoveClock = now
        if dist > Config.StopWalkRange and dist < 120 then
            local offset = (myPos - enemyPos)
            local flatOffset = Vector3.new(offset.X, 0, offset.Z)
            local targetPoint = enemyPos
            if flatOffset.Magnitude > 0.1 then
                targetPoint = enemyPos + (flatOffset.Unit * (Config.StopWalkRange - 0.4))
            end
            myHum:MoveTo(targetPoint)
        elseif dist <= Config.StopWalkRange then
            myHum:MoveTo(myPos)
        end
    end

    -- ========================================================================
    -- QUY TẮC D: TỰ ĐỘNG VUNG KIẾM KHI ĐỊCH KHÔNG ĐỠ & KHÔNG ĐANG CHÉM
    -- ========================================================================
    local isDefending = State.IsBlocking or (now < State.BlockReleaseClock) or (now - State.LastDodgeClock < 0.18)
    if not isDefending and not enemyBlockingNow and not enemySwingingNow and not coloredSkillNow then
        if dist <= Config.AttackRange and now >= State.HoldAttackUntil and (now - State.LastAttackClock >= 0.24) then
            State.LastAttackClock = now
            triggerAction("Light", "Tap")
        end
    end

    local modeLabel = Config.Mode1v1 and "1v1" or "2v2"
    local actionLabel = coloredSkillNow and "NÉ SKILL MÀU!"
        or (enemySwingingNow and "ĐỠ & PHẢN ĐÒN!"
        or (enemyBlockingNow and "ĐỊCH ĐỠ -> DỪNG!"
        or "Đang áp sát"))
    State.StatusText = string.format("[%s] %s (%.1fm) %s", modeLabel, enemy.Name:sub(1, 8), dist, actionLabel)
end

-- ============================================================================
-- 5. GIAO DIỆN MENU TỐI GIẢN: CHỈ GỒM 2 NÚT [CHẾ ĐỘ 1V1] VÀ [CHẾ ĐỘ 2V2]
-- ============================================================================

local function buildCleanDualModeHud()
    local parentGui = (typeof(gethui) == "function" and gethui()) or CoreGui
    for _, oldName in ipairs({ "OllieKatanaDuelHUD", "OllieKatanaDuelHUD_V2", "OllieKatanaDuelHUD_V3", "OllieKatanaDuelHUD_V4" }) do
        local old = parentGui:FindFirstChild(oldName)
        if old then old:Destroy() end
    end

    local sg = Instance.new("ScreenGui")
    sg.Name = "OllieKatanaDuelHUD_V4"
    sg.ResetOnSpawn = false
    sg.Parent = parentGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 215, 0, 112)
    frame.Position = UDim2.new(0.015, 0, 0.18, 0)
    frame.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
    frame.BackgroundTransparency = 0.08
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = sg

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 70, 70)
    stroke.Thickness = 1.5
    stroke.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -12, 0, 20)
    title.Position = UDim2.new(0, 6, 0, 4)
    title.BackgroundTransparency = 1
    title.Text = "KATANA AUTO V4 [1v1 / 2v2]"
    title.TextColor3 = Color3.fromRGB(255, 90, 90)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 12
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = frame

    local statusLbl = Instance.new("TextLabel")
    statusLbl.Size = UDim2.new(1, -12, 0, 16)
    statusLbl.Position = UDim2.new(0, 6, 0, 22)
    statusLbl.BackgroundTransparency = 1
    statusLbl.Text = State.StatusText
    statusLbl.TextColor3 = Color3.fromRGB(110, 235, 255)
    statusLbl.Font = Enum.Font.Code
    statusLbl.TextSize = 10
    statusLbl.TextXAlignment = Enum.TextXAlignment.Left
    statusLbl.Parent = frame

    local btn1v1 = Instance.new("TextButton")
    btn1v1.Size = UDim2.new(1, -16, 0, 30)
    btn1v1.Position = UDim2.new(0, 8, 0, 42)
    btn1v1.Font = Enum.Font.GothamBold
    btn1v1.TextSize = 12
    btn1v1.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn1v1.Parent = frame
    Instance.new("UICorner", btn1v1).CornerRadius = UDim.new(0, 6)

    local btn2v2 = Instance.new("TextButton")
    btn2v2.Size = UDim2.new(1, -16, 0, 30)
    btn2v2.Position = UDim2.new(0, 8, 0, 76)
    btn2v2.Font = Enum.Font.GothamBold
    btn2v2.TextSize = 12
    btn2v2.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn2v2.Parent = frame
    Instance.new("UICorner", btn2v2).CornerRadius = UDim.new(0, 6)

    local function updateUiButtons()
        btn1v1.Text = "Chế Độ 1v1 (Full Auto): " .. (Config.Mode1v1 and "BẬT" or "TẮT")
        btn1v1.BackgroundColor3 = Config.Mode1v1 and Color3.fromRGB(35, 120, 60) or Color3.fromRGB(45, 45, 55)

        btn2v2.Text = "Chế Độ 2v2 (Full Auto): " .. (Config.Mode2v2 and "BẬT" or "TẮT")
        btn2v2.BackgroundColor3 = Config.Mode2v2 and Color3.fromRGB(35, 105, 145) or Color3.fromRGB(45, 45, 55)
    end

    btn1v1.MouseButton1Click:Connect(function()
        Config.Mode1v1 = not Config.Mode1v1
        if Config.Mode1v1 then
            Config.Mode2v2 = false
        end
        updateUiButtons()
    end)

    btn2v2.MouseButton1Click:Connect(function()
        Config.Mode2v2 = not Config.Mode2v2
        if Config.Mode2v2 then
            Config.Mode1v1 = false
        end
        updateUiButtons()
    end)

    updateUiButtons()

    RunService.RenderStepped:Connect(function()
        statusLbl.Text = State.StatusText
    end)
end

scanGameButtons()
buildCleanDualModeHud()
RunService.RenderStepped:Connect(masterCombatLoop)
