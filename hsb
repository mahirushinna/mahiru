local HookedMoveRemote = nil
local HookedRemoteArgsTemplate = nil

-- Install __namecall metamethod hook to capture RoChess move RemoteEvent/RemoteFunction automatically
if hookmetamethod and getnamecallmethod then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if (method == "FireServer" or method == "InvokeServer") and not checkcaller() then
            local args = { ... }
            local nameLower = string.lower(self.Name)
            if string.find(nameLower, "move") or string.find(nameLower, "play") or string.find(nameLower, "piece") or string.find(nameLower, "chess") then
                HookedMoveRemote = self
                HookedRemoteArgsTemplate = args
            elseif #args >= 2 and type(args[1]) == "string" and #args[1] == 2 and AlgebraicToIndex(args[1]) then
                HookedMoveRemote = self
                HookedRemoteArgsTemplate = args
            end
        end
        return oldNamecall(self, ...)
    end)
end

-- Locate square GuiObjects (a1..h8) on the RoChess board
local SquareGuiCache = {}

local function ScanBoardSquares()
    table.clear(SquareGuiCache)
    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if desc:IsA("GuiObject") and desc.Visible then
            local nameLower = string.lower(desc.Name)
            if #nameLower == 2 and AlgebraicToIndex(nameLower) then
                SquareGuiCache[nameLower] = desc
            end
        end
    end

    -- Fallback: Geometric 8x8 Grid Reconstruction from Main Board Frame if squares aren't named "a1".."h8"
    if next(SquareGuiCache) == nil then
        local largestSquareFrame = nil
        local bestArea = 0
        for _, desc in ipairs(PlayerGui:GetDescendants()) do
            if desc:IsA("GuiObject") and desc.Visible then
                local size = desc.AbsoluteSize
                if size.X >= 220 and math.abs(size.X - size.Y) <= 12 then
                    local area = size.X * size.Y
                    if area > bestArea then
                        bestArea = area
                        largestSquareFrame = desc
                    end
                end
            end
        end
        if largestSquareFrame then
            SquareGuiCache["_BOARD_FRAME"] = largestSquareFrame
        end
    end
end

local function ClickScreenPosition(x, y)
    local inset = GuiService:GetGuiInset()
    local realX, realY = x, y + inset.Y
    VirtualInputManager:SendMouseButtonEvent(realX, realY, 0, true, game, 1)
    task.wait(0.04)
    VirtualInputManager:SendMouseButtonEvent(realX, realY, 0, false, game, 1)
end

-- Executes the chosen move via Hooked Remote first, and UI Square Simulation second
local function ExecuteMoveOnBoard(move, mySide)
    local fromAlg = IndexToAlgebraic(move.from)
    local toAlg = IndexToAlgebraic(move.to)

    -- Method A: Direct Hooked Remote Dispatch
    if Config.UseHookMove and HookedMoveRemote then
        pcall(function()
            if HookedMoveRemote:IsA("RemoteEvent") then
                if HookedRemoteArgsTemplate and type(HookedRemoteArgsTemplate[1]) == "table" then
                    HookedMoveRemote:FireServer({ from = fromAlg, to = toAlg, promotion = "q" })
                else
                    HookedMoveRemote:FireServer(fromAlg, toAlg, "q")
                end
            elseif HookedMoveRemote:IsA("RemoteFunction") then
                task.spawn(function()
                    HookedMoveRemote:InvokeServer(fromAlg, toAlg, "q")
                end)
            end
        end)
    end

    -- Method B: Simulated Hook on UI Squares (Handles both Named Squares & 8x8 Coordinate Grid)
    if Config.UseUIFallback then
        ScanBoardSquares()
        local fromObj = SquareGuiCache[fromAlg]
        local toObj = SquareGuiCache[toAlg]

        if fromObj and toObj then
            -- Fire getconnections if executor supports signal firing
            if getconnections then
                for _, sigName in ipairs({ "MouseButton1Click", "MouseButton1Down", "Activated", "InputBegan" }) do
                    if fromObj[sigName] then
                        for _, conn in ipairs(getconnections(fromObj[sigName])) do
                            pcall(function() conn:Fire() end)
                        end
                    end
                end
                task.wait(0.06)
                for _, sigName in ipairs({ "MouseButton1Click", "MouseButton1Down", "MouseButton1Up", "Activated" }) do
                    if toObj[sigName] then
                        for _, conn in ipairs(getconnections(toObj[sigName])) do
                            pcall(function() conn:Fire() end)
                        end
                    end
                end
            end

            -- Also click center of square coordinates
            local fPos, fSize = fromObj.AbsolutePosition, fromObj.AbsoluteSize
            local tPos, tSize = toObj.AbsolutePosition, toObj.AbsoluteSize
            ClickScreenPosition(fPos.X + fSize.X * 0.5, fPos.Y + fSize.Y * 0.5)
            task.wait(0.08)
            ClickScreenPosition(tPos.X + tSize.X * 0.5, tPos.Y + tSize.Y * 0.5)

        elseif SquareGuiCache["_BOARD_FRAME"] then
            local boardFrame = SquareGuiCache["_BOARD_FRAME"]
            local bPos = boardFrame.AbsolutePosition
            local bSize = boardFrame.AbsoluteSize
            local cellW, cellH = bSize.X / 8, bSize.Y / 8

            local fFile, fRank = IndexToFileRank(move.from)
            local tFile, tRank = IndexToFileRank(move.to)

            local fCol, fRow, tCol, tRow
            if mySide == 1 then -- Playing White (a1 bottom-left)
                fCol = fFile - 1
                fRow = 8 - fRank
                tCol = tFile - 1
                tRow = 8 - tRank
            else -- Playing Black (h8 bottom-left)
                fCol = 8 - fFile
                fRow = fRank - 1
                tCol = 8 - tFile
                tRow = tRank - 1
            end

            local fx = bPos.X + (fCol + 0.5) * cellW
            local fy = bPos.Y + (fRow + 0.5) * cellH
            local tx = bPos.X + (tCol + 0.5) * cellW
            local ty = bPos.Y + (tRow + 0.5) * cellH

            ClickScreenPosition(fx, fy)
            task.wait(0.08)
            ClickScreenPosition(tx, ty)
        end
    end
end

