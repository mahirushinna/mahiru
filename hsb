-- Theo dõi chính xác mọi nút bấm trên màn hình di động hoặc PC
local ActiveTouchesCount = 0

UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		IsFiringActive = true
	elseif input.UserInputType == Enum.UserInputType.Touch then
		Camera = Workspace.CurrentCamera
		local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
		local tPos = Vector2.new(input.Position.X, input.Position.Y)

		-- Vùng nút bắn phải và nút bắn trái dựa trên layout trong video
		local rightFireCenter = Vector2.new(vp.X * 0.835, vp.Y * 0.625)
		local leftFireCenter = Vector2.new(vp.X * 0.045, vp.Y * 0.505)

		if (tPos - rightFireCenter).Magnitude <= 70 or (tPos - leftFireCenter).Magnitude <= 60 then
			ActiveTouchesCount += 1
			IsFiringActive = true
		end
	end
end)

UserInputService.InputEnded:Connect(function(input: InputObject)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		IsFiringActive = false
	elseif input.UserInputType == Enum.UserInputType.Touch then
		Camera = Workspace.CurrentCamera
		local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
		local tPos = Vector2.new(input.Position.X, input.Position.Y)
		local rightFireCenter = Vector2.new(vp.X * 0.835, vp.Y * 0.625)
		local leftFireCenter = Vector2.new(vp.X * 0.045, vp.Y * 0.505)

		if (tPos - rightFireCenter).Magnitude <= 70 or (tPos - leftFireCenter).Magnitude <= 60 then
			ActiveTouchesCount = math.max(0, ActiveTouchesCount - 1)
			if ActiveTouchesCount == 0 then
				IsFiringActive = false
			end
		end
	end
end)

