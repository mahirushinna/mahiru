local HookState = {
    NetQueue = {},
    HexRemote = nil,          -- e.g. 0c35590e8d discovered from queue/move packets
    MovePacketBuilder = nil,  -- Learned function(fromAlg, toAlg, uci, fromIdx, toIdx) -> payload
    LiveBoardInstances = {},  -- Verified live instances (NEVER class prototypes!)
    LastHookSummary = "Ready"
}

-- ZERO-INTERFERENCE __namecall Hook:
-- Calls oldNamecall FIRST or without ANY colon calls so the LuaU namecall register is NEVER corrupted!
if hookmetamethod and getnamecallmethod then
    pcall(function()
        local oldNamecall
        local hookFn = function(self, ...)
            local method = getnamecallmethod()
            if (method == "FireServer" or method == "InvokeServer") and not checkcaller() then
                HookState.NetQueue[#HookState.NetQueue + 1] = {
                    rem = self,
                    method = method,
                    args = { ... }
                }
            end
            return oldNamecall(self, ...)
        end
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure and newcclosure(hookFn) or hookFn)
        Logger.Push("INIT", "Safe Async __namecall installed (Zero UI/Touch block).")
    end)
end

local function SerializeVal(v, depth)
    depth = depth or 0
    if depth > 2 then return "..." end
    if type(v) == "string" then
        return '"' .. v .. '"'
    elseif type(v) == "number" or type(v) == "boolean" then
        return tostring(v)
    elseif typeof(v) == "Instance" then
        return v.ClassName .. ":" .. v.Name
    elseif type(v) == "table" then
        local parts = {}
        local c = 0
        for k, val in pairs(v) do
            c += 1
            if c <= 8 then
                parts[#parts + 1] = tostring(k) .. "=" .. SerializeVal(val, depth + 1)
            end
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

-- Background processor for intercepted network packets (runs in OUR thread, never blocks game!)
local function ProcessNetQueue()
    while #HookState.NetQueue > 0 do
        local item = table.remove(HookState.NetQueue, 1)
        pcall(function()
            local rem = item.rem
            local remName = tostring(rem.Name)
            local args = item.args

            local dumped = {}
            for i = 1, math.min(#args, 4) do
                dumped[#dumped + 1] = SerializeVal(args[i], 0)
            end
            Logger.Push("NET", string.format("%s:%s(%s)", remName, item.method, table.concat(dumped, ", ")))

            -- If this remote sends a table with `type=...` (like 0c35590e8d in video_1.mp4!)
            if #args >= 1 and type(args[1]) == "table" then
                local t = args[1]
                HookState.HexRemote = rem

                -- Check if this packet is a chess move packet!
                local pType = tostring(t.type or t.t or "")
                if pType ~= "queue" and pType ~= "ping" then
                    Logger.Push("SNIFF", "Captured Table Packet on " .. remName .. ": " .. SerializeVal(t, 0))
                    -- Auto-clone template keys for future AI moves!
                    local template = {}
                    for k, v in pairs(t) do template[k] = v end

                    HookState.MovePacketBuilder = function(fromAlg, toAlg, uci)
                        local pkt = {}
                        for k, v in pairs(template) do
                            if type(v) == "string" then
                                if #v == 2 and AlgebraicToIndex(v) then
                                    -- Distinguish source vs target key name
                                    local kl = string.lower(tostring(k))
                                    if string.find(kl, "to") or string.find(kl, "dst") or string.find(kl, "end") or string.find(kl, "target") or kl == "b" then
                                        pkt[k] = toAlg
                                    else
                                        pkt[k] = fromAlg
                                    end
                                elseif #v >= 4 and AlgebraicToIndex(string.sub(v, 1, 2)) and AlgebraicToIndex(string.sub(v, 3, 4)) then
                                    pkt[k] = uci
                                elseif string.find(v, "=") then
                                    -- Encoded query string like c="e2e4" or c="from=e2&to=e4"
                                    local replaced = string.gsub(v, "[a-h][1-8][a-h][1-8]", uci)
                                    pkt[k] = replaced
                                else
                                    pkt[k] = v
                                end
                            else
                                pkt[k] = v
                            end
                        end
                        return pkt
                    end
                    Logger.Push("LOCK", "Auto-Learned Move Packet Builder on " .. remName .. "!")
                end
            elseif #args >= 2 and type(args[1]) == "string" and type(args[2]) == "string" and AlgebraicToIndex(args[1]) and AlgebraicToIndex(args[2]) then
                HookState.HexRemote = rem
                HookState.MovePacketBuilder = function(fromAlg, toAlg)
                    return fromAlg, toAlg, "q"
                end
                Logger.Push("LOCK", "Auto-Learned 2-String Move Packet on " .. remName .. "!")
            end
        end)
    end
end

-- Deep Inspector: Inspects the 3 `makeMove` functions & finds LIVE instances (never prototypes!)
local function DeepInspectGCAndRemotes()
    table.clear(HookState.LiveBoardInstances)

    -- 1. Scan ReplicatedStorage for hex-named RemoteEvents (like 0c35590e8d)
    for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
        if desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction") then
            local n = desc.Name
            if string.match(n, "^[0-9a-fA-F]+$") and #n >= 6 then
                HookState.HexRemote = HookState.HexRemote or desc
                Logger.Push("REM", "Found Hex Remote: " .. desc:GetFullName())
            end
        end
    end

    if not getgc then
        Logger.Push("WARN", "getgc not supported on this executor.")
        return
    end

    local prototypeTables = {}
    local moveFnList = {}

    pcall(function()
        for _, obj in ipairs(getgc(true)) do
            if type(obj) == "table" then
                for _, fnName in ipairs({ "makeMove", "MakeMove", "MovePiece", "TryMove", "sendMove", "selectSquare", "onSquareClick" }) do
                    local fn = rawget(obj, fnName)
                    if type(fn) == "function" then
                        local isPrototype = (rawget(obj, "__index") == obj)
                        table.insert(moveFnList, { name = fnName, fn = fn, tbl = obj, isProto = isPrototype })
                        if isPrototype then
                            prototypeTables[obj] = fnName
                        else
                            -- Verify if `obj` has live state fields (not just a function library)
                            local fieldCount = 0
                            for k, v in pairs(obj) do
                                if type(v) ~= "function" then fieldCount += 1 end
                            end
                            if fieldCount >= 2 then
                                table.insert(HookState.LiveBoardInstances, { inst = obj, fn = fn, name = fnName })
                            end
                        end
                    end
                end
            end
        end

        -- Second pass: Find LIVE instances whose metatable is one of the discovered prototypeTables!
        for _, obj in ipairs(getgc(true)) do
            if type(obj) == "table" and not prototypeTables[obj] then
                local mt = getmetatable(obj)
                if type(mt) == "table" then
                    local protoName = prototypeTables[mt] or (type(rawget(mt, "__index")) == "table" and prototypeTables[rawget(mt, "__index")])
                    if protoName then
                        local fn = obj[protoName]
                        if type(fn) == "function" then
                            table.insert(HookState.LiveBoardInstances, { inst = obj, fn = fn, name = protoName })
                        end
                    end
                end
            end
        end
    end)

    -- Dump constants & upvalues of each discovered moveFn to the Log so we see the exact protocol!
    for idx, item in ipairs(moveFnList) do
        local constStrings = {}
        if debug and debug.getconstants then
            local ok, consts = pcall(debug.getconstants, item.fn)
            if ok and consts then
                for _, c in pairs(consts) do
                    if type(c) == "string" and #c > 0 and #c <= 24 then
                        table.insert(constStrings, c)
                    end
                end
            end
        end
        Logger.Push("GC-FN", string.format("#%d %s (Proto:%s) Consts:[%s]",
            idx, item.name, tostring(item.isProto), table.concat(constStrings, ", ")
        ))
    end

    Logger.Push("SCAN", string.format("HexRemote: %s | MoveFns: %d | LiveInstances: %d",
        HookState.HexRemote and HookState.HexRemote.Name or "None",
        #moveFnList,
        #HookState.LiveBoardInstances
    ))
end

