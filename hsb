-- 1. LIVE DIAGNOSTIC LOGGER SYSTEM (TOGGLEABLE ON-SCREEN CONSOLE)
--------------------------------------------------------------------------------
local Logger = {
    Lines = {},
    MaxLines = 120,
    Visible = true,
    OnUpdate = nil
}

function Logger:Add(category, msg)
    local timestamp = os.date("%H:%M:%S")
    local formatted = string.format("[%s][%s] %s", timestamp, category, tostring(msg))
    table.insert(self.Lines, formatted)
    if #self.Lines > self.MaxLines then
        table.remove(self.Lines, 1)
    end
    if self.OnUpdate then
        pcall(self.OnUpdate)
    end
end

function Logger:GetText()
    return table.concat(self.Lines, "\n")
end

function Logger:Clear()
    table.clear(self.Lines)
    if self.OnUpdate then
        pcall(self.OnUpdate)
    end
end

