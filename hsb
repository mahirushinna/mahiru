-- Tự động học RemoteEvent khi bạn bấm tay 1 lần hoặc tự quét trong ReplicatedStorage
if typeof(hookmetamethod) == "function" and typeof(getnamecallmethod) == "function" then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if not checkcaller() and (method == "FireServer" or method == "InvokeServer") then
            local name = string.lower(self.Name)
            local args = { ... }
            local firstArg = type(args[1]) == "string" and string.lower(args[1]) or ""

            if string.find(name, "block") or string.find(name, "parry") or string.find(name, "guard")
                or string.find(firstArg, "block") or string.find(firstArg, "parry") or string.find(firstArg, "guard") then
                if args[1] == false or args[2] == false or string.find(firstArg, "unblock") or string.find(firstArg, "stop") or string.find(firstArg, "end") then
                    State.CapturedRemotes.BlockUp = { Remote = self, Method = method, Args = args }
                else
                    State.CapturedRemotes.BlockDown = { Remote = self, Method = method, Args = args }
                end
            elseif string.find(name, "light") or string.find(name, "slash") or string.find(name, "m1") or string.find(name, "attack")
                or string.find(firstArg, "light") or string.find(firstArg, "slash") or string.find(firstArg, "m1") then
                State.CapturedRemotes.Light = { Remote = self, Method = method, Args = args }
            elseif string.find(name, "heavy") or string.find(name, "m2") or string.find(name, "strong")
                or string.find(firstArg, "heavy") or string.find(firstArg, "m2") then
                State.CapturedRemotes.Heavy = { Remote = self, Method = method, Args = args }
            end
        end
        return oldNamecall(self, ...)
    end)
end

local function fireCapturedRemote(key)
    local data = State.CapturedRemotes[key]
    if data and data.Remote and data.Remote.Parent then
        pcall(function()
            if data.Method == "FireServer" then
                data.Remote:FireServer(unpack(data.Args))
            else
                data.Remote:InvokeServer(unpack(data.Args))
            end
        end)
        return true
    end
    return false
end

local function performAction(action, mode)
    -- mode: "Tap", "Down", "Up"
    if not State.Buttons[action] or not State.Buttons[action].Parent then
        scanMobileButtons()
    end

    local btn = State.Buttons[action]

    if action == "Block" then
        if mode == "Down" then
            fireCapturedRemote("BlockDown")
            fireTouchElement(btn, true)
            pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game) end)
        elseif mode == "Up" then
            fireCapturedRemote("BlockUp")
            fireTouchElement(btn, false)
            pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end)
        else
            fireCapturedRemote("BlockDown")
            fireTouchElement(btn, true)
            pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game) end)
            task.delay(Config.HoldBlockTime, function()
                if not State.EnemyAttacking then
                    fireCapturedRemote("BlockUp")
                    fireTouchElement(btn, false)
                    pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end)
                end
            end)
        end
    elseif action == "Light" then
        if mode == "Up" then
            fireTouchElement(btn, false)
        else
            fireCapturedRemote("Light")
            fireTouchElement(btn, true)
            -- Kích hoạt Tool nếu kiếm là một Tool trong Character
            local char = LocalPlayer.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool then pcall(function() tool:Activate() end) end
            task.delay(0.04, function()
                fireTouchElement(btn, false)
            end)
        end
    elseif action == "Heavy" then
        fireCapturedRemote("Heavy")
        fireTouchElement(btn, true)
        pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game) end)
        task.delay(0.05, function()
            fireTouchElement(btn, false)
            pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game) end)
        end)
    end
end

-- ============================================================================
-- 3. BỘ NHẬN DIỆN ĐÒN ĐÁNH & ĐỠ ĐÒN KHÔNG PHỤ THUỘC TÊN ANIMATION
-- ============================================================================

local function detectEnemyState(enemyChar, dist)
    if not enemyChar then return false, false, false end
    local hum = enemyChar:FindFirstChildOfClass("Humanoid")
    local root = enemyChar:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return false, false, false end

    local isBlocking = false
    local isAttacking = false
    local isStunned = false

    -- A. Kiểm tra WalkSpeed & Attributes / hiệu ứng trên người đối thủ
    -- Khi đỡ đòn (như ở 0:09, 0:14, 0:24 trong video 2), tốc độ di chuyển của nhân vật giảm mạnh (< 9)
    local speed = hum.WalkSpeed

    for k, v in pairs(enemyChar:GetAttributes()) do
        local name = string.lower(k)
        if v == true then
            if string.find(name, "block") or string.find(name, "parry") or string.find(name, "guard") then
                isBlocking = true
            elseif string.find(name, "attack") or string.find(name, "swing") or string.find(name, "slash") or string.find(name, "m1") or string.find(name, "heavy") or string.find(name, "combo") then
                isAttacking = true
            elseif string.find(name, "stun") or string.find(name, "break") or string.find(name, "stagger") then
                isStunned = true
            end
        end
    end

    -- B. Quét trực tiếp hiệu ứng vũ khí: Tia kiếm (Trail), Ánh sáng đỏ (Highlight), Âm thanh chém (Sound), Thanh giáp trắng (BillboardGui)
    for _, desc in ipairs(enemyChar:GetDescendants()) do
        if desc:IsA("BoolValue") and desc.Value == true then
            local n = string.lower(desc.Name)
            if string.find(n, "block") or string.find(n, "guard") or string.find(n, "parry") then
                isBlocking = true
            elseif string.find(n, "attack") or string.find(n, "swing") or string.find(n, "slash") then
                isAttacking = true
            elseif string.find(n, "stun") or string.find(n, "broken") then
                isStunned = true
            end
        elseif desc:IsA("Trail") and desc.Enabled then
            -- Vệt sáng lưỡi kiếm bật lên khi vung kiếm
            isAttacking = true
        elseif desc:IsA("Highlight") and desc.Enabled then
            -- Đòn Nặng phát sáng viền/thân màu đỏ rực (như ở 0:25, 0:31, 0:35, 0:38 trong video 2)
            if desc.FillColor.R > 0.65 and desc.FillColor.G < 0.4 then
                isAttacking = true
            end
        elseif desc:IsA("Sound") and desc.IsPlaying and desc.TimePosition < 0.35 then
            local sn = string.lower(desc.Name)
            if string.find(sn, "slash") or string.find(sn, "swing") or string.find(sn, "sword") or string.find(sn, "katana") or string.find(sn, "attack") or string.find(sn, "heavy") or string.find(sn, "whoosh") then
                isAttacking = true
            end
        end
    end

    -- C. Phân tích AnimationTrack bằng cơ chế Tự Học (Auto-Learn ID)
    local animator = hum:FindFirstChildOfClass("Animator") or hum
    local tracks = animator:GetPlayingAnimationTracks()

    for _, track in ipairs(tracks) do
        if track.IsPlaying and track.WeightCurrent > 0.2 then
            local animId = track.Animation and track.Animation.AnimationId or ""
            local tName = string.lower(track.Name or "")
            local len = track.Length
            local pos = track.TimePosition
            local spd = track.Speed
            local prio = track.Priority

            -- Bước 1: Nếu đối thủ đang ở xa (> 20 studs) và chỉ chạy/đứng yên, ghi nhận ID đó là hoạt ảnh di chuyển cơ bản
            if dist > 20 and (track.Looped or len > 2.0 or prio == Enum.AnimationPriority.Core or prio == Enum.AnimationPriority.Idle or prio == Enum.AnimationPriority.Movement) then
                State.LocomotionAnims[animId] = true
            end

            if string.find(tName, "walk") or string.find(tName, "run") or string.find(tName, "idle") or string.find(tName, "jump") or string.find(tName, "fall") then
                State.LocomotionAnims[animId] = true
            end

            -- Bước 2: Nếu KHÔNG phải hoạt ảnh di chuyển cơ bản
            if animId ~= "" and not State.LocomotionAnims[animId] then
                -- Hoạt ảnh Đỡ đòn (Block):
                -- Khi giơ kiếm ngang ngực đỡ đòn, hoạt ảnh hoặc có Speed == 0 (đứng khung hình), hoặc Looped == true ở ưu tiên Action, hoặc nhân vật đi chậm lại
                local prevPos = State.LastTrackPositions[animId]
                State.LastTrackPositions[animId] = pos
                local isFrozenPose = (prevPos and math.abs(pos - prevPos) < 0.001 and pos > 0.05)

                if State.ConfirmedBlockAnims[animId]
                    or string.find(tName, "block") or string.find(tName, "guard") or string.find(tName, "parry")
                    or isFrozenPose
                    or (track.Looped and prio ~= Enum.AnimationPriority.Idle and prio ~= Enum.AnimationPriority.Movement and speed <= 10)
                then
                    State.ConfirmedBlockAnims[animId] = true
                    isBlocking = true

                -- Hoạt ảnh Vung kiếm tấn công (Attack):
                -- Không lặp lại (not Looped), thời lượng một nhát chém từ 0.2s đến 2.2s, đang ở 75% đầu của nhát chém
                elseif not track.Looped and len >= 0.18 and len <= 2.3 then
                    local ratio = (len > 0) and (pos / len) or 0.3
                    if ratio >= 0.01 and ratio <= 0.76 then
                        isAttacking = true
                    end
                end
            end
        end
    end

    -- Nếu vừa phát hiện vung kiếm vừa phát hiện giữ khiên, ưu tiên trạng thái vung kiếm để đỡ đòn ngay
    if isAttacking then
        isBlocking = false
    end

    return isBlocking, isAttacking, isStunned
end

