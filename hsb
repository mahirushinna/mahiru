local function update2v2Roster()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local cam = workspace.CurrentCamera
    if not pg or not cam then return end

    local vp = cam.ViewportSize
    local halfW = vp.X * 0.5
    local maxTopY = vp.Y * 0.48

    for _, lbl in ipairs(pg:GetDescendants()) do
        if lbl:IsA("TextLabel") and isGuiShown(lbl) then
            local pos = lbl.AbsolutePosition
            local size = lbl.AbsoluteSize
            if pos.Y >= 0 and pos.Y < maxTopY and size.X > 20 then
                local raw = string.lower(lbl.Text or "")
                local loc = ""
                pcall(function() loc = string.lower(lbl.LocalizedText or "") end)
                local combined = raw .. " " .. loc
                local centerX = pos.X + (size.X * 0.5)

                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then
                        local uName = string.lower(plr.Name)
                        local dName = string.lower(plr.DisplayName)
                        local matched = string.find(combined, "@" .. uName, 1, true)
                            or (#uName >= 4 and string.find(combined, uName, 1, true))
                            or (#dName >= 4 and string.find(combined, dName, 1, true))

                        if matched then
                            if centerX < halfW then
                                State.ConfirmedAllies2v2[plr.UserId] = true
                                State.ConfirmedEnemies2v2[plr.UserId] = nil
                            else
                                State.ConfirmedEnemies2v2[plr.UserId] = true
                                State.ConfirmedAllies2v2[plr.UserId] = nil
                            end
                        end
                    end
                end
            end
        end
    end
end

local function hasGreenAllyRingUnderFeet(char)
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    for _, obj in ipairs(char:GetDescendants()) do
        local col = nil
        pcall(function()
            if (obj:IsA("BasePart") or obj:IsA("MeshPart")) and obj.Transparency < 0.9 then col = obj.Color
            elseif obj:IsA("Decal") or obj:IsA("ImageLabel") then col = obj.ImageColor3 end
        end)
        if col and col.G > 0.62 and col.R < 0.42 and col.B < 0.45 then
            return true
        end
    end

    local rPos = root.Position
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("MeshPart")) and not obj:IsDescendantOf(char) then
            if obj.Size.Y < 1.5 and (obj.Size.X > 2.5 or obj.Size.Z > 2.5) then
                if (obj.Position - rPos).Magnitude < 5.0 then
                    local c = obj.Color
                    if c.G > 0.62 and c.R < 0.42 and c.B < 0.45 then
                        return true
                    end
                end
            end
        end
    end
    return false
end

local function getTarget()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, 999 end

    if Config.Mode1v1 then
        local best = nil
        local minDist = 999
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local c = plr.Character
                local h = c:FindFirstChildOfClass("Humanoid")
                local r = c:FindFirstChild("HumanoidRootPart")
                if h and h.Health > 0 and r then
                    local d = (r.Position - myRoot.Position).Magnitude
                    if d < minDist then
                        minDist = d
                        best = c
                    end
                end
            end
        end
        return best, minDist
    end

    update2v2Roster()
    local bestEnemy = nil
    local minDist = 999

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local c = plr.Character
            local h = c:FindFirstChildOfClass("Humanoid")
            local r = c:FindFirstChild("HumanoidRootPart")
            if h and h.Health > 0 and r then
                if hasGreenAllyRingUnderFeet(c) then
                    State.ConfirmedAllies2v2[plr.UserId] = true
                end
                if not State.ConfirmedAllies2v2[plr.UserId] then
                    local d = (r.Position - myRoot.Position).Magnitude
                    if d < minDist then
                        minDist = d
                        bestEnemy = c
                    end
                end
            end
        end
    end
    return bestEnemy, minDist
end

