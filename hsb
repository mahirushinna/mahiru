-- Nhận diện thao tác bóp cò súng trên cả giao diện cảm ứng Mobile lẫn chuột PC
local function checkTouchIsOnFireButton(screenPos)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end

    local guiObjects = playerGui:GetGuiObjectsAtPosition(screenPos.X, screenPos.Y)
    for _, obj in ipairs(guiObjects) do
        -- Bỏ qua nếu đang chạm vào Menu hoặc Nút Nổi của script
        if obj:IsDescendantOf(ScreenGui) then
            return false
        end
        if obj:IsA("GuiButton") and obj.Visible then
            local lowerName = string.lower(obj.Name)
            -- Nhận diện nút bắn theo tên hoặc vị trí nút cò súng trên màn hình Mobile
            if string.find(lowerName, "fire") or string.find(lowerName, "shoot") or string.find(lowerName, "attack") then
                return true
            end
            -- Trong bố cục HUD của game, nút bắn nằm ở cụm nút điều khiển bên phải hoặc nút bắn phụ bên trái
            local viewport = Camera.ViewportSize
            if screenPos.X > viewport.X * 0.55 and screenPos.Y > viewport.Y * 0.35 then
                return true
            end
        end
    end
    return false
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.Touch then
        if checkTouchIsOnFireButton(input.Position) then
            ActiveTouches[input] = true
            IsShootingTouch = true
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if ActiveTouches[input] then
        ActiveTouches[input] = nil
        IsShootingTouch = (next(ActiveTouches) ~= nil)
    end
end)

local function isPlayerFiring()
    -- 1. Chuột trái trên PC
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        return true
    end
    -- 2. Chạm nút bắn trên màn hình cảm ứng Mobile
    if IsShootingTouch then
        return true
    end
    return false
end

-- Tìm phần ĐẦU (Head) của kẻ địch gần tâm súng (giữa màn hình) nhất
local function getClosestEnemyHeadToCrosshair()
    local bestHead = nil
    local shortestScreenDistance = math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    local targets = getPotentialTargets()
    for _, targetData in ipairs(targets) do
        local char = targetData.Character
        local plr = targetData.Player
        if char and not isTeammate(plr, char) then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local head = char:FindFirstChild("Head")

            if humanoid and humanoid.Health > 0 and head then
                local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen and screenPoint.Z > 0 then
                    local screenPos2D = Vector2.new(screenPoint.X, screenPoint.Y)
                    local distFromCrosshair = (screenPos2D - screenCenter).Magnitude

                    if distFromCrosshair < shortestScreenDistance then
                        shortestScreenDistance = distFromCrosshair
                        bestHead = head
                    end
                end
            end
        end
    end

    return bestHead
end

-- Vòng lặp cập nhật mỗi khung hình
local lastEspUpdate = 0
RunService.RenderStepped:Connect(function()
    Camera = Workspace.CurrentCamera
    if not Camera then return end

    -- Cập nhật Aimbot ngay lập tức khi bật và người chơi đang bắn
    if Config.Aimbot_Enabled and isPlayerFiring() then
        local targetHead = getClosestEnemyHeadToCrosshair()
        if targetHead then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
        end
    end

    -- Cập nhật ESP định kỳ (mỗi 0.1 giây để tối ưu FPS trên điện thoại)
    local now = tick()
    if now - lastEspUpdate >= 0.1 then
        lastEspUpdate = now
        local targets = getPotentialTargets()
        for _, targetData in ipairs(targets) do
            updateCharacterESP(targetData
