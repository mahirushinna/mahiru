-- 7.1 Deep GC & Module Scanner for RoChess internal functions & Remotes
local function ScanGarbageCollectorForHooks()
    if not getgc then return end
    pcall(function()
        for _, obj in ipairs(getgc(true)) do
            if type(obj) == "table" then
                local moveFn = rawget(obj, "MakeMove") or rawget(obj, "MovePiece") or rawget(obj, "TryMove") or rawget(obj, "SubmitMove") or rawget(obj, "sendMove") or rawget(obj, "makeMove")
                if type(moveFn) == "function" then
                    HookState.GCBoardController = obj
                    HookState.GCMoveFunction = moveFn
                end
            elseif type(obj) == "function" and islclosure and islclosure(obj) and not isexecutorclosure(obj) then
                if debug and debug.getupvalues then
                    local ok, upvals = pcall(debug.getupvalues, obj)
                    if ok and upvals then
                        for _, uv in pairs(upvals) do
                            if typeof(uv) == "Instance" and (uv:IsA("RemoteEvent") or uv:IsA("RemoteFunction")) then
                                local n = string.lower(uv.Name)
                                if string.find(n, "move") or string.find(n, "chess") or string.find(n, "game") or string.find(n, "play") then
                                    HookState.CapturedRemote = HookState.CapturedRemote or uv
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end
task.spawn(ScanGarbageCollectorForHooks)

-- 7.2 Metamethod __namecall Hook to intercept any move packet structure
