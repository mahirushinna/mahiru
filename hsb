--[[
	TacticalLocator_Mobile_v3.lua
	Cập nhật:
	1. Chỉ định vị KẺ ĐỊCH (TeamCheck = true), tự động ẩn và xóa hoàn toàn ESP trên đồng đội.
	2. Loại bỏ lỗi nhận diện nhầm tay cầm súng góc nhìn thứ nhất (Viewmodel trong Camera).
	3. Thêm bộ đếm tổng số kẻ địch đang được ESP vẽ (ví dụ: 7, 9) nằm ngay dưới dòng chữ
	   "Xác nhận vụ giết đồng đội" ở chính giữa phía trên màn hình.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

