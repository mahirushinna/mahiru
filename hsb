end

function AIEngine:RestoreState(state)
    for i = 1, 64 do self.Squares64[i] = state.Squares64[i] end
    self.ActiveSide = state.ActiveSide
    self.CRights.WK = state.CRights.WK
    self.CRights.WQ = state.CRights.WQ
    self.CRights.BK = state.CRights.BK
    self.CRights.BQ = state.CRights.BQ
    self.EPSquare = state.EPSquare
end

function AIEngine:IsSquareAttacked(sq, attackerSide)
    local f, r = IndexToFileRank(sq)
    local b = self.Squares64

    local pawnRank = r - attackerSide
    if pawnRank >= 1 and pawnRank <= 8 then
        if f > 1 and b[SqIndex(f - 1, pawnRank)] == attackerSide then return true end
        if f < 8 and b[SqIndex(f + 1, pawnRank)] == attackerSide then return true end
    end

    local knightOffsets = { {-2,-1},{-2,1},{-1,-2},{-1,2},{1,-2},{1,2},{2,-1},{2,1} }
    for _, o in ipairs(knightOffsets) do
        local nf, nr = f + o[1], r + o[2]
        if nf >= 1 and nf <= 8 and nr >= 1 and nr <= 8 then
            if b[SqIndex(nf, nr)] == attackerSide * 2 then return true end
        end
    end

    for df = -1, 1 do
        for dr = -1, 1 do
            if df ~= 0 or dr ~= 0 then
                local kf, kr = f + df, r + dr
                if kf >= 1 and kf <= 8 and kr >= 1 and kr <= 8 then
                    if b[SqIndex(kf, kr)] == attackerSide * 6 then return true end
                end
            end
        end
    end

    local orthoDirs = { {1,0}, {-1,0}, {0,1}, {0,-1} }
    for _, d in ipairs(orthoDirs) do
        local cf, cr = f + d[1], r + d[2]
        while cf >= 1 and cf <= 8 and cr >= 1 and cr <= 8 do
            local p = b[SqIndex(cf, cr)]
            if p ~= 0 then
                if p == attackerSide * 4 or p == attackerSide * 5 then return true end
                break
            end
            cf += d[1]; cr += d[2]
        end
    end

    local diagDirs = { {1,1}, {1,-1}, {-1,1}, {-1,-1} }
    for _, d in ipairs(diagDirs) do
        local cf, cr = f + d[1], r + d[2]
        while cf >= 1 and cf <= 8 and cr >= 1 and cr <= 8 do
            local p = b[SqIndex(cf, cr)]
            if p ~= 0 then
                if p == attackerSide * 3 or p == attackerSide * 5 then return true end
                break
            end
            cf += d[1]; cr += d[2]
        end
    end

    return false
end

function AIEngine:FindKing(side)
    local target = side * 6
    for i = 1, 64 do
        if self.Squares64[i] == target then return i end
    end
    return nil
end

function AIEngine:IsInCheck(side)
    local kSq = self:FindKing(side)
    if not kSq then return true end
    return self:IsSquareAttacked(kSq, -side)
end

function AIEngine:GeneratePseudoMoves(side, capturesOnly)
    local moves = {}
    local b = self.Squares64

    for sq = 1, 64 do
        local p = b[sq]
        if p * side > 0 then
            local absP = math.abs(p)
            local f, r = IndexToFileRank(sq)

            if absP == 1 then
                local forward = r + side
                if forward >= 1 and forward <= 8 then
                    local oneStep = SqIndex(f, forward)
                    local isPromo = (forward == 8 or forward == 1)
                    if not capturesOnly and b[oneStep] == 0 then
                        table.insert(moves, { from = sq, to = oneStep, piece = p, captured = 0, promo = isPromo and (side * 5) or nil })
                        local startRank = (side == 1) and 2 or 7
                        if r == startRank then
                            local twoStep = SqIndex(f, r + 2 * side)
                            if b[twoStep] == 0 then
                                table.insert(moves, { from = sq, to = twoStep, piece = p, captured = 0, isDoublePush = true })
                            end
                        end
                    end
                    for _, df in ipairs({ -1, 1 }) do
                        local cf = f + df
                        if cf >= 1 and cf <= 8 then
                            local tSq = SqIndex(cf, forward)
                            local tP = b[tSq]
                            if tP * side < 0 then
                                table.insert(moves, { from = sq, to = tSq, piece = p, captured = tP, promo = isPromo and (side * 5) or nil })
                            elseif tSq == self.EPSquare then
                                table.insert(moves, { from = sq, to = tSq, piece = p, captured = -side, isEP = true })
                            end
                        end
                    end
                end

            elseif absP == 2 then
                local offsets = { {-2,-1},{-2,1},{-1,-2},{-1,2},{1,-2},{1,2},{2,-1},{2,1} }
                for _, o in ipairs(offsets) do
                    local nf, nr = f + o[1], r + o[2]
                    if nf >= 1 and nf <= 8 and nr >= 1 and nr <= 8 then
                        local tSq = SqIndex(nf, nr)
                        local tP = b[tSq]
                        if tP * side <= 0 and (not capturesOnly or tP ~= 0) then
                            table.insert(moves, { from = sq, to = tSq, piece = p, captured = tP })
                        end
                    end
                end

            elseif absP == 3 or absP == 4 or absP == 5 then
                local dirs = {}
                if absP == 3 or absP == 5 then
                    table.insert(dirs, {1,1}); table.insert(dirs, {1,-1})
                    table.insert(dirs, {-1,1}); table.insert(dirs, {-1,-1})
                end
                if absP == 4 or absP == 5 then
                    table.insert(dirs, {1,0}); table.insert(dirs, {-1,0})
                    table.insert(dirs, {0,1}); table.insert(dirs, {0,-1})
                end
                for _, d in ipairs(dirs) do
                    local cf, cr = f + d[1], r + d[2]
                    while cf >= 1 and cf <= 8 and cr >= 1 and cr <= 8 do
                        local tSq = SqIndex(cf, cr)
                        local tP = b[tSq]
                        if tP == 0 then
                            if not capturesOnly then
                                table.insert(moves, { from = sq, to = tSq, piece = p, captured = 0 })
                            end
                        else
                            if tP * side < 0 then
                                table.insert(moves, { from = sq, to = tSq, piece = p, captured = tP })
                            end
                            break
                        end
                        cf += d[1]; cr += d[2]
                    end
                end

            elseif absP == 6 then
                for df = -1, 1 do
                    for dr = -1, 1 do
                        if df ~= 0 or dr ~= 0 then
                            local kf, kr = f + df, r + dr
                            if kf >= 1 and kf <= 8 and kr >= 1 and kr <= 8 then
                                local tSq = SqIndex(kf, kr)
                                local tP = b[tSq]
                                if tP * side <= 0 and (not capturesOnly or tP ~= 0) then
                                    table.insert(moves, { from = sq, to = tSq, piece = p, captured = tP })
                                end
                            end
                        end
                    end
                end
                if not capturesOnly and not self:IsInCheck(side) then
                    if side == 1 and sq == 5 then
                        if self.CRights.WK and b[6] == 0 and b[7] == 0 and b[8] == 4 then
                            if not self:IsSquareAttacked(6, -1) and not self:IsSquareAttacked(7, -1) then
                                table.insert(moves, { from = 5, to = 7, piece = 6, captured = 0, isCastle = "WK" })
                            end
                        end
                        if self.CRights.WQ and b[4] == 0 and b[3] == 0 and b[2] == 0 and b[1] == 4 then
                            if not self:IsSquareAttacked(4, -1) and not self:IsSquareAttacked(3, -1) then
                                table.insert(moves, { from = 5, to = 3, piece = 6, captured = 0, isCastle = "WQ" })
                            end
                        end
                    elseif side == -1 and sq == 61 then
                        if self.CRights.BK and b[62] == 0 and b[63] == 0 and b[64] == -4 then
                            if not self:IsSquareAttacked(62, 1) and not self:IsSquareAttacked(63, 1) then
                                table.insert(moves, { from = 61, to = 63, piece = -6, captured = 0, isCastle = "BK" })
                            end
                        end
                        if self.CRights.BQ and b[60] == 0 and b[59] == 0 and b[58] == 0 and b[57] == -4 then
                            if not self:IsSquareAttacked(60, 1) and not self:IsSquareAttacked(59, 1) then
                                table.insert(moves, { from = 61, to = 59, piece = -6, captured = 0, isCastle = "BQ" })
                            end
                        end
                    end
                end
            end
        end
    end

    return moves
end

function AIEngine:StepBoard(move)
    local b = self.Squares64
    local side = self.ActiveSide
    b[move.to] = move.promo or move.piece
    b[move.from] = 0

    if move.isEP then
        b[move.to - (side * 8)] = 0
    elseif move.isCastle == "WK" then
        b[6] = 4; b[8] = 0
    elseif move.isCastle == "WQ" then
        b[4] = 4; b[1] = 0
    elseif move.isCastle == "BK" then
        b[62] = -4; b[64] = 0
    elseif move.isCastle == "BQ" then
        b[60] = -4; b[57] = 0
    end

    if move.from == 5 or move.to == 5 then self.CRights.WK = false; self.CRights.WQ = false end
    if move.from == 61 or move.to == 61 then self.CRights.BK = false; self.CRights.BQ = false end
    if move.from == 1 or move.to == 1 then self.CRights.WQ = false end
    if move.from == 8 or move.to == 8 then self.CRights.WK = false end
    if move.from == 57 or move.to == 57 then self.CRights.BQ = false end
    if move.from == 64 or move.to == 64 then self.CRights.BK = false end

    self.EPSquare = move.isDoublePush and (move.from + side * 8) or nil
    self.ActiveSide = -side
end

function AIEngine:GetLegalMoves(side, capturesOnly)
    side = side or self.ActiveSide
    local pseudo = self:GeneratePseudoMoves(side, capturesOnly)
    local legal = {}
    for _, m in ipairs(pseudo) do
        local saved = self:CloneState()
        self:StepBoard(m)
        if not self:IsInCheck(side) then
            m.uci = IndexToAlgebraic(m.from) .. IndexToAlgebraic(m.to) .. (m.promo and "q" or "")
            table.insert(legal, m)
        end
        self:RestoreState(saved)
    end
    return legal
end

-- Enhanced Grandmaster Evaluation: Tapered PeSTO + Bishop Pair + Passed Pawns + King Pawn Shield
function AIEngine:Evaluate(aggressionBias)
    aggressionBias = aggressionBias or 1.0
    local b = self.Squares64
    local mgScore, egScore = 0, 0
    local phase = 0
    local whiteBishops, blackBishops = 0, 0

    for sq = 1, 64 do
        local p = b[sq]
        if p ~= 0 then
            local side = (p > 0) and 1 or -1
            local absP = math.abs(p)
            local baseVal = PIECE_VALUES[absP] or 0
            local f, r = IndexToFileRank(sq)
            local pstRank = (side == 1) and (8 - r) or (r - 1)
            local pstIdx = pstRank * 8 + f

            local mgPos = (PST_MG[absP] and PST_MG[absP][pstIdx]) or 0
            local egPos = (PST_EG[absP] and PST_EG[absP][pstIdx]) or mgPos

            mgScore += side * (baseVal + mgPos * aggressionBias)
            egScore += side * (baseVal + egPos * aggressionBias)

            if absP == 1 then
                -- Passed Pawn bonus
                local advRank = (side == 1) and r or (9 - r)
                if advRank >= 5 then
                    local enemyPawn = -side
                    local blocked = false
                    local checkRank = r + side
                    if checkRank >= 1 and checkRank <= 8 then
                        if b[SqIndex(f, checkRank)] == enemyPawn then blocked = true end
                        if f > 1 and b[SqIndex(f - 1, checkRank)] == enemyPawn then blocked = true end
                        if f < 8 and b[SqIndex(f + 1, checkRank)] == enemyPawn then blocked = true end
                    end
                    if not blocked then
                        egScore += side * ((advRank - 4) * 28)
                    end
                end
            elseif absP == 2 or absP == 3 then
                phase += 1
            elseif absP == 4 then
                phase += 2
            elseif absP == 5 then
                phase += 4
            end

            if p == 3 then whiteBishops += 1
            elseif p == -3 then blackBishops += 1
            end
        end
    end

    if whiteBishops >= 2 then mgScore += 35; egScore += 55 end
    if blackBishops >= 2 then mgScore -= 35; egScore -= 55 end

    local mgWeight = math.min(phase, 24)
    local egWeight = 24 - mgWeight
    local tapered = (mgScore * mgWeight + egScore * egWeight) / 24
    return tapered * self.ActiveSide
end

function AIEngine:ScoreMove(m, ply, ttMoveUCI)
    if ttMoveUCI and m.uci == ttMoveUCI then return 40000 end
    local s = 0
    if m.captured ~= 0 then
        s += 12000 + ((PIECE_VALUES[math.abs(m.captured)] or 100) * 10) - (PIECE_VALUES[math.abs(m.piece)] or 100)
    end
    if m.promo then s += 10000 end
    if m.isCastle then s += 2500 end
    if self.KillerMoves[ply] == m.uci then s += 6000 end
    s += math.min(4500, self.HistoryTable[m.uci] or 0)
    return s
end

function AIEngine:OrderMoves(moves, ply, ttMoveUCI)
    table.sort(moves, function(a, b)
        return self:ScoreMove(a, ply, ttMoveUCI) > self:ScoreMove(b, ply, ttMoveUCI)
    end)
end

function AIEngine:Quiescence(alpha, beta, qDepth, aggressionBias)
    self.NodesSearched += 1
    local standPat = self:Evaluate(aggressionBias)
    if standPat >= beta then return beta end
    if alpha < standPat then alpha = standPat end
    if qDepth <= 0 then return standPat end

    local captures = self:GetLegalMoves(self.ActiveSide, true)
    self:OrderMoves(captures, 99, nil)

    for _, m in ipairs(captures) do
        local saved = self:CloneState()
        self:StepBoard(m)
        local score = -self:Quiescence(-beta, -alpha, qDepth - 1, aggressionBias)
        self:RestoreState(saved)
        if score >= beta then return beta end
        if score > alpha then alpha = score end
    end
    return alpha
end

function AIEngine:AlphaBeta(depth, alpha, beta, ply, aggressionBias)
    self.NodesSearched += 1
    local hash = self:ComputeHash()
    local ttEntry = TranspositionTable[hash]
    if ttEntry and ttEntry.depth >= depth and aggressionBias == 1.0 and ply > 1 then
        if ttEntry.flag == "EXACT" then return ttEntry.score end
        if ttEntry.flag == "LOWER" and ttEntry.score >= beta then return ttEntry.score end
        if ttEntry.flag == "UPPER" and ttEntry.score <= alpha then return ttEntry.score end
    end

    if depth <= 0 then
        return self:Quiescence(alpha, beta, Config.MaxQuiescenceDepth, aggressionBias)
    end

    local inCheck = self:IsInCheck(self.ActiveSide)
    if inCheck then
        depth += 1 -- Check Extension: never horizon-clip while in check!
    end

    local legalMoves = self:GetLegalMoves(self.ActiveSide, false)
    if #legalMoves == 0 then
        if inCheck then
            return -19000 + ply
        end
        return -OpponentProfile.ContemptFactor
    end

    self:OrderMoves(legalMoves, ply, ttEntry and ttEntry.bestUCI or nil)
    local origAlpha = alpha
    local bestUCI = legalMoves[1].uci

    for idx, m in ipairs(legalMoves) do
        local saved = self:CloneState()
        self:StepBoard(m)

        local score
        -- Late Move Reductions (LMR) for quiet late moves
        if idx > 4 and depth >= 3 and not inCheck and m.captured == 0 and not m.promo then
            score = -self:AlphaBeta(depth - 2, -alpha - 1, -alpha, ply + 1, aggressionBias)
            if score > alpha then
                score = -self:AlphaBeta(depth - 1, -beta, -alpha, ply + 1, aggressionBias)
            end
        else
            score = -self:AlphaBeta(depth - 1, -beta, -alpha, ply + 1, aggressionBias)
        end

        self:RestoreState(saved)

        if score >= beta then
            if m.captured == 0 then
                self.KillerMoves[ply] = m.uci
                self.HistoryTable[m.uci] = (self.HistoryTable[m.uci] or 0) + (depth * depth)
            end
            TranspositionTable[hash] = { score = beta, depth = depth, flag = "LOWER", bestUCI = m.uci }
            return beta
        end
        if score > alpha then
            alpha = score
            bestUCI = m.uci
        end
    end

    local flag = (alpha > origAlpha) and "EXACT" or "UPPER"
    TranspositionTable[hash] = { score = alpha, depth = depth, flag = flag, bestUCI = bestUCI }
    return alpha
end

-- Iterative Deepening + Multi-Simulation Verification + Opponent Ponder Reply Extraction
function AIEngine:ComputeBestMoveAndPonder(mySide, onProgress)
    self.ActiveSide = mySide
    local legalMoves = self:GetLegalMoves(mySide, false)
    if #legalMoves == 0 then return nil, nil, 0, "No Legal Moves" end

    -- 1. Check Grandmaster Opening Book first
    local historyKey = table.concat(self.MoveHistoryUCI, " ")
    local bookUCI = OpeningBook[historyKey]
    if bookUCI then
        for _, m in ipairs(legalMoves) do
            if m.uci == bookUCI then
                -- Compute expected opponent reply for ponder arrow
                local saved = self:CloneState()
                self:StepBoard(m)
                local oppReplies = self:GetLegalMoves(-mySide, false)
                self:OrderMoves(oppReplies, 1, nil)
                local ponderMove = oppReplies[1]
                self:RestoreState(saved)
                return m, ponderMove, 999, "GM Book (" .. bookUCI .. ")"
            end
        end
    end

    if #legalMoves == 1 then
        return legalMoves[1], nil, 0, "Forced Move"
    end

    self.NodesSearched = 0
    local maxDepth = Config.SearchDepth + OpponentProfile.DynamicDepthBonus
    local biases = { 0.94, 1.0, 1.15 }
    local cumulativeScores = {}
    local pvUCI = nil

    -- Iterative Deepening from Depth 2 up to maxDepth
    for currentDepth = 2, maxDepth do
        local simCount = (currentDepth == maxDepth) and Config.SimulationsPerMove or 1
        table.clear(cumulativeScores)

        for simIdx = 1, simCount do
            local bias = biases[simIdx] or 1.0
            self:OrderMoves(legalMoves, 1, pvUCI)

            for _, m in ipairs(legalMoves) do
                local saved = self:CloneState()
                self:StepBoard(m)
                local val = -self:AlphaBeta(currentDepth - 1, -30000, 30000, 1, bias)
                self:RestoreState(saved)

                cumulativeScores[m.uci] = (cumulativeScores[m.uci] or 0) + val
            end
            RunService.Heartbeat:Wait()
        end

        -- Update Principal Variation (PV) move after completing this depth
        local bestDScore = -999999
        for _, m in ipairs(legalMoves) do
            local avg = (cumulativeScores[m.uci] or -99999) / simCount
            if avg > bestDScore then
                bestDScore = avg
                pvUCI = m.uci
            end
        end

        if onProgress then
            pcall(onProgress, currentDepth, maxDepth, pvUCI, math.floor(bestDScore), self.NodesSearched)
        end
    end

    local bestMove = legalMoves[1]
    local bestAvg = -999999
    for _, m in ipairs(legalMoves) do
        local avg = (cumulativeScores[m.uci] or -99999) / Config.SimulationsPerMove
        if avg > bestAvg then
            bestAvg = avg
            bestMove = m
        end
    end

    -- Extract opponent's strongest reply (Ponder Move) from Transposition Table or 1-ply search
    local ponderMove = nil
    local saved = self:CloneState()
    self:StepBoard(bestMove)
    local childHash = self:ComputeHash()
    local childTT = TranspositionTable[childHash]
    local oppMoves = self:GetLegalMoves(-mySide, false)
    if childTT and childTT.bestUCI then
        for _, om in ipairs(oppMoves) do
            if om.uci == childTT.bestUCI then
                ponderMove = om
                break
            end
        end
    end
    if not ponderMove and #oppMoves > 0 then
        self:OrderMoves(oppMoves, 2, nil)
        ponderMove = oppMoves[1]
    end
    self:RestoreState(saved)

    return bestMove, ponderMove, math.floor(bestAvg), string.format("ID-D%d x%d", maxDepth, Config.SimulationsPerMove)
end

function AIEngine:ParseSANMove(san, side)
    san = string.gsub(san, "<[^>]+>", "")
    san = string.gsub(san, "[+#!?%s]", "")
    if san == "" then return nil end

    local legal = self:GetLegalMoves(side, false)
    if san == "O-O" or san == "0-0" then
        for _, m in ipairs(legal) do
            if m.isCastle == "WK" or m.isCastle == "BK" then return m end
        end
    elseif san == "O-O-O" or san == "0-0-0" then
        for _, m in ipairs(legal) do
            if m.isCastle == "WQ" or m.isCastle == "BQ" then return m end
        end
    end

    local promoPiece = nil
    if string.find(san, "=") then
        promoPiece = side * 5
        san = string.gsub(san, "=.[QRNB]?", "")
    end

    local destStr = string.sub(san, -2)
    local destSq = AlgebraicToIndex(destStr)
    if not destSq then return nil end

    local firstChar = string.sub(san, 1, 1)
    local pieceType = 1
    if firstChar == "N" then pieceType = 2
    elseif firstChar == "B" then pieceType = 3
    elseif firstChar == "R" then pieceType = 4
    elseif firstChar == "Q" then pieceType = 5
    elseif firstChar == "K" then pieceType = 6
    end

    local disambig = string.gsub(string.sub(san, 1, -3), "[NBRQKx]", "")

    for _, m in ipairs(legal) do
        if m.to == destSq and math.abs(m.piece) == pieceType then
            if not promoPiece or m.promo == promoPiece then
                if disambig == "" or string.find(IndexToAlgebraic(m.from), disambig, 1, true) then
                    return m
                end
            end
        end
    end
    return nil
end

