local LockedMatchSide = nil
local LastBoardSignature = ""
local IsCalculating = false

task.spawn(function()
    while Running and task.wait(0.18) do
        local boardFrame = GetBoardFrame()
        if not boardFrame then
            ActiveRenderState.HasCalculatedMove = false
            StatusLabel.Text = "State: Waiting for Chess Board...\nOpen a match or puzzle to start."
        elseif not IsCalculating then
            local turnState = DetectTurnState(boardFrame)
            if turnState == "LOBBY_IDLE" then
                LockedMatchSide = nil
            end

            if not MemoryState.BoundRAMBoard then
                ScanRoChessMemoryPassive()
            end

            local sanList = ScrapeAllMovesScrollProof(boardFrame)
            local ramBoard = MemoryState.BoundRAMBoard
            local ramPly = (ramBoard and type(ramBoard.ply) == "number") and ramBoard.ply or -1

            -- Reconstruct current board position
            Engine:Reset()
            local appliedSAN = 0
            for _, san in ipairs(sanList) do
                local sideToMove = (appliedSAN % 2 == 0) and 1 or -1
                local parsed = Engine:ParseSANMove(san, sideToMove)
                if parsed then
                    Engine:StepBoard(parsed)
                    table.insert(Engine.MoveHistoryUCI, parsed.uci)
                    appliedSAN += 1
                else
                    break
                end
            end

            local syncSource = "UI (" .. tostring(appliedSAN) .. " mvs)"
            if ramBoard and ramPly > appliedSAN then
                if SyncEngineFromRAMBoard(Engine, ramBoard) then
                    syncSource = "RAM (ply " .. tostring(ramPly) .. ")"
                end
            end

            -- Determine Player Side (White = 1, Black = -1)
            if Config.SideMode == "WHITE" then
                LockedMatchSide = 1
            elseif Config.SideMode == "BLACK" then
                LockedMatchSide = -1
            else
                if turnState == "MY_TURN" then
                    LockedMatchSide = LockedMatchSide or Engine.ActiveSide
                elseif turnState == "OPPONENT_TURN" then
                    LockedMatchSide = LockedMatchSide or -Engine.ActiveSide
                end
            end
            local mySide = LockedMatchSide or 1
            ActiveRenderState.MySide = mySide

            local currentBoardSig = Engine:GetBoardSignature() .. "|S:" .. tostring(mySide)

            -- Whenever the board changes (or user clicks RECALC NOW):
            -- 1) Immediately HIDE the arrow while calculating!
            -- 2) Run full Iterative Deepening + Multi-Simulation calculation
            -- 3) ONLY show the green arrow once the exact best move is finalized!
            if currentBoardSig ~= LastBoardSignature or ActiveRenderState.ForceRecalc then
                ActiveRenderState.ForceRecalc = false
                LastBoardSignature = currentBoardSig

                -- Hide arrow during calculation (strictly as requested!)
                ActiveRenderState.HasCalculatedMove = false
                BestMoveArrow:Hide()
                PonderArrow:Hide()

                IsCalculating = true
                local sideToCalculate = Engine.ActiveSide
                local isOurTurnToMove = (sideToCalculate == mySide)

                Logger.Push("SYNC", string.format("Board updated via %s | Turn:%s",
                    syncSource, sideToCalculate == 1 and "WHITE" or "BLACK"
                ))

                local bestMove, ponderMove, score, meta = Engine:ComputeBestMoveAndPonder(
                    sideToCalculate,
                    function(curD, maxD, pvUCI, curScore, nodes)
                        StatusLabel.Text = string.format(
                            "Side: %s | Sync: %s\n[CALCULATING DEPTH %d/%d...]\nCandidate: %s (%+.2f) | Nodes: %d\nArrow hidden until calculation finishes...",
                            (mySide == 1) and "WHITE" or "BLACK",
                            syncSource,
                            curD, maxD,
                            tostring(pvUCI),
                            curScore / 100,
                            nodes
                        )
                    end
                )

                if bestMove then
                    -- If we calculated for our side, show the green arrow for our move;
                    -- if it's currently opponent's turn, show what move we should prepare or opponent's threat!
                    ActiveRenderState.BestMove = bestMove
                    ActiveRenderState.PonderMove = ponderMove
                    ActiveRenderState.BestScore = isOurTurnToMove and score or -score
                    ActiveRenderState.MetaText = meta
                    ActiveRenderState.HasCalculatedMove = Config.AssistEnabled

                    local recentMoves = table.concat(sanList, " ", math.max(1, #sanList - 3), #sanList)
                    StatusLabel.Text = string.format(
                        "Side: %s | Turn: %s (%s)\nBest Move: %s -> %s (Eval: %+.2f)\nPonder Reply: %s | [%s | %d nodes]\nHistory: %s",
                        (mySide == 1) and "WHITE" or "BLACK",
                        isOurTurnToMove and "YOUR TURN" or "OPPONENT TURN",
                        syncSource,
                        IndexToAlgebraic(bestMove.from),
                        IndexToAlgebraic(bestMove.to),
                        ActiveRenderState.BestScore / 100,
                        ponderMove and ponderMove.uci or "--",
                        meta,
                        Engine.NodesSearched,
                        recentMoves ~= "" and recentMoves or "Start"
                    )

                    Logger.Push("ARROW", string.format("Rendered %s (%+.2f) | Ponder:%s [%s, %d nodes]",
                        bestMove.uci,
                        ActiveRenderState.BestScore / 100,
                        ponderMove and ponderMove.uci or "none",
                        meta,
                        Engine.NodesSearched
                    ))
                else
                    StatusLabel.Text = "Match Ended or No Legal Moves."
                end

                IsCalculating = false
            end
        end
    end
end)
