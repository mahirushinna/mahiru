-- 2. BỘ PHÂN TÍCH TRẠNG THÁI & HOẠT ẢNH KIẾM CỦA ĐỐI THỦ
-- ============================================================================

local function getPingSeconds()
    local ok, ping = pcall(function()
        return LocalPlayer:GetNetworkPing()
    end)
    if ok and type(ping) == "number" and ping > 0 then
        return math.clamp(ping, 0.02, 0.35)
    end
    local okStats, netPing = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    if okStats and type(netPing) == "number" then
        return math.clamp(netPing, 0.02, 0.35)
    end
    return 0.085 -- Mặc định 85ms như trong video
end

-- Kiểm tra các Attribute / BoolValue / Highlight đặc trưng trên nhân vật đối thủ
local function inspectCharacterFlags(char)
    if not char then return false, false, false, false end
    local isBlocking = false
    local isAttacking = false
    local isHeavyRedGlint = false
    local isStunned = false

    -- 1. Quét Attributes gắn trực tiếp trên Character hoặc Humanoid
    for name, val in pairs(char:GetAttributes()) do
        local lower = string.lower(name)
        if val == true then
            if string.find(lower, "block") or string.find(lower, "parry") or string.find(lower, "guard") or string.find(lower, "defend") then
                isBlocking = true
            elseif string.find(lower, "attack") or string.find(lower, "swing") or string.find(lower, "slash") or string.find(lower, "combo") or string.find(lower, "m1") then
                isAttacking = true
            elseif string.find(lower, "heavy") or string.find(lower, "unblockable") or string.find(lower, "charge") then
                isAttacking = true
                isHeavyRedGlint = true
            elseif string.find(lower, "stun") or string.find(lower, "broken") or string.find(lower, "stagger") or string.find(lower, "parried") then
                isStunned = true
            end
        end
    end

    -- 2. Quét các đối tượng trạng thái con & Hiệu ứng loé sáng đỏ (Heavy Attack) / khiên đỡ
    for _, child in ipairs(char:GetDescendants()) do
        if child:IsA("BoolValue") and child.Value == true then
            local lower = string.lower(child.Name)
            if string.find(lower, "block") or string.find(lower, "parry") or string.find(lower, "guard") then
                isBlocking = true
            elseif string.find(lower, "attack") or string.find(lower, "swing") or string.find(lower, "hitting") then
                isAttacking = true
            elseif string.find(lower, "stun") or string.find(lower, "guardbreak") or string.find(lower, "posture") then
                isStunned = true
            end
        elseif child:IsA("Highlight") and child.Enabled then
            -- Trong video (0:04, 0:38, 0:47), đòn Nặng hoặc phá giáp phát sáng màu đỏ rực
            local c = child.FillColor
            local o = child.OutlineColor
            if (c.R > 0.7 and c.G < 0.35 and c.B < 0.35) or (o.R > 0.7 and o.G < 0.35 and o.B < 0.35) then
                isAttacking = true
                isHeavyRedGlint = true
            end
        elseif child:IsA("Trail") and child.Enabled then
            -- Vệt kiếm (Blade Trail) bật sáng khi đối thủ đang vung kiếm
            isAttacking = true
        end
    end

    return isBlocking, isAttacking, isHeavyRedGlint, isStunned
end

-- Phân loại AnimationTrack của đối thủ theo thời gian thực
local function analyzeEnemyAnimations(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false, false end
    local animator = hum:FindFirstChildOfClass("Animator") or hum

    local animBlocking = false
    local animAttacking = false

    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if track.IsPlaying and track.WeightCurrent > 0.15 then
            local animId = track.Animation and track.Animation.AnimationId or ""
            local trackName = string.lower(track.Name or "")
            local priority = track.Priority
            local length = track.Length
            local timePos = track.TimePosition

            -- Bỏ qua các hoạt ảnh di chuyển / đứng yên cơ bản
            local isCoreMovement = (priority == Enum.AnimationPriority.Core)
                or (priority == Enum.AnimationPriority.Idle)
                or (priority == Enum.AnimationPriority.Movement)
                or string.find(trackName, "walk")
                or string.find(trackName, "run")
                or string.find(trackName, "idle")
                or string.find(trackName, "jump")
                or string.find(trackName, "fall")

            if not isCoreMovement then
                -- Nhận diện hoạt ảnh Chặn đòn (Block / Guard):
                -- Thường được giữ liên tục (Looped = true, Speed = 0 khi giữ thế kiếm ngang trước ngực như ở 0:09, 0:26, 0:33)
                if State.KnownBlockAnims[animId]
                    or string.find(trackName, "block")
                    or string.find(trackName, "guard")
                    or string.find(trackName, "parry")
                    or string.find(trackName, "defend")
                    or (track.Looped and priority == Enum.AnimationPriority.Action and track.Speed <= 0.1)
                then
                    State.KnownBlockAnims[animId] = true
                    animBlocking = true
                -- Nhận diện hoạt ảnh Vung kiếm (Slash / Light / Heavy):
                -- Độ dài ngắn (0.3s -> 1.6s), không lặp lại, ưu tiên Action+
                elseif State.KnownAttackAnims[animId]
                    or string.find(trackName, "slash")
                    or string.find(trackName, "swing")
                    or string.find(trackName, "attack")
                    or string.find(trackName, "light")
                    or string.find(trackName, "heavy")
                    or string.find(trackName, "combo")
                    or string.find(trackName, "m1")
                    or string.find(trackName, "katana")
                    or (not track.Looped and length > 0.22 and length < 1.75 and (
                        priority == Enum.AnimationPriority.Action
                        or priority == Enum.AnimationPriority.Action2
                        or priority == Enum.AnimationPriority.Action3
                        or priority == Enum.AnimationPriority.Action4
                    ))
                then
                    -- Chỉ tính là đang vung đòn trong giai đoạn đầu -> giữa nhát chém (trước khi thu kiếm về)
                    local progress = (length > 0) and (timePos / length) or 0.5
                    if progress >= 0.02 and progress <= 0.72 then
                        State.KnownAttackAnims[animId] = true
                        animAttacking = true
                    end
                end
            end
        end
    end

    return animBlocking, animAttacking
end

-- Tìm đối thủ gần nhất đang sống trong sàn đấu
local function getNearestOpponent()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, math.huge end

    local bestTarget = nil
    local bestDist = Config.CombatRange

    -- Quét tất cả người chơi
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root then
                local dist = (root.Position - myRoot.Position).Magnitude
                if dist <= bestDist then
                    bestDist = dist
                    bestTarget = char
                end
            end
        end
    end

    -- Quét thêm NPC / Bot trong Workspace nếu đấu với máy
    if not bestTarget then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Humanoid") and obj.Health > 0 and obj.Parent ~= myChar then
                local char = obj.Parent
                if not Players:GetPlayerFromCharacter(char) then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = (root.Position - myRoot.Position).Magnitude
                        if dist <= bestDist then
                            bestDist = dist
                            bestTarget = char
                        end
                    end
                end
            end
        end
    end

    return bestTarget, bestDist
end

-- ============================================================================
-- 3. LOGIC THỰC THI: ĐỠ ĐÒN -> PHẢN CÔNG & NGẮT ĐÒN KHI ĐỊCH ĐỠ
-- ============================================================================

local function stopOurAttackImmediately()
    State.WeAreAttacking = false
    State.HoldFireUntil = os.clock() + 0.18
    -- Nhả nút đánh để ngắt chuỗi combo ngay lập tức
    triggerGuiButton("Light", "Up")
    -- Nhấp nhẹ Chặn đòn (Feint / Cancel) giúp thu kiếm về thế thủ ngay như trong video (0:09, 0:26)
    triggerGuiButton("Block", "Down")
    task.delay(0.06, function()
        if not State.EnemyIsAttacking then
            triggerGuiButton("Block", "Up")
        end
    end)
end

local function executeParryAndCounter(isHeavyRedGlint)
    local now = os.clock()
    if now - State.LastParryTime < 0.14 then return end
    State.LastParryTime = now

    -- Nếu đang vung kiếm dở mà địch chém trả -> huỷ đòn đánh để ưu tiên Chặn đòn ngay
    if State.WeAreAttacking then
        triggerGuiButton("Light", "Up")
        State.WeAreAttacking = false
    end

    State.WeAreBlocking = true

    -- Bước 1: Bấm Chặn đòn (Parry) ngay khoảnh khắc kiếm địch vung tới
    triggerGuiButton("Block", "Tap")

    -- Bước 2: Ngay sau khi đỡ đòn (nảy tia lửa trắng như ở 0:10, 0:15, 0:26, 0:34), lập tức đánh trả
    if Config.AutoCounter then
        task.delay(Config.CounterDelay, function()
            if not Config.Enabled then return end
            -- Kiểm tra lại: nếu địch vẫn đang giữ khiên đỡ cứng thì không chém bừa, nếu địch hở sườn sau pha bị Parry thì chém trả ngay
            local flagBlock, flagAtk, _, flagStun = inspectCharacterFlags(State.Target)
            local animBlock, _ = analyzeEnemyAnimations(State.Target)

            if flagStun and Config.AutoHeavyPunish then
                -- Địch bị vỡ thanh Posture trắng -> bồi đòn Nặng kết liễu (như pha 0:47 - 0:50)
                triggerGuiButton("Heavy", "Tap")
                State.LastAttackTime = os.clock()
            elseif not (flagBlock or animBlock) or flagAtk then
                State.WeAreAttacking = true
                triggerGuiButton("Light", "Tap")
                State.LastAttackTime = os.clock()
                task.delay(0.15, function()
                    State.WeAreAttacking = false
                end)
            end
            State.WeAreBlocking = false
        end)
    else
        task.delay(0.1, function()
            State.WeAreBlocking = false
        end)
    end
end

-- ============================================================================
-- 4. VÒNG LẶP PHẢN XẠ CHÍNH (CHẠY MỖI FRAME RENDERSTEPPED)
-- ============================================================================

local function onHeartbeat()
    if not Config.Enabled then return end

    local target, dist = getNearestOpponent()
    State.Target = target
    if not target then return end

    local flagBlock, flagAttack, isHeavyRed, flagStun = inspectCharacterFlags(target)
    local animBlock, animAttack = analyzeEnemyAnimations(target)

    local enemyBlocking = flagBlock or animBlock
    local enemyAttacking = flagAttack or animAttack

    State.EnemyIsBlocking = enemyBlocking
    State.EnemyIsAttacking = enemyAttacking
    State.EnemyStunned = flagStun

    local now = os.clock()
    local ping = getPingSeconds()

    -- QUY TẮC 1 & 3: Khi kẻ địch vung kiếm (hoặc đánh trả ngay sau khi đỡ đòn) -> Tự động Chặn đòn & Đánh trả
    if enemyAttacking and dist <= Config.CombatRange then
        local waitTime = math.max(0, Config.ParryWindowPreempt - (ping * 0.5))
        if waitTime <= 0.005 then
            executeParryAndCounter(isHeavyRed)
        else
            task.delay(waitTime, function()
                if State.EnemyIsAttacking then
                    executeParryAndCounter(isHeavyRed)
                end
            end)
        end
        return
    end

    -- QUY TẮC 2: Khi ta đang tung đòn mà kẻ địch giơ kiếm đỡ đòn -> Ngay lập tức dừng lại, chờ địch đánh trả để đỡ và phản công
    if enemyBlocking and Config.StopOnEnemyBlock then
        if State.WeAreAttacking or (now - State.LastAttackTime < 0.28) then
            stopOurAttackImmediately()
        end
        -- Giữ trạng thái chờ: tuyệt đối không spam thêm ÁNH SÁNG vào kiếm đang đỡ của địch
        State.HoldFireUntil = now + 0.12
        return
    end

    -- Nếu địch bị choáng / vỡ thanh thế thủ (Posture Break như ở 0:16, 0:27, 0:37) -> Tự động áp sát đánh bồi
    if flagStun and dist <= Config.CombatRange and (now >= State.HoldFireUntil) then
        if now - State.LastAttackTime >= Config.AttackCooldown then
            State.LastAttackTime = now
            State.WeAreAttacking = true
            if Config.AutoHeavyPunish then
                triggerGuiButton("Heavy", "Tap")
            else
                triggerGuiButton("Light", "Tap")
            end
            task.delay(0.15, function()
                State.WeAreAttacking = false
            end)
        end
    end
end

