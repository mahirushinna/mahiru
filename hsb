local function isTeammateCyanBlue(color: Color3): boolean
	local h, s, v = color:ToHSV()
	if h >= 0.46 and h <= 0.68 and s >= 0.35 and v >= 0.45 then
		return true
	end
	if color.B >= 0.55 and color.G >= 0.40 and color.R <= 0.45 then
		return true
	end
	return false
end

local function isEnemy(player: Player): boolean
	if player == LocalPlayer then
		return false
	end

	-- Kiểm tra Team chuẩn của Roblox
	if LocalPlayer.Team ~= nil and player.Team ~= nil then
		if player.Team == LocalPlayer.Team then
			return false
		end
	end

	local character = player.Character
	if not character then
		return false
	end

	-- Kiểm tra nhãn tên đồng đội màu xanh nước biển trên đầu nhân vật
	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("TextLabel") or desc:IsA("TextBox") then
			local billboard = desc:FindFirstAncestorOfClass("BillboardGui")
			if (not billboard or billboard.Enabled) and desc.Visible then
				if isTeammateCyanBlue(desc.TextColor3) or isTeammateCyanBlue(desc.TextStrokeColor3) then
					return false
				end
			end
		end
	end

	return true
end

