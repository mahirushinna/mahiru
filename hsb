    statusLbl.TextColor3 = Color3.fromRGB(120, 230, 255)
    statusLbl.Font = Enum.Font.Code
    statusLbl.TextSize = 11
    statusLbl.TextXAlignment = Enum.TextXAlignment.Left
    statusLbl.Parent = frame

    local function addToggle(label, yOffset, key)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -16, 0, 24)
        btn.Position = UDim2.new(0, 8, 0, yOffset)
        btn.BackgroundColor3 = Config[key] and Color3.fromRGB(38, 105, 55) or Color3.fromRGB(45, 45, 52)
        btn.TextColor3 = Color3.fromRGB(245, 245, 245)
        btn.Font = Enum.Font.GothamSemibold
        btn.TextSize = 11
        btn.Text = label .. ": " .. (Config[key] and "BẬT" or "TẮT")
        btn.Parent = frame

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 5)
        c.Parent = btn

        btn.MouseButton1Click:Connect(function()
            Config[key] = not Config[key]
            btn.Text = label .. ": " .. (Config[key] and "BẬT" or "TẮT")
            btn.BackgroundColor3 = Config[key] and Color3.fromRGB(38, 105, 55) or Color3.fromRGB(45, 45, 52)
            if key == "Enabled" then
                title.Text = Config.Enabled and "KATANA AUTO-PARRY V2 [ON]" or "KATANA AUTO-PARRY V2 [OFF]"
            end
        end)
    end

    addToggle("Tự Chặn & Đánh Trả", 44, "Enabled")
    addToggle("Dừng Khi Địch Đỡ", 74, "StopOnEnemyBlock")
    addToggle("Bồi Đòn Nặng (Phá Giáp)", 104, "AutoHeavyPunish")

    RunService.RenderStepped:Connect(function()
        statusLbl.Text = State.StatusText
    end)
end

