local function getOrCreateESPLabel(char)
    local lbl = ESPLabels[char]
    if not lbl then
        lbl = Instance.new("TextLabel")
        lbl.Name = "EnemyESP"
        lbl.Size = UDim2.new(0, 200, 0, 60)
        lbl.AnchorPoint = Vector2.new(0.5, 1)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = Color3.fromRGB(255, 55, 55)
        lbl.TextStrokeTransparency = 0.15
        lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.ZIndex = 50
        lbl.Parent = ESPContainer
        ESPLabels[char] = lbl
    end
    return lbl
end

-- Sử dụng BindToRenderStep với mức ưu tiên cao hơn Camera của game để khóa tâm tức thì
RunService:BindToRenderStep("MrDon_FastAimbot", Enum.RenderPriority.Camera.Value + 10, function()
    Camera = Workspace.CurrentCamera
    if not Camera then return end

    local vpCenter = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)
    local closestHead = nil
    local minScreenDist = math.huge

    local anyESP = Config.ESP_Name or Config.ESP_Health or Config.ESP_Distance
    local activeCharsThisFrame = {}

    local myRootPos = Camera.CFrame.Position
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        myRootPos = LocalPlayer.Character.HumanoidRootPart.Position
    end

    for _, enemy in ipairs(CachedEnemies) do
        local char = enemy.Character
        local head = enemy.Head
        local hum = enemy.Humanoid
        local root = enemy.Root

        if char and char.Parent and head and hum and hum.Health > 0 then
            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)

            if onScreen and screenPos.Z > 0 then
                local pos2D = Vector2.new(screenPos.X, screenPos.Y)
                local distToCrosshair = (pos2D - vpCenter).Magnitude

                -- Tìm đầu địch gần tâm ngắm nhất cho Aimbot
                if distToCrosshair < minScreenDist then
                    minScreenDist = distToCrosshair
                    closestHead = head
                end

                -- Vẽ ESP 2D ngay phía trên đầu kẻ địch
                if anyESP then
                    activeCharsThisFrame[char] = true
                    local lbl = getOrCreateESPLabel(char)
                    lbl.Visible = true
                    lbl.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y - 18)

                    local info = {}
                    if Config.ESP_Name then
                        table.insert(info, enemy.Name)
                    end
                    if Config.ESP_Health then
                        table.insert(info, string.format("Máu: %d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth)))
                    end
                    if Config.ESP_Distance and root then
                        local studs = math.floor((root.Position - myRootPos).Magnitude)
                        table.insert(info, string.format("%dm", studs))
                    end
                    lbl.Text = table.concat(info, "\n")
                end
            end
        end
    end

    -- Ẩn các nhãn ESP của mục tiêu đã khuất màn hình hoặc đã bị hạ gục
    for char, lbl in pairs(ESPLabels) do
        if not activeCharsThisFrame[char] then
            if not char or not char.Parent then
                lbl:Destroy()
                ESPLabels[char] = nil
            else
                lbl.Visible = false
            end
        end
    end

    -- Khóa thẳng CFrame của Camera vào chính giữa phần ĐẦU (Head) tức thì khi bắn
    if Config.Aimbot_Enabled and isShootingNow() and closestHead then
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, closestHead.Position)
    end
end)
