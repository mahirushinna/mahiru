-- ==========================================
-- 3. LOGIC KIỂM TRA ĐỒNG ĐỘI & MỤC TIÊU
-- ==========================================
local trackedModels = {}
local updateTimer = 0
local scanTimer = 0

local function cleanupModelTracker(characterModel)
	local data = trackedModels[characterModel]
	if not data then
		return
	end

	if data.BoxAdornment then
		data.BoxAdornment:Destroy()
	end
	if data.Billboard then
		data.Billboard:Destroy()
	end
	if data.Highlight then
		data.Highlight:Destroy()
	end

	trackedModels[characterModel] = nil
end

local function getTargetRootPart(characterModel)
	return characterModel:FindFirstChild("HumanoidRootPart")
		or characterModel:FindFirstChild("Torso")
		or characterModel:FindFirstChild("UpperTorso")
		or characterModel.PrimaryPart
end

-- Kiểm tra chính xác xem người chơi có phải đồng đội hay không
local function isTeammate(ownerPlayer, characterModel)
	if not ownerPlayer then
		return false
	end
	if ownerPlayer == LocalPlayer then
		return true
	end

	-- Kiểm tra qua dịch vụ Teams chuẩn của Roblox
	if LocalPlayer.Team ~= nil and ownerPlayer.Team ~= nil then
		if not LocalPlayer.Neutral and not ownerPlayer.Neutral then
			return LocalPlayer.Team == ownerPlayer.Team
		end
	end

	-- Kiểm tra qua TeamColor nếu game chỉ gán màu đội
	if not LocalPlayer.Neutral and not ownerPlayer.Neutral then
		if LocalPlayer.TeamColor == ownerPlayer.TeamColor then
			return true
		end
	end

	-- Kiểm tra Attribute Team tùy chỉnh (nếu có)
	local localTeamAttr = LocalPlayer:GetAttribute("Team") or (LocalPlayer.Character and LocalPlayer.Character:GetAttribute("Team"))
	local targetTeamAttr = ownerPlayer:GetAttribute("Team") or (characterModel and characterModel:GetAttribute("Team"))
	if localTeamAttr ~= nil and targetTeamAttr ~= nil and localTeamAttr == targetTeamAttr then
		return true
	end

	return false
end

local function createTrackerForEnemy(characterModel, ownerPlayer)
	if trackedModels[characterModel] then
		return
	end
	if not ownerPlayer or ownerPlayer == LocalPlayer then
		return
	end
	if characterModel == LocalPlayer.Character then
		return
	end
	-- Bỏ qua mọi mô hình nằm trong Camera (tránh tô nhầm tay súng góc nhìn thứ nhất)
	if Workspace.CurrentCamera and characterModel:IsDescendantOf(Workspace.CurrentCamera) then
		return
	end
	-- Nếu là đồng đội thì tuyệt đối không tạo ESP
	if CONFIG.EnemyOnly and isTeammate(ownerPlayer, characterModel) then
		return
	end

	local humanoid = characterModel:FindFirstChildOfClass("Humanoid")
	local rootPart = getTargetRootPart(characterModel)
	if not humanoid or not rootPart or humanoid.Health <= 0 then
		return
	end

	local color = CONFIG.EnemyColor

	-- 1. Hộp 3D xuyên tường
	local boxAdorn = Instance.new("BoxHandleAdornment")
	boxAdorn.Name = "EnemyBox3D"
	boxAdorn.Adornee = rootPart
	boxAdorn.AlwaysOnTop = true
	boxAdorn.ZIndex = 5
	boxAdorn.Size = Vector3.new(4, 5.5, 2)
	boxAdorn.Color3 = color
	boxAdorn.Transparency = 0.55
	boxAdorn.Parent = containerFolder

	-- 2. BillboardGui hiển thị Tên, Khoảng cách & Thanh máu
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "EnemyBillboard"
	billboard.Adornee = rootPart
	billboard.AlwaysOnTop = true
	billboard.Size = UDim2.fromOffset(150, 50)
	billboard.StudsOffset = Vector3.new(0, 3.8, 0)
	billboard.Parent = containerFolder

	local infoLabel = Instance.new("TextLabel")
	infoLabel.Name = "InfoLabel"
	infoLabel.Size = UDim2.new(1, 0, 0, 22)
	infoLabel.BackgroundTransparency = 1
	infoLabel.Font = Enum.Font.GothamBold
	infoLabel.TextSize = 12
	infoLabel.TextStrokeTransparency = 0.15
	infoLabel.TextColor3 = color
	infoLabel.Text = ownerPlayer.DisplayName
	infoLabel.Parent = billboard

	local healthBg = Instance.new("Frame")
	healthBg.Name = "HealthBg"
	healthBg.Size = UDim2.new(0.76, 0, 0, 6)
	healthBg.Position = UDim2.new(0.12, 0, 0, 24)
	healthBg.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	healthBg.BorderSizePixel = 1
	healthBg.BorderColor3 = Color3.fromRGB(0, 0, 0)
	healthBg.Parent = billboard

	local healthFill = Instance.new("Frame")
	healthFill.Name = "HealthFill"
	healthFill.Size = UDim2.fromScale(1, 1)
	healthFill.BackgroundColor3 = Color3.fromRGB(50, 230, 80)
	healthFill.BorderSizePixel = 0
	healthFill.Parent = healthBg

	local markerDot = Instance.new("Frame")
	markerDot.Name = "CenterDot"
	markerDot.Size = UDim2.fromOffset(8, 8)
	markerDot.Position = UDim2.new(0.5, -4, 0, 36)
	markerDot.BackgroundColor3 = color
	markerDot.BorderSizePixel = 1
	markerDot.BorderColor3 = Color3.new(1, 1, 1)
	markerDot.Parent = billboard

	local dotCorner = Instance.new("UICorner")
	dotCorner.CornerRadius = UDim.new(1, 0)
	dotCorner.Parent = markerDot

	-- 3. Highlight viền đỏ cho kẻ địch
	local highlight = Instance.new("Highlight")
	highlight.Name = "EnemyHighlight"
	highlight.Adornee = characterModel
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = color
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 0.7
	highlight.OutlineTransparency = 0.1
	highlight.Parent = containerFolder

	trackedModels[characterModel] = {
		Model = characterModel,
		OwnerPlayer = ownerPlayer,
		Humanoid = humanoid,
		RootPart = rootPart,
		BoxAdornment = boxAdorn,
		Billboard = billboard,
		InfoLabel = infoLabel,
		HealthFill = healthFill,
		MarkerDot = markerDot,
		Highlight = highlight,
	}
end

-- Quét danh sách người chơi để gắn ESP cho kẻ địch
local function scanEnemies()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			if not (CONFIG.EnemyOnly and isTeammate(player, player.Character)) then
				createTrackerForEnemy(player.Character, player)
			end
		end
	end
end

-- Vòng lặp cập nhật vị trí và đếm tổng số kẻ địch đang được vẽ
RunService.Heartbeat:Connect(function(deltaTime)
	updateTimer = updateTimer + deltaTime
	scanTimer = scanTimer + deltaTime

	if scanTimer >= CONFIG.ScanInterval then
		scanTimer = 0
		scanEnemies()
	end

	if updateTimer < CONFIG.RefreshRate then
		return
	end
	updateTimer = 0

	local camera = Workspace.CurrentCamera
	local localChar = LocalPlayer.Character
	local localRoot = localChar and getTargetRootPart(localChar)
	local originPos = (localRoot and localRoot.Position) or (camera and camera.CFrame.Position) or Vector3.zero

	local drawnEnemyCount = 0

	for characterModel, data in pairs(trackedModels) do
		local ownerPlayer = data.OwnerPlayer

		-- Nếu mục tiêu đã chết, thoát game, hoặc chuyển sang cùng đội với mình -> Xóa ngay lập tức
		if not characterModel.Parent
			or not ownerPlayer
			or not ownerPlayer.Parent
			or characterModel == localChar
			or not data.RootPart.Parent
			or not data.Humanoid.Parent
			or data.Humanoid.Health <= 0
			or (CONFIG.EnemyOnly and isTeammate(ownerPlayer, characterModel))
		then
			cleanupModelTracker(characterModel)
		else
			local distance = (originPos - data.RootPart.Position).Magnitude
			local shouldShow = CONFIG.Enabled and (distance <= CONFIG.MaxDistance)

			data.BoxAdornment.Visible = shouldShow
			data.Billboard.Enabled = shouldShow
			data.Highlight.Enabled = shouldShow

			if shouldShow then
				drawnEnemyCount = drawnEnemyCount + 1

				local maxHp = math.max(data.Humanoid.MaxHealth, 1)
				local curHp = math.clamp(data.Humanoid.Health, 0, maxHp)
				local hpRatio = curHp / maxHp

				data.InfoLabel.Text = string.format("%s [%dm | %d%%]", ownerPlayer.DisplayName, math.floor(distance), math.floor(hpRatio * 100))
				data.HealthFill.Size = UDim2.fromScale(hpRatio, 1)
				data.HealthFill.BackgroundColor3 = Color3.fromHSV(hpRatio * 0.33, 0.85, 0.95)
			end
		end
	end

	-- Cập nhật con số tổng kẻ địch đang được ESP vẽ ngay dưới dòng chữ trên cùng
	counterLabel.Text = tostring(drawnEnemyCount)
end)

scanEnemies()
