local MemoryState = {
    Controller2 = nil,
    BoundRAMBoard = nil,
    AllRAMBoards = {}
}

local function ScanRoChessMemoryPassive()
    if not getgc then
        Logger.Push("WARN", "getgc() not supported; using UI Move List sync.")
        return
    end

    table.clear(MemoryState.AllRAMBoards)
    MemoryState.BoundRAMBoard = nil

    pcall(function()
        for _, obj in ipairs(getgc(true)) do
            if type(obj) == "table" and not rawget(obj, "_IsOurAIEngine") and obj ~= MemoryState and obj ~= Logger then
                local brd = rawget(obj, "board")
                local ply = rawget(obj, "ply")
                local kingSq = rawget(obj, "kingSq")
                if type(brd) == "table" and type(ply) == "number" and kingSq ~= nil then
                    table.insert(MemoryState.AllRAMBoards, obj)
                end

                local pm = rawget(obj, "playMove")
                local mm = rawget(obj, "makeMove")
                if type(pm) == "function" and type(mm) == "function" then
                    MemoryState.Controller2 = obj
                    for _, v in pairs(obj) do
                        if type(v) == "table" and rawget(v, "board") and rawget(v, "kingSq") then
                            MemoryState.BoundRAMBoard = v
                        elseif type(v) == "function" and debug and debug.getupvalues then
                            local okU, uvs = pcall(debug.getupvalues, v)
                            if okU and uvs then
                                for _, uv in pairs(uvs) do
                                    if type(uv) == "table" and rawget(uv, "board") and rawget(uv, "kingSq") then
                                        MemoryState.BoundRAMBoard = uv
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    -- Pick the RAMBoard with highest active ply if BoundRAMBoard wasn't directly in upvalues
    if not MemoryState.BoundRAMBoard and #MemoryState.AllRAMBoards > 0 then
        table.sort(MemoryState.AllRAMBoards, function(a, b)
            return (rawget(a, "ply") or 0) > (rawget(b, "ply") or 0)
        end)
        MemoryState.BoundRAMBoard = MemoryState.AllRAMBoards[1]
    end

    if MemoryState.BoundRAMBoard then
        local rb = MemoryState.BoundRAMBoard.board
        local sample = {}
        for i = 1, 8 do sample[#sample + 1] = tostring(rb[i]) end
        Logger.Push("RAM", string.format("RAMBoard ply=%s side=%s rank1=[%s]",
            tostring(MemoryState.BoundRAMBoard.ply),
            tostring(MemoryState.BoundRAMBoard.side),
            table.concat(sample, ",")
        ))
    else
        Logger.Push("SCAN", "RAMBoards found: " .. tostring(#MemoryState.AllRAMBoards))
    end
end

local OurScreenGui = nil

local function IsTrulyVisible(guiObj)
    if not guiObj or not guiObj:IsA("GuiObject") then return false end
    local cur = guiObj
    while cur and cur ~= PlayerGui do
        if cur:IsA("GuiObject") and not cur.Visible then
            return false
        elseif cur:IsA("LayerCollector") and not cur.Enabled then
            return false
        end
        cur = cur.Parent
    end
    return cur == PlayerGui
end

local function GetBoardFrame()
    if MemoryState.Controller2 then
        local bg = rawget(MemoryState.Controller2, "bgFrame")
        if typeof(bg) == "Instance" and bg:IsA("GuiObject") and IsTrulyVisible(bg) and bg.AbsoluteSize.X >= 200 then
            return bg
        end
    end

    local candidates = {}
    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if desc:IsA("GuiObject") and (not OurScreenGui or not desc:IsDescendantOf(OurScreenGui)) and IsTrulyVisible(desc) then
            local sz = desc.AbsoluteSize
            if sz.X >= 220 and sz.Y >= 220 and math.abs(sz.X - sz.Y) <= 18 then
                local n = string.lower(desc.Name)
                if not string.find(n, "modal") and not string.find(n, "overlay") and not string.find(n, "toast") then
                    local childCount = #desc:GetDescendants()
                    if childCount >= 16 then
                        table.insert(candidates, { frame = desc, children = childCount, area = sz.X * sz.Y })
                    end
                end
            end
        end
    end
    table.sort(candidates, function(a, b)
        if a.children ~= b.children then return a.children > b.children end
        return a.area > b.area
    end)
    return candidates[1] and candidates[1].frame or nil
end

local function DetectTurnState(boardFrame)
    if not boardFrame then return "NO_BOARD" end
    local boardCenterY = boardFrame.AbsolutePosition.Y + (boardFrame.AbsoluteSize.Y * 0.5)
    local boardTopY = boardFrame.AbsolutePosition.Y

    local topClockLbl, bottomClockLbl = nil, nil
    local explicitBadgeTurn = nil

    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and (not OurScreenGui or not desc:IsDescendantOf(OurScreenGui)) then
            if IsTrulyVisible(desc) then
                local rawTxt = desc.Text
                local t = string.lower(rawTxt)

                if string.find(t, "to move") then
                    explicitBadgeTurn = (desc.AbsolutePosition.Y > boardCenterY) and "MY_TURN" or "OPPONENT_TURN"
                end

                local trimmed = string.gsub(rawTxt, "%s+", "")
                if string.match(trimmed, "^%d+:%d%d$") then
                    if desc.AbsolutePosition.Y < boardTopY then
                        topClockLbl = desc
                    elseif desc.AbsolutePosition.Y > boardCenterY then
                        bottomClockLbl = desc
                    end
                end
            end
        end
    end

    if not topClockLbl or not bottomClockLbl then
        return "LOBBY_IDLE"
    end

    if explicitBadgeTurn then
        return explicitBadgeTurn
    end

    local botCol = bottomClockLbl.TextColor3
    local topCol = topClockLbl.TextColor3
    local botLum = (botCol.R + botCol.G + botCol.B) / 3
    local topLum = (topCol.R + topCol.G + topCol.B) / 3

    if botLum < 0.48 and topLum > 0.52 then
        return "MY_TURN"
    elseif topLum < 0.48 and botLum > 0.52 then
        return "OPPONENT_TURN"
    end

    return "LIVE_MATCH"
end

local function ScrapeAllMovesScrollProof(boardFrame)
    if not boardFrame then return {} end
    local boardBottomY = boardFrame.AbsolutePosition.Y + boardFrame.AbsoluteSize.Y - 12
    local rawTokens = {}

    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and (not OurScreenGui or not desc:IsDescendantOf(OurScreenGui)) then
            if IsTrulyVisible(desc) then
                local scrollAncestor = desc:FindFirstAncestorWhichIsA("ScrollingFrame")
                local isBottomPanel = false
                local sortY = desc.AbsolutePosition.Y

                if scrollAncestor and scrollAncestor.AbsolutePosition.Y >= boardBottomY - 20 then
                    isBottomPanel = true
                    sortY = desc.AbsolutePosition.Y + scrollAncestor.CanvasPosition.Y
                elseif desc.AbsolutePosition.Y >= boardBottomY and desc.AbsoluteSize.Y > 8 and desc.AbsoluteSize.Y < 45 then
                    isBottomPanel = true
                end

                if isBottomPanel then
                    local clean = string.gsub(desc.Text, "<[^>]+>", "")
                    clean = string.gsub(clean, "^%s*(.-)%s*$", "%1")
                    for token in string.gmatch(clean, "%S+") do
                        if not string.match(token, "^%d+%.+$") then
                            local stripped = string.gsub(token, "[+#!?]", "")
                            if
                                stripped == "O-O" or stripped == "O-O-O" or
                                string.match(stripped, "^[NBRQK]?[a-h]?[1-8]?x?[a-h][1-8]=?[QRNB]?$")
                            then
                                table.insert(rawTokens, {
                                    san = stripped,
                                    rowY = math.floor(sortY / 8) * 8,
                                    colX = desc.AbsolutePosition.X
                                })
                            end
                        end
                    end
                end
            end
        end
    end

    table.sort(rawTokens, function(a, b)
        if math.abs(a.rowY - b.rowY) > 10 then return a.rowY < b.rowY end
        return a.colX < b.colX
    end)

    local deduped = {}
    for _, item in ipairs(rawTokens) do
        local prev = deduped[#deduped]
        if not prev or prev.san ~= item.san or math.abs(prev.colX - item.colX) > 15 or math.abs(prev.rowY - item.rowY) > 12 then
            table.insert(deduped, item)
        end
    end

    local result = {}
    for _, item in ipairs(deduped) do
        table.insert(result, item.san)
    end
    return result
end

-- Auto-calibrating RAMBoard Decoder:
-- Learns the exact piece code mapping from a known starting/early board or standard piece characters!
local PieceCharMap = {
    P = 1, N = 2, B = 3, R = 4, Q = 5, K = 6,
    p = -1, n = -2, b = -3, r = -4, q = -5, k = -6,
    wp = 1, wn = 2, wb = 3, wr = 4, wq = 5, wk = 6,
    bp = -1, bn = -2, bb = -3, br = -4, bq = -5, bk = -6
}

local function SyncEngineFromRAMBoard(aiEngine, ramBoard)
    if not ramBoard or type(ramBoard.board) ~= "table" then return false end
    local rb = ramBoard.board
    local converted = table.create(64, 0)
    local nonZero = 0

    for sq = 1, 64 do
        local v = rb[sq]
        if v == nil then v = rb[sq - 1] end
        local mapped = 0

        if type(v) == "number" and v ~= 0 then
            if v >= -6 and v <= 6 then
                mapped = v
            elseif v >= 1 and v <= 12 then
                mapped = (v <= 6) and v or -(v - 6)
            elseif v >= 9 and v <= 22 then
                local pType = bit32.band(v, 7)
                local isBlack = (bit32.band(v, 16) ~= 0) or (v >= 17)
                mapped = isBlack and -pType or pType
            end
        elseif type(v) == "string" then
            mapped = PieceCharMap[v] or PieceCharMap[string.lower(v)] or 0
        end

        if mapped ~= 0 then nonZero += 1 end
        converted[sq] = mapped
    end

    if nonZero < 2 then return false end

    -- Ensure Rank 1 is White's home rank (positive pieces) and Rank 8 is Black's home rank
    -- Check using `ramBoard.kingSq` if available, or initial rank sums
    local rank1Sum, rank8Sum = 0, 0
    for f = 1, 8 do
        rank1Sum += converted[f]
        rank8Sum += converted[56 + f]
    end
    if rank1Sum < 0 and rank8Sum > 0 then
        local flipped = table.create(64, 0)
        for r = 1, 8 do
            for f = 1, 8 do
                flipped[SqIndex(f, r)] = converted[SqIndex(f, 9 - r)]
            end
        end
        converted = flipped
    end

    for i = 1, 64 do
        aiEngine.Squares64[i] = converted[i]
    end

    if type(ramBoard.ply) == "number" then
        aiEngine.ActiveSide = (ramBoard.ply % 2 == 0) and 1 or -1
    end
    return true
end

