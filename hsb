local ESPLabels = {}

-- Nhận diện màu xanh lá cây của tên đồng đội hoặc ô vuông xanh lá
local function isGreenColor(c)
    if not c then return false end
    return (c.G > 0.52) and (c.G > c.R * 1.35) and (c.G > c.B * 1.25)
end

local function checkInstanceHasGreenUI(inst)
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("TextLabel") and d.Visible and isGreenColor(d.TextColor3) then
            return true
        elseif d:IsA("Frame") and d.Visible and d.BackgroundTransparency < 0.95 and isGreenColor(d.BackgroundColor3) then
            return true
        elseif d:IsA("ImageLabel") and d.Visible and d.ImageTransparency < 0.95 and isGreenColor(d.ImageColor3) then
            return true
        elseif d:IsA("Highlight") and d.Enabled and (isGreenColor(d.FillColor) or isGreenColor(d.OutlineColor)) then
            return true
        end
    end
    return false
end

-- Thu thập các Adornee hoặc vị trí màn hình của chỉ báo xanh lá trong PlayerGui
local function getGreenTeammateMarkers()
    local greenAdornees = {}
    local greenScreenPositions = {}
    local greenNames = {}

    if PlayerGui then
        local viewport = Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
        for _, d in ipairs(PlayerGui:GetDescendants()) do
            if not d:IsDescendantOf(ScreenGui) then
                -- Nếu game gắn BillboardGui trong PlayerGui và trỏ Adornee vào nhân vật đồng đội
                if d:IsA("BillboardGui") and d.Enabled and d.Adornee then
                    if checkInstanceHasGreenUI(d) then
                        greenAdornees[d.Adornee] = true
                    end
                elseif d:IsA("TextLabel") and d.Visible and isGreenColor(d.TextColor3) then
                    local absPos = d.AbsolutePosition
                    -- Loại trừ vùng bảng thông báo hạ gục ở góc trên bên phải màn hình
                    local isKillfeed = (absPos.X > viewport.X * 0.65 and absPos.Y < viewport.Y * 0.25)
                    if not isKillfeed and #d.Text >= 3 then
                        greenNames[d.Text] = true
                        table.insert(greenScreenPositions, absPos + (d.AbsoluteSize * 0.5))
                    end
                elseif (d:IsA("Frame") and d.Visible and d.BackgroundTransparency < 0.9 and isGreenColor(d.BackgroundColor3))
                    or (d:IsA("ImageLabel") and d.Visible and d.ImageTransparency < 0.9 and isGreenColor(d.ImageColor3)) then
                    local size = d.AbsoluteSize
                    -- Nhận diện hình vuông nhỏ màu xanh lá cây của đồng đội trên màn hình
                    if size.X >= 4 and size.X <= 45 and size.Y >= 4 and size.Y <= 45 then
                        local center = d.AbsolutePosition + (size * 0.5)
                        -- Bỏ qua thanh máu của bản thân ở góc dưới bên trái
                        if not (center.X < viewport.X * 0.25 and center.Y > viewport.Y * 0.80) then
                            table.insert(greenScreenPositions, center)
                        end
                    end
                end
            end
        end
    end

    return greenAdornees, greenScreenPositions, greenNames
end

local function isCharacterTeammate(plr, char, head, greenAdornees, greenScreenPositions, greenNames)
    if plr == LocalPlayer or char == LocalPlayer.Character then
        return true
    end

    -- 1. Kiểm tra Team chuẩn của Roblox
    if plr and LocalPlayer.Team ~= nil and plr.Team ~= nil and not plr.Neutral then
        if plr.Team == LocalPlayer.Team then
            return true
        end
    end

    -- 2. Kiểm tra tên trùng với chữ màu xanh lá cây trên màn hình
    if greenNames[char.Name] or (plr and (greenNames[plr.Name] or greenNames[plr.DisplayName])) then
        return true
    end

    -- 3. Kiểm tra BillboardGui gắn trực tiếp trong mô hình nhân vật
    if checkInstanceHasGreenUI(char) then
        return true
    end

    -- 4. Kiểm tra BillboardGui trong PlayerGui có Adornee trỏ vào nhân vật
    for adornee, _ in pairs(greenAdornees) do
        if adornee == char or adornee:IsDescendantOf(char) then
            return true
        end
    end

    -- 5. Kiểm tra nếu vị trí đầu nhân vật trên màn hình trùng khớp với ô vuông xanh lá / tên xanh lá
    if Camera and head and #greenScreenPositions > 0 then
        local screenPt, onScreen = Camera:WorldToViewportPoint(head.Position)
        if onScreen and screenPt.Z > 0 then
            local head2D = Vector2.new(screenPt.X, screenPt.Y)
            for _, markerPos in ipairs(greenScreenPositions) do
                if (head2D - markerPos).Magnitude < 65 then
                    return true
                end
            end
        end
    end

    return false
end

-- Quét và cập nhật danh sách KẺ ĐỊCH mỗi 0.35 giây (giữ FPS luôn mượt 60FPS)
task.spawn(function()
    while ScreenGui.Parent do
        local newEnemies = {}
        local seenChars = {}
        local greenAdornees, greenScreenPositions, greenNames = getGreenTeammateMarkers()

        local function evaluateModel(char, plr)
            if not char or seenChars[char] or char == LocalPlayer.Character then return end
            seenChars[char] = true

            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                if not isCharacterTeammate(plr, char, head, greenAdornees, greenScreenPositions, greenNames) then
                    table.insert(newEnemies, {
                        Character = char,
                        Head = head,
                        Humanoid = hum,
                        Root = char:FindFirstChild("HumanoidRootPart") or head,
                        Name = (plr and (plr.DisplayName or plr.Name)) or char.Name
                    })
                end
            end
        end

        -- Quét danh sách Players
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                evaluateModel(plr.Character, plr)
            end
        end

        -- Quét thêm các nhân vật / Bot trực tiếp trong Workspace (1 cấp và 2 cấp thư mục để không gây lag)
        for _, child in ipairs(Workspace:GetChildren()) do
            if child:IsA("Model") then
                evaluateModel(child, Players:GetPlayerFromCharacter(child))
            elseif child:IsA("Folder") or child:IsA("Model") then
                for _, sub in ipairs(child:GetChildren()) do
                    if sub:IsA("Model") then
                        evaluateModel(sub, Players:GetPlayerFromCharacter(sub))
                    end
                end
            end
        end

        CachedEnemies = newEnemies
        task.wait(0.35)
    end
end)

