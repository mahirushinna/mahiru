local function SqCenter(bf, sqIdx, mySide)
    local f, r = FR(sqIdx)
    local c = (mySide == 1) and (f - 1) or (8 - f)
    local rw = (mySide == 1) and (8 - r) or (r - 1)
    local p, s = bf.AbsolutePosition, bf.AbsoluteSize
    local cw = s.X / 8
    return math.floor(p.X + (c + 0.5) * cw), math.floor(p.Y + (rw + 0.5) * cw), cw
end

