                    turnState,
                    HookState.Controller2 and "HOOKED" or "Scanning",
                    HookState.BoundRAMBoard and "YES" or "Scanning"
                )
            else
                if not HookState.Controller2 or not GetActiveRAMBoard() then
                    ScanRoChessMemoryV6()
                end

                local sanList = ScrapeAllMovesScrollProof(boardFrame)
                local currentSig = table.concat(sanList, " ")
                local ramBoard = GetActiveRAMBoard()
                local ramPly = (ramBoard and type(ramBoard.ply) == "number") and ramBoard.ply or -1

                -- Sync Engine whenever either UI move list OR RAMBoard.ply changes!
                if currentSig ~= LastSyncedSig or (ramPly >= 0 and ramPly ~= LastRAMPly) then
                    Engine:Reset()
                    local applied = 0
                    for _, san in ipairs(sanList) do
                        local sideToMove = (applied % 2 == 0) and 1 or -1
                        local parsed = Engine:ParseSANMove(san, sideToMove)
                        if parsed then
                            Engine:StepBoard(parsed)
                            table.insert(Engine.MoveHistoryUCI, parsed.uci)
                            applied += 1
                        else
                            break
                        end
                    end

                    -- If UI move list is hidden (e.g. [Players] tab open as in video_1.mp4 at 00:31!), sync directly from RAMBoard!
                    if ramBoard and ramPly > applied then
                        if SyncEngineFromRAMBoard(Engine, ramBoard) then
                            Logger.Push("SYNC-RAM", string.format("Synced board from RAM #3 (ply=%d, side=%s)",
                                ramPly, Engine.ActiveSide == 1 and "W" or "B"
                            ))
                        end
                    else
                        Logger.Push("SYNC-UI", string.format("Synced %d UI moves (%s) [RAMPly:%d]",
                            applied, currentSig ~= "" and currentSig or "Start", ramPly
                        ))
                    end

                    LastSyncedSig = currentSig
                    LastRAMPly = ramPly
                end

                if turnState == "MY_TURN" then
                    LockedMatchSide = LockedMatchSide or Engine.ActiveSide
                elseif turnState == "OPPONENT_TURN" then
                    LockedMatchSide = LockedMatchSide or -Engine.ActiveSide
                end
                local mySide = LockedMatchSide or 1

                if turnState ~= LastTurnState then
                    LastTurnState = turnState
                    Logger.Push("TURN", string.format("Turn=%s | MySide=%s | BoardTurn=%s (Ply:%d)",
                        turnState, mySide == 1 and "WHITE" or "BLACK", Engine.ActiveSide == 1 and "WHITE" or "BLACK", ramPly
                    ))
                end

                local isMyTurn = (turnState == "MY_TURN") or (turnState == "LIVE_TURN_BY_PLY" and Engine.ActiveSide == mySide)
                local recentHistory = table.concat(sanList, " ", math.max(1, #sanList - 3), #sanList)

                if Config.AutoPlay and isMyTurn and Engine.ActiveSide == mySide then
                    IsExecuting = true
                    local bestMove, score, meta = Engine:SelectBestMove(mySide)
                    if bestMove then
                        StatusLabel.Text = string.format(
                            "Side: %s | Turn: MY_TURN (Ply:%d)\nHook: %s\nMoves: %s\nBest: %s (%+d) [%s]",
                            (mySide == 1) and "WHITE" or "BLACK",
                            ramPly,
                            HookState.LastHookSummary,
                            (recentHistory ~= "" and recentHistory or ("RAM Ply " .. tostring(ramPly))),
                            bestMove.uci,
                            score,
                            meta
                        )
                        Logger.Push("AI", string.format("Move %s (%+d) [%s]", bestMove.uci, score, meta))
                        DispatchMoveV6(bestMove)
                        task.wait(Config.PostMoveCooldown)
                    end
                    IsExecuting = false
                else
                    StatusLabel.Text = string.format(
                        "Side: %s | Turn: %s (Ply:%d)\nHook: %s\nMoves: %s\nWaiting for opponent...",
                        (mySide == 1) and "WHITE" or "BLACK",
                        turnState,
                        ramPly,
                        HookState.LastHookSummary,
                        (recentHistory ~= "" and recentHistory or ("RAM Ply " .. tostring(ramPly)))
                    )
                end
            end
        end
    end
end)
