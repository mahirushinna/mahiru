-- 3. PHÂN TÍCH ĐÒN TẤN CÔNG CỦA ĐỊCH (KHÔNG BAO GIỜ LỌC NHẦM ĐÒN ĐÁNH)
-- ============================================================================

-- Nhận diện hiệu ứng Skill có màu sắc (Đỏ, Cam, Vàng, Tím, Xanh đậm) trên người hoặc vũ khí địch
local function isEnemyUsingColoredSkill(enemyChar)
    if not enemyChar then return false end
    for _, obj in ipairs(enemyChar:GetDescendants()) do
        if obj:IsA("Highlight") and obj.Enabled and obj.FillTransparency < 0.92 then
            local fc = obj.FillColor
            local oc = obj.OutlineColor
            local isWhite = (fc.R > 0.80 and fc.G > 0.80 and fc.B > 0.80)
            if not isWhite then
                if (fc.R > 0.65 and fc.G < 0.42) or (oc.R > 0.65 and oc.G < 0.42)
                    or (fc.B > 0.65 and fc.R < 0.45) or (fc.R > 0.70 and fc.G > 0.50 and fc.B < 0.25) then
                    return true
                end
            end
        elseif (obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")) and obj.Enabled then
            local seq = obj.Color
            if seq and #seq.Keypoints > 0 then
                local c = seq.Keypoints[1].Value
                -- Nếu tia sáng có màu đỏ/vàng/tím rõ rệt (khác màu trắng/xám thường)
                if (c.R > 0.75 and c.G < 0.35 and c.B < 0.35) or (c.B > 0.75 and c.R < 0.35) then
                    return true
                end
            end
        end
    end
    return false
end

-- Kiểm tra chính xác một AnimationTrack có phải là đòn vung vũ khí tấn công không
local function isEnemyAttackTrack(track)
    if not track or not track.IsPlaying then return false end
    -- Đòn vung kiếm/đao không bao giờ lặp vô tận (not Looped) và có độ dài từ 0.18s đến 2.5s
    if track.Looped or track.Length < 0.18 or track.Length > 2.5 or track.Speed <= 0.05 then
        return false
    end

    local prio = track.Priority
    if prio == Enum.AnimationPriority.Core
        or prio == Enum.AnimationPriority.Idle
        or prio == Enum.AnimationPriority.Movement then
        return false
    end

    local name = string.lower(track.Name or "")
    if string.find(name, "idle") or string.find(name, "walk") or string.find(name, "run")
        or string.find(name, "sprint") or string.find(name, "jump") or string.find(name, "fall")
        or string.find(name, "dash") or string.find(name, "dodge") or string.find(name, "block")
        or string.find(name, "guard") or string.find(name, "parry") or string.find(name, "hit")
        or string.find(name, "stun") or string.find(name, "hurt") or string.find(name, "equip") then
        return false
    end

    -- Nếu đối thủ vừa bị mất máu trong 0.28s trước đó thì hoạt ảnh mới bật lên là hoạt ảnh bị chém trúng (Hit Stun), không phải đòn đánh!
    if (os.clock() - State.EnemyLastDamagedTime) < 0.28 then
        return false
    end

    -- Đòn đánh đang trong giai đoạn vung kiếm tới lúc chạm mục tiêu (từ 0% đến 74% thời lượng hoạt ảnh)
    local progress = (track.Length > 0) and (track.TimePosition / track.Length) or 0.3
    if progress >= 0.0 and progress <= 0.74 then
        return true
    end

    return false
end

-- Tìm nhát chém đang hoạt động của đối thủ
local function getActiveEnemyAttackTrack(enemyChar)
    if not enemyChar then return nil end
    local hum = enemyChar:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local animator = hum:FindFirstChildOfClass("Animator") or hum

    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if track.WeightCurrent > 0.15 and isEnemyAttackTrack(track) then
            return track
        end
    end
    return nil
end

-- Chỉ tính là địch đang THỦ khi địch KHÔNG vung kiếm và đang giữ thế kiếm chặn
local function isEnemyGuarding(enemyChar, activeAtkTrack)
    if not enemyChar or activeAtkTrack ~= nil then return false end
    local hum = enemyChar:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    for k, v in pairs(enemyChar:GetAttributes()) do
        if v == true then
            local n = string.lower(k)
            if string.find(n, "block") or string.find(n, "guard") or string.find(n, "parry") then
                return true
            end
        end
    end
    for _, ch in ipairs(enemyChar:GetChildren()) do
        if ch:IsA("BoolValue") and ch.Value == true then
            local n = string.lower(ch.Name)
            if string.find(n, "block") or string.find(n, "guard") or string.find(n, "parry") then
                return true
            end
        end
    end

    local animator = hum:FindFirstChildOfClass("Animator") or hum
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if track.IsPlaying and track.WeightCurrent > 0.25 then
            local name = string.lower(track.Name or "")
            local prio = track.Priority
            if string.find(name, "block") or string.find(name, "guard") or string.find(name, "parry") then
                return true
            end
            if (prio == Enum.AnimationPriority.Action or prio == Enum.AnimationPriority.Action2) then
                if (track.Speed == 0 and track.TimePosition > 0.02) or (track.Looped and hum.WalkSpeed < 9.5) then
                    return true
                end
            end
        end
    end

    return false
end

-- Ngay khoảnh khắc địch bắt đầu vung kiếm: NGẮT NHỊP ĐÁNH & PHÒNG THỦ NGAY LẬP TỨC!
local function startDefenseAgainstTrack(enemyChar, track, isColored)
    if not (Config.Mode1v1 or Config.Mode2v2) then return end
    if State.TargetDist > Config.ParryRange then return end

    local now = os.clock()

    -- Nếu địch tung Skill có màu sắc -> Bấm nút Lướt (Né) rồi đặt cờ phản công ngay
    if isColored then
        if now - State.LastDodgeTime >= 0.30 then
            State.LastDodgeTime = now
            doAction("Dodge", "Tap")
            State.PendingCounter = true
            State.CounterWindowUntil = now + 0.55
        end
        return
    end

    -- Đòn chém thường/nặng: Ngắt nhịp đánh của mình (Feint) và GIỮ NÚT ĐỠ cho đến khi nhát chém của địch kết thúc!
    State.ActiveEnemyTrack = track
    State.BlockStartTime = now
    -- Giữ đỡ tối đa theo độ dài nhát chém của địch (tối thiểu 0.26s, tối đa 0.65s cho đao dài Naginata)
    local holdTime = 0.35
    if track and track.Length > 0 then
        local remaining = (track.Length * 0.72) - track.TimePosition
        holdTime = math.clamp(remaining + 0.08, 0.26, 0.65)
    end
    State.MaxBlockHoldTime = now + holdTime
    State.PendingCounter = true
    State.CounterWindowUntil = State.MaxBlockHoldTime + 0.45

    doAction("FeintAndBlock", "Down")
end

local function hookTargetAnimator(enemyChar)
    if not enemyChar then return end
    local hum = enemyChar:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator") or hum
    if State.HookedAnimators[animator] then return end
    State.HookedAnimators[animator] = true

    animator.AnimationPlayed:Connect(function(track)
        if not (Config.Mode1v1 or Config.Mode2v2) then return end
        if enemyChar ~= State.Target then return end
        if State.TargetDist <= Config.ParryRange and isEnemyAttackTrack(track) then
            startDefenseAgainstTrack(enemyChar, track, isEnemyUsingColoredSkill(enemyChar))
        end
    end)
end

-- ============================================================================
-- 4. VÒNG LẶP CHIẾN ĐẤU V6: ĐỠ TRỌN NHÁT KIẾM -> ĐÁNH TRẢ NGAY LẬP TỨC
-- ============================================================================

local function onCombatStep()
    if not (Config.Mode1v1 or Config.Mode2v2) then
        if State.IsBlocking then doAction("Block", "Up") end
        State.StatusText = "Đang Tắt [OFF]"
        return
    end

    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHum or not myRoot or myHum.Health <= 0 then return end

    local enemy, dist = getTarget()
    if enemy ~= State.Target then
        State.Target = enemy
        State.LastEnemyHealth = nil
        State.ActiveEnemyTrack = nil
        State.PendingCounter = false
        if enemy then hookTargetAnimator(enemy) end
    end
    State.TargetDist = dist

    if not enemy then
        if State.IsBlocking then doAction("Block", "Up") end
        State.StatusText = Config.Mode1v1 and "1v1: Đang đợi đối thủ..." or "2v2: Đang tìm kẻ địch..."
        return
    end

    hookTargetAnimator(enemy)
    local enemyHum = enemy:FindFirstChildOfClass("Humanoid")
    local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
    if not enemyHum or not enemyRoot then return end

    local now = os.clock()

    -- ========================================================================
    -- 1. THEO DÕI MÁU ĐỊCH: ĐÁNH TRÚNG 1 CÁI -> XẢ LUÔN SKILL NỘ (SIÊU CẤP)
    -- ========================================================================
    local currentHp = enemyHum.Health
    if State.LastEnemyHealth ~= nil and currentHp < State.LastEnemyHealth then
        State.EnemyLastDamagedTime = now
        if dist <= 13.0 and isUltimateReady() and (now - State.LastUltTime > 0.45) then
            State.LastUltTime = now
            doAction("Ultimate", "Tap")
        end
    end
    State.LastEnemyHealth = currentHp

    -- ========================================================================
    -- 2. KIỂM TRA ĐỊCH TẤN CÔNG: NGẮT NHỊP ĐÁNH ĐỂ ĐỠ TRỌN NHÁT CHÉM
    -- ========================================================================
    local coloredSkill = isEnemyUsingColoredSkill(enemy)
    local activeAtkTrack = getActiveEnemyAttackTrack(enemy)

    if dist <= Config.ParryRange then
        if coloredSkill and (now - State.LastDodgeTime > 0.32) then
            startDefenseAgainstTrack(enemy, activeAtkTrack, true)
        elseif activeAtkTrack then
            -- Nếu địch đang vung kiếm mà mình chưa đỡ hoặc địch tung nhát chém tiếp theo -> Giữ đỡ ngay!
            if not State.IsBlocking or State.ActiveEnemyTrack ~= activeAtkTrack then
                startDefenseAgainstTrack(enemy, activeAtkTrack, false)
            end
        end
    end

    -- ========================================================================
    -- 3. KHI ĐỠ XONG NHÁT CHÉM CỦA ĐỊCH -> NHẢ ĐỠ & PHẢN CÔNG LẠI NGAY LẬP TỨC!
    -- ========================================================================
    if State.IsBlocking then
        local trackDone = (activeAtkTrack == nil)
        local holdExpired = (now >= State.MaxBlockHoldTime)
        local minHeld = (now - State.BlockStartTime) >= 0.20

        if (trackDone and minHeld) or holdExpired then
            -- Nhát chém của địch đã va vào kiếm đỡ của mình xong -> Nhả nút đỡ ra ngay!
            doAction("Block", "Up")
            State.ActiveEnemyTrack = nil

            -- ĐỠ ĐÒN XONG LÀ ĐÁNH LẠI LUÔN!
            if dist <= Config.StrikeRange + 2.5 then
                State.PendingCounter = false
                if isUltimateReady() and (now - State.LastUltTime > 0.5) then
                    State.LastUltTime = now
                    doAction("Ultimate", "Tap")
                else
                    State.LastLightTime = now
                    doAction("Light", "Tap")
                end
            end
        end
    end

    -- ========================================================================
    -- 4. TỰ ĐỘNG ĐI ĐẾN ĐỊCH & XOAY MẶT ĐÓN ĐỠ
    -- ========================================================================
    local myPos = myRoot.Position
    local enemyPos = enemyRoot.Position

    if dist <= 18.0 and dist > 0.5 and (now - State.LastDodgeTime > 0.18) then
        pcall(function()
            myRoot.CFrame = CFrame.lookAt(myPos, Vector3.new(enemyPos.X, myPos.Y, enemyPos.Z))
        end)
    end

    if now - State.LastMoveTime >= 0.05 then
        State.LastMoveTime = now
        if dist > Config.StopWalkRange and dist < 120 then
            local diff = myPos - enemyPos
            local flat = Vector3.new(diff.X, 0, diff.Z)
            local goal = enemyPos
            if flat.Magnitude > 0.1 then
                goal = enemyPos + (flat.Unit * (Config.StopWalkRange - 0.3))
            end
            myHum:MoveTo(goal)
        elseif dist <= Config.StopWalkRange then
            myHum:MoveTo(myPos)
        end
    end

    -- ========================================================================
    -- 5. TẤN CÔNG KHI ĐÃ ÁP SÁT (KHÔNG CHÉM BỪA TỪ XA, ĐỊCH ĐÁNH LÀ NGẮT NGAY)
    -- ========================================================================
    local enemyGuarding = isEnemyGuarding(enemy, activeAtkTrack)

    if not State.IsBlocking and activeAtkTrack == nil and not coloredSkill and dist <= Config.StrikeRange then
        -- Ưu tiên 1: Nếu vừa đỡ/né đòn xong (PendingCounter) -> Phản công ngay lập tức!
        if State.PendingCounter and now <= State.CounterWindowUntil then
            State.PendingCounter = false
            if isUltimateReady() and (now - State.LastUltTime > 0.5) then
                State.LastUltTime = now
                doAction("Ultimate", "Tap")
            elseif enemyGuarding then
                State.LastHeavyTime = now
                doAction("Heavy", "Tap")
            else
                State.LastLightTime = now
                doAction("Light", "Tap")
            end

        -- Ưu tiên 2: Nếu có sẵn Skill Nộ (Siêu Cấp / [R]) và địch không thủ -> Xả Skill Nộ luôn!
        elseif isUltimateReady() and not enemyGuarding and (now - State.LastUltTime >= 0.55) then
            State.LastUltTime = now
            doAction("Ultimate", "Tap")

        -- Ưu tiên 3: Nếu kẻ địch giơ kiếm THỦ -> Dùng chiêu Phá Phòng Thủ (Nặng / M2)
        elseif enemyGuarding then
            if now - State.LastHeavyTime >= 0.55 then
                State.LastHeavyTime = now
                doAction("Heavy", "Tap")
            end

        -- Ưu tiên 4: Đánh nhịp đơn kiểm soát ở cự ly gần (cách 0.42s để luôn kịp ngắt đòn đỡ nếu địch chém lại)
        elseif now - State.LastLightTime >= 0.42 then
            State.LastLightTime = now
            doAction("Light", "Tap")
        end
    end

    local modeTag = Config.Mode1v1 and "1v1" or "2v2"
    local statusAction = State.IsBlocking and "ĐANG ĐỠ ĐÒN ĐỊCH!"
        or (coloredSkill and "LƯỚT NÉ SKILL MÀU!"
        or (enemyGuarding and "ĐỊCH THỦ -> PHÁ GIÁP!"
        or (dist > Config.StrikeRange and "Đang tiến tới địch" or "Đỡ xong -> Đánh trả!")))
    State.StatusText = string.format("[%s] %s (%.1fm) %s", modeTag, enemy.Name:sub(1, 8), dist, statusAction)
end

