local function buildHudV6()
    local parentGui = (typeof(gethui) == "function" and gethui()) or CoreGui
    for _, name in ipairs({
        "OllieKatanaDuelHUD", "OllieKatanaDuelHUD_V2", "OllieKatanaDuelHUD_V3",
        "OllieKatanaDuelHUD_V4", "OllieKatanaDuelHUD_V5", "OllieKatanaDuelHUD_V6"
    }) do
        local old = parentGui:FindFirstChild(name)
        if old then old:Destroy() end
    end

    local sg = Instance.new("ScreenGui")
    sg.Name = "OllieKatanaDuelHUD_V6"
    sg.ResetOnSpawn = false
    sg.Parent = parentGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 220, 0, 112)
    frame.Position = UDim2.new(0.015, 0, 0.18, 0)
    frame.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
    frame.BackgroundTransparency = 0.08
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = sg

    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(255, 75, 75)
    stroke.Thickness = 1.5

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -12, 0, 20)
    title.Position = UDim2.new(0, 6, 0, 4)
    title.BackgroundTransparency = 1
    title.Text = "KATANA AUTO V6 [1v1 / 2v2]"
    title.TextColor3 = Color3.fromRGB(255, 95, 95)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 12
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = frame

    local statusLbl = Instance.new("TextLabel")
    statusLbl.Size = UDim2.new(1, -12, 0, 16)
    statusLbl.Position = UDim2.new(0, 6, 0, 22)
    statusLbl.BackgroundTransparency = 1
    statusLbl.Text = State.StatusText
    statusLbl.TextColor3 = Color3.fromRGB(110, 235, 255)
    statusLbl.Font = Enum.Font.Code
    statusLbl.TextSize = 10
    statusLbl.TextXAlignment = Enum.TextXAlignment.Left
    statusLbl.Parent = frame

    local btn1v1 = Instance.new("TextButton")
    btn1v1.Size = UDim2.new(1, -16, 0, 30)
    btn1v1.Position = UDim2.new(0, 8, 0, 42)
    btn1v1.Font = Enum.Font.GothamBold
    btn1v1.TextSize = 12
    btn1v1.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn1v1.Parent = frame
    Instance.new("UICorner", btn1v1).CornerRadius = UDim.new(0, 6)

    local btn2v2 = Instance.new("TextButton")
    btn2v2.Size = UDim2.new(1, -16, 0, 30)
    btn2v2.Position = UDim2.new(0, 8, 0, 76)
    btn2v2.Font = Enum.Font.GothamBold
    btn2v2.TextSize = 12
    btn2v2.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn2v2.Parent = frame
    Instance.new("UICorner", btn2v2).CornerRadius = UDim.new(0, 6)

    local function syncUi()
        btn1v1.Text = "Chế Độ 1v1 (Full Auto): " .. (Config.Mode1v1 and "BẬT" or "TẮT")
        btn1v1.BackgroundColor3 = Config.Mode1v1 and Color3.fromRGB(35, 125, 62) or Color3.fromRGB(45, 45, 55)

        btn2v2.Text = "Chế Độ 2v2 (Full Auto): " .. (Config.Mode2v2 and "BẬT" or "TẮT")
        btn2v2.BackgroundColor3 = Config.Mode2v2 and Color3.fromRGB(35, 105, 150) or Color3.fromRGB(45, 45, 55)
    end

    btn1v1.MouseButton1Click:Connect(function()
        Config.Mode1v1 = not Config.Mode1v1
        if Config.Mode1v1 then Config.Mode2v2 = false end
        syncUi()
    end)

    btn2v2.MouseButton1Click:Connect(function()
        Config.Mode2v2 = not Config.Mode2v2
        if Config.Mode2v2 then Config.Mode1v1 = false end
        syncUi()
    end)

    syncUi()

    RunService.RenderStepped:Connect(function()
        statusLbl.Text = State.StatusText
    end)
end

scanTouchButtons()
buildHudV6()
RunService.RenderStepped:Connect(onCombatStep)
