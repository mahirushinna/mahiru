local function IsValidEnemyModel(model, myChar, myRoot)
    if not model or not model:IsA("Model") then return false end
    if model == myChar then return false end
    if model.Name == LocalPlayer.Name or model.Name == LocalPlayer.DisplayName then return false end
    if Players:GetPlayerFromCharacter(model) == LocalPlayer then return false end
    if myChar and model:IsDescendantOf(myChar) then return false end
    if Camera and model:IsDescendantOf(Camera) then return false end

    local hum = model:FindFirstChildOfClass("Humanoid")
    local head = model:FindFirstChild("Head")
    local root = model:FindFirstChild("HumanoidRootPart")
    if not (hum and head and root and hum.Health > 0) then
        return false
    end

    if myRoot and (root.Position - myRoot.Position).Magnitude < 1.8 and not Config.Memory.TeleBehindAndAttack then
        return false
    end

    return true
end

local function GetEnemyCharacters()
    local enemies = {}
    local seen = {}
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            if IsValidEnemyModel(char, myChar, myRoot) then
                seen[char] = true
                table.insert(enemies, char)
            end
        end
    end

    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") and not seen[child] then
            if IsValidEnemyModel(child, myChar, myRoot) then
                seen[child] = true
                table.insert(enemies, child)
            end
        elseif child:IsA("Folder") and child ~= Camera then
            local folderName = string.lower(child.Name)
            if string.find(folderName, "bot") or string.find(folderName, "player") or string.find(folderName, "enem") or string.find(folderName, "char") then
                for _, sub in ipairs(child:GetChildren()) do
                    if sub:IsA("Model") and not seen[sub] and IsValidEnemyModel(sub, myChar, myRoot) then
                        seen[sub] = true
                        table.insert(enemies, sub)
                    end
                end
            end
        end
    end

    return enemies
end

-- // 7. KIỂM TRA VẬT CẢN (RAYCAST VISIBILITY CHECK)
local function HasClearLineOfSight(targetPart, targetCharacter)
    if not Config.Aim.VisibleCheck then
        return true
    end

    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin
    if direction.Magnitude < 1 then
        return true
    end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local ignoreList = {Camera}
    if LocalPlayer.Character then
        table.insert(ignoreList, LocalPlayer.Character)
    end
    rayParams.FilterDescendantsInstances = ignoreList
    rayParams.IgnoreWater = true

    local result = Workspace:Raycast(origin, direction, rayParams)
    if not result then
        return true
    end

    if result.Instance and result.Instance:IsDescendantOf(targetCharacter) then
        return true
    end

    return false
end

-- // 8. HÀM TỰ BẮN / ĐÁNH ĐỊCH KHI ĐANG TELE SAU LƯNG
local function TriggerAutoAttack()
    local now = os.clock()
    if now - LastAutoAttackClock < 0.08 then
        return
    end
    LastAutoAttackClock = now

    local myChar = LocalPlayer.Character
    if myChar then
        local tool = myChar:FindFirstChildOfClass("Tool")
        if tool then
            pcall(function()
                tool:Activate()
            end)
        end
    end

    -- Kích hoạt click / chạm tấn công trên cả Executor Mobile và PC
    pcall(function()
        if mouse1click then
            mouse1click()
        else
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5))
        end
    end)
end

-- // 9. VÒNG LẶP ĐỒNG BỘ: MEMORY TELE 70M -> AIMBOT -> ESP
local frameCount = 0
local lastFPSTime = os.clock()

RunService:BindToRenderStep(RenderStepName, Enum.RenderPriority.Camera.Value + 1, function()
    Camera = Workspace.CurrentCamera
    if not Camera then return end

    -- Cập nhật FPS
    frameCount = frameCount + 1
    local now = os.clock()
    if now - lastFPSTime >= 0.4 then
        local currentFPS = math.clamp(frameCount / (now - lastFPSTime), 1, 999)
        local fpsStr = string.format("%.1f", currentFPS)
        PillFPSLabel.Text = string.format('<font color="#35e060">%s</font> <font color="#d8d8d8">fps</font>', fpsStr)
        HeaderTitle.Text = string.format('<font color="#e6c84f">Monica Hub [Killstreak BR]</font>  <font color="#8a909e">|  FPS:</font> <font color="#35e060">%s</font>', fpsStr)
        frameCount = 0
        lastFPSTime = now
    end

    local viewportSize = Camera.ViewportSize
    local screenCenter = Vector2.new(viewportSize.X * 0.5, viewportSize.Y * 0.5)

    FOVCircleFrame.Position = UDim2.new(0, screenCenter.X, 0, screenCenter.Y)
    FOVCircleFrame.Size = UDim2.new(0, Config.Aim.FOVRadius * 2, 0, Config.Aim.FOVRadius * 2)
    FOVCircleFrame.Visible = Config.ESP.ShowFOV

    local activeEnemies = GetEnemyCharacters()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

    -- BƯỚC 1: CHỨC NĂNG MEMORY — TELE NHANH RA SAU ĐỊCH (≤ 70M) & TỰ BẮN/ĐÁNH
    if Config.Memory.Unlocked and Config.Memory.TeleBehindAndAttack and myRoot and myHum and myHum.Health > 0 then
        local chosenEnemy = nil
        local bestScore = math.huge
        local chosenDistMeters = 0

        for _, enemyChar in ipairs(activeEnemies) do
            local eRoot = enemyChar:FindFirstChild("HumanoidRootPart")
            local eHum = enemyChar:FindFirstChildOfClass("Humanoid")
            local eHead = enemyChar:FindFirstChild("Head")

            if eRoot and eHum and eHead and eHum.Health > 0 then
                local distStuds = (myRoot.Position - eRoot.Position).Magnitude
                local distMeters = distStuds * 0.28

                -- Chỉ quét mục tiêu trong bán kính 70m
                if distMeters <= Config.Memory.MaxRange then
                    if Config.Memory.TargetPriority == "LowestHP" then
                        -- Ưu tiên địch yếu máu nhất (nếu bằng máu thì lấy đứa gần hơn)
                        local score = (eHum.Health * 1000) + distMeters
                        if score < bestScore then
                            bestScore = score
                            chosenEnemy = enemyChar
                            chosenDistMeters = math.max(1, math.floor(distMeters + 0.5))
                        end
                    else
                        -- Ưu tiên địch gần nhất
                        if distMeters < bestScore then
                            bestScore = distMeters
                            chosenEnemy = enemyChar
                            chosenDistMeters = math.max(1, math.floor(distMeters + 0.5))
                        end
                    end
                end
            end
        end

        if chosenEnemy then
            local eRoot = chosenEnemy:FindFirstChild("HumanoidRootPart")
            local eHead = chosenEnemy:FindFirstChild("Head")
            local eHum = chosenEnemy:FindFirstChildOfClass("Humanoid")

            if eRoot and eHead and eHum then
                -- Tính vị trí ngay phía sau lưng địch (ngược hướng LookVector của địch) và quay mặt về phía địch
                local lookVec = eRoot.CFrame.LookVector
                local flatLook = Vector3.new(lookVec.X, 0, lookVec.Z)
                if flatLook.Magnitude < 0.05 then
                    flatLook = Vector3.new(0, 0, -1)
                else
                    flatLook = flatLook.Unit
                end

                local behindPos = eRoot.Position - (flatLook * Config.Memory.BehindStuds)
                myRoot.CFrame = CFrame.new(behindPos, Vector3.new(eRoot.Position.X, behindPos.Y, eRoot.Position.Z))
                myRoot.AssemblyLinearVelocity = Vector3.zero

                -- Khóa thẳng tâm Camera vào đầu/thân địch và tự động kích hoạt bắn/đánh
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, eHead.Position)
                TriggerAutoAttack()

                MemTargetStatus.Text = string.format(
                    'Mục tiêu: <font color="#35e060">%s</font> | HP: <font color="#ffdf5d">%d</font> | Cách: <font color="#63b3ff">%dm</font>',
                    chosenEnemy.Name,
                    math.floor(eHum.Health),
                    chosenDistMeters
                )
            end
        else
            MemTargetStatus.Text = 'Mục tiêu hiện tại: <font color="#ff9d5c">Không có địch nào trong phạm vi 70m</font>'
        end
    else
        MemTargetStatus.Text = 'Mục tiêu hiện tại: <font color="#9096a4">Đang chờ kích hoạt...</font>'
    end

    -- BƯỚC 2: TÍNH TOÁN & XOAY CAMERA AIMBOT TRƯỚC KHI VẼ ESP
    if Config.Aim.Enabled and IsShooting then
        local bestTargetHead = nil
        local closestDistToCenter = Config.Aim.FOVRadius

        for _, enemyChar in ipairs(activeEnemies) do
            local head = enemyChar:FindFirstChild("Head")
            local hum = enemyChar:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local headScreen, headOnScreen = Camera:WorldToViewportPoint(head.Position)
                if headOnScreen and headScreen.Z > 0.2 then
                    local headPos2D = Vector2.new(headScreen.X, headScreen.Y)
                    local distFromCrosshair = (headPos2D - screenCenter).Magnitude

                    if distFromCrosshair <= closestDistToCenter and HasClearLineOfSight(head, enemyChar) then
                        closestDistToCenter = distFromCrosshair
                        bestTargetHead = head
                    end
                end
            end
        end

        if bestTargetHead then
            local camPos = Camera.CFrame.Position
            local targetCFrame = CFrame.new(camPos, bestTargetHead.Position)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Config.Aim.Smoothness)
        end
    end

    -- BƯỚC 3: CHIẾU TỌA ĐỘ MÀN HÌNH & VẼ ESP BẰNG MA TRẬN CAMERA MỚI NHẤT + LỌC KHOẢNG CÁCH (1-500m)
    local activeLookup = {}
    local fovFactor = 1 / math.tan(math.rad(Camera.FieldOfView * 0.5))

    for _, enemyChar in ipairs(activeEnemies) do
        activeLookup[enemyChar] = true
        local node = CreateESPNode(enemyChar)

        local root = enemyChar:FindFirstChild("HumanoidRootPart")
        local head = enemyChar:FindFirstChild("Head")
        local hum = enemyChar:FindFirstChildOfClass("Humanoid")

        if root and head and hum and hum.Health > 0 then
            local distStuds = myRoot and (myRoot.Position - root.Position).Magnitude or (Camera.CFrame.Position - root.Position).Magnitude
            local distMeters = math.max(1, math.floor(distStuds * 0.28 + 0.5))

            if distMeters <= Config.ESP.MaxDistance then
                local rootScreen, rootOnScreen = Camera:WorldToViewportPoint(root.Position)

                if rootScreen.Z > 0.5 then
                    local topWorld = root.Position + Vector3.new(0, 2.6, 0)
                    local bottomWorld = root.Position - Vector3.new(0, 3.0, 0)
                    local topScreen = Camera:WorldToViewportPoint(topWorld)
                    local bottomScreen = Camera:WorldToViewportPoint(bottomWorld)

                    local boxHeight
                    local boxPosY

                    if topScreen.Z > 0.2 and bottomScreen.Z > 0.2 then
                        boxHeight = math.clamp(math.abs(bottomScreen.Y - topScreen.Y), 12, viewportSize.Y * 1.5)
                        boxPosY = math.min(topScreen.Y, bottomScreen.Y)
                    else
                        boxHeight = math.clamp((5.6 / rootScreen.Z) * (viewportSize.Y * 0.5) * fovFactor, 12, viewportSize.Y * 1.2)
                        boxPosY = rootScreen.Y - (boxHeight * 0.5)
                    end

                    local boxWidth = math.max(boxHeight * 0.58, 8)
                    local boxPosX = rootScreen.X - (boxWidth * 0.5)

                    local isInsideViewport = (boxPosX + boxWidth >= 0)
                        and (boxPosX <= viewportSize.X)
                        and (boxPosY + boxHeight >= 0)
                        and (boxPosY <= viewportSize.Y)

                    if rootOnScreen or isInsideViewport then
                        if Config.ESP.Box2D then
                            node.Box.Position = UDim2.new(0, boxPosX, 0, boxPosY)
                            node.Box.Size = UDim2.new(0, boxWidth, 0, boxHeight)
                            node.Box.Visible = true
                        else
                            node.Box.Visible = false
                        end

                        local hpRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                        if Config.ESP.Health then
                            node.HealthBG.Position = UDim2.new(0, boxPosX - 6, 0, boxPosY)
                            node.HealthBG.Size = UDim2.new(0, 3, 0, boxHeight)
                            node.HealthFill.Size = UDim2.new(1, 0, hpRatio, 0)
                            node.HealthFill.BackgroundColor3 = Color3.fromHSV(hpRatio * 0.33, 0.9, 0.95)
                            node.HealthBG.Visible = true
                        else
                            node.HealthBG.Visible = false
                        end

                        if Config.ESP.Health or Config.ESP.Distance then
                            local parts = {}
                            if Config.ESP.Health then
                                table.insert(parts, string.format("HP: %d", math.floor(hum.Health)))
                            end
                            if Config.ESP.Distance then
                                table.insert(parts, string.format("[%dm]", distMeters))
                            end
                            node.InfoLabel.Text = table.concat(parts, " ")
                            node.InfoLabel.Position = UDim2.new(0, rootScreen.X, 0, boxPosY - 3)
                            node.InfoLabel.Visible = true
                        else
                            node.InfoLabel.Visible = false
                        end
                    else
                        HideESPNode(node)
                    end
                else
                    HideESPNode(node)
                end
            else
                HideESPNode(node)
            end
        else
            HideESPNode(node)
        end
    end

    for model, _ in pairs(ESPCache) do
        if not activeLookup[model] then
            RemoveESPNode(model)
        end
    end
end)
