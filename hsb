local OurScreenGui = nil

local function GetBoardFrame()
    local candidates = {}
    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if desc:IsA("GuiObject") and desc.Visible and (not OurScreenGui or not desc:IsDescendantOf(OurScreenGui)) then
            local sz = desc.AbsoluteSize
            if sz.X >= 220 and sz.Y >= 220 and math.abs(sz.X - sz.Y) <= 18 then
                local n = string.lower(desc.Name)
                if not string.find(n, "modal") and not string.find(n, "overlay") and not string.find(n, "toast") then
                    local childCount = #desc:GetDescendants()
                    if childCount >= 16 then
                        table.insert(candidates, { frame = desc, children = childCount, area = sz.X * sz.Y })
                    end
                end
            end
        end
    end
    table.sort(candidates, function(a, b)
        if a.children ~= b.children then return a.children > b.children end
        return a.area > b.area
    end)
    return candidates[1] and candidates[1].frame or nil
end

-- Picks the live #3 RAM Board instance that represents the active match
