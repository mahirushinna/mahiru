local function ComputeSquareScreenCenter(boardFrame, sqIdx, mySide)
    local file, rank = IndexToFileRank(sqIdx)
    local col, row
    if mySide == 1 then
        col = file - 1
        row = 8 - rank
    else
        col = 8 - file
        row = rank - 1
    end
    local bPos = boardFrame.AbsolutePosition
    local bSize = boardFrame.AbsoluteSize
    local cellW, cellH = bSize.X / 8, bSize.Y / 8
    return math.floor(bPos.X + (col + 0.5) * cellW), math.floor(bPos.Y + (row + 0.5) * cellH)
end

-- Uses native PlayerGui:GetGuiObjectsAtPosition(x, y) + fallback bounding box scan
local function GetAllGuiObjectsAtScreenPoint(x, y)
    local list = {}
    local seen = {}

    local ok, nativeHits = pcall(function()
        return PlayerGui:GetGuiObjectsAtPosition(x, y)
    end)
    if ok and nativeHits then
        for _, obj in ipairs(nativeHits) do
            if not OurScreenGui or not obj:IsDescendantOf(OurScreenGui) then
                seen[obj] = true
                table.insert(list, obj)
            end
        end
    end

    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if desc:IsA("GuiObject") and desc.Visible and not seen[desc] then
            if not OurScreenGui or not desc:IsDescendantOf(OurScreenGui) then
                local pos = desc.AbsolutePosition
                local sz = desc.AbsoluteSize
                if x >= pos.X and x <= (pos.X + sz.X) and y >= pos.Y and y <= (pos.Y + sz.Y) then
                    seen[desc] = true
                    table.insert(list, desc)
                end
            end
        end
    end

    return list
end

local function FireHooksAtPoint(x, y, labelTag)
    HookState.SpoofActive = true
    HookState.SpoofX = x
    HookState.SpoofY = y

    local hitObjects = GetAllGuiObjectsAtScreenPoint(x, y)
    local topNames = {}
    for i = 1, math.min(3, #hitObjects) do
        table.insert(topNames, hitObjects[i].ClassName .. ":" .. hitObjects[i].Name)
    end

    local signalFires = 0
    local connFires = 0

    local fakeTableBegin = {
        UserInputType = Enum.UserInputType.Touch,
        UserInputState = Enum.UserInputState.Begin,
        Position = Vector3.new(x, y, 0),
        Delta = Vector3.zero,
        KeyCode = Enum.KeyCode.Unknown
    }
    local fakeTableEnd = {
        UserInputType = Enum.UserInputType.Touch,
        UserInputState = Enum.UserInputState.End,
        Position = Vector3.new(x, y, 0),
        Delta = Vector3.zero,
        KeyCode = Enum.KeyCode.Unknown
    }

    local inputPayloadBegin = HookState.RealInputObject or fakeTableBegin
    local inputPayloadEnd = HookState.RealInputObject or fakeTableEnd

    for _, obj in ipairs(hitObjects) do
        -- 1. Button signals if obj is a GuiButton (TextButton / ImageButton)
        if obj:IsA("GuiButton") then
            for _, sigName in ipairs({ "Activated", "MouseButton1Down", "MouseButton1Click", "MouseButton1Up", "TouchTap" }) do
                local okSig, sig = pcall(function() return obj[sigName] end)
                if okSig and sig then
                    if firesignal then
                        pcall(firesignal, sig)
                        pcall(firesignal, sig, x, y)
                        signalFires += 1
                    end
                    if getconnections then
                        local okC, conns = pcall(getconnections, sig)
                        if okC and conns then
                            for _, c in ipairs(conns) do
                                connFires += 1
                                if c.Function then pcall(task.spawn, c.Function, x, y) end
                                pcall(function() c:Fire(x, y) end)
                            end
                        end
                    end
                end
            end
        end

        -- 2. GuiObject InputBegan / InputEnded / TouchTap signals
        HookState.SpoofState = Enum.UserInputState.Begin
        HookState.SpoofType = Enum.UserInputType.Touch

        if getconnections then
            local okIn, connsIn = pcall(getconnections, obj.InputBegan)
            if okIn and connsIn then
                for _, c in ipairs(connsIn) do
                    connFires += 1
                    if c.Function then pcall(task.spawn, c.Function, inputPayloadBegin, false) end
                    pcall(function() c:Fire(inputPayloadBegin, false) end)
                end
            end

            local okTap, connsTap = pcall(getconnections, obj.TouchTap)
            if okTap and connsTap then
                for _, c in ipairs(connsTap) do
                    connFires += 1
                    if c.Function then pcall(task.spawn, c.Function, { Vector2.new(x, y) }) end
                    pcall(function() c:Fire({ Vector2.new(x, y) }) end)
                end
            end
        end

        if firesignal then
            pcall(firesignal, obj.InputBegan, inputPayloadBegin, false)
            pcall(firesignal, obj.TouchTap, { Vector2.new(x, y) })
            signalFires += 1
        end

        HookState.SpoofState = Enum.UserInputState.End
        if getconnections then
            local okOut, connsOut = pcall(getconnections, obj.InputEnded)
            if okOut and connsOut then
                for _, c in ipairs(connsOut) do
                    connFires += 1
                    if c.Function then pcall(task.spawn, c.Function, inputPayloadEnd, false) end
                    pcall(function() c:Fire(inputPayloadEnd, false) end)
                end
            end
        end
        if firesignal then
            pcall(firesignal, obj.InputEnded, inputPayloadEnd, false)
        end
    end

    -- 3. Also fire UserInputService global InputBegan / TouchTap connections with spoofed RealInputObject
    if getconnections then
        HookState.SpoofState = Enum.UserInputState.Begin
        local okUIS, uisConns = pcall(getconnections, UserInputService.InputBegan)
        if okUIS and uisConns then
            for _, c in ipairs(uisConns) do
                if c.Function and c.Function ~= inputCaptureConn then
                    connFires += 1
                    pcall(task.spawn, c.Function, inputPayloadBegin, false)
                end
            end
        end
    end

    HookState.SpoofActive = false

    Logger:Add("GUI", string.format("%s @(%d,%d) Hit:%d [%s] Sig:%d Conn:%d",
        labelTag, x, y, #hitObjects, table.concat(topNames, ", "), signalFires, connFires
    ))

    return signalFires + connFires, #hitObjects
end

local function DispatchMoveHooks(move, mySide)
    local fromAlg = IndexToAlgebraic(move.from)
    local toAlg = IndexToAlgebraic(move.to)
    local uci = fromAlg .. toAlg
    local methodsUsed = {}

    -- 1. Locked Remote Hook (if __namecall or GC already captured the Remote)
    if HookState.CapturedRemote then
        local rem = HookState.CapturedRemote
        local ok, err = pcall(function()
            if rem:IsA("RemoteEvent") then
                if HookState.CapturedSchema == "ACTION_TWO_STRINGS" then
                    rem:FireServer(HookState.CapturedActionPrefix or "Move", fromAlg, toAlg, "q")
                elseif HookState.CapturedSchema == "UCI_STRING" then
                    rem:FireServer(uci)
                elseif HookState.CapturedSchema == "TABLE_FROM_TO" then
                    rem:FireServer({ from = fromAlg, to = toAlg, From = fromAlg, To = toAlg, move = uci, promotion = "q" })
                elseif HookState.CapturedSchema == "NUMERIC_PAIR" then
                    rem:FireServer(move.from, move.to)
                else
                    rem:FireServer(fromAlg, toAlg, "q")
                end
            elseif rem:IsA("RemoteFunction") then
                task.spawn(function() rem:InvokeServer(fromAlg, toAlg, "q") end)
            end
        end)
        if ok then
            table.insert(methodsUsed, "Rem:" .. rem.Name)
        else
            Logger:Add("ERR", "Remote hook error: " .. tostring(err))
        end
    end

    -- 2. Discovered GC Move Functions
    for _, item in ipairs(HookState.GCMoveFunctions) do
        pcall(function()
            if item.selfTable then
                item.fn(item.selfTable, fromAlg, toAlg, "q")
            else
                item.fn(fromAlg, toAlg, "q")
            end
            table.insert(methodsUsed, "GC:" .. item.name)
        end)
    end

    -- 3. Two-Phase Screen-Coordinate GUI + Real InputObject Hook
    local boardFrame = GetBoardFrame()
    if boardFrame then
        local fx, fy = ComputeSquareScreenCenter(boardFrame, move.from, mySide)
        local tx, ty = ComputeSquareScreenCenter(boardFrame, move.to, mySide)

        local c1, h1 = FireHooksAtPoint(fx, fy, "SRC:" .. fromAlg)
        task.wait(Config.SelectionHookDelay)
        local c2, h2 = FireHooksAtPoint(tx, ty, "DST:" .. toAlg)

        table.insert(methodsUsed, string.format("GUI(H:%d/%d,C:%d)", h1, h2, c1 + c2))
    else
        Logger:Add("ERR", "GetBoardFrame() returned nil during move dispatch!")
    end

    HookState.LastHookSummary = table.concat(methodsUsed, " + ")
end

