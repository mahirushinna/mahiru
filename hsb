-- ============================================================================
-- 1. HỆ THỐNG BẤM NÚT ĐA TẦNG (CHUẨN CẢ NÚT CẢM ỨNG MOBILE LẪN PHÍM PC)
-- ============================================================================

local ButtonKeywords = {
    Block    = { "chặn đòn", "chan don", "chặn", "block", "parry", "guard" },
    Light    = { "ánh sáng", "anh sang", "tấn công nhẹ", "light", "slash", "m1" },
    Heavy    = { "nặng", "nang", "tấn công mạnh", "heavy", "strong", "m2" },
    Dodge    = { "né", "ne", "dodge", "dash", "lướt" },
    Ultimate = { "siêu cấp", "sieu cap", "sơ cấp", "kỹ năng tối thượng", "ultimate", "ult" },
}

local function matchAny(str, list)
    if type(str) ~= "string" or str == "" then return false end
    local lower = string.lower(str)
    for _, w in ipairs(list) do
        if string.find(lower, w, 1, true) then
            return true
        end
    end
    return false
end

local function findButtonInstance(inst)
    if inst:IsA("GuiButton") then return inst end
    local up = inst:FindFirstAncestorWhichIsA("GuiButton")
    if up then return up end
    if inst.Parent and inst.Parent:IsA("GuiObject") then
        for _, ch in ipairs(inst.Parent:GetChildren()) do
            if ch:IsA("GuiButton") then return ch end
        end
        return inst.Parent
    end
    return nil
end

local function scanTouchButtons()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return end

    for _, desc in ipairs(pg:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("TextButton") then
            local raw = desc.Text or ""
            local loc = ""
            pcall(function() loc = desc.LocalizedText or "" end)

            local btn = findButtonInstance(desc)
            if btn and btn.AbsoluteSize.X > 15 then
                for action, kwList in pairs(ButtonKeywords) do
                    if matchAny(raw, kwList) or matchAny(loc, kwList) or matchAny(btn.Name, kwList) then
                        State.Buttons[action] = btn
                    end
                end
            end
        end
    end
end

local function fireGuiSignal(btn, isDown)
    if not btn or not btn.Parent then return end
    if typeof(firesignal) == "function" and btn:IsA("GuiButton") then
        pcall(function()
            if isDown then
                firesignal(btn.MouseButton1Down, 0, 0)
                firesignal(btn.TouchTap)
                firesignal(btn.MouseButton1Click)
                firesignal(btn.Activated)
            else
                firesignal(btn.MouseButton1Up, 0, 0)
            end
        end)
    end
    if typeof(getconnections) == "function" and btn:IsA("GuiButton") then
        pcall(function()
            local sig = isDown and btn.MouseButton1Down or btn.MouseButton1Up
            for _, c in ipairs(getconnections(sig)) do pcall(function() c:Fire() end) end
            if isDown then
                for _, c in ipairs(getconnections(btn.Activated)) do pcall(function() c:Fire() end) end
                for _, c in ipairs(getconnections(btn.MouseButton1Click)) do pcall(function() c:Fire() end) end
            end
        end)
    end
end

local function getSafeRightClickCoords(action)
    local btn = State.Buttons[action]
    local inset = GuiService:GetGuiInset()
    if btn and btn.Parent and btn.AbsoluteSize.X > 15 then
        return btn.AbsolutePosition.X + (btn.AbsoluteSize.X * 0.5),
               btn.AbsolutePosition.Y + (btn.AbsoluteSize.Y * 0.5) + inset.Y
    end
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(800, 450)
    return vp.X * 0.78, vp.Y * 0.65
end

local function doAction(action, mode)
    if GuiService.MenuIsOpen then return end
    local btn = State.Buttons[action]

    if action == "Block" then
        if mode == "Down" then
            if not State.IsBlocking then
                State.IsBlocking = true
                fireGuiSignal(btn, true)
                pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game) end)
            end
        elseif mode == "Up" then
            if State.IsBlocking then
                State.IsBlocking = false
                fireGuiSignal(btn, false)
                pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end)
            end
        end

    elseif action == "FeintAndBlock" then
        -- Nếu đang vung kiếm dở mà địch chém -> Nhả chuột đánh + Nhấp giữ F ngay lập tức để ngắt đòn chuyển sang Đỡ!
        local cx, cy = getSafeRightClickCoords("Light")
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        end)
        State.IsBlocking = true
        fireGuiSignal(btn, true)
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        end)

    elseif action == "Light" then
        if State.IsBlocking then
            State.IsBlocking = false
            fireGuiSignal(State.Buttons.Block, false)
            pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end)
        end
        fireGuiSignal(btn, true)
        local cx, cy = getSafeRightClickCoords("Light")
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
            task.delay(0.03, function()
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                fireGuiSignal(btn, false)
            end)
        end)

    elseif action == "Heavy" then
        if State.IsBlocking then
            State.IsBlocking = false
            fireGuiSignal(State.Buttons.Block, false)
            pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end)
        end
        fireGuiSignal(btn, true)
        local cx, cy = getSafeRightClickCoords("Heavy")
        pcall(function()
            if btn and btn.Visible then
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
            end
            VirtualInputManager:SendMouseButtonEvent(cx, cy, 1, true, game, 1)
            task.delay(0.04, function()
                if btn and btn.Visible then
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                end
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 1, false, game, 1)
                fireGuiSignal(btn, false)
            end)
        end)

    elseif action == "Dodge" then
        if State.IsBlocking then
            State.IsBlocking = false
            fireGuiSignal(State.Buttons.Block, false)
            pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end)
        end
        fireGuiSignal(btn, true)
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
            task.delay(0.04, function()
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
                fireGuiSignal(btn, false)
            end)
        end)

    elseif action == "Ultimate" then
        if State.IsBlocking then
            State.IsBlocking = false
            fireGuiSignal(State.Buttons.Block, false)
            pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end)
        end
        fireGuiSignal(btn, true)
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
            if btn and btn.Visible then
                local cx, cy = getSafeRightClickCoords("Ultimate")
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                task.delay(0.04, function()
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                end)
            end
            task.delay(0.04, function()
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                fireGuiSignal(btn, false)
            end)
        end)
    end
end

local function isGuiReallyVisible(guiObj)
    local curr = guiObj
    while curr and curr ~= game do
        if curr:IsA("GuiObject") and not curr.Visible then return false end
        if curr:IsA("ScreenGui") and not curr.Enabled then return false end
        curr = curr.Parent
    end
    return true
end

local function isUltimateReady()
    local btn = State.Buttons.Ultimate
    if btn and btn.Parent and isGuiReallyVisible(btn) and btn.AbsoluteSize.X > 18 then
        return true
    end
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pg then
        for _, lbl in ipairs(pg:GetDescendants()) do
            if lbl:IsA("TextLabel") and isGuiReallyVisible(lbl) then
                local raw = string.lower(lbl.Text or "")
                local loc = ""
                pcall(function() loc = string.lower(lbl.LocalizedText or "") end)
                if string.find(raw, "kỹ năng tối thượng", 1, true) or string.find(loc, "kỹ năng tối thượng", 1, true)
                    or string.find(raw, "siêu cấp", 1, true) or string.find(loc, "siêu cấp", 1, true) then
                    return true
                end
            end
        end
    end
    return false
end

