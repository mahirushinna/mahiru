                    -- If UI move list scrolled/missed moves compared to RAM ply, sync directly from RAMBoard!
                    if ramBoard and ramPly > applied then
                        if TrySyncFromRAMBoard(Engine, ramBoard) then
                            Logger.Push("RAM-SYNC", string.format("Synced directly from RAM #3 (ply=%d)", ramPly))
