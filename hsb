local function drawLine2D(lineFrame: Frame, fromPos: Vector2, toPos: Vector2)
	local delta = toPos - fromPos
	local distance = delta.Magnitude
	local midpoint = (fromPos + toPos) * 0.5
	local angle = math.deg(math.atan2(delta.Y, delta.X))

	lineFrame.Position = UDim2.fromOffset(midpoint.X, midpoint.Y)
	lineFrame.Size = UDim2.fromOffset(distance, 1.5)
	lineFrame.Rotation = angle
end

-- ============================================================================
-- 5. CƠ CHẾ AIM KHI NHẤN NÚT BẮN (FIRE BUTTON SNAP AIM)
-- ============================================================================
local function findClosestTargetToCrosshair(): BasePart?
	if not State.Aim_Enabled or State.Aim_TargetPart == "None" then
		return nil
	end

	Camera = Workspace.CurrentCamera
	if not Camera then
		return nil
	end

	local viewportCenter = Camera.ViewportSize * 0.5
	local closestPart: BasePart? = nil
	local shortestDistance = State.Aim_MaxFOV

	for _, player in ipairs(Players:GetPlayers()) do
		if isEnemy(player) and player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			local targetPart = getTargetPart(player.Character, State.Aim_TargetPart)

			if humanoid and humanoid.Health > 0 and targetPart then
				local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
				if onScreen then
					local screenVec = Vector2.new(screenPoint.X, screenPoint.Y)
					local distFromCenter = (screenVec - viewportCenter).Magnitude
					if distFromCenter <= shortestDistance then
						shortestDistance = distFromCenter
						closestPart = targetPart
					end
				end
			end
		end
	end

	return closestPart
end

local function snapAimOnFire()
	if not State.Aim_Enabled or State.Aim_TargetPart == "None" then
		return
	end

	local targetPart = findClosestTargetToCrosshair()
	if targetPart and Camera then
		local camPos = Camera.CFrame.Position
		Camera.CFrame = CFrame.lookAt(camPos, targetPart.Position)
	end
end

-- Tự động nhận diện nút bắn trên giao diện cảm ứng (Mobile Fire Button)
local function bindMobileFireButtons()
	for _, desc in ipairs(PlayerGui:GetDescendants()) do
		if desc:IsA("GuiButton") and not ConnectedFireButtons[desc] and not desc:IsDescendantOf(ScreenGui) then
			local lowerName = string.lower(desc.Name)
			if string.find(lowerName, "fire")
				or string.find(lowerName, "shoot")
				or string.find(lowerName, "attack")
				or string.find(lowerName, "bullet")
			then
				ConnectedFireButtons[desc] = desc.InputBegan:Connect(function(input: InputObject)
					if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
						snapAimOnFire()
					end
				end)
			end
		end
	end
end

bindMobileFireButtons()
PlayerGui.DescendantAdded:Connect(function(desc)
	if desc:IsA("GuiButton") and not desc:IsDescendantOf(ScreenGui) then
		task.defer(bindMobileFireButtons)
	end
end)

-- Hỗ trợ kích hoạt khi nhấn nút bắn trên PC (Chuột trái) hoặc chạm vùng nút bắn bên phải màn hình
UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if not State.Aim_Enabled or State.Aim_TargetPart == "None" then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseButton1 and not gameProcessed then
		snapAimOnFire()
	elseif input.UserInputType == Enum.UserInputType.Touch then
		-- Nếu người chơi chạm vào khu vực nút bắn bên phải màn hình (như bố cục HUD trong video)
		local vp = Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
		local touchPos = Vector2.new(input.Position.X, input.Position.Y)
		if touchPos.X > vp.X * 0.65 and touchPos.Y > vp.Y * 0.45 then
			snapAimOnFire()
		end
	end
end)

