                HookState.NetQueue[#HookState.NetQueue + 1] = {
                    rem = self,
                    method = method,
                    args = { ... }
                }
            end
            return oldNamecall(self, ...)
        end
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure and newcclosure(hookFn) or hookFn)
        Logger.Push("INIT", "Passive __namecall sniffer ready (0% touch interference).")
    end)
end

local function ProcessNetQueue()
    while #HookState.NetQueue > 0 do
        local item = table.remove(HookState.NetQueue, 1)
        pcall(function()
            local remName = tostring(item.rem.Name)
            local args = item.args
            local dumped = {}
            for i = 1, math.min(#args, 4) do
                dumped[#dumped + 1] = SerializeVal(args[i], 0)
            end
            Logger.Push("NET", string.format("%s:%s(%s)", remName, item.method, table.concat(dumped, ", ")))
        end)
    end
end

-- Inspects a function's param count, constants, and upvalues into short log lines
local function InspectAndLogFunction(tag, fn)
    if type(fn) ~= "function" then return end
    local numParams = "?"
    if debug and debug.getinfo then
        local ok, info = pcall(debug.getinfo, fn)
        if ok and info then
            numParams = tostring(info.numparams) .. (info.is_vararg ~= 0 and "+" or "")
        end
    end

    local constsList = {}
    if debug and debug.getconstants then
        local ok, consts = pcall(debug.getconstants, fn)
        if ok and consts then
            for _, c in pairs(consts) do
                if type(c) == "string" and #c > 0 and #c <= 22 then
                    constsList[#constsList + 1] = c
                end
            end
        end
    end

    local upvalsList = {}
    if debug and debug.getupvalues then
        local ok, uvs = pcall(debug.getupvalues, fn)
        if ok and uvs then
            for k, uv in pairs(uvs) do
                if type(uv) == "table" and rawget(uv, "board") and rawget(uv, "kingSq") then
                    HookState.BoundRAMBoard = uv
                    upvalsList[#upvalsList + 1] = "uv" .. tostring(k) .. "=RAMBoard(ply=" .. tostring(uv.ply) .. ")"
                else
                    upvalsList[#upvalsList + 1] = "uv" .. tostring(k) .. ":" .. type(uv)
                end
            end
        end
    end

    Logger.Push(tag, string.format("Params:%s Consts:[%s] UVs:[%s]",
        numParams,
        table.concat(constsList, ","),
        table.concat(upvalsList, ",")
    ))
end

local function ScanRoChessMemoryV6()
    if not getgc then
        Logger.Push("WARN", "Executor does not support getgc()!")
        return
    end

    table.clear(HookState.AllRAMBoards)
    table.clear(HookState.SquareClickFns)
    HookState.BoundRAMBoard = nil

    pcall(function()
        for _, obj in ipairs(getgc(true)) do
            if type(obj) == "table" and not rawget(obj, "_IsOurAIEngine") and obj ~= HookState and obj ~= Logger then
                -- 1. Check for RAMBoard #3 ({board, side, ply, kingSq})
                local brd = rawget(obj, "board")
                local ply = rawget(obj, "ply")
                local kingSq = rawget(obj, "kingSq")
                if type(brd) == "table" and type(ply) == "number" and kingSq ~= nil then
                    table.insert(HookState.AllRAMBoards, obj)
                end

                -- 2. Check for Controller #2 (has both `playMove` and `makeMove` or `inLiveGame`)
                local pm = rawget(obj, "playMove")
                local mm = rawget(obj, "makeMove")
                local ilg = rawget(obj, "inLiveGame")
                if type(pm) == "function" and type(mm) == "function" then
                    HookState.Controller2 = obj
                    HookState.OrigPlayMove = rawget(obj, "_OrigPlayMove") or pm
                    HookState.OrigMakeMove = rawget(obj, "_OrigMakeMove") or mm

                    -- Dump all keys of Controller #2 in short 6-key chunks so nothing is cut off!
                    local chunk = {}
                    local chunkIdx = 1
                    for k, v in pairs(obj) do
                        if tostring(k) ~= "_OrigPlayMove" and tostring(k) ~= "_OrigMakeMove" then
                            chunk[#chunk + 1] = tostring(k) .. ":" .. string.sub(type(v), 1, 3)
                            if #chunk >= 6 then
                                Logger.Push("C2-KEYS#" .. chunkIdx, table.concat(chunk, " | "))
                                table.clear(chunk)
                                chunkIdx += 1
                            end
                        end
                    end
                    if #chunk > 0 then
                        Logger.Push("C2-KEYS#" .. chunkIdx, table.concat(chunk, " | "))
                    end

                    -- Inspect both playMove and makeMove
                    InspectAndLogFunction("PM-INFO", HookState.OrigPlayMove)
                    InspectAndLogFunction("MM-INFO", HookState.OrigMakeMove)

                    -- Also check if any field or upvalue of Controller #2 holds the active RAMBoard
                    for k, v in pairs(obj) do
                        if type(v) == "table" and rawget(v, "board") and rawget(v, "kingSq") then
                            HookState.BoundRAMBoard = v
                            Logger.Push("C2-BRD", "Found RAMBoard in Controller2." .. tostring(k))
                        elseif type(v) == "function" and debug and debug.getupvalues then
                            local okU, uvs = pcall(debug.getupvalues, v)
                            if okU and uvs then
                                for _, uv in pairs(uvs) do
                                    if type(uv) == "table" and rawget(uv, "board") and rawget(uv, "kingSq") then
                                        HookState.BoundRAMBoard = uv
                                    end
                                end
                            end
                        end
                    end

                    -- Install transparent, zero-side-effect spies on playMove and makeMove
                    if not rawget(obj, "_OrigPlayMove") then
                        rawset(obj, "_OrigPlayMove", pm)
                        rawset(obj, "playMove", function(...)
                            local args = { ... }
                            local d = {}
                            for i = 1, #args do d[#d + 1] = SerializeVal(args[i], 0) end
                            Logger.Push("SPY-PM", "playMove(" .. table.concat(d, ", ") .. ")")
                            return pm(...)
                        end)
                    end
                    if not rawget(obj, "_OrigMakeMove") then
                        rawset(obj, "_OrigMakeMove", mm)
                        rawset(obj, "makeMove", function(...)
                            local args = { ... }
                            local d = {}
                            for i = 1, #args do d[#d + 1] = SerializeVal(args[i], 0) end
                            Logger.Push("SPY-MM", "makeMove(" .. table.concat(d, ", ") .. ")")
                            return mm(...)
                        end)
                    end
                end

            elseif type(obj) == "function" and islclosure and islclosure(obj) and (not isexecutorclosure or not isexecutorclosure(obj)) then
                if debug and debug.getconstants then
                    local okC, consts = pcall(debug.getconstants, obj)
                    if okC and consts then
                        local hasSelectedSq = false
                        local cList = {}
                        for _, c in pairs(consts) do
                            if type(c) == "string" then
                                if c == "selectedSq" then hasSelectedSq = true end
                                if #c > 0 and #c <= 20 then cList[#cList + 1] = c end
                            end
                        end
                        if hasSelectedSq then
                            table.insert(HookState.SquareClickFns, obj)
                            Logger.Push("SQ-FN", "Fn with 'selectedSq'! Consts:[" .. table.concat(cList, ",") .. "]")
                        end
                    end
                end
            end
        end
    end)

    Logger.Push("SCAN", string.format("C2:%s | BoundRAM:%s | AllRAM:%d | SqFns:%d",
        HookState.Controller2 and "OK" or "nil",
        HookState.BoundRAMBoard and ("ply=" .. tostring(HookState.BoundRAMBoard.ply)) or "nil",
        #HookState.AllRAMBoards,
        #HookState.SquareClickFns
    ))
end

