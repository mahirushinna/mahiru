-- Kiểm tra màu xanh nước biển / xanh dương (Cyan / Sky Blue) của thẻ tên đồng đội trên đầu
local function isTeammateCyanBlue(color: Color3): boolean
	local h, s, v = color:ToHSV()
	if h >= 0.47 and h <= 0.67 and s >= 0.40 and v >= 0.50 then
		return true
	end
	if color.B >= 0.60 and color.G >= 0.45 and color.R <= 0.38 then
		return true
	end
	return false
end

-- Kiểm tra màu đỏ của viền kẻ địch (Red Highlight)
local function isEnemyRedColor(color: Color3): boolean
	return color.R >= 0.65 and color.G <= 0.35 and color.B <= 0.35
end

-- Kiểm tra xem game có thực sự chia thành nhiều Team khác nhau hay không
local function hasDistinctTeams(): boolean
	local teamList = Teams:GetTeams()
	if #teamList < 2 then
		return false
	end
	local firstTeam: Team? = nil
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Team ~= nil then
			if firstTeam == nil then
				firstTeam = p.Team
			elseif p.Team ~= firstTeam then
				return true
			end
		end
	end
	return false
end

-- Kiểm tra một BillboardGui hoặc Highlight gắn trực tiếp vào Character của mục tiêu
local function check3DCharacterIndicators(character: Model): (boolean, boolean)
	local hasEnemyRed = false
	local hasTeammateCyan = false

	-- 1. Quét các thành phần 3D nằm trực tiếp bên trong Character
	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("Highlight") and desc.Enabled then
			if isEnemyRedColor(desc.OutlineColor) or isEnemyRedColor(desc.FillColor) then
				hasEnemyRed = true
			elseif isTeammateCyanBlue(desc.OutlineColor) or isTeammateCyanBlue(desc.FillColor) then
				hasTeammateCyan = true
			end
		elseif desc:IsA("BillboardGui") and desc.Enabled then
			for _, sub in ipairs(desc:GetDescendants()) do
				if (sub:IsA("TextLabel") or sub:IsA("TextBox")) and sub.Visible then
					if isTeammateCyanBlue(sub.TextColor3) or isTeammateCyanBlue(sub.TextStrokeColor3) then
						hasTeammateCyan = true
					elseif isEnemyRedColor(sub.TextColor3) then
						hasEnemyRed = true
					end
				elseif sub:IsA("ImageLabel") and sub.Visible then
					if isTeammateCyanBlue(sub.ImageColor3) then
						hasTeammateCyan = true
					end
				end
			end
		end
	end

	-- 2. Quét các BillboardGui/Highlight đặt trong PlayerGui nhưng có Adornee gắn vào Character này
	if not hasEnemyRed and not hasTeammateCyan then
		for _, guiObj in ipairs(PlayerGui:GetDescendants()) do
			if guiObj:IsA("BillboardGui") and guiObj.Enabled and guiObj.Adornee then
				if guiObj.Adornee == character or guiObj.Adornee:IsDescendantOf(character) then
					for _, sub in ipairs(guiObj:GetDescendants()) do
						if (sub:IsA("TextLabel") or sub:IsA("TextBox")) and sub.Visible then
							if isTeammateCyanBlue(sub.TextColor3) or isTeammateCyanBlue(sub.TextStrokeColor3) then
								hasTeammateCyan = true
								break
							end
						end
					end
				end
			elseif guiObj:IsA("Highlight") and guiObj.Enabled and guiObj.Adornee then
				if guiObj.Adornee == character or guiObj.Adornee:IsDescendantOf(character) then
					if isEnemyRedColor(guiObj.OutlineColor) or isEnemyRedColor(guiObj.FillColor) then
						hasEnemyRed = true
					elseif isTeammateCyanBlue(guiObj.OutlineColor) or isTeammateCyanBlue(guiObj.FillColor) then
						hasTeammateCyan = true
					end
				end
			end
		end
	end

	return hasEnemyRed, hasTeammateCyan
end

local function isEnemy(player: Player): boolean
	if player == LocalPlayer then
		return false
	end

	local character = player.Character
	if not character then
		return false
	end

	-- Kiểm tra chỉ báo 3D trực tiếp trên nhân vật (Viền đỏ = Địch, Chữ xanh trên đầu = Đồng đội)
	local hasEnemyRed, hasTeammateCyan = check3DCharacterIndicators(character)
	if hasEnemyRed then
		return true
	end
	if hasTeammateCyan then
		return false
	end

	-- Kiểm tra Team chuẩn của Roblox (chỉ áp dụng khi các người chơi thực sự ở các Team khác nhau)
	if LocalPlayer.Team ~= nil and player.Team ~= nil and hasDistinctTeams() then
		if player.Team == LocalPlayer.Team then
			return false
		end
	end

	-- Kiểm tra Attribute Team nếu có
	local myTeamAttr = LocalPlayer:GetAttribute("Team") or LocalPlayer:GetAttribute("TeamId")
	local theirTeamAttr = player:GetAttribute("Team") or player:GetAttribute("TeamId")
	if myTeamAttr ~= nil and theirTeamAttr ~= nil and myTeamAttr == theirTeamAttr then
		return false
	end

	return true
end

-- Lấy đầy đủ các bộ phận của nhân vật với cơ chế dự phòng (tránh bỏ sót người khi rig khác nhau)
local function getCharacterParts(character: Model): (BasePart?, BasePart?, BasePart?, Humanoid?)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = (
		character:FindFirstChild("HumanoidRootPart")
		or character.PrimaryPart
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
		or character:FindFirstChildWhichIsA("BasePart")
	) :: BasePart?

	local headPart = (
		character:FindFirstChild("Head")
		or character:FindFirstChild("FakeHead")
		or rootPart
	) :: BasePart?

	local torsoPart = (
		character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("LowerTorso")
		or rootPart
	) :: BasePart?

	return rootPart, headPart, torsoPart, humanoid
end

local function isCharacterAlive(character: Model, humanoid: Humanoid?, rootPart: BasePart?): boolean
	if not rootPart or not character.Parent then
		return false
	end
	if humanoid then
		if humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead then
			return false
		end
		return true
	end
	local hpAttr = character:GetAttribute("Health") or character:GetAttribute("HP")
	if type(hpAttr) == "number" then
		return hpAttr > 0
	end
	return true
end

local function getAimPartFromCharacter(character: Model, mode: string): BasePart?
	local rootPart, headPart, torsoPart = getCharacterParts(character)
	if mode == "Head" then
		return headPart or rootPart
	elseif mode == "Torso" then
		return torsoPart or rootPart
	end
	return nil
end

