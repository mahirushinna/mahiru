-- Main Match Synchronization & Auto-Play Loop
local LastMoveCount = -1
local IsThinking = false

task.spawn(function()
    while task.wait(0.2) do
        if Config.AutoPlay and not IsThinking then
            local sanList = ScrapeMoveListFromUI()
            local mySide = DetectPlayerColor()

            -- New match detected
            if #sanList == 0 and LastMoveCount ~= 0 then
                Engine:Reset()
                OpponentProfile:Reset()
                LastMoveCount = 0
            end

            -- Sync internal board with scraped SAN move history from the beginning of the match
            if #sanList ~= LastMoveCount then
                Engine:Reset()
                local syncOk = true
                for idx, san in ipairs(sanList) do
                    local sideToMove = (idx % 2 == 1) and 1 or -1
                    local evalBefore = Engine:Evaluate(1.0)
                    local parsedMove = Engine:ParseSANMove(san, sideToMove)
                    if parsedMove then
                        Engine:MakeMove(parsedMove)
                        table.insert(Engine.MoveHistoryUCI, parsedMove.uci)
                        if sideToMove ~= mySide then
                            local evalAfter = -Engine:Evaluate(1.0)
                            local isAggro = (parsedMove.captured ~= 0) or Engine:IsInCheck(mySide)
                            OpponentProfile:RecordMove(evalBefore - evalAfter, isAggro)
                        end
                    else
                        syncOk = false
                        break
                    end
                end

                if syncOk then
                    LastMoveCount = #sanList
                end
            end

            -- Check if it is our turn to move
            if Engine.Turn == mySide then
                IsThinking = true
                local bestMove, score, metaInfo = Engine:SelectBestMove(mySide)
                if bestMove then
                    StatusLabel.Text = string.format(
                        "Turn: %s | Nodes: %d\nOpponent: %s\nMove: %s (Eval: %+d) [%s]",
                        (mySide == 1) and "WHITE" or "BLACK",
                        Engine.NodesSearched,
                        OpponentProfile.Archetype,
                        bestMove.uci,
                        score,
                        metaInfo
                    )
                    task.wait(Config.MoveDelayMin + math.random() * (Config.MoveDelayMax - Config.MoveDelayMin))
                    ExecuteMoveOnBoard(bestMove, mySide)
                end
                IsThinking = false
            end
        end
    end
end)
