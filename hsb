local ActiveFireTouches = {}
local IsFiringMobile = false

-- Kiểm tra tọa độ chạm có nằm vào nút bắn bên phải hoặc nút bắn bên trái như trong video hay không
local function isTouchOnFireButton(pos)
    if not Camera then return false end
    local vp = Camera.ViewportSize

    -- Bỏ qua nếu đang chạm vào Menu hoặc Nút Nổi đang hiển thị
    if Config.Menu_Visible then
        local mPos = MainFrame.AbsolutePosition
        local mSize = MainFrame.AbsoluteSize
        if pos.X >= mPos.X and pos.X <= mPos.X + mSize.X and pos.Y >= mPos.Y and pos.Y <= mPos.Y + mSize.Y then
            return false
        end
    end
    local fPos = FloatingBtn.AbsolutePosition
    local fSize = FloatingBtn.AbsoluteSize
    if pos.X >= fPos.X and pos.X <= fPos.X + fSize.X and pos.Y >= fPos.Y and pos.Y <= fPos.Y + fSize.Y then
        return false
    end

    -- 1. Vùng nút bắn chính bên phải màn hình (như bố cục nút hình viên đạn bên phải trong video)
    if pos.X >= vp.X * 0.68 and pos.Y >= vp.Y * 0.45 then
        return true
    end

    -- 2. Vùng nút bắn phụ bên trái màn hình (nút hình viên đạn phía trên cần di chuyển trái trong video)
    if pos.X >= vp.X * 0.14 and pos.X <= vp.X * 0.30 and pos.Y >= vp.Y * 0.55 and pos.Y <= vp.Y * 0.85 then
        return true
    end

    return false
end

UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        if isTouchOnFireButton(input.Position) then
            ActiveFireTouches[input] = true
            IsFiringMobile = true
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if ActiveFireTouches[input] then
        ActiveFireTouches[input] = nil
        IsFiringMobile = (next(ActiveFireTouches) ~= nil)
    end
end)

local function isShootingNow()
    if IsFiringMobile then
        return true
    end
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        return true
    end
    return false
end

