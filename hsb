    end)

    return holder
end

local function CreateSlider(parentFrame, titlePrefix, suffix, posY, minVal, maxVal, defaultVal, callback)
    local group = Instance.new("Frame")
    group.Size = UDim2.new(1, 0, 0, 42)
    group.Position = UDim2.new(0, 0, 0, posY)
    group.BackgroundTransparency = 1
    group.ZIndex = 8
    group.Parent = parentFrame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 18)
    title.Position = UDim2.new(0, 0, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = string.format("%s: %d%s", titlePrefix, defaultVal, suffix)
    title.TextColor3 = Color3.fromRGB(220, 224, 232)
    title.Font = Enum.Font.GothamSemibold
    title.TextSize = 12
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.ZIndex = 9
    title.Parent = group

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -10, 0, 10)
    track.Position = UDim2.new(0, 0, 0, 22)
    track.BackgroundColor3 = Color3.fromRGB(42, 45, 52)
    track.BorderSizePixel = 0
    track.ZIndex = 9
    track.Parent = group

    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = track

    local initRel = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(initRel, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(48, 112, 205)
    fill.BorderSizePixel = 0
    fill.ZIndex = 10
    fill.Parent = track

    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(1, 0)
    fillCorner.Parent = fill

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new(1, -8, 0.5, -8)
    knob.BackgroundColor3 = Color3.fromRGB(240, 245, 255)
    knob.BorderSizePixel = 0
    knob.ZIndex = 11
    knob.Parent = fill

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    local dragging = false
    local function UpdateFromInput(input)
        local absPos = track.AbsolutePosition.X
        local absSize = math.max(track.AbsoluteSize.X, 1)
        local rel = math.clamp((input.Position.X - absPos) / absSize, 0, 1)
        local value = math.floor(minVal + rel * (maxVal - minVal) + 0.5)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        title.Text = string.format("%s: %d%s", titlePrefix, value, suffix)
        callback(value)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateFromInput(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateFromInput(input)
        end
    end)

    return group
end

