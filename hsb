local Config = {
    Mode1v1 = true,              -- Bật mặc định Chế độ 1v1
    Mode2v2 = false,             -- Chế độ 2v2 (tự lọc đồng đội)
    ParryRange = 14.5,           -- Khoảng cách bắt đầu giơ kiếm đỡ / lướt né (studs)
    StrikeRange = 6.0,           -- Chỉ vung kiếm khi đã áp sát trong 6.0m (chống chém bừa vào không khí)
    StopWalkRange = 4.8,         -- Cự ly áp sát đối thủ
}

local State = {
    Target = nil,
    TargetDist = 999,
    LastEnemyHealth = nil,
    EnemyLastDamagedTime = 0,

    IsBlocking = false,
    ActiveEnemyTrack = nil,      -- Theo dõi trực tiếp nhát kiếm đang vung của địch
    BlockStartTime = 0,
    MaxBlockHoldTime = 0,
    PendingCounter = false,      -- Cờ báo: vừa đỡ đòn xong -> lập tức chém trả ngay!
    CounterWindowUntil = 0,

    LastParryTime = 0,
    LastDodgeTime = 0,
