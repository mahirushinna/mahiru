	local sliding = false

	local function updateSliderFromX(screenX: number)
		local trackPos = SliderTrack.AbsolutePosition.X
		local trackWidth = math.max(SliderTrack.AbsoluteSize.X, 1)
		local ratio = math.clamp((screenX - trackPos) / trackWidth, 0, 1)
		local deg = math.floor(40 + ratio * (360 - 40) + 0.5)

		State.Aim_Degree = deg
		SliderFill.Size = UDim2.fromScale(ratio, 1)
		SliderKnob.Position = UDim2.fromScale(ratio, 0.5)
		SliderTitle.Text = string.format("Vùng Aim: %d°", deg)
	end

	SliderFrame.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			updateSliderFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input: InputObject)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateSliderFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)
end

-- ============================================================================
-- 4. NHẬN DIỆN CHÍNH XÁC NÚT BẮN (CHỈ KHI NHẤN NÚT BẮN MỚI BẮT TÂM)
-- ============================================================================
-- Kiểm tra xem tọa độ điểm BẮT ĐẦU CHẠM (TouchStarted) có nằm đúng trong Nút Bắn hay không
local function isPointInsideFireButton(screenPoint: Vector2): boolean
	-- Không kích hoạt nếu người chơi đang bấm vào Menu hoặc Nút nổi của chính script
	if State.MenuOpen then
		local mPos = MainMenu.AbsolutePosition
		local mSize = MainMenu.AbsoluteSize
		if screenPoint.X >= mPos.X and screenPoint.X <= mPos.X + mSize.X
			and screenPoint.Y >= mPos.Y and screenPoint.Y <= mPos.Y + mSize.Y then
			return false
		end
	end

	local fPos = FloatingBtn.AbsolutePosition
	local fSize = FloatingBtn.AbsoluteSize
	if screenPoint.X >= fPos.X and screenPoint.X <= fPos.X + fSize.X
		and screenPoint.Y >= fPos.Y and screenPoint.Y <= fPos.Y + fSize.Y then
		return false
	end

	Camera = Workspace.CurrentCamera
	local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)

	-- 1. Kiểm tra các GuiButton / ImageButton thực tế trong PlayerGui có tên hoặc vị trí là Nút Bắn
	for _, desc in ipairs(PlayerGui:GetDescendants()) do
		if (desc:IsA("GuiButton") or (desc:IsA("GuiObject") and desc.Active))
			and desc.Visible
			and not desc:IsDescendantOf(ScreenGui)
		then
			local size = desc.AbsoluteSize
			if size.X >= 34 and size.X <= 165 and size.Y >= 34 and size.Y <= 165 then
				local pos = desc.AbsolutePosition
				local center = pos + size * 0.5
				local normX = center.X / math.max(vp.X, 1)
				local normY = center.Y / math.max(vp.Y, 1)

				local lowerName = string.lower(desc.Name)
				local isFireNamed = (string.find(lowerName, "fire", 1, true) ~= nil)
					or (string.find(lowerName, "shoot", 1, true) ~= nil)

				-- Vị trí nút bắn phải (X ~ 83.2%, Y ~ 62.5%) và nút bắn trái (X ~ 4.5%, Y ~ 50.5%) trong video
				local isRightFireSlot = (math.abs(normX - 0.832) <= 0.055 and math.abs(normY - 0.625) <= 0.075)
				local isLeftFireSlot = (math.abs(normX - 0.045) <= 0.040 and math.abs(normY - 0.505) <= 0.065)

				if isFireNamed or isRightFireSlot or isLeftFireSlot then
					local radius = math.max(size.X, size.Y) * 0.52
					if (screenPoint - center).Magnitude <= radius then
						return true
					end
				end
			end
		end
	end

	-- 2. Kiểm tra tọa độ hình tròn chuẩn của Nút Bắn Phải và Nút Bắn Trái trên HUD Mobile
	local rightFireCenter = Vector2.new(vp.X * 0.832, vp.Y * 0.625)
	local leftFireCenter = Vector2.new(vp.X * 0.045, vp.Y * 0.505)
	local rightRadius = math.min(vp.X, vp.Y) * 0.068
	local leftRadius = math.min(vp.X, vp.Y) * 0.052

	if (screenPoint - rightFireCenter).Magnitude <= rightRadius then
		return true
	end
	if (screenPoint - leftFireCenter).Magnitude <= leftRadius then
		return true
	end

	return false
end

-- Trên thiết bị cảm ứng: CHỈ ghi nhận khi ngón tay BẮT ĐẦU CHẠM (TouchStarted) ngay trong Nút Bắn.
-- Nếu người chơi chạm ngoài nút bắn để xoay camera rồi lướt ngón tay ngang qua nút bắn, hệ thống sẽ BỎ QUA.
UserInputService.TouchStarted:Connect(function(touchInput: InputObject, _gameProcessed: boolean)
	local startPos = Vector2.new(touchInput.Position.X, touchInput.Position.Y)
	if isPointInsideFireButton(startPos) then
		ActiveFireTouches[touchInput] = true
	end
end)

UserInputService.TouchEnded:Connect(function(touchInput: InputObject, _gameProcessed: boolean)
	ActiveFireTouches[touchInput] = nil
end)

-- Trên PC (Không phải màn hình cảm ứng): chỉ nhận Chuột Trái khi không bấm vào Menu
UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if not UserInputService.TouchEnabled then
		if input.UserInputType == Enum.UserInputType.MouseButton1 and not gameProcessed and not State.MenuOpen then
			MouseFireHeld = true
		end
	end
end)

UserInputService.InputEnded:Connect(function(input: InputObject)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		MouseFireHeld = false
	elseif input.UserInputType == Enum.UserInputType.Touch then
		ActiveFireTouches[input] = nil
	end
end)

-- Kiểm tra và dọn dẹp trạng thái nút bắn mỗi khung hình (đảm bảo nhả tay là ngừng Aim ngay lập tức)
local function isActivelyFiring(): boolean
	-- Kiểm tra nhân vật của người chơi còn sống không
	local myChar = LocalPlayer.Character
	local _, _, _, myHum = if myChar then getCharacterParts(myChar) else nil, nil, nil, nil
	if not myChar or (myHum and myHum.Health <= 0) then
		table.clear(ActiveFireTouches)
		MouseFireHeld = false
		return false
	end

	-- Xác thực từng ngón tay đang giữ nút bắn; xóa ngay nếu ngón tay đã nhấc lên
	local hasActiveTouch = false
	for touchInput in pairs(ActiveFireTouches) do
		local st = touchInput.UserInputState
		if st == Enum.UserInputState.End or st == Enum.UserInputState.Cancel then
			ActiveFireTouches[touchInput] = nil
		else
			hasActiveTouch = true
		end
	end

	if hasActiveTouch then
		return true
	end

	if not UserInputService.TouchEnabled and MouseFireHeld then
		if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
			return true
		else
			MouseFireHeld = false
		end
	end

	return false
end

-- ============================================================================
-- 5. TÌM MỤC TIÊU TRONG VÒNG AIM & VẼ ĐƯỜNG THẲNG 2D
-- ============================================================================
local function drawLine2D(lineFrame: Frame, fromPos: Vector2, toPos: Vector2)
	local delta = toPos - fromPos
	local distance = delta.Magnitude
	local midpoint = (fromPos + toPos) * 0.5
	local angle = math.deg(math.atan2(delta.Y, delta.X))

	lineFrame.Position = UDim2.fromOffset(midpoint.X, midpoint.Y)
	lineFrame.Size = UDim2.fromOffset(distance, 1.6)
	lineFrame.Rotation = angle
end

local function findClosestEnemyInFOVCircle(): (BasePart?, Vector2?)
	local partMode = State.Aim_TargetPart
	if partMode == "None" then
		partMode = "Head"
	end

	Camera = Workspace.CurrentCamera
	if not Camera then
		return nil, nil
	end

	local viewportCenter = Camera.ViewportSize * 0.5
	local maxRadius = getFOVRadiusPixels()
	local closestPart: BasePart? = nil
	local closestScreenPos: Vector2? = nil
	local shortestDist = maxRadius

	for _, player in ipairs(Players:GetPlayers()) do
		if isEnemy(player) and player.Character then
			local rootPart, _, _, humanoid = getCharacterParts(player.Character)
			local targetPart = getAimPartFromCharacter(player.Character, partMode)

			if isCharacterAlive(player.Character, humanoid, rootPart) and targetPart then
				local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
				if onScreen and screenPoint.Z > 0 then
					local screenVec = Vector2.new(screenPoint.X, screenPoint.Y)
					local distFromCenter = (screenVec - viewportCenter).Magnitude
					if distFromCenter <= shortestDist then
						shortestDist = distFromCenter
						closestPart = targetPart
						closestScreenPos = screenVec
					end
				end
			end
		end
	end

	return closestPart, closestScreenPos
end

