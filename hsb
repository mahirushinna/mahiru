-- 7. VÒNG LẶP CHÍNH: THEO DÕI SESSION, VẼ MŨI TÊN & TỰ ĐÁNH THẮNG
local LastSession = nil
local LastEvaluatedPly = -1
local PrevScore = 0

task.spawn(function()
    while Running and task.wait(0.18) do
        local session = App.session
        if not session or session.over or session.kind == "idle" then
            TopLabel.Text = "⚡ RoChess AI v4.0 [VORTEX + SF16]\nĐang đợi bắt đầu ván đấu..."
        else
            if session ~= LastSession then
                LastSession = session
                LastEvaluatedPly = -1
                PrevScore = 0
            end

            local ucis = session.ucis or {}
            local plyCount = #ucis
            local myColorName = (session.myColor == 1) and "TRẮNG" or "ĐEN"
            local okTurn, isMyTurn = pcall(function() return session:isMyTurn() end)

            if okTurn and isMyTurn then
                local bestMove, score, mate, srcName = ComputeBestMove(session)

                if bestMove and Running and App.session == session and #(session.ucis or {}) == plyCount then
                    DrawBoardArrow(bestMove)

                    local scoreStr = mate and ("Mate #" .. tostring(mate)) or string.format("%+.2f", score)
                    TopLabel.Text = string.format(
                        "Quân: %s | %s (%s)\nNước đi: %s -> %s",
                        myColorName, srcName, scoreStr,
                        string.sub(bestMove, 1, 2), string.sub(bestMove, 3, 4)
                    )

                    if plyCount > 0 and LastEvaluatedPly ~= plyCount then
                        LastEvaluatedPly = plyCount
                        local oppLast = ucis[plyCount] or "?"
                        local diff = math.abs(score - PrevScore)

                        if mate then
                            SubLabel.Text = string.format("🔥 Đối thủ đi %s -> Đã khóa chuỗi CHIẾU HẾT bằng %s!", oppLast, bestMove)
                            SubLabel.TextColor3 = Color3.fromRGB(85, 255, 135)
                        elseif diff >= 1.8 then
                            SubLabel.Text = string.format("🔥 BLUNDER từ đối thủ (%s)! Trừng phạt bằng %s", oppLast, bestMove)
                            SubLabel.TextColor3 = Color3.fromRGB(85, 255, 135)
                        elseif diff >= 0.75 then
                            SubLabel.Text = string.format("⚠️ Đối thủ đi yếu (%s) -> Khai thác bằng %s", oppLast, bestMove)
                            SubLabel.TextColor3 = Color3.fromRGB(255, 215, 85)
                        else
                            SubLabel.Text = string.format("Đối thủ đi %s -> Phản đòn tối ưu: %s", oppLast, bestMove)
                            SubLabel.TextColor3 = Color3.fromRGB(175, 225, 255)
                        end
                        PrevScore = score
                    end

                    if CFG.AutoPlay then
                        local waitSec = CFG.MoveDelayMin + math.random() * (CFG.MoveDelayMax - CFG.MoveDelayMin)
                        task.wait(waitSec)
                        if Running and App.session == session and #(session.ucis or {}) == plyCount then
                            ExecuteMoveNative(session, bestMove)
                        end
                    end
                end
            else
                TopLabel.Text = string.format(
                    "Quân: %s | Đang đợi đối thủ đi...\nSố nước đã đi: %d",
                    myColorName, plyCount
                )
            end
        end
    end
end)
