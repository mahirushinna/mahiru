-- 6. KHỞI TẠO CÁC PHẦN TỬ VẼ ESP 2D CHO TỪNG NGƯỜI CHƠI
-- ============================================================================
local function createESPVisuals(player: Player): ESPVisuals
	local container = Instance.new("Frame")
	container.Name = player.Name .. "_ESP"
	container.BackgroundTransparency = 1
	container.Size = UDim2.fromScale(1, 1)
	container.Visible = false
	container.Parent = OverlayFolder

	local boxOutline = Instance.new("Frame")
	boxOutline.BackgroundTransparency = 1
	boxOutline.Visible = false
	boxOutline.Parent = container

	local boxStroke = Instance.new("UIStroke")
	boxStroke.Color = Color3.fromRGB(255, 55, 55)
	boxStroke.Thickness = 1.5
	boxStroke.Parent = boxOutline

	local healthBarBg = Instance.new("Frame")
	healthBarBg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	healthBarBg.BorderSizePixel = 0
	healthBarBg.Visible = false
	healthBarBg.Parent = container

	local healthBarFill = Instance.new("Frame")
	healthBarFill.AnchorPoint = Vector2.new(0, 1)
	healthBarFill.Position = UDim2.fromScale(0, 1)
	healthBarFill.Size = UDim2.fromScale(1, 1)
	healthBarFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
	healthBarFill.BorderSizePixel = 0
	healthBarFill.Parent = healthBarBg

	local infoLabel = Instance.new("TextLabel")
	infoLabel.Name = "TacticalInfoLabel"
	infoLabel.AnchorPoint = Vector2.new(0.5, 1)
	infoLabel.Size = UDim2.fromOffset(200, 18)
	infoLabel.BackgroundTransparency = 1
	infoLabel.Font = Enum.Font.GothamBold
	infoLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	infoLabel.TextStrokeTransparency = 0.2
	infoLabel.TextSize = 12
	infoLabel.Visible = false
	infoLabel.Parent = container

	local tracerLine = Instance.new("Frame")
	tracerLine.AnchorPoint = Vector2.new(0.5, 0.5)
	tracerLine.BackgroundColor3 = Color3.fromRGB(255, 75, 75)
	tracerLine.BorderSizePixel = 0
	tracerLine.Visible = false
	tracerLine.Parent = container

	local visuals: ESPVisuals = {
		Container = container,
		BoxOutline = boxOutline,
		BoxStroke = boxStroke,
		HealthBarBg = healthBarBg,
		HealthBarFill = healthBarFill,
		InfoLabel = infoLabel,
		TracerLine = tracerLine,
	}

	ESPCache[player] = visuals
	return visuals
end

Players.PlayerRemoving:Connect(function(player: Player)
	local visuals = ESPCache[player]
	if visuals then
		visuals.Container:Destroy()
		ESPCache[player] = nil
	end
end)

-- ============================================================================
-- 7. VÒNG LẶP AIM KHI BẮN & VÒNG LẶP VẼ ESP 2D
-- ============================================================================
RunService:BindToRenderStep("TacticalStickyAimV3", Enum.RenderPriority.Camera.Value + 1, function()
	Camera = Workspace.CurrentCamera
	if not Camera then
		return
	end

	local targetPart, targetScreenPos = findClosestEnemyInFOVCircle()
	CurrentLockedTargetPart = targetPart

	-- Vẽ Vòng tròn Aim & Đường kẻ ESP Aim từ tâm ngắm
	local viewportCenter = Camera.ViewportSize * 0.5
	local radiusPx = getFOVRadiusPixels()

	if State.Aim_ESPEnabled then
		FOVCircle.Position = UDim2.fromOffset(viewportCenter.X, viewportCenter.Y)
		FOVCircle.Size = UDim2.fromOffset(radiusPx * 2, radiusPx * 2)
		FOVCircle.Visible = true

		if targetPart and targetScreenPos then
			drawLine2D(AimTargetLine, viewportCenter, targetScreenPos)
			AimTargetLine.Visible = true
		else
			AimTargetLine.Visible = false
		end
	else
		FOVCircle.Visible = false
		AimTargetLine.Visible = false
	end

	-- CHỈ BẮT TÂM KHI NGƯỜI CHƠI ĐANG BẤM NÚT BẮN
	if State.Aim_Enabled and State.Aim_TargetPart ~= "None" and isActivelyFiring() then
		if CurrentLockedTargetPart and CurrentLockedTargetPart.Parent then
			local camPos = Camera.CFrame.Position
			Camera.CFrame = CFrame.lookAt(camPos, CurrentLockedTargetPart.Position)
		end
	end
end)

RunService.RenderStepped:Connect(function()
	Camera = Workspace.CurrentCamera
	if not Camera then
		return
	end

	local anyESPEnabled = State.ESP_Box2D
		or State.ESP_Health
		or State.ESP_Distance
		or State.ESP_Name
		or State.ESP_Tracer

	local trackedCount = 0
	local myRoot = if LocalPlayer.Character then getCharacterParts(LocalPlayer.Character) else nil

	local counterOrigin = Vector2.new(
		CounterBadge.AbsolutePosition.X + CounterBadge.AbsoluteSize.X * 0.5,
		CounterBadge.AbsolutePosition.Y + CounterBadge.AbsoluteSize.Y
	)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local visuals = ESPCache[player] or createESPVisuals(player)
			local character = player.Character

			if anyESPEnabled and character and isEnemy(player) then
				local rootPart, headPart, _, humanoid = getCharacterParts(character)

				if rootPart and headPart and isCharacterAlive(character, humanoid, rootPart) then
					local rootScreen, onScreen = Camera:WorldToViewportPoint(rootPart.Position)

					if onScreen and rootScreen.Z > 0 then
						trackedCount += 1
						visuals.Container.Visible = true

						local topWorld = headPart.Position + Vector3.new(0, 1.2, 0)
						local bottomWorld = rootPart.Position - Vector3.new(0, 3.0, 0)
						local topScreen = Camera:WorldToViewportPoint(topWorld)
						local bottomScreen = Camera:WorldToViewportPoint(bottomWorld)

						local boxHeight = math.clamp(math.abs(bottomScreen.Y - topScreen.Y), 16, 1200)
						local boxWidth = boxHeight * 0.62
						local boxPosX = rootScreen.X - boxWidth * 0.5
						local boxPosY = topScreen.Y

						if State.ESP_Box2D then
							visuals.BoxOutline.Position = UDim2.fromOffset(boxPosX, boxPosY)
							visuals.BoxOutline.Size = UDim2.fromOffset(boxWidth, boxHeight)
							visuals.BoxOutline.Visible = true
						else
							visuals.BoxOutline.Visible = false
						end

						local curHp = if humanoid then humanoid.Health else 100
						local maxHp = if humanoid and humanoid.MaxHealth > 0 then humanoid.MaxHealth else 100
						local hpRatio = math.clamp(curHp / maxHp, 0, 1)

						if State.ESP_Health then
							visuals.HealthBarBg.Position = UDim2.fromOffset(boxPosX - 6, boxPosY)
							visuals.HealthBarBg.Size = UDim2.fromOffset(3, boxHeight)
							visuals.HealthBarFill.Size = UDim2.fromScale(1, hpRatio)
							visuals.HealthBarFill.BackgroundColor3 = Color3.fromHSV(hpRatio * 0.33, 0.9, 1)
							visuals.HealthBarBg.Visible = true
						else
							visuals.HealthBarBg.Visible = false
						end

						local infoParts = {}
						if State.ESP_Name then
							table.insert(infoParts, player.DisplayName)
						end
						if State.ESP_Health then
							table.insert(infoParts, string.format("%d HP", math.floor(curHp)))
						end
						if State.ESP_Distance then
							local dist = myRoot and (myRoot.Position - rootPart.Position).Magnitude or rootScreen.Z
							table.insert(infoParts, string.format("[%dm]", math.floor(dist)))
						end

						if #infoParts > 0 then
							visuals.InfoLabel.Text = table.concat(infoParts, " | ")
							visuals.InfoLabel.Position = UDim2.fromOffset(rootScreen.X, boxPosY - 4)
							visuals.InfoLabel.Visible = true
						else
							visuals.InfoLabel.Visible = false
						end

						if State.ESP_Tracer then
							local targetPoint = Vector2.new(rootScreen.X, boxPosY)
							drawLine2D(visuals.TracerLine, counterOrigin, targetPoint)
							visuals.TracerLine.Visible = true
						else
							visuals.TracerLine.Visible = false
						end
					else
						visuals.Container.Visible = false
					end
				else
					visuals.Container.Visible = false
				end
			else
				visuals.Container.Visible = false
			end
		end
	end

	if anyESPEnabled then
		CounterBadge.Visible = true
		CounterLabel.Text = tostring(trackedCount)
	else
		CounterBadge.Visible = false
	end
end)
