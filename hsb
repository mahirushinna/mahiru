local OurScreenGui = nil

local function GetBoardFrame()
    local candidates = {}
    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if desc:IsA("GuiObject") and desc.Visible and (not OurScreenGui or not desc:IsDescendantOf(OurScreenGui)) then
            local sz = desc.AbsoluteSize
            if sz.X >= 220 and sz.Y >= 220 and math.abs(sz.X - sz.Y) <= 18 then
                local n = string.lower(desc.Name)
                if not string.find(n, "modal") and not string.find(n, "overlay") and not string.find(n, "toast") then
                    local childCount = #desc:GetDescendants()
                    if childCount >= 16 then
                        table.insert(candidates, { frame = desc, children = childCount, area = sz.X * sz.Y })
                    end
                end
            end
        end
    end

    table.sort(candidates, function(a, b)
        if a.children ~= b.children then return a.children > b.children end
        return a.area > b.area
    end)

    return candidates[1] and candidates[1].frame or nil
end

-- Strictly verifies that a match is ACTUALLY live (prevents false triggers in the Lobby at 01:18!)
local function DetectMatchAndTurnState(boardFrame)
    if not boardFrame then return "NO_BOARD" end
    local boardCenterY = boardFrame.AbsolutePosition.Y + (boardFrame.AbsoluteSize.Y * 0.5)
    local boardTopY = boardFrame.AbsolutePosition.Y
    local boardBottomY = boardFrame.AbsolutePosition.Y + boardFrame.AbsoluteSize.Y

    local topClockPill, bottomClockPill = nil, nil

    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible and (not OurScreenGui or not desc:IsDescendantOf(OurScreenGui)) then
            local rawTxt = desc.Text
            local t = string.lower(rawTxt)

            -- If any Lobby / Queue / Game Over button or modal is visible, match is NOT active!
            if
                string.find(t, "find a match") or
                string.find(t, "searching for opponent") or
                string.find(t, "loading...") or
                t == "game aborted" or
                string.find(t, "play again") or
                string.find(t, "you won") or
                string.find(t, "you lost")
            then
                if desc.AbsolutePosition.Y < boardBottomY + 180 then
                    return "LOBBY_OR_ENDED"
                end
            end

            -- Detect Top & Bottom Clocks ("3:00", "2:58", etc.)
            local trimmed = string.gsub(rawTxt, "%s+", "")
            if string.match(trimmed, "^%d+:%d%d$") then
                if desc.AbsolutePosition.Y < boardTopY then
                    topClockPill = desc
                elseif desc.AbsolutePosition.Y > boardCenterY then
                    bottomClockPill = desc
                end
            end
        end
    end

    -- In RoChess!, a live match ALWAYS has both a top clock and a bottom clock!
    if not topClockPill or not bottomClockPill then
        return "LOBBY_NO_CLOCKS"
    end

    -- Check explicit "to move" badge first
    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible and (not OurScreenGui or not desc:IsDescendantOf(OurScreenGui)) then
            local t = string.lower(desc.Text)
            if string.find(t, "to move") then
                return (desc.AbsolutePosition.Y > boardCenterY) and "MY_TURN" or "OPPONENT_TURN"
            end
        end
    end

    -- Compare brightness of Bottom Clock Pill vs Top Clock Pill (Active turn clock is bright white)
    local function GetPillBrightness(lbl)
        local obj = (lbl.BackgroundTransparency < 0.6) and lbl or lbl.Parent
        if obj and obj:IsA("GuiObject") and obj.BackgroundTransparency < 0.85 then
            local c = obj.BackgroundColor3
            return (c.R + c.G + c.B) / 3
        end
        return 0
    end

    local botBright = GetPillBrightness(bottomClockPill)
    local topBright = GetPillBrightness(topClockPill)

    if botBright > 0.7 and botBright > topBright + 0.15 then
        return "MY_TURN"
    elseif topBright > 0.7 and topBright > botBright + 0.15 then
        return "OPPONENT_TURN"
    end

    return "ACTIVE_UNKNOWN_TURN"
end

local LockedMatchSide = nil

local function DetectPlayerColor(boardFrame, turnState, engineTurn)
    if turnState == "MY_TURN" then
        LockedMatchSide = engineTurn
        return engineTurn
    elseif turnState == "OPPONENT_TURN" then
        LockedMatchSide = -engineTurn
        return -engineTurn
    end
    if LockedMatchSide then
        return LockedMatchSide
    end
    return 1
end

local function ScrapeMoveListStrictlyBelowBoard(boardFrame)
    if not boardFrame then return {} end
    local boardBottomY = boardFrame.AbsolutePosition.Y + boardFrame.AbsoluteSize.Y - 4
    local rawTokens = {}

    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and desc.Visible then
            if not OurScreenGui or not desc:IsDescendantOf(OurScreenGui) then
                local pos = desc.AbsolutePosition
                if pos.Y >= boardBottomY and desc.AbsoluteSize.Y > 8 and desc.AbsoluteSize.Y < 45 then
                    local clean = string.gsub(desc.Text, "<[^>]+>", "")
                    clean = string.gsub(clean, "^%s*(.-)%s*$", "%1")

                    for token in string.gmatch(clean, "%S+") do
                        if not string.match(token, "^%d+%.+$") then
                            local stripped = string.gsub(token, "[+#!?]", "")
                            if
                                stripped == "O-O" or stripped == "O-O-O" or
                                string.match(stripped, "^[NBRQK]?[a-h]?[1-8]?x?[a-h][1-8]=?[QRNB]?$")
                            then
                                table.insert(rawTokens, {
                                    san = stripped,
                                    rowY = math.floor(pos.Y / 8) * 8,
                                    colX = pos.X
                                })
                            end
                        end
                    end
                end
            end
        end
    end

    table.sort(rawTokens, function(a, b)
        if math.abs(a.rowY - b.rowY) > 10 then return a.rowY < b.rowY end
        return a.colX < b.colX
    end)

    local deduped = {}
    for _, item in ipairs(rawTokens) do
        local prev = deduped[#deduped]
        if not prev or prev.san ~= item.san or math.abs(prev.colX - item.colX) > 15 or math.abs(prev.rowY - item.rowY) > 12 then
            table.insert(deduped, item)
        end
    end

    local result = {}
    for _, item in ipairs(deduped) do
        table.insert(result, item.san)
    end
    return result
end

local function ComputeSquareScreenCenter(boardFrame, sqIdx, mySide)
    local file, rank = IndexToFileRank(sqIdx)
    local col, row
    if mySide == 1 then
        col = file - 1; row = 8 - rank
    else
        col = 8 - file; row = rank - 1
    end
    local bPos = boardFrame.AbsolutePosition
    local bSize = boardFrame.AbsoluteSize
    local cellW, cellH = bSize.X / 8, bSize.Y / 8
    return math.floor(bPos.X + (col + 0.5) * cellW), math.floor(bPos.Y + (row + 0.5) * cellH)
end

-- STRICT SINGLE-SHOT SQUARE HOOK:
-- 1) Searches ONLY descendants of `boardFrame` (NEVER touches Frame:Modals, Frame:Overlay, Frame:Toasts!)
-- 2) Filters ONLY square-sized elements (width <= 22% of board width) at (x, y)
-- 3) Fires ONLY ONCE per active connection (prevents double-click deselection!)
local function FireSingleShotSquareHook(boardFrame, x, y, algTag)
    if not boardFrame or not getconnections then return 0 end
    local maxSquareW = boardFrame.AbsoluteSize.X * 0.22
    local candidates = {}

    for _, desc in ipairs(boardFrame:GetDescendants()) do
        if desc:IsA("GuiObject") and desc.Visible then
            local pos = desc.AbsolutePosition
            local sz = desc.AbsoluteSize
            if sz.X > 4 and sz.X <= maxSquareW and sz.Y > 4 and sz.Y <= maxSquareW then
                if x >= pos.X and x <= (pos.X + sz.X) and y >= pos.Y and y <= (pos.Y + sz.Y) then
                    table.insert(candidates, desc)
                end
            end
        end
    end

    -- Also check if boardFrame itself holds the single unified board input connection
    table.insert(candidates, boardFrame)

    -- Sort topmost ZIndex first (so newly spawned legal-move dot at destination square is hit first!)
    table.sort(candidates, function(a, b)
        if a == boardFrame then return false end
        if b == boardFrame then return true end
        return a.ZIndex > b.ZIndex
    end)

    local fakeInputBegin = {
        UserInputType = Enum.UserInputType.Touch,
        UserInputState = Enum.UserInputState.Begin,
        Position = Vector3.new(x, y, 0),
        Delta = Vector3.zero,
        KeyCode = Enum.KeyCode.Unknown
    }

    local firedCount = 0
    local hitInfo = {}

    for _, obj in ipairs(candidates) do
        local objFired = false

        -- Priority 1: GuiButton Activated / MouseButton1Down / MouseButton1Click (fire ONLY the first signal that has connections!)
        if obj:IsA("GuiButton") then
            for _, sigName in ipairs({ "Activated", "MouseButton1Down", "MouseButton1Click" }) do
                local ok, conns = pcall(getconnections, obj[sigName])
                if ok and conns and #conns > 0 then
                    for _, c in ipairs(conns) do
                        if c.Function then
                            pcall(task.spawn, c.Function)
                            firedCount += 1
                            objFired = true
                        end
                    end
                    hitInfo[#hitInfo + 1] = obj.Name .. "." .. sigName
                    break -- Stop after firing 1 signal type so we don't double-toggle!
                end
            end
        end

        -- Priority 2: InputBegan (only if no button signal fired on this object)
        if not objFired then
            local ok, conns = pcall(getconnections, obj.InputBegan)
            if ok and conns and #conns > 0 then
                for _, c in ipairs(conns) do
                    if c.Function then
                        pcall(task.spawn, c.Function, fakeInputBegin, false)
                        firedCount += 1
                        objFired = true
                    end
                end
                hitInfo[#hitInfo + 1] = obj.Name .. ".InputBegan"
            end
        end

        -- Stop as soon as we triggered the topmost interactive square/dot at (x, y)!
        if objFired then
            break
        end
    end

    Logger.Push("SQ-HOOK", string.format("%s @(%d,%d) Fired:%d [%s]",
        algTag, x, y, firedCount, table.concat(hitInfo, ", ")
    ))
    return firedCount
end

local function DispatchMovev4(move, mySide)
    local fromAlg = IndexToAlgebraic(move.from)
    local toAlg = IndexToAlgebraic(move.to)
    local uci = fromAlg .. toAlg
    local summary = {}

    -- 1. If we already auto-learned the HexRemote Move Packet structure, fire it directly!
    if HookState.HexRemote and HookState.MovePacketBuilder then
        local ok, err = pcall(function()
            local p1, p2, p3 = HookState.MovePacketBuilder(fromAlg, toAlg, uci)
            if p2 then
                HookState.HexRemote:FireServer(p1, p2, p3)
            else
                HookState.HexRemote:FireServer(p1)
            end
        end)
        if ok then
            summary[#summary + 1] = "HexPacket:" .. HookState.HexRemote.Name
        else
            Logger.Push("ERR", "HexPacket failed: " .. tostring(err))
        end
    end

    -- 2. Call ONLY verified Live Board Instances (NEVER class prototypes!)
    for _, item in ipairs(HookState.LiveBoardInstances) do
        pcall(function()
            item.fn(item.inst, fromAlg, toAlg, "q")
            summary[#summary + 1] = "LiveGC:" .. item.name
        end)
    end

    -- 3. Clean Single-Shot Sub-Square Hook inside BoardFrame
    local boardFrame = GetBoardFrame()
    if boardFrame then
        local fx, fy = ComputeSquareScreenCenter(boardFrame, move.from, mySide)
        local tx, ty = ComputeSquareScreenCenter(boardFrame, move.to, mySide)

        local f1 = FireSingleShotSquareHook(boardFrame, fx, fy, "SRC:" .. fromAlg)
        task.wait(Config.SelectionHookDelay)
        local f2 = FireSingleShotSquareHook(boardFrame, tx, ty, "DST:" .. toAlg)

        summary[#summary + 1] = string.format("SqHook(%d->%d)", f1, f2)
    end

    HookState.LastHookSummary = (#summary > 0) and table.concat(summary, " + ") or "None"
end

