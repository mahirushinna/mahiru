-- // CƠ CHẾ XỬ LÝ FLY (BAY 3D) & NOCLIP (XUYÊN TƯỜNG)
local function StopFlyMechanics()
    if FlyBodyVelocity then
        pcall(function() FlyBodyVelocity:Destroy() end)
        FlyBodyVelocity = nil
    end
    if FlyBodyGyro then
        pcall(function() FlyBodyGyro:Destroy() end)
        FlyBodyGyro = nil
    end

    local myChar = LocalPlayer.Character
    if myChar then
        local myHum = myChar:FindFirstChildOfClass("Humanoid")
        if myHum then
            myHum.PlatformStand = false
        end
    end
end

local function RestoreNoclipCollision()
    for part, origCollide in pairs(OriginalCollideState) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = origCollide
            end)
        end
    end
    OriginalCollideState = {}
end

local function UpdateFlyMovement(myChar, myRoot, myHum, deltaTime)
    if not (Config.Memory.Unlocked and Config.Memory.FlyEnabled and myChar and myRoot and myHum and myHum.Health > 0) then
        if FlyBodyVelocity or FlyBodyGyro then
            StopFlyMechanics()
        end
        return
    end

    -- Tạo bộ giữ vận tốc và góc xoay trên không nếu chưa có
    if not FlyBodyVelocity or FlyBodyVelocity.Parent ~= myRoot then
        if FlyBodyVelocity then pcall(function() FlyBodyVelocity:Destroy() end) end
        FlyBodyVelocity = Instance.new("BodyVelocity")
        FlyBodyVelocity.Name = "MonicaFlyBV"
        FlyBodyVelocity.MaxForce = Vector3.new(1e8, 1e8, 1e8)
        FlyBodyVelocity.Velocity = Vector3.zero
        FlyBodyVelocity.P = 12500
        FlyBodyVelocity.Parent = myRoot
    end

    if not FlyBodyGyro or FlyBodyGyro.Parent ~= myRoot then
        if FlyBodyGyro then pcall(function() FlyBodyGyro:Destroy() end) end
        FlyBodyGyro = Instance.new("BodyGyro")
        FlyBodyGyro.Name = "MonicaFlyBG"
        FlyBodyGyro.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
        FlyBodyGyro.P = 15000
        FlyBodyGyro.D = 500
        FlyBodyGyro.CFrame = Camera.CFrame
        FlyBodyGyro.Parent = myRoot
    end

    local camCF = Camera.CFrame
    FlyBodyGyro.CFrame = camCF

    -- Chuyển hướng kéo Joystick (Mobile) hoặc phím WASD (PC) sang không gian 3D của Camera (nhìn lên bay lên, nhìn xuống bay xuống)
    local moveDir = myHum.MoveDirection
    local flyDir = Vector3.zero

    if moveDir.Magnitude > 0.01 then
        local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
        local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)

        if flatLook.Magnitude > 0.01 then flatLook = flatLook.Unit end
        if flatRight.Magnitude > 0.01 then flatRight = flatRight.Unit end

        local forwardInput = moveDir:Dot(flatLook)
        local rightInput = moveDir:Dot(flatRight)

        flyDir = (camCF.LookVector * forwardInput) + (camCF.RightVector * rightInput)
    end

    -- Hỗ trợ thêm phím Space (Bay thẳng lên) / LeftControl hoặc C (Bay thẳng xuống) nếu dùng bàn phím
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        flyDir = flyDir + Vector3.new(0, 1, 0)
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.C) then
        flyDir = flyDir - Vector3.new(0, 1, 0)
    end

    if flyDir.Magnitude > 0.01 then
        flyDir = flyDir.Unit
        FlyBodyVelocity.Velocity = flyDir * Config.Memory.FlySpeed
    else
        FlyBodyVelocity.Velocity = Vector3.zero
    end
end

