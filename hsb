local Logger = {
    Lines = {},
    Max = 100,
    Visible = false,
    OnChange = nil
}

function Logger.Log(tag, msg)
    local line = string.format("[%s][%s] %s", os.date("%H:%M:%S"), tostring(tag), tostring(msg))
    table.insert(Logger.Lines, 1, line)
    if #Logger.Lines > Logger.Max then
        table.remove(Logger.Lines)
    end
    if Logger.OnChange then
        pcall(Logger.OnChange)
    end
end

function Logger.Clear()
    table.clear(Logger.Lines)
    Logger.Log("SYS", "Log cleared.")
end

function Logger.GetText()
    return table.concat(Logger.Lines, "\n")
end

