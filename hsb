local function IsVisibleDeep(obj)
    local cur = obj
    while cur and cur ~= PlayerGui do
        if (cur:IsA("GuiObject") and not cur.Visible) or (cur:IsA("LayerCollector") and not cur.Enabled) then
            return false
        end
        cur = cur.Parent
    end
    return cur == PlayerGui
end

-- NEVER uses `C2.bgFrame`! Finds the exact 1:1 square 8x8 chess board & computes the exact 64-tile bounding box!
local CachedBoardInfo = { Frame = nil, X = 0, Y = 0, W = 0, H = 0, LastCheck = 0 }

local function GetExactChessBoardGeometry()
    local now = os.clock()
    if CachedBoardInfo.Frame and CachedBoardInfo.Frame.Parent and IsVisibleDeep(CachedBoardInfo.Frame) and (now - CachedBoardInfo.LastCheck < 0.5) then
        local p, s = CachedBoardInfo.Frame.AbsolutePosition, CachedBoardInfo.Frame.AbsoluteSize
        if s.X >= 200 and math.abs(s.X - s.Y) <= 12 then
            CachedBoardInfo.X, CachedBoardInfo.Y, CachedBoardInfo.W, CachedBoardInfo.H = p.X, p.Y, s.X, s.Y
            return CachedBoardInfo
        end
    end
    CachedBoardInfo.LastCheck = now

    local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(400, 850)
    local bestFrame = nil
    local bestScore = -1

    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if d:IsA("GuiObject") and not d:IsDescendantOf(GuiRoot) and IsVisibleDeep(d) then
            local sz = d.AbsoluteSize
            local pos = d.AbsolutePosition
            -- Must be a 1:1 square (width == height within 10px), >= 210px, and NEVER fullscreen height!
            if sz.X >= 210 and sz.Y >= 210 and math.abs(sz.X - sz.Y) <= 10 and sz.Y <= vp.Y * 0.72 and pos.Y >= 30 then
                local expectedTileW = sz.X / 8
                local tileMatches = 0
                for _, ch in ipairs(d:GetDescendants()) do
                    if ch:IsA("GuiObject") and ch.Visible then
                        local csz = ch.AbsoluteSize
                        if math.abs(csz.X - expectedTileW) <= 6 and math.abs(csz.Y - expectedTileW) <= 6 then
                            tileMatches += 1
                        end
                    end
                end
                local score = tileMatches * 10 + (#d:GetDescendants())
                if score > bestScore then
                    bestScore = score
                    bestFrame = d
                end
            end
        end
    end

    if bestFrame then
        -- Check if we can tighten the bounding box to the exact 64 square tiles inside `bestFrame`
        local expectedTileW = bestFrame.AbsoluteSize.X / 8
        local minX, minY, maxX, maxY = 99999, 99999, -99999, -99999
        local tileCount = 0
        for _, ch in ipairs(bestFrame:GetDescendants()) do
            if ch:IsA("GuiObject") and ch.Visible then
                local csz = ch.AbsoluteSize
                local cpos = ch.AbsolutePosition
                if math.abs(csz.X - expectedTileW) <= 5 and math.abs(csz.Y - expectedTileW) <= 5 then
                    tileCount += 1
                    if cpos.X < minX then minX = cpos.X end
                    if cpos.Y < minY then minY = cpos.Y end
                    if cpos.X + csz.X > maxX then maxX = cpos.X + csz.X end
                    if cpos.Y + csz.Y > maxY then maxY = cpos.Y + csz.Y end
                end
            end
        end

        CachedBoardInfo.Frame = bestFrame
        if tileCount >= 32 and math.abs((maxX - minX) - (maxY - minY)) <= 12 then
            CachedBoardInfo.X = minX
            CachedBoardInfo.Y = minY
            CachedBoardInfo.W = maxX - minX
            CachedBoardInfo.H = maxY - minY
        else
            CachedBoardInfo.X = bestFrame.AbsolutePosition.X
            CachedBoardInfo.Y = bestFrame.AbsolutePosition.Y
            CachedBoardInfo.W = bestFrame.AbsoluteSize.X
            CachedBoardInfo.H = bestFrame.AbsoluteSize.Y
        end
        return CachedBoardInfo
    end

    return nil
end

-- Detects board orientation (White = 1, Black = -1) directly from the "1".."8" and "a".."h" rank/file labels on the board!
-- Look at video_1.mp4 at 00:31: When playing Black, rank "1" is at the TOP of the board and rank "8" is at the BOTTOM!
local function DetectBoardOrientationFromLabels(bGeo)
    if not bGeo or not bGeo.Frame then return nil end
    local bx, by, bw, bh = bGeo.X, bGeo.Y, bGeo.W, bGeo.H
    local rank1Y, rank8Y = nil, nil
    local fileAX, fileHX = nil, nil

    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if d:IsA("TextLabel") and not d:IsDescendantOf(GuiRoot) and IsVisibleDeep(d) then
            local pos = d.AbsolutePosition
            local sz = d.AbsoluteSize
            -- Must be inside or within 28px of the 8x8 board edges and small font label
            if sz.X < 36 and sz.Y < 36 and pos.X >= (bx - 28) and pos.X <= (bx + bw + 28) and pos.Y >= (by - 28) and pos.Y <= (by + bh + 28) then
                local txt = string.gsub(d.Text, "%s+", "")
                if txt == "1" then rank1Y = pos.Y
                elseif txt == "8" then rank8Y = pos.Y
                elseif txt == "a" then fileAX = pos.X
                elseif txt == "h" then fileHX = pos.X
                end
            end
        end
    end

    if rank1Y and rank8Y and math.abs(rank1Y - rank8Y) > (bh * 0.5) then
        return (rank1Y > rank8Y) and 1 or -1
    end
    if fileAX and fileHX and math.abs(fileAX - fileHX) > (bw * 0.5) then
        return (fileAX < fileHX) and 1 or -1
    end
    return nil
end

-- Layer 1: Passive Spy on RoChess #3 RAMBoard (`makeMove`) + Auto-Calibrated Piece Map
local RAMTracker = {
    ActiveBoard = nil,
    AllBoards = {},
    CodeToPiece = {},
    Calibrated = false,
    FlippedRanks = false
}

local function CalibrateRAMBoardMap(rb)
    if type(rb) ~= "table" then return end
    -- Standard starting board at ply == 0:
    -- Either Rank 1 is at indices 1..8 OR indices 57..64
    local e1 = rb[5]
    local e8 = rb[61]
    if e1 ~= nil and e8 ~= nil and e1 ~= e8 and (rb[17] == 0 or rb[17] == false or rb[17] == "") then
        -- Check if rb[1..8] are White pieces or Black pieces
        RAMTracker.CodeToPiece[rb[1]] = 4   -- Rook
        RAMTracker.CodeToPiece[rb[2]] = 2   -- Knight
        RAMTracker.CodeToPiece[rb[3]] = 3   -- Bishop
        RAMTracker.CodeToPiece[rb[4]] = 5   -- Queen
        RAMTracker.CodeToPiece[rb[5]] = 6   -- King
        RAMTracker.CodeToPiece[rb[9]] = 1   -- Pawn
