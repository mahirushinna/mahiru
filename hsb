}

function OpponentProfile:Reset()
    self.MoveCount = 0
    self.BlunderCount = 0
    self.AggressiveMoves = 0
    self.Archetype = "Balanced"
    self.DynamicDepthBonus = 0
    self.ContemptFactor = 20
end

function OpponentProfile:RecordMove(evalDrop, isAggro)
    self.MoveCount += 1
    if evalDrop > 160 then self.BlunderCount += 1 end
    if isAggro then self.AggressiveMoves += 1 end

    local blunderRate = self.BlunderCount / self.MoveCount
    local aggroRate = self.AggressiveMoves / self.MoveCount

    if blunderRate >= 0.25 then
        self.Archetype = "Blunder-Prone (Punish)"
        self.DynamicDepthBonus = 0
        self.ContemptFactor = 65
    elseif aggroRate >= 0.45 then
        self.Archetype = "Aggressive Tactician"
        self.DynamicDepthBonus = 1
        self.ContemptFactor = 35
    elseif blunderRate < 0.08 and self.MoveCount >= 5 then
        self.Archetype = "High-Elo / Solid"
        self.DynamicDepthBonus = 1
        self.ContemptFactor = 0
    else
        self.Archetype = "Balanced"
        self.DynamicDepthBonus = 0
        self.ContemptFactor = 20
    end
end

