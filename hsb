    Instance.new("UICorner", originBox).CornerRadius = UDim.new(0, 6)
    local originStroke = Instance.new("UIStroke", originBox)
    originStroke.Color = color
    originStroke.Thickness = 2.2
    originStroke.Transparency = 0.15
    group.OriginBox = originBox

    local destBox = Instance.new("Frame")
    destBox.BackgroundColor3 = color
    destBox.BackgroundTransparency = 0.72
    destBox.BorderSizePixel = 0
    destBox.ZIndex = zBase
    destBox.Visible = false
    destBox.Active = false
    destBox.Parent = OverlayContainer
    Instance.new("UICorner", destBox).CornerRadius = UDim.new(0, 6)
    group.DestBox = destBox

    local shaft = Instance.new("Frame")
    shaft.BackgroundColor3 = color
    shaft.BackgroundTransparency = transparency
    shaft.BorderSizePixel = 0
    shaft.AnchorPoint = Vector2.new(0.5, 0.5)
    shaft.ZIndex = zBase + 1
    shaft.Visible = false
    shaft.Active = false
    shaft.Parent = OverlayContainer
    Instance.new("UICorner", shaft).CornerRadius = UDim.new(0, 4)
    group.Shaft = shaft

    -- Build a crisp 5-slice triangular arrowhead so it works on 100% of devices without external asset IDs!
    local headSlices = {}
    for i = 1, 6 do
        local slice = Instance.new("Frame")
        slice.BackgroundColor3 = color
        slice.BackgroundTransparency = transparency
        slice.BorderSizePixel = 0
        slice.AnchorPoint = Vector2.new(0.5, 0.5)
        slice.ZIndex = zBase + 2
        slice.Visible = false
        slice.Active = false
        slice.Parent = OverlayContainer
        Instance.new("UICorner", slice).CornerRadius = UDim.new(0, 2)
        headSlices[i] = slice
    end
    group.HeadSlices = headSlices

    function group:Hide()
        self.OriginBox.Visible = false
        self.DestBox.Visible = false
        self.Shaft.Visible = false
        for _, s in ipairs(self.HeadSlices) do
            s.Visible = false
        end
    end

    function group:Render(fx, fy, tx, ty, cellSize)
        local dx = tx - fx
        local dy = ty - fy
        local dist = math.sqrt(dx * dx + dy * dy)
        if dist < 4 then
            self:Hide()
            return
        end

        local ux = dx / dist
        local uy = dy / dist
        local angleDeg = math.deg(math.atan2(dy, dx))

        -- Highlight source & destination squares subtly like video_1.mp4
        local boxSz = math.floor(cellSize * 0.92)
        self.OriginBox.Size = UDim2.fromOffset(boxSz, boxSz)
        self.OriginBox.Position = UDim2.fromOffset(fx - boxSz * 0.5, fy - boxSz * 0.5)
        self.OriginBox.Visible = true

        self.DestBox.Size = UDim2.fromOffset(boxSz, boxSz)
        self.DestBox.Position = UDim2.fromOffset(tx - boxSz * 0.5, ty - boxSz * 0.5)
        self.DestBox.Visible = true

        -- Geometry of Shaft + Triangular Head
        local headLen = math.clamp(cellSize * 0.52, 16, 34)
        local headMaxWidth = math.clamp(cellSize * 0.58, 18, 38)
        local shaftThickness = math.clamp(cellSize * 0.24, 8, 15)

        local startOffset = cellSize * 0.12
        local shaftLen = math.max(4, dist - headLen - startOffset * 0.5)
        local shaftCenterX = fx + ux * (startOffset + shaftLen * 0.5)
        local shaftCenterY = fy + uy * (startOffset + shaftLen * 0.5)

        self.Shaft.Size = UDim2.fromOffset(shaftLen, shaftThickness)
        self.Shaft.Position = UDim2.fromOffset(shaftCenterX, shaftCenterY)
        self.Shaft.Rotation = angleDeg
        self.Shaft.Visible = true

        -- Position 6 tapered slices from base of arrowhead to the tip at (tx, ty)
        local baseStartX = tx - ux * headLen
        local baseStartY = ty - uy * headLen
        local numSlices = #self.HeadSlices
        local sliceStep = headLen / numSlices

        for i = 1, numSlices do
            local t = (i - 0.5) / numSlices -- 0 (base) -> 1 (tip)
            local widthAtSlice = math.max(3, headMaxWidth * (1.0 - t * 0.88))
            local cx = baseStartX + ux * (t * headLen)
            local cy = baseStartY + uy * (t * headLen)

            local slice = self.HeadSlices[i]
            slice.Size = UDim2.fromOffset(sliceStep + 2, widthAtSlice)
            slice.Position = UDim2.fromOffset(cx, cy)
            slice.Rotation = angleDeg
            slice.Visible = true
        end
    end

    return group
end

