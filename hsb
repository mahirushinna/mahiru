local function ComputeSquareCenter(boardFrame, sqIdx, mySide)
    local file, rank = IndexToFileRank(sqIdx)
    local col, row
    if mySide == 1 then
        col = file - 1; row = 8 - rank
    else
        col = 8 - file; row = rank - 1
    end
    local bPos = boardFrame.AbsolutePosition
    local bSize = boardFrame.AbsoluteSize
    local cellW, cellH = bSize.X / 8, bSize.Y / 8
    return math.floor(bPos.X + (col + 0.5) * cellW), math.floor(bPos.Y + (row + 0.5) * cellH), cellW
end

local function UpdateEvalBarVisual(boardFrame, centipawnScore, mySide)
    if not Config.ShowEvalBar or not boardFrame then
        EvalBarBg.Visible = false
        return
    end
    local bPos = boardFrame.AbsolutePosition
    local bSize = boardFrame.AbsoluteSize
    EvalBarBg.Size = UDim2.fromOffset(10, bSize.Y)
    EvalBarBg.Position = UDim2.fromOffset(math.max(2, bPos.X - 14), bPos.Y)
    EvalBarBg.Visible = true

    -- Sigmoid mapping from centipawn advantage to 0.05..0.95 bar height
    local pawns = centipawnScore / 100
    local ratio = 0.5 + 0.5 * math.tanh(pawns / 4.0)
    ratio = math.clamp(ratio, 0.05, 0.95)

    EvalBarFill.Size = UDim2.new(1, 0, ratio, 0)
    EvalBarFill.BackgroundColor3 = (centipawnScore >= 0) and Color3.fromRGB(115, 225, 110) or Color3.fromRGB(235, 95, 95)
    EvalScoreTag.Text = (centipawnScore >= 9000 and "M+" or (centipawnScore <= -9000 and "M-" or string.format("%+.1f", pawns)))
end

