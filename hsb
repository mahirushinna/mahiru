    function arrow:Hide()
        self.OriginBox.Visible = false
        self.TargetBox.Visible = false
        self.Shaft.Visible = false
        self.LeftWing.Visible = false
        self.RightWing.Visible = false
        self.Badge.Visible = false
        for i = 1, 10 do self.HeadFill[i].Visible = false end
    end

    function arrow:Draw(fx, fy, tx, ty, cellW, badgeText)
        local dx, dy = tx - fx, ty - fy
        local dist = math.sqrt(dx * dx + dy * dy)
        if dist < 4 then self:Hide(); return end

        local ux, uy = dx / dist, dy / dist
        local px, py = -uy, ux
        local angDeg = math.deg(math.atan2(dy, dx))

        local boxSz = math.floor(cellW * 0.88)
        self.OriginBox.Size = UDim2.fromOffset(boxSz, boxSz)
        self.OriginBox.Position = UDim2.fromOffset(fx - boxSz * 0.5, fy - boxSz * 0.5)
        self.OriginBox.Visible = true

        self.TargetBox.Size = UDim2.fromOffset(boxSz, boxSz)
        self.TargetBox.Position = UDim2.fromOffset(tx - boxSz * 0.5, ty - boxSz * 0.5)
        self.TargetBox.Visible = true

        local headLen = math.clamp(cellW * 0.48, 15, 30)
        local headHalfW = math.clamp(cellW * 0.28, 9, 18)
        local shaftThk = math.clamp(cellW * 0.21, 7, 13)
        local startPad = cellW * 0.10
        local shaftLen = math.max(4, dist - headLen * 0.85 - startPad)

        self.Shaft.Size = UDim2.fromOffset(shaftLen, shaftThk)
        self.Shaft.Position = UDim2.fromOffset(fx + ux * (startPad + shaftLen * 0.5), fy + uy * (startPad + shaftLen * 0.5))
        self.Shaft.Rotation = angDeg
        self.Shaft.Visible = true

        local baseX = tx - ux * headLen
        local baseY = ty - uy * headLen

        local leftCornerX = baseX + px * headHalfW
        local leftCornerY = baseY + py * headHalfW
        local rightCornerX = baseX - px * headHalfW
        local rightCornerY = baseY - py * headHalfW

        local wingLen = math.sqrt(headLen * headLen + headHalfW * headHalfW)
        local wingThk = math.max(3, shaftThk * 0.35)

        local ldx, ldy = leftCornerX - tx, leftCornerY - ty
        self.LeftWing.Size = UDim2.fromOffset(wingLen, wingThk)
        self.LeftWing.Position = UDim2.fromOffset((tx + leftCornerX) * 0.5, (ty + leftCornerY) * 0.5)
        self.LeftWing.Rotation = math.deg(math.atan2(ldy, ldx))
        self.LeftWing.Visible = true

        local rdx, rdy = rightCornerX - tx, rightCornerY - ty
        self.RightWing.Size = UDim2.fromOffset(wingLen, wingThk)
        self.RightWing.Position = UDim2.fromOffset((tx + rightCornerX) * 0.5, (ty + rightCornerY) * 0.5)
        self.RightWing.Rotation = math.deg(math.atan2(rdy, rdx))
        self.RightWing.Visible = true

        local nSlices = #self.HeadFill
        local stepLen = headLen / nSlices
        for i = 1, nSlices do
            local t = (i - 0.5) / nSlices
            local w = math.max(2, (headHalfW * 2) * (1.0 - t))
            local sl = self.HeadFill[i]
            sl.Size = UDim2.fromOffset(stepLen + 1.5, w)
            sl.Position = UDim2.fromOffset(baseX + ux * (t * headLen), baseY + uy * (t * headLen))
            sl.Rotation = angDeg
            sl.Visible = true
        end

        if Config.ShowMoveBadges and badgeText and badgeText ~= "" then
            self.Badge.Text = badgeText
            local textW = math.max(46, #badgeText * 6.5 + 10)
            self.Badge.Size = UDim2.fromOffset(textW, 18)
            self.Badge.Position = UDim2.fromOffset(tx, ty - cellW * 0.48)
            self.Badge.Visible = true
        else
            self.Badge.Visible = false
        end
    end

    return arrow
end

