end

Logger.Log("INIT", "v10.0 TURBO Loaded (Zero-Allocation + 0.32s Time Budget).")

local LastPlyCount = -1
local LastSideMode = ""

task.spawn(function()
    while Running and task.wait(0.08) do
        local bGeo = GetExactChessBoardGeometry()
        if bGeo then
            local autoSide = DetectBoardOrientation(bGeo)
            local mySide = (Config.SideMode == "WHITE" and 1) or (Config.SideMode == "BLACK" and -1) or autoSide
            RenderState.Side = mySide

            local maxPly = ScrapeMovesFast(bGeo)

            if maxPly ~= LastPlyCount or Config.SideMode ~= LastSideMode or RenderState.ForceRecalc then
                RenderState.ForceRecalc = false
                LastPlyCount = maxPly
                LastSideMode = Config.SideMode

                -- Rebuild current board position using fast in-place MakeMove
                Engine:Reset()
                local applied = 0
                for ply = 1, maxPly do
                    local san = PersistentMovesByPly[ply]
                    if not san then break end
                    local m = Engine:ParseSAN(san, (ply % 2 == 1) and 1 or -1)
                    if m then
                        Engine:MakeMove(m, 59)
                        table.insert(Engine.Hist, m.uci)
                        applied += 1
                    else
                        Logger.Log("WARN", string.format("Ply %d (%s) parse mismatch", ply, tostring(san)))
                        break
                    end
                end

                RenderState.InCheckSq = Engine:InCheck(Engine.Side) and ((Engine.Side == 1) and Engine.WKingSq or Engine.BKingSq) or nil

                local calcSide = Engine.Side
                local isMyTurn = (calcSide == mySide)

                -- Hide arrows briefly while calculating (<0.32s)
                RenderState.Ready = false
                BestArrow:Hide(); AltArrow:Hide(); PonderArrow:Hide()

                -- On opponent's turn, do a super-fast 0.12s threat preview and abort immediately if opponent plays!
                local budget = isMyTurn and Config.ThinkTimeLimit or math.min(0.14, Config.ThinkTimeLimit * 0.45)

                local bestM, altM, ponderM, sc, meta, elapsed = Engine:AnalyzeFast(
                    calcSide,
                    budget,
                    function()
                        -- Abort immediately if a new move appeared on the UI!
                        return ScrapeMovesFast(bGeo) ~= maxPly
                    end
                )

                if bestM and ScrapeMovesFast(bGeo) == maxPly then
                    RenderState.Best = bestM
                    RenderState.Alt = altM
                    RenderState.Ponder = ponderM
                    RenderState.Score = isMyTurn and sc or -sc
                    RenderState.Meta = meta
                    RenderState.Ready = Config.ESPEnabled

                    local recentSAN = {}
                    for p = math.max(1, applied - 3), applied do
                        if PersistentMovesByPly[p] then
                            recentSAN[#recentSAN + 1] = PersistentMovesByPly[p]
                        end
                    end

                    Status.Text = string.format(
                        "Side: %s | Ply: %d | %s\n#1 Best: %s (%s) [%+.2f]\n#2 Alt: %s | Opp: %s\nSpeed: %s (%d nodes) | %s",
                        mySide == 1 and "WHITE" or "BLACK",
                        applied,
                        isMyTurn and "YOUR TURN" or "OPP TURN",
                        bestM.san or bestM.uci, bestM.uci, RenderState.Score / 100,
                        altM and (altM.san or altM.uci) or "--",
                        ponderM and (ponderM.san or ponderM.uci) or "--",
                        meta,
                        Engine.Nodes,
                        #recentSAN > 0 and table.concat(recentSAN, " ") or "Start"
                    )

                    Logger.Log("TURBO", string.format("Ply %d -> %s (%+.2f) in %s [%d nodes]",
                        applied, bestM.san or bestM.uci, RenderState.Score / 100, meta, Engine.Nodes
                    ))
                end
            end
        end
    end
end)
