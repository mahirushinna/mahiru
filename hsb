-- 1. REAL-TIME TOP-FIRST LOGGER (NEWEST ENTRY ALWAYS AT LINE 1 - NO SCROLL BUG)
--------------------------------------------------------------------------------
local Logger = {
    Lines = {},
    PendingQueue = {},
    MaxLines = 120,
    Visible = true,
    Dirty = true,
    TickCount = 0
}

function Logger.Push(category, msg)
    Logger.PendingQueue[#Logger.PendingQueue + 1] = {
        t = os.date("%H:%M:%S"),
        c = tostring(category),
        m = tostring(msg)
    }
end

function Logger.Clear()
    table.clear(Logger.Lines)
    table.clear(Logger.PendingQueue)
    Logger.Push("SYS", "Log cleared by user.")
    Logger.Dirty = true
end

-- Returns text with NEWEST line at the TOP (Line 1) so it is ALWAYS visible immediately!
function Logger.GetTopFirstText()
    local out = {}
    for i = #Logger.Lines, 1, -1 do
        out[#out + 1] = Logger.Lines[i]
    end
    return table.concat(out, "\n")
end

-- Returns chronological text for clipboard export
function Logger.GetChronologicalText()
    return table.concat(Logger.Lines, "\n")
end

