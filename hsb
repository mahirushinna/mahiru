-- 7.3 Locate the 8x8 Board Container Frame accurately
local function GetBoardFrame()
    local bestFrame = nil
    local bestArea = 0
    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if desc:IsA("GuiObject") and desc.Visible then
            local sz = desc.AbsoluteSize
            -- Board frame is a large square (width == height, >= 220px)
            if sz.X >= 220 and sz.Y >= 220 and math.abs(sz.X - sz.Y) <= 16 then
                local area = sz.X * sz.Y
                if area > bestArea then
                    bestArea = area
                    bestFrame = desc
                end
            end
        end
    end
    return bestFrame
end

-- 7.4 Pure Memory Signal Hook on any GuiObject (NO screen touch, NO VirtualInputManager)
local function FireGuiObjectHooks(guiObj, screenX, screenY)
    local firedCount = 0
    local fakeTouchBegin = {
        UserInputType = Enum.UserInputType.Touch,
        UserInputState = Enum.UserInputState.Begin,
        Position = Vector3.new(screenX, screenY, 0),
        Delta = Vector3.zero,
        KeyCode = Enum.KeyCode.Unknown
    }
    local fakeTouchEnd = {
        UserInputType = Enum.UserInputType.Touch,
        UserInputState = Enum.UserInputState.End,
        Position = Vector3.new(screenX, screenY, 0),
        Delta = Vector3.zero,
        KeyCode = Enum.KeyCode.Unknown
    }
    local fakeMouseBegin = {
        UserInputType = Enum.UserInputType.MouseButton1,
        UserInputState = Enum.UserInputState.Begin,
        Position = Vector3.new(screenX, screenY, 0),
        Delta = Vector3.zero,
        KeyCode = Enum.KeyCode.Unknown
    }
    local fakeMouseEnd = {
        UserInputType = Enum.UserInputType.MouseButton1,
        UserInputState = Enum.UserInputState.End,
        Position = Vector3.new(screenX, screenY, 0),
        Delta = Vector3.zero,
        KeyCode = Enum.KeyCode.Unknown
    }

    -- Use firesignal if supported by executor
    if firesignal then
        for _, sigName in ipairs({ "Activated", "MouseButton1Down", "MouseButton1Click", "MouseButton1Up", "TouchTap" }) do
            local ok, sig = pcall(function() return guiObj[sigName] end)
            if ok and sig then
                pcall(firesignal, sig)
                pcall(firesignal, sig, screenX, screenY)
                firedCount += 1
            end
        end
    end

    -- Use getconnections to invoke bound Lua closures directly in memory
    if getconnections then
        local buttonSigs = { "Activated", "MouseButton1Down", "MouseButton1Click", "MouseButton1Up", "TouchTap" }
        for _, sigName in ipairs(buttonSigs) do
            local ok, sig = pcall(function() return guiObj[sigName] end)
            if ok and sig then
                local okConn, conns = pcall(getconnections, sig)
                if okConn and conns then
                    for _, c in ipairs(conns) do
                        if c.Function then
                            pcall(task.spawn, c.Function, screenX, screenY)
                            pcall(task.spawn, c.Function)
                            firedCount += 1
                        end
                        pcall(function() c:Fire(screenX, screenY) end)
                        pcall(function() c:Fire() end)
                    end
                end
            end
        end

        local inputSigs = {
            { name = "InputBegan", payloads = { fakeTouchBegin, fakeMouseBegin } },
            { name = "InputEnded", payloads = { fakeTouchEnd, fakeMouseEnd } }
        }
        for _, entry in ipairs(inputSigs) do
            local ok, sig = pcall(function() return guiObj[entry.name] end)
            if ok and sig then
                local okConn, conns = pcall(getconnections, sig)
                if okConn and conns then
                    for _, c in ipairs(conns) do
                        for _, payload in ipairs(entry.payloads) do
                            if c.Function then
                                pcall(task.spawn, c.Function, payload, false)
                                firedCount += 1
                            end
                            pcall(function() c:Fire(payload, false) end)
                        end
                    end
                end
            end
        end
    end

    return firedCount
end

-- Collects all GuiObjects inside the BoardFrame whose bounding box covers (targetX, targetY)
local function GetSquareGuiTargetsAt(boardFrame, targetX, targetY, algName)
    local targets = {}
    local seen = {}

    for _, desc in ipairs(boardFrame:GetDescendants()) do
        if desc:IsA("GuiObject") and desc.Visible then
            local n = string.lower(desc.Name)
            local pos = desc.AbsolutePosition
            local sz = desc.AbsoluteSize
            local isNamedMatch = (n == algName or n == "square_" .. algName or n == "tile_" .. algName)
            local isCoordMatch = (
                targetX >= pos.X and targetX <= (pos.X + sz.X) and
                targetY >= pos.Y and targetY <= (pos.Y + sz.Y) and
                sz.X <= (boardFrame.AbsoluteSize.X * 0.25)
            )

            if (isNamedMatch or isCoordMatch) and not seen[desc] then
                seen[desc] = true
                table.insert(targets, desc)
                if desc.Parent and desc.Parent:IsA("GuiObject") and desc.Parent ~= boardFrame and not seen[desc.Parent] then
                    seen[desc.Parent] = true
                    table.insert(targets, desc.Parent)
                end
            end
        end
    end

    -- Sort deepest/topmost children (like newly spawned legal-move indicator dots!) first
    table.sort(targets, function(a, b)
        return a.ZIndex > b.ZIndex
    end)

    return targets
end

local function ComputeSquareScreenCenter(boardFrame, sqIdx, mySide)
    local file, rank = IndexToFileRank(sqIdx)
    local col, row
    if mySide == 1 then
        col = file - 1
        row = 8 - rank
    else
        col = 8 - file
        row = rank - 1
    end
    local bPos = boardFrame.AbsolutePosition
    local bSize = boardFrame.AbsoluteSize
    local cellW, cellH = bSize.X / 8, bSize.Y / 8
    return bPos.X + (col + 0.5) * cellW, bPos.Y + (row + 0.5) * cellH
end

-- Executes a move using 100% Hook Simulation (Remote Hook + GC Function Hook + Two-Phase Signal Hook)
local function ExecuteMoveViaHook(move, mySide)
    local fromAlg = IndexToAlgebraic(move.from)
    local toAlg = IndexToAlgebraic(move.to)
    local uci = fromAlg .. toAlg
    local totalHooksFired = 0

    -- Stage 1: Direct Remote Hook if captured
    if HookState.CapturedRemote then
        pcall(function()
            local rem = HookState.CapturedRemote
            if rem:IsA("RemoteEvent") then
                if HookState.CapturedFormat and type(HookState.CapturedFormat[1]) == "table" then
                    rem:FireServer({ from = fromAlg, to = toAlg, promotion = "q", From = fromAlg, To = toAlg })
                elseif HookState.CapturedFormat and type(HookState.CapturedFormat[1]) == "string" and #HookState.CapturedFormat[1] == 4 then
                    rem:FireServer(uci)
                else
                    rem:FireServer(fromAlg, toAlg, "q")
                end
                HookState.LastHookMethod = "Remote:" .. rem.Name
                totalHooksFired += 1
            elseif rem:IsA("RemoteFunction") then
                task.spawn(function()
                    rem:InvokeServer(fromAlg, toAlg, "q")
                end)
                HookState.LastHookMethod = "RemoteFn:" .. rem.Name
                totalHooksFired += 1
            end
        end)
    end

    -- Stage 2: Direct GC Controller Function Hook
    if HookState.GCMoveFunction then
        pcall(function()
            if HookState.GCBoardController then
                HookState.GCMoveFunction(HookState.GCBoardController, fromAlg, toAlg, "q")
            else
                HookState.GCMoveFunction(fromAlg, toAlg, "q")
            end
            HookState.LastHookMethod = "GC:MoveFn"
            totalHooksFired += 1
        end)
    end

    -- Stage 3: Two-Phase Pure Signal Hook on Board GUI Squares & Spawned Legal-Move Dots
    local boardFrame = GetBoardFrame()
    if boardFrame then
        local fx, fy = ComputeSquareScreenCenter(boardFrame, move.from, mySide)
        local tx, ty = ComputeSquareScreenCenter(boardFrame, move.to, mySide)

        -- Phase 3A: Hook source square/piece (`fromAlg`) to trigger RoChess piece selection
        local fromTargets = GetSquareGuiTargetsAt(boardFrame, fx, fy, fromAlg)
        for _, obj in ipairs(fromTargets) do
            totalHooksFired += FireGuiObjectHooks(obj, fx, fy)
        end
        FireGuiObjectHooks(boardFrame, fx, fy)

        -- Wait for RoChess to spawn the legal-move target dots (fixes the 00:29 bug in video_1.mp4!)
        task.wait(Config.SelectionHookDelay)

        -- Phase 3B: Re-scan destination square (`toAlg`) to capture newly spawned legal-move dot & square
        local toTargets = GetSquareGuiTargetsAt(boardFrame, tx, ty, toAlg)
        for _, obj in ipairs(toTargets) do
            totalHooksFired += FireGuiObjectHooks(obj, tx, ty)
        end
        FireGuiObjectHooks(boardFrame, tx, ty)

        -- Phase 3C: Auto-hook Queen promotion popup if pawn promoted
        if move.promo then
            task.wait(0.08)
            for _, desc in ipairs(boardFrame.Parent:GetDescendants()) do
                if desc:IsA("GuiButton") and desc.Visible then
                    local n = string.lower(desc.Name)
                    if string.find(n, "queen") or n == "q" then
                        FireGuiObjectHooks(desc, desc.AbsolutePosition.X + 10, desc.AbsolutePosition.Y + 10)
                    end
                end
            end
        end

        HookState.LastHookMethod = string.format("SignalHook (%d)", totalHooksFired)
    end
end

