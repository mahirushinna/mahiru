-- High-Precision Vector Arrow Constructor (Origin Ring + Target Ring + Smooth Shaft + 14-Slice Micro-Tapered Triangular Head + Two Wing Edges + Floating Move/Eval Badge)
local function CreateVIPArrow(mainColor, badgeBgColor, trans, zBase)
    local arrow = {}

    arrow.OriginBox = Instance.new("Frame", Overlay)
    arrow.OriginBox.BackgroundColor3 = mainColor
    arrow.OriginBox.BackgroundTransparency = 0.72
    arrow.OriginBox.BorderSizePixel = 0
