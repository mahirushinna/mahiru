local function createToggle(parent, title, index, key)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -14, 0, 36)
    btn.Position = UDim2.new(0, 7, 0, 30 + (index - 1) * 44)
    btn.BorderSizePixel = 0
    btn.ZIndex = 93
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 12
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local function refresh()
        if Config[key] then
            btn.BackgroundColor3 = Color3.fromRGB(0, 170, 95)
            btn.Text = title .. ": BẬT"
        else
            btn.BackgroundColor3 = Color3.fromRGB(50, 55, 68)
            btn.Text = title .. ": TẮT"
        end
    end

    btn.Activated:Connect(function()
        Config[key] = not Config[key]
        refresh()
    end)

    refresh()
end

