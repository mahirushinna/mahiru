local OpponentProfile = {
    MoveCount = 0,
    TotalThinkTime = 0,
    BlunderCount = 0,
    AggressiveMoves = 0,
    LastEvalBeforeOpponent = 0,
    Archetype = "Unknown",
    DynamicDepthBonus = 0,
    ContemptFactor = 15,
    LastMoveTimestamp = os.clock()
}

function OpponentProfile:Reset()
    self.MoveCount = 0
    self.TotalThinkTime = 0
    self.BlunderCount = 0
    self.AggressiveMoves = 0
    self.LastEvalBeforeOpponent = 0
    self.Archetype = "Balanced"
    self.DynamicDepthBonus = 0
    self.ContemptFactor = 15
    self.LastMoveTimestamp = os.clock()
end

function OpponentProfile:RecordMove(evalDrop, isCaptureOrCheck)
    local now = os.clock()
    local dt = math.clamp(now - self.LastMoveTimestamp, 0.1, 60)
    self.LastMoveTimestamp = now
    self.MoveCount += 1
    self.TotalThinkTime += dt

    if evalDrop > 180 then
        self.BlunderCount += 1
    end
    if isCaptureOrCheck then
        self.AggressiveMoves += 1
    end

    local avgTime = self.TotalThinkTime / self.MoveCount
    local blunderRate = self.BlunderCount / self.MoveCount
    local aggroRate = self.AggressiveMoves / self.MoveCount

    if blunderRate >= 0.25 and avgTime < 3.5 then
        self.Archetype = "Impulse Blunderer"
        self.DynamicDepthBonus = 0
        self.ContemptFactor = 60 -- Punish fast blunders ruthlessly, avoid draws
    elseif aggroRate >= 0.45 then
        self.Archetype = "Tactical Aggressor"
        self.DynamicDepthBonus = 1 -- Deepen tactical verification
        self.ContemptFactor = 30
    elseif blunderRate < 0.08 and self.MoveCount >= 6 then
        self.Archetype = "High-Accuracy / Engine"
        self.DynamicDepthBonus = 1
        self.ContemptFactor = 0
    else
        self.Archetype = "Standard Player"
        self.DynamicDepthBonus = 0
        self.ContemptFactor = 20
    end
end

