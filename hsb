Logger.Log("INIT", "v8 Compact Loaded (<16KB). Scanning board...")
task.spawn(ScanRAM)

local LockedSide = nil
local LastSig = ""
local Busy = false

task.spawn(function()
    while Running and task.wait(0.2) do
        local bf = GetBoardFrame()
        if bf and not Busy then
            local tState = DetectTurnAndSide(bf)
            if tState == "IDLE" then LockedSide = nil end

            local maxPly = UpdateMoveCacheFromUI(bf)
            Engine:Reset()
            local applied = 0
            for ply = 1, maxPly do
                local san = MoveCacheByPly[ply]
                if not san then break end
                local m = Engine:ParseSAN(san, (ply % 2 == 1) and 1 or -1)
                if m then
                    Engine:Step(m)
                    table.insert(Engine.Hist, m.uci)
                    applied += 1
                else
                    Logger.Log("WARN", "SAN parse stopped at ply " .. ply .. ": " .. tostring(san))
                    break
                end
            end

            if Config.SideMode == "WHITE" then LockedSide = 1
            elseif Config.SideMode == "BLACK" then LockedSide = -1
            elseif tState == "MY_TURN" then LockedSide = LockedSide or Engine.Side
            elseif tState == "OPP_TURN" then LockedSide = LockedSide or -Engine.Side end

            local mySide = LockedSide or 1
            State.Side = mySide

            local sig = Engine:Signature() .. "|" .. tostring(mySide)
            if sig ~= LastSig or State.Force then
                State.Force = false
                LastSig = sig
                State.Ready = false
                BestArrow:Hide(); PonderArrow:Hide()

                Busy = true
                local calcSide = Engine.Side
                local bestM, ponderM, sc, meta = Engine:FindBest(calcSide, function(d, maxD, pv, nodes)
                    Status.Text = string.format(
                        "Moves: %d | Turn: %s\nCalculating Depth %d/%d...\nCandidate: %s (%d nodes)\n(Arrow hidden until finished)",
                        applied, calcSide == 1 and "WHITE" or "BLACK", d, maxD, tostring(pv), nodes
                    )
                end)

                if bestM then
                    State.Best = bestM
                    State.Ponder = ponderM
                    State.Score = (calcSide == mySide) and sc or -sc
                    State.Ready = Config.Enabled

                    Status.Text = string.format(
                        "Side: %s | Ply: %d (%s)\nBest Move: %s -> %s (%+.2f)\nPonder: %s | [%s | %d nodes]",
                        mySide == 1 and "WHITE" or "BLACK",
                        applied,
                        calcSide == mySide and "YOUR TURN" or "OPPONENT",
                        Alg(bestM.from), Alg(bestM.to),
                        State.Score / 100,
                        ponderM and ponderM.uci or "--",
                        meta, Engine.Nodes
                    )
                    Logger.Log("ESP", string.format("Move %d: %s (%+.2f) [%s]", applied + 1, bestM.uci, State.Score / 100, meta))
                end
                Busy = false
            end
        end
    end
end)
