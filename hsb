local function hasColoredSkill(char)
    if not char then return false end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("Highlight") and obj.Enabled and obj.FillTransparency < 0.92 then
            local fc = obj.FillColor
            local oc = obj.OutlineColor
            local isWhite = (fc.R > 0.8 and fc.G > 0.8 and fc.B > 0.8)
            if not isWhite then
                if (fc.R > 0.68 and fc.G < 0.38) or (oc.R > 0.68 and oc.G < 0.38)
                    or (fc.B > 0.68 and fc.R < 0.42) then
                    return true
                end
            end
        end
    end
    return false
end

-- Kiểm tra chuẩn xác một AnimationTrack có phải là đòn vung vũ khí tấn công không
-- (TUYỆT ĐỐI KHÔNG dùng khoảng cách để blacklist AnimationId như lỗi của V5!)
local function isEnemyAttackTrack(track)
    if not track or not track.IsPlaying then return false end
    if track.Looped then return false end
    if track.Length < 0.22 or track.Length > 1.85 then return false end
    if track.Speed <= 0.15 then return false end

    local prio = track.Priority
    if prio == Enum.AnimationPriority.Core
        or prio == Enum.AnimationPriority.Idle
        or prio == Enum.AnimationPriority.Movement then
        return false
    end

    local name = string.lower(track.Name or "")
    if string.find(name, "idle") or string.find(name, "walk") or string.find(name, "run")
        or string.find(name, "sprint") or string.find(name, "jump") or string.find(name, "fall")
        or string.find(name, "dash") or string.find(name, "dodge") or string.find(name, "roll")
        or string.find(name, "block") or string.find(name, "guard") or string.find(name, "parry")
        or string.find(name, "hit") or string.find(name, "hurt") or string.find(name, "stun")
        or string.find(name, "stagger") or string.find(name, "equip") or string.find(name, "unequip")
        or string.find(name, "emote") or string.find(name, "win") or string.find(name, "death") then
        return false
    end

    return true
end

-- Nhận diện khi đối thủ đang giữ kiếm THỦ (Block)
local function isEnemyBlocking(enemyChar)
    if not enemyChar then return false end
    local hum = enemyChar:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    for k, v in pairs(enemyChar:GetAttributes()) do
        if v == true then
            local n = string.lower(k)
            if string.find(n, "block") or string.find(n, "guard") or string.find(n, "parry") then
                return true
            end
        end
    end
    for _, ch in ipairs(enemyChar:GetChildren()) do
        if ch:IsA("BoolValue") and ch.Value == true then
            local n = string.lower(ch.Name)
            if string.find(n, "block") or string.find(n, "guard") or string.find(n, "parry") then
                return true
            end
        end
    end

    local animator = hum:FindFirstChildOfClass("Animator") or hum
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if track.IsPlaying and track.WeightCurrent > 0.25 then
            local name = string.lower(track.Name or "")
            local prio = track.Priority
            if string.find(name, "block") or string.find(name, "guard") or string.find(name, "parry") then
                return true
            end
            if (prio == Enum.AnimationPriority.Action or prio == Enum.AnimationPriority.Action2) then
                if track.Speed == 0 or (track.Looped and hum.WalkSpeed < 10.5) then
                    return true
                end
            end
        end
    end
    return false
end

-- Hàm phản công NGAY LẬP TỨC sau khi vừa đỡ đòn thành công
local function fireImmediateCounterAttack()
    if not (Config.Mode1v1 or Config.Mode2v2) then return end
    if not State.Target or State.TargetDist > Config.AttackRange then return end

    -- Nhả nút đỡ ngay lập tức để vung kiếm phản công
    doAction("Block", "Up")

    local now = os.clock()
    -- Mở cửa sổ cho phép đánh bồi 2 nhát liên tiếp sau khi đỡ được đòn của địch
    State.CounterWindowUntil = now + 0.65
    State.CounterSwingsLeft = 2

    if isUltimateReady() and (now - State.LastUltTime > 0.5) then
        State.LastUltTime = now
        doAction("Ultimate", "Tap")
    elseif isEnemyBlocking(State.Target) then
        State.LastHeavyTime = now
        doAction("Heavy", "Tap")
    else
        State.LastLightTime = now
        State.CounterSwingsLeft = State.CounterSwingsLeft - 1
        doAction("Light", "Tap")
    end
end

-- Hàm ĐỠ TRỌN NHÁT CHÉM của đối thủ rồi LẬP TỨC ĐÁNH TRẢ (Không nhả sớm khi vũ khí địch chưa chạm tới!)
local function startParryForSwing(enemyChar, track, isColored)
    if not (Config.Mode1v1 or Config.Mode2v2) then return end
    if State.TargetDist > Config.ParryRange then return end

    local now = os.clock()
    -- Huỷ mọi ý định chém đang chờ để ưu tiên tuyệt đối cho việc ĐỠ ĐÒN
    State.CounterSwingsLeft = 0
    State.CounterWindowUntil = 0

    -- 1. Nếu là Skill màu sắc (Đỏ/Tím/Vàng) -> Bấm nút Lướt (Né) rồi phản công ngay
    if isColored then
        if now - State.LastDodgeTime >= 0.30 then
            State.LastDodgeTime = now
            doAction("Dodge", "Tap")
            task.delay(0.16, function()
                fireImmediateCounterAttack()
            end)
        end
        return
    end

    -- 2. Nếu là đòn chém thường:
    -- Tính thời gian vung vũ khí thực tế của nhát chém đó (cây thương/đao dài trong Video 10 mất ~0.35s - 0.48s để chạm người)
    local swingLen = (track and track.Length and track.Length > 0.2) and (track.Length / math.max(track.Speed, 0.5)) or 0.55
    local remainingHitTime = math.clamp((swingLen * 0.62) - (track and track.TimePosition or 0), 0.24, 0.46)

    State.LastParryTime = now
    State.BlockExpireTime = math.max(State.BlockExpireTime, now + remainingHitTime)

    -- Giơ kiếm lên Chặn đòn ngay tức khắc
    doAction("Block", "Down")

    -- Ngay khi lưỡi kiếm/thương của địch vừa đập vào kiếm mình (hoặc kết thúc pha vung) -> Nhả đỡ và CHÉM TRẢ NGAY!
    task.delay(remainingHitTime, function()
        if os.clock() >= State.BlockExpireTime - 0.02 then
            fireImmediateCounterAttack()
        end
    end)
end

-- Gắn cảm biến lên đối thủ: bắt cả AnimationPlayed lẫn âm thanh/hiệu ứng tia lửa khi đỡ đòn thành công (Parry Spark)
local function hookEnemyCharacter(enemyChar)
    if not enemyChar then return end
    local hum = enemyChar:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator") or hum
    if State.HookedAnimators[animator] then return end
    State.HookedAnimators[animator] = true

    -- Bắt 0ms ngay khi đối thủ vừa bắt đầu nhấc vũ khí
    animator.AnimationPlayed:Connect(function(track)
        if not (Config.Mode1v1 or Config.Mode2v2) then return end
        if enemyChar ~= State.Target then return end
        if State.HandledTracks[track] then return end

        if isEnemyAttackTrack(track) then
            State.HandledTracks[track] = true
            local colored = hasColoredSkill(enemyChar)
            startParryForSwing(enemyChar, track, colored)
            if not colored then
                task.delay(0.03, function()
                    if hasColoredSkill(enemyChar) then
                        startParryForSwing(enemyChar, track, true)
                    end
                end)
            end
        end
    end)
end

-- Phát hiện khoảnh khắc kiếm mình vừa ĐỠ TRÚNG đòn của địch (tia lửa Parry / âm thanh keng / địch bị khựng)
local function didJustSuccessfullyParry(myChar, enemyChar)
    if not State.IsBlocking then return false end
    for _, char in ipairs({ myChar, enemyChar }) do
        if char then
            for _, desc in ipairs(char:GetDescendants()) do
                if desc:IsA("Sound") and desc.IsPlaying and desc.TimePosition < 0.18 then
                    local sn = string.lower(desc.Name)
                    if string.find(sn, "parry") or string.find(sn, "clash") or string.find(sn, "clang")
                        or string.find(sn, "block") or string.find(sn, "deflect") or string.find(sn, "spark") then
                        return true
                    end
                elseif desc:IsA("ParticleEmitter") and desc.Enabled then
                    local pn = string.lower(desc.Name)
                    if string.find(pn, "parry") or string.find(pn, "clash") or string.find(pn, "spark") or string.find(pn, "block") then
                        return true
                    end
                end
            end
        end
    end
    return false
end

-- ============================================================================
-- 4. VÒNG LẶP CHIẾN ĐẤU V6: CANH ĐỠ TRƯỚC -> ĐỠ TRÚNG MỚI PHẢN CÔNG!
-- ============================================================================

local function reactiveCombatLoop()
    if not (Config.Mode1v1 or Config.Mode2v2) then
        if State.IsBlocking then doAction("Block", "Up") end
        State.StatusText = "Đang Tắt [OFF]"
        return
    end

    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHum or not myRoot or myHum.Health <= 0 then return end

    local enemy, dist = getTarget()
    if enemy ~= State.Target then
        State.Target = enemy
        State.LastEnemyHealth = nil
        State.CounterSwingsLeft = 0
        if enemy then hookEnemyCharacter(enemy) end
    end
    State.TargetDist = dist

    if not enemy then
        if State.IsBlocking then doAction("Block", "Up") end
        State.StatusText = Config.Mode1v1 and "1v1: Đang đợi đối thủ..." or "2v2: Đang tìm kẻ địch..."
        return
    end

    hookEnemyCharacter(enemy)
    local enemyHum = enemy:FindFirstChildOfClass("Humanoid")
    local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
    if not enemyHum or not enemyRoot then return end

    local now = os.clock()

    -- ========================================================================
    -- 1. NẾU VỪA ĐỠ TRÚNG KIẾM ĐỊCH (NẢY TIA LỬA / KENG) -> PHẢN CÔNG NGAY LẬP TỨC!
    -- ========================================================================
    if State.IsBlocking and didJustSuccessfullyParry(myChar, enemy) then
        State.BlockExpireTime = 0
        fireImmediateCounterAttack()
        return
    end

    -- Tự động nhả nút đỡ khi hết nhịp vung kiếm của địch và chuyển sang phản công
    if State.IsBlocking and now >= State.BlockExpireTime then
        fireImmediateCounterAttack()
    end

    -- ========================================================================
    -- 2. KHI ĐÁNH TRÚNG ĐỊCH (ĐỊCH TỤT MÁU) -> XẢ LUÔN SKILL NỘ (NẾU CÓ)
    -- ========================================================================
    local currentHp = enemyHum.Health
    local enemyTookDamage = false
    if State.LastEnemyHealth ~= nil and currentHp < State.LastEnemyHealth then
        enemyTookDamage = true
        -- Khi chém trúng địch làm địch bị choáng, đánh dấu các track choáng để không nhầm là địch tấn công
        local animator = enemyHum:FindFirstChildOfClass("Animator") or enemyHum
        for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
            State.HandledTracks[t] = true
        end
        if dist <= 13.0 and isUltimateReady() and (now - State.LastUltTime > 0.5) then
            State.LastUltTime = now
            doAction("Ultimate", "Tap")
        end
    end
    State.LastEnemyHealth = currentHp

    -- ========================================================================
    -- 3. QUÉT ĐÒN VUNG KIẾM CỦA ĐỊCH MỖI FRAME (BẮT MỌI NHÁT CHÉM KỂ CẢ KHI VỪA LAO VÀO)
    -- ========================================================================
    local activeSwingTrack = nil
    if not enemyTookDamage then
        local animator = enemyHum:FindFirstChildOfClass("Animator") or enemyHum
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            if isEnemyAttackTrack(track) then
                local progress = (track.Length > 0) and (track.TimePosition / track.Length) or 0.3
                -- Bắt trọn giai đoạn vung vũ khí (từ 0% đến 65% thời lượng nhát chém)
                if progress <= 0.65 and not State.HandledTracks[track] then
                    activeSwingTrack = track
                    break
                end
            end
        end
    end

    local coloredNow = hasColoredSkill(enemy)
    if activeSwingTrack and dist <= Config.ParryRange then
        State.HandledTracks[activeSwingTrack] = true
        startParryForSwing(enemy, activeSwingTrack, coloredNow)
    elseif coloredNow and dist <= Config.ParryRange and (now - State.LastDodgeTime > 0.38) then
        startParryForSwing(enemy, nil, true)
    end

    -- ========================================================================
    -- 4. TỰ ĐI ĐẾN ĐỊCH & XOAY MẶT HƯỚNG VỀ ĐỊCH ĐỂ ĐỠ TRÚNG 100%
    -- ========================================================================
    local myPos = myRoot.Position
    local enemyPos = enemyRoot.Position

    if dist <= 18.5 and dist > 0.5 and (now - State.LastDodgeTime > 0.18) then
        pcall(function()
            myRoot.CFrame = CFrame.lookAt(myPos, Vector3.new(enemyPos.X, myPos.Y, enemyPos.Z))
        end)
    end

    if now - State.LastMoveTime >= 0.05 then
        State.LastMoveTime = now
        if dist > Config.StopWalkRange and dist < 120 then
            local diff = myPos - enemyPos
            local flat = Vector3.new(diff.X, 0, diff.Z)
            local goal = enemyPos
            if flat.Magnitude > 0.1 then
                goal = enemyPos + (flat.Unit * (Config.StopWalkRange - 0.3))
            end
            myHum:MoveTo(goal)
        elseif dist <= Config.StopWalkRange then
            myHum:MoveTo(myPos)
        end
    end

    -- ========================================================================
    -- 5. QUY TẮC TẤN CÔNG NGHIÊM NGẶT (TUYỆT ĐỐI KHÔNG CHÉM BỪA!):
    --    - Nếu địch giơ kiếm THỦ -> Dùng chiêu Phá Phòng Thủ (Nặng / M2) rồi bồi 1 nhát
    --    - Nếu vừa ĐỠ ĐƯỢC đòn của địch (còn trong CounterWindow) -> Chém phản công
    --    - Bình thường khi địch chưa đánh và không thủ -> ĐỨNG CANH ĐỠ, KHÔNG CHÉM BỪA!
    -- ========================================================================
    local enemyBlocking = isEnemyBlocking(enemy)

    if not State.IsBlocking and dist <= Config.AttackRange then
        if enemyBlocking then
            -- Kẻ địch đang thủ -> Dừng ngay chém thường, tung chiêu Phá Phòng Thủ (Nặng / M2)!
            State.CounterSwingsLeft = 0
            if now - State.LastHeavyTime >= 0.58 then
                State.LastHeavyTime = now
                doAction("Heavy", "Tap")
                -- Sau khi phá thủ 0.35s, mở cửa sổ bồi thêm 1 nhát chém
                State.CounterWindowUntil = now + 0.70
                State.CounterSwingsLeft = 1
            end

        elseif isUltimateReady() and (now <= State.CounterWindowUntil) and (now - State.LastUltTime >= 0.55) then
            -- Vừa đỡ đòn xong mà có Skill Nộ -> Xả luôn Skill Nộ!
            State.LastUltTime = now
            doAction("Ultimate", "Tap")

        elseif now <= State.CounterWindowUntil and State.CounterSwingsLeft > 0 then
            -- Chỉ chém trả trong cửa sổ phản công sau khi vừa ĐỠ ĐƯỢC đòn của đối thủ!
            if now - State.LastLightTime >= 0.25 then
                State.LastLightTime = now
                State.CounterSwingsLeft = State.CounterSwingsLeft - 1
                doAction("Light", "Tap")
            end
        end
    end

    local modeTag = Config.Mode1v1 and "1v1" or "2v2"
    local statusAction = State.IsBlocking and "ĐANG ĐỠ ĐÒN!"
        or (enemyBlocking and "ĐỊCH THỦ -> PHÁ GIÁP!"
        or (now <= State.CounterWindowUntil and "PHẢN CÔNG NGAY!"
        or "Canh đỡ đòn địch"))
    State.StatusText = string.format("[%s] %s (%.1fm) %s", modeTag, enemy.Name:sub(1, 8), dist, statusAction)
end

