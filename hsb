local function IsPointOverShootControl(screenPos)
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if pGui then
        local guiObjects = pGui:GetGuiObjectsAtPosition(screenPos.X, screenPos.Y)
        for _, obj in ipairs(guiObjects) do
            if obj.Visible and not obj:IsDescendantOf(ScreenGui) then
                local nameLower = string.lower(obj.Name)
                local parentLower = obj.Parent and string.lower(obj.Parent.Name) or ""
                if string.find(nameLower, "fire")
                    or string.find(nameLower, "shoot")
                    or string.find(nameLower, "attack")
                    or string.find(nameLower, "bullet")
                    or string.find(nameLower, "punch")
                    or string.find(nameLower, "melee")
                    or string.find(parentLower, "fire")
                    or string.find(parentLower, "shoot")
                    or string.find(parentLower, "attack") then
                    return true
                end
            end
        end
    end

    local vp = Camera.ViewportSize
    local normX = screenPos.X / vp.X
    local normY = screenPos.Y / vp.Y
    if normX >= 0.62 and normX <= 0.96 and normY >= 0.36 and normY <= 0.88 then
        return true
    end
    return false
end

