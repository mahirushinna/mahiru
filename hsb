                local currentSig = table.concat(sanList, " ")
                local ramBoard = GetActiveRAMBoard()
                local ramPly = ramBoard and ramBoard.ply or -1

                if currentSig ~= LastSyncedSig or (ramPly >= 0 and ramPly ~= LastRAMPly) then
                    Engine:Reset()
                    local applied = 0
                    for _, san in ipairs(sanList) do
                        local sideToMove = (applied % 2 == 0) and 1 or -1
                        local parsed = Engine:ParseSANMove(san, sideToMove)
                        if parsed then
