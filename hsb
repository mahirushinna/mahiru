-- Detects whether LocalPlayer is White (1) or Black (-1) by inspecting the bottom rank label or player card
local function DetectPlayerColor()
    -- Check rank/file labels on the board edges ("1" near bottom = White, "8" near bottom = Black)
    local rank1Y, rank8Y = nil, nil
    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible then
            local txt = string.gsub(desc.Text, "%s+", "")
            if txt == "1" and desc.AbsoluteSize.X < 35 then
                rank1Y = desc.AbsolutePosition.Y
            elseif txt == "8" and desc.AbsoluteSize.X < 35 then
                rank8Y = desc.AbsolutePosition.Y
            end
        end
    end
    if rank1Y and rank8Y then
        return (rank1Y > rank8Y) and 1 or -1
    end
    return 1
end

-- Scrapes the algebraic move list shown in the RoChess bottom panel (e.g. "1. e4 Na6 2. Bc4 Nb4")
local function ScrapeMoveListFromUI()
    local moveTokens = {}
    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible then
            local t = string.gsub(desc.Text, "^%s*(.-)%s*$", "%1")
            -- Match valid SAN move tokens like "e4", "Na6", "Bc4", "cxb4", "Qxd3", "O-O"
            if string.match(t, "^[NBRQK]?[a-h]?[1-8]?x?[a-h][1-8][+#]?$") or t == "O-O" or t == "O-O-O" then
                table.insert(moveTokens, {
                    text = t,
                    y = math.floor(desc.AbsolutePosition.Y / 6) * 6,
                    x = desc.AbsolutePosition.X
                })
            end
        end
    end

    table.sort(moveTokens, function(a, b)
        if math.abs(a.y - b.y) > 8 then
            return a.y < b.y
        end
        return a.x < b.x
    end)

    local orderedSAN = {}
    for _, item in ipairs(moveTokens) do
        table.insert(orderedSAN, item.text)
    end
    return orderedSAN
end

