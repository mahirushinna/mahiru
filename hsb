local function MakeArrowESP(color, trans, z)
    local g = {}
    g.FromBox = Instance.new("Frame", Overlay)
    g.FromBox.BackgroundColor3 = color
    g.FromBox.BackgroundTransparency = 0.65
    g.FromBox.BorderSizePixel = 0
    g.FromBox.ZIndex = z
    g.FromBox.Visible = false
    Instance.new("UICorner", g.FromBox).CornerRadius = UDim.new(0, 6)
    local fs = Instance.new("UIStroke", g.FromBox)
    fs.Color = color; fs.Thickness = 2.5

    g.ToBox = Instance.new("Frame", Overlay)
    g.ToBox.BackgroundColor3 = color
    g.ToBox.BackgroundTransparency = 0.65
    g.ToBox.BorderSizePixel = 0
    g.ToBox.ZIndex = z
    g.ToBox.Visible = false
    Instance.new("UICorner", g.ToBox).CornerRadius = UDim.new(0, 6)
    local ts = Instance.new("UIStroke", g.ToBox)
    ts.Color = color; ts.Thickness = 2.5

    g.Shaft = Instance.new("Frame", Overlay)
    g.Shaft.BackgroundColor3 = color
    g.Shaft.BackgroundTransparency = trans
    g.Shaft.BorderSizePixel = 0
    g.Shaft.AnchorPoint = Vector2.new(0.5, 0.5)
    g.Shaft.ZIndex = z + 1
    g.Shaft.Visible = false
    Instance.new("UICorner", g.Shaft).CornerRadius = UDim.new(0, 4)

    g.Head = {}
    for i = 1, 5 do
        local s = Instance.new("Frame", Overlay)
        s.BackgroundColor3 = color
        s.BackgroundTransparency = trans
        s.BorderSizePixel = 0
        s.AnchorPoint = Vector2.new(0.5, 0.5)
        s.ZIndex = z + 2
        s.Visible = false
        Instance.new("UICorner", s).CornerRadius = UDim.new(0, 2)
        g.Head[i] = s
    end

    function g:Hide()
        self.FromBox.Visible = false
        self.ToBox.Visible = false
        self.Shaft.Visible = false
        for i = 1, 5 do self.Head[i].Visible = false end
    end

    function g:Draw(fx, fy, tx, ty, cellW)
        local dx, dy = tx - fx, ty - fy
        local dist = math.sqrt(dx * dx + dy * dy)
        if dist < 4 then self:Hide() return end
        local ux, uy = dx / dist, dy / dist
        local ang = math.deg(math.atan2(dy, dx))
        local bSz = math.floor(cellW * 0.90)

        self.FromBox.Size = UDim2.fromOffset(bSz, bSz)
        self.FromBox.Position = UDim2.fromOffset(fx - bSz * 0.5, fy - bSz * 0.5)
        self.FromBox.Visible = true

        self.ToBox.Size = UDim2.fromOffset(bSz, bSz)
        self.ToBox.Position = UDim2.fromOffset(tx - bSz * 0.5, ty - bSz * 0.5)
        self.ToBox.Visible = true

        local hLen = math.clamp(cellW * 0.52, 16, 34)
        local hWid = math.clamp(cellW * 0.58, 18, 38)
        local sThk = math.clamp(cellW * 0.24, 8, 15)
        local sLen = math.max(4, dist - hLen)

        self.Shaft.Size = UDim2.fromOffset(sLen, sThk)
        self.Shaft.Position = UDim2.fromOffset(fx + ux * (sLen * 0.5), fy + uy * (sLen * 0.5))
        self.Shaft.Rotation = ang
        self.Shaft.Visible = true

        local bx, by = tx - ux * hLen, ty - uy * hLen
        for i = 1, 5 do
            local t = (i - 0.5) / 5
            local w = math.max(3, hWid * (1.0 - t * 0.86))
            local sl = self.Head[i]
            sl.Size = UDim2.fromOffset(hLen / 5 + 2, w)
            sl.Position = UDim2.fromOffset(bx + ux * (t * hLen), by + uy * (t * hLen))
            sl.Rotation = ang
            sl.Visible = true
        end
    end
    return g
end

