        -1, -1, -1, -1, -1, -1, -1, -1,
        -4, -2, -3, -5, -6, -3, -2, -4
    }
    self.Side = 1
    self.WK, self.WQ, self.BK, self.BQ = true, true, true, true
    self.EP = nil
    self.WKingSq = 5
    self.BKingSq = 61
    self.Hist = {}
    self.Nodes = 0
    self.Killers1 = {}
    self.Killers2 = {}
    self.HistHeur = {}
    self.Aborted = false
    self.SearchDeadline = 0
    self.LastYieldClock = 0

    -- Initialize incremental MG, EG, Phase, and Zobrist Hash
    local mg, eg, ph, h = 0, 0, 0, Zobrist.Side
    for sq = 1, 64 do
        local p = self.B[sq]
        if p ~= 0 then
            mg += FAST_MG[p][sq]
            eg += FAST_EG[p][sq]
            ph += PHASE_WEIGHTS[math.abs(p)]
            h = bit32.bxor(h, Zobrist.PieceSq[p][sq])
        end
    end
    self.MG = mg
    self.EG = eg
    self.Phase = ph
    self.Hash = h
end
Engine:Reset()

function Engine:Signature()
    local t = table.create(65)
    for i = 1, 64 do t[i] = tostring(self.B[i]) end
    t[65] = tostring(self.Side)
    return table.concat(t, ",")
end

-- In-Place MakeMove: Updates board, king positions, Zobrist hash, and MG/EG scores in O(1) time!
function Engine:MakeMove(m, ply)
    local u = UndoStack[ply]
    local b = self.B
    local s = self.Side
    local from, to = m.from, m.to
    local piece = m.piece
    local placed = m.promo or piece
    local cap = m.cap

    u.from = from
    u.to = to
    u.piece = piece
    u.cap = cap
    u.promo = m.promo
    u.ep = m.ep
    u.castle = m.castle
    u.prevEP = self.EP
    u.prevWK, u.prevWQ, u.prevBK, u.prevBQ = self.WK, self.WQ, self.BK, self.BQ
    u.prevHash = self.Hash
    u.prevMG = self.MG
    u.prevEG = self.EG
    u.prevPhase = self.Phase
    u.prevWKingsq = self.WKingSq
    u.prevBKingsq = self.BKingSq

    local h = bit32.bxor(self.Hash, Zobrist.Side)
    local mg = self.MG - FAST_MG[piece][from] + FAST_MG[placed][to]
    local eg = self.EG - FAST_EG[piece][from] + FAST_EG[placed][to]
    local ph = self.Phase

    h = bit32.bxor(h, Zobrist.PieceSq[piece][from])
    h = bit32.bxor(h, Zobrist.PieceSq[placed][to])

    if m.promo then
        ph += PHASE_WEIGHTS[math.abs(placed)]
    end

    b[to] = placed
    b[from] = 0

    if m.ep then
        local capSq = to - s * 8
        local epPawn = -s
        b[capSq] = 0
        mg -= FAST_MG[epPawn][capSq]
        eg -= FAST_EG[epPawn][capSq]
        h = bit32.bxor(h, Zobrist.PieceSq[epPawn][capSq])
    elseif cap ~= 0 then
        mg -= FAST_MG[cap][to]
        eg -= FAST_EG[cap][to]
        ph -= PHASE_WEIGHTS[math.abs(cap)]
        h = bit32.bxor(h, Zobrist.PieceSq[cap][to])
    end

    if m.castle then
        if m.castle == "WK" then
            b[6] = 4; b[8] = 0
            mg += FAST_MG[4][6] - FAST_MG[4][8]
            eg += FAST_EG[4][6] - FAST_EG[4][8]
            h = bit32.bxor(bit32.bxor(h, Zobrist.PieceSq[4][8]), Zobrist.PieceSq[4][6])
        elseif m.castle == "WQ" then
            b[4] = 4; b[1] = 0
            mg += FAST_MG[4][4] - FAST_MG[4][1]
            eg += FAST_EG[4][4] - FAST_EG[4][1]
            h = bit32.bxor(bit32.bxor(h, Zobrist.PieceSq[4][1]), Zobrist.PieceSq[4][4])
        elseif m.castle == "BK" then
            b[62] = -4; b[64] = 0
            mg += FAST_MG[-4][62] - FAST_MG[-4][64]
            eg += FAST_EG[-4][62] - FAST_EG[-4][64]
            h = bit32.bxor(bit32.bxor(h, Zobrist.PieceSq[-4][64]), Zobrist.PieceSq[-4][62])
        elseif m.castle == "BQ" then
            b[60] = -4; b[57] = 0
            mg += FAST_MG[-4][60] - FAST_MG[-4][57]
            eg += FAST_EG[-4][60] - FAST_EG[-4][57]
            h = bit32.bxor(bit32.bxor(h, Zobrist.PieceSq[-4][57]), Zobrist.PieceSq[-4][60])
        end
    end

    if piece == 6 then
        self.WKingSq = to
        self.WK, self.WQ = false, false
    elseif piece == -6 then
        self.BKingSq = to
        self.BK, self.BQ = false, false
    end

    if from == 1 or to == 1 then self.WQ = false end
    if from == 8 or to == 8 then self.WK = false end
    if from == 57 or to == 57 then self.BQ = false end
    if from == 64 or to == 64 then self.BK = false end

    self.EP = m.dbl and (from + s * 8) or nil
    self.Side = -s
    self.Hash = h
    self.MG = mg
    self.EG = eg
    self.Phase = ph
end

-- In-Place UnmakeMove: Restores board state in O(1) time without a single table allocation!
function Engine:UnmakeMove(ply)
    local u = UndoStack[ply]
    local b = self.B
    local s = -self.Side

    b[u.from] = u.piece
    if u.ep then
        b[u.to] = 0
        b[u.to - s * 8] = -s
    else
        b[u.to] = u.cap
    end

    if u.castle then
        if u.castle == "WK" then b[8] = 4; b[6] = 0
        elseif u.castle == "WQ" then b[1] = 4; b[4] = 0
        elseif u.castle == "BK" then b[64] = -4; b[62] = 0
        elseif u.castle == "BQ" then b[57] = -4; b[60] = 0
        end
    end

    self.Side = s
    self.EP = u.prevEP
    self.WK, self.WQ, self.BK, self.BQ = u.prevWK, u.prevWQ, u.prevBK, u.prevBQ
    self.Hash = u.prevHash
    self.MG = u.prevMG
    self.EG = u.prevEG
    self.Phase = u.prevPhase
    self.WKingSq = u.prevWKingsq
    self.BKingSq = u.prevBKingsq
end

function Engine:Attacked(sq, bySide)
    local f, r = FR(sq)
    local b = self.B
    local pr = r - bySide
    if pr >= 1 and pr <= 8 then
        if f > 1 and b[Sq(f - 1, pr)] == bySide then return true end
        if f < 8 and b[Sq(f + 1, pr)] == bySide then return true end
    end
    -- Unrolled Knight checks
    local nf, nr
    nf = f - 2; if nf >= 1 then
        nr = r - 1; if nr >= 1 and b[Sq(nf, nr)] == bySide * 2 then return true end
        nr = r + 1; if nr <= 8 and b[Sq(nf, nr)] == bySide * 2 then return true end
    end
    nf = f - 1; if nf >= 1 then
        nr = r - 2; if nr >= 1 and b[Sq(nf, nr)] == bySide * 2 then return true end
        nr = r + 2; if nr <= 8 and b[Sq(nf, nr)] == bySide * 2 then return true end
    end
    nf = f + 1; if nf <= 8 then
        nr = r - 2; if nr >= 1 and b[Sq(nf, nr)] == bySide * 2 then return true end
        nr = r + 2; if nr <= 8 and b[Sq(nf, nr)] == bySide * 2 then return true end
    end
    nf = f + 2; if nf <= 8 then
        nr = r - 1; if nr >= 1 and b[Sq(nf, nr)] == bySide * 2 then return true end
        nr = r + 1; if nr <= 8 and b[Sq(nf, nr)] == bySide * 2 then return true end
    end

    -- Orthogonal Rays (Rook / Queen)
    local rook, queen = bySide * 4, bySide * 5
    for cf = f + 1, 8 do local p = b[Sq(cf, r)]; if p ~= 0 then if p == rook or p == queen then return true end break end end
    for cf = f - 1, 1, -1 do local p = b[Sq(cf, r)]; if p ~= 0 then if p == rook or p == queen then return true end break end end
    for cr = r + 1, 8 do local p = b[Sq(f, cr)]; if p ~= 0 then if p == rook or p == queen then return true end break end end
    for cr = r - 1, 1, -1 do local p = b[Sq(f, cr)]; if p ~= 0 then if p == rook or p == queen then return true end break end end

    -- Diagonal Rays (Bishop / Queen)
    local bishop = bySide * 3
    local cf, cr = f + 1, r + 1
    while cf <= 8 and cr <= 8 do local p = b[Sq(cf, cr)]; if p ~= 0 then if p == bishop or p == queen then return true end break end cf += 1; cr += 1 end
    cf, cr = f + 1, r - 1
    while cf <= 8 and cr >= 1 do local p = b[Sq(cf, cr)]; if p ~= 0 then if p == bishop or p == queen then return true end break end cf += 1; cr -= 1 end
    cf, cr = f - 1, r + 1
    while cf >= 1 and cr <= 8 do local p = b[Sq(cf, cr)]; if p ~= 0 then if p == bishop or p == queen then return true end break end cf -= 1; cr += 1 end
    cf, cr = f - 1, r - 1
    while cf >= 1 and cr >= 1 do local p = b[Sq(cf, cr)]; if p ~= 0 then if p == bishop or p == queen then return true end break end cf -= 1; cr -= 1 end

    -- King adjacent
    local oppKingSq = (bySide == 1) and self.WKingSq or self.BKingSq
    local kf, kr = FR(oppKingSq)
    if math.abs(f - kf) <= 1 and math.abs(r - kr) <= 1 then return true end

    return false
end

function Engine:InCheck(side)
    local kSq = (side == 1) and self.WKingSq or self.BKingSq
    return self:Attacked(kSq, -side)
end

function Engine:FormatMoveLabel(m)
    if m.castle == "WK" or m.castle == "BK" then return "O-O" end
    if m.castle == "WQ" or m.castle == "BQ" then return "O-O-O" end
    local ap = math.abs(m.piece)
    local sym = PIECE_SYMBOLS[ap] or ""
    local capStr = (m.cap ~= 0 or m.ep) and "x" or ""
    if ap == 1 and capStr == "x" then
        sym = string.sub(Alg(m.from), 1, 1)
    end
    return sym .. capStr .. Alg(m.to) .. (m.promo and "=Q" or "")
end

function Engine:GeneratePseudoMoves(side, capsOnly)
    local pseudo, b = {}, self.B
    for sq = 1, 64 do
        local p = b[sq]
        if p * side > 0 then
            local ap = math.abs(p)
            local f, r = FR(sq)
            if ap == 1 then
                local fw = r + side
                if fw >= 1 and fw <= 8 then
                    local one = Sq(f, fw)
                    local prm = (fw == 8 or fw == 1) and (side * 5) or nil
                    if not capsOnly and b[one] == 0 then
                        pseudo[#pseudo + 1] = { from = sq, to = one, piece = p, cap = 0, promo = prm }
                        if r == ((side == 1) and 2 or 7) and b[Sq(f, r + 2 * side)] == 0 then
                            pseudo[#pseudo + 1] = { from = sq, to = Sq(f, r + 2 * side), piece = p, cap = 0, dbl = true }
                        end
                    end
                    if f > 1 then
                        local tSq = Sq(f - 1, fw)
                        local tP = b[tSq]
                        if tP * side < 0 then
                            pseudo[#pseudo + 1] = { from = sq, to = tSq, piece = p, cap = tP, promo = prm }
                        elseif tSq == self.EP then
                            pseudo[#pseudo + 1] = { from = sq, to = tSq, piece = p, cap = -side, ep = true }
                        end
                    end
                    if f < 8 then
                        local tSq = Sq(f + 1, fw)
                        local tP = b[tSq]
                        if tP * side < 0 then
                            pseudo[#pseudo + 1] = { from = sq, to = tSq, piece = p, cap = tP, promo = prm }
                        elseif tSq == self.EP then
                            pseudo[#pseudo + 1] = { from = sq, to = tSq, piece = p, cap = -side, ep = true }
                        end
                    end
                end
            elseif ap == 2 then
                for _, o in ipairs({{-2,-1},{-2,1},{-1,-2},{-1,2},{1,-2},{1,2},{2,-1},{2,1}}) do
                    local nf, nr = f + o[1], r + o[2]
                    if nf >= 1 and nf <= 8 and nr >= 1 and nr <= 8 then
                        local tSq = Sq(nf, nr)
                        local tP = b[tSq]
                        if tP * side <= 0 and (not capsOnly or tP ~= 0) then
                            pseudo[#pseudo + 1] = { from = sq, to = tSq, piece = p, cap = tP }
                        end
                    end
                end
            elseif ap >= 3 and ap <= 5 then
                local dirs = {}
                if ap ~= 4 then dirs[#dirs+1]={1,1}; dirs[#dirs+1]={1,-1}; dirs[#dirs+1]={-1,1}; dirs[#dirs+1]={-1,-1} end
                if ap ~= 3 then dirs[#dirs+1]={1,0}; dirs[#dirs+1]={-1,0}; dirs[#dirs+1]={0,1}; dirs[#dirs+1]={0,-1} end
                for _, d in ipairs(dirs) do
                    local cf, cr = f + d[1], r + d[2]
                    while cf >= 1 and cf <= 8 and cr >= 1 and cr <= 8 do
                        local tSq = Sq(cf, cr)
                        local tP = b[tSq]
                        if tP == 0 then
                            if not capsOnly then pseudo[#pseudo + 1] = { from = sq, to = tSq, piece = p, cap = 0 } end
                        else
                            if tP * side < 0 then pseudo[#pseudo + 1] = { from = sq, to = tSq, piece = p, cap = tP } end
                            break
                        end
                        cf += d[1]; cr += d[2]
                    end
                end
            elseif ap == 6 then
                for df = -1, 1 do
                    for dr = -1, 1 do
                        if df ~= 0 or dr ~= 0 then
                            local kf, kr = f + df, r + dr
                            if kf >= 1 and kf <= 8 and kr >= 1 and kr <= 8 then
                                local tSq = Sq(kf, kr)
                                local tP = b[tSq]
                                if tP * side <= 0 and (not capsOnly or tP ~= 0) then
                                    pseudo[#pseudo + 1] = { from = sq, to = tSq, piece = p, cap = tP }
                                end
                            end
                        end
                    end
                end
                if not capsOnly and not self:InCheck(side) then
                    if side == 1 and sq == 5 then
                        if self.WK and b[6] == 0 and b[7] == 0 and b[8] == 4 and not self:Attacked(6, -1) and not self:Attacked(7, -1) then
                            pseudo[#pseudo + 1] = { from = 5, to = 7, piece = 6, cap = 0, castle = "WK" }
                        end
                        if self.WQ and b[4] == 0 and b[3] == 0 and b[2] == 0 and b[1] == 4 and not self:Attacked(4, -1) and not self:Attacked(3, -1) then
                            pseudo[#pseudo + 1] = { from = 5, to = 3, piece = 6, cap = 0, castle = "WQ" }
                        end
                    elseif side == -1 and sq == 61 then
                        if self.BK and b[62] == 0 and b[63] == 0 and b[64] == -4 and not self:Attacked(62, 1) and not self:Attacked(63, 1) then
                            pseudo[#pseudo + 1] = { from = 61, to = 63, piece = -6, cap = 0, castle = "BK" }
                        end
                        if self.BQ and b[60] == 0 and b[59] == 0 and b[58] == 0 and b[57] == -4 and not self:Attacked(60, 1) and not self:Attacked(59, 1) then
                            pseudo[#pseudo + 1] = { from = 61, to = 59, piece = -6, cap = 0, castle = "BQ" }
                        end
                    end
                end
            end
        end
    end
    return pseudo
end

-- Helper for UI/Root Legal Move Generation (uses ply 60 on UndoStack)
function Engine:RootLegalMoves(side)
    side = side or self.Side
    local pseudo = self:GeneratePseudoMoves(side, false)
    local legal = {}
    for _, m in ipairs(pseudo) do
        self:MakeMove(m, 60)
        if not self:InCheck(side) then
            m.uci = Alg(m.from) .. Alg(m.to) .. (m.promo and "q" or "")
            m.san = self:FormatMoveLabel(m)
            legal[#legal + 1] = m
        end
        self:UnmakeMove(60)
    end
    return legal
end

-- O(1) Tapered Evaluation + Endgame Mating-Net King Tropism!
function Engine:Eval()
    local mgW = math.min(self.Phase, 24)
    local egW = 24 - mgW
    local score = (self.MG * mgW + self.EG * egW) / 24

    -- Endgame Mating-Net Bonus: Drive enemy King to the corner when winning in endgame!
    if egW > 14 and math.abs(score) > 300 then
        local losingSide = (score > 0) and -1 or 1
        local losingKingSq = (losingSide == 1) and self.WKingSq or self.BKingSq
        local winningKingSq = (losingSide == 1) and self.BKingSq or self.WKingSq
        local lf, lr = FR(losingKingSq)
        local wf, wr = FR(winningKingSq)
        local centerDist = math.abs(lf - 4.5) + math.abs(lr - 4.5)
        local kingDist = math.abs(lf - wf) + math.abs(lr - wr)
        local mopUp = (centerDist * 12) + ((14 - kingDist) * 6)
        score += (score > 0) and mopUp or -mopUp
    end

    return score * self.Side
end

function Engine:OrderMoves(moves, ply, ttUCI)
    local k1, k2 = self.Killers1[ply], self.Killers2[ply]
    local hh = self.HistHeur
    for i = 1, #moves do
        local m = moves[i]
        local uci = m.uci
        if not uci then
            uci = Alg(m.from) .. Alg(m.to) .. (m.promo and "q" or "")
            m.uci = uci
        end
        local s = 0
        if ttUCI and uci == ttUCI then
            s = 100000
        elseif m.cap ~= 0 then
            s = 20000 + (PIECE_VALUES[math.abs(m.cap)] * 10) - PIECE_VALUES[math.abs(m.piece)]
        elseif m.promo then
            s = 18000
        elseif uci == k1 then
            s = 9000
        elseif uci == k2 then
            s = 8000
        elseif m.castle then
            s = 4000
        else
            s = hh[uci] or 0
        end
        m.sortScore = s
    end
    table.sort(moves, function(a, b)
        return a.sortScore > b.sortScore
    end)
end

-- Check Time Budget & Frame-Slice Yield every 512 nodes
function Engine:CheckClock()
    local now = os.clock()
    if now >= self.SearchDeadline then
        self.Aborted = true
        return true
    end
    if (now - self.LastYieldClock) >= Config.FrameSliceBudget then
        RunService.Heartbeat:Wait()
        self.LastYieldClock = os.clock()
        if self.LastYieldClock >= self.SearchDeadline then
            self.Aborted = true
            return true
        end
    end
    return false
end

function Engine:Quiesce(alpha, beta, qd, ply)
    self.Nodes += 1
    if bit32.band(self.Nodes, 511) == 0 and self:CheckClock() then
        return 0
    end

    local sp = self:Eval()
    if sp >= beta then return beta end
    if alpha < sp then alpha = sp end
    if qd <= 0 or ply >= 58 then return sp end

    local side = self.Side
    local pseudoCaps = self:GeneratePseudoMoves(side, true)
    if #pseudoCaps == 0 then return alpha end
    self:OrderMoves(pseudoCaps, ply, nil)

    for i = 1, #pseudoCaps do
        local m = pseudoCaps[i]
        -- Delta Pruning: skip captures that cannot possibly raise alpha
        if not m.promo and (sp + PIECE_VALUES[math.abs(m.cap)] + 180 < alpha) then
            continue
        end
        self:MakeMove(m, ply)
        if not self:InCheck(side) then
            local sc = -self:Quiesce(-beta, -alpha, qd - 1, ply + 1)
            self:UnmakeMove(ply)
            if self.Aborted then return 0 end
            if sc >= beta then return beta end
            if sc > alpha then alpha = sc end
        else
            self:UnmakeMove(ply)
        end
    end
    return alpha
end

function Engine:PVSearch(depth, alpha, beta, ply, allowNull)
    self.Nodes += 1
    if bit32.band(self.Nodes, 511) == 0 and self:CheckClock() then
        return 0
    end

    local hash = self.Hash
    local tt = TranspositionTable[hash]
    if tt and tt.depth >= depth and ply > 1 then
        if tt.flag == "EXACT" then return tt.score end
        if tt.flag == "LOWER" and tt.score >= beta then return tt.score end
        if tt.flag == "UPPER" and tt.score <= alpha then return tt.score end
    end

    if depth <= 0 or ply >= 55 then
        return self:Quiesce(alpha, beta, 5, ply)
    end

    local side = self.Side
    local inChk = self:InCheck(side)
    if inChk then
        depth += 1
    else
        local staticEval = self:Eval()
        -- Reverse Futility Pruning (Static Null Move Pruning) at shallow depths
        if depth <= 2 and math.abs(beta) < 9000 and (staticEval - depth * 110) >= beta then
            return staticEval - depth * 110
        end
        -- Null-Move Pruning
        if allowNull and depth >= 3 and ply > 1 and self.Phase > 4 and staticEval >= beta then
            local savedEP = self.EP
            local savedHash = self.Hash
            self.Side = -side
            self.EP = nil
            self.Hash = bit32.bxor(savedHash, Zobrist.Side)
            local nullSc = -self:PVSearch(depth - 3, -beta, -beta + 1, ply + 1, false)
            self.Side = side
            self.EP = savedEP
            self.Hash = savedHash
            if self.Aborted then return 0 end
            if nullSc >= beta then return beta end
        end
    end

    local pseudo = self:GeneratePseudoMoves(side, false)
    self:OrderMoves(pseudo, ply, tt and tt.bestUCI or nil)

    local origAlpha = alpha
    local bestUCI = nil
    local legalCount = 0

    for i = 1, #pseudo do
        local m = pseudo[i]
        self:MakeMove(m, ply)
        if not self:InCheck(side) then
            legalCount += 1
            local sc
            if legalCount == 1 then
                sc = -self:PVSearch(depth - 1, -beta, -alpha, ply + 1, true)
            else
                -- Late Move Reductions (LMR)
                local reduction = 0
                if legalCount > 3 and depth >= 3 and not inChk and m.cap == 0 and not m.promo then
                    reduction = (legalCount > 8 and depth >= 4) and 2 or 1
                end
                sc = -self:PVSearch(depth - 1 - reduction, -alpha - 1, -alpha, ply + 1, true)
                if not self.Aborted and sc > alpha and reduction > 0 then
                    sc = -self:PVSearch(depth - 1, -alpha - 1, -alpha, ply + 1, true)
                end
                if not self.Aborted and sc > alpha and sc < beta then
                    sc = -self:PVSearch(depth - 1, -beta, -alpha, ply + 1, true)
                end
            end

            self:UnmakeMove(ply)
            if self.Aborted then return 0 end

            if sc >= beta then
                if m.cap == 0 then
                    if self.Killers1[ply] ~= m.uci then
                        self.Killers2[ply] = self.Killers1[ply]
                        self.Killers1[ply] = m.uci
                    end
                    self.HistHeur[m.uci] = math.min(6000, (self.HistHeur[m.uci] or 0) + depth * depth)
                end
                TranspositionTable[hash] = { score = beta, depth = depth, flag = "LOWER", bestUCI = m.uci }
                return beta
            end
            if sc > alpha then
                alpha = sc
                bestUCI = m.uci
            end
        else
            self:UnmakeMove(ply)
        end
    end

    if legalCount == 0 then
        return inChk and (-19000 + ply) or 0
    end

    local flag = (alpha > origAlpha) and "EXACT" or "UPPER"
    TranspositionTable[hash] = { score = alpha, depth = depth, flag = flag, bestUCI = bestUCI or pseudo[1].uci }
    return alpha
end

-- Fast Time-Bounded Iterative Deepening: Completes in 0.15s - 0.32s!
function Engine:AnalyzeFast(side, timeBudget, shouldAbortFn, onDepthDone)
    self.Side = side
    local legal = self:RootLegalMoves(side)
    if #legal == 0 then return nil, nil, nil, 0, "No Moves", 0 end

    -- 1. Instant Grandmaster Opening Book Lookup (0.001s!)
    local hKey = table.concat(self.Hist, " ")
    local bookUCI = OpeningBook[hKey]
    if bookUCI then
        for _, m in ipairs(legal) do
            if m.uci == bookUCI then
                self:MakeMove(m, 58)
                local oppMoves = self:RootLegalMoves(-side)
                self:OrderMoves(oppMoves, 1, nil)
                local ponderM = oppMoves[1]
                self:UnmakeMove(58)
                local altM = (#legal > 1) and (legal[1].uci ~= m.uci and legal[1] or legal[2]) or nil
                return m, altM, ponderM, 95, "GM Book", 0.001
            end
        end
    end

    if #legal == 1 then
        return legal[1], nil, nil, self:Eval(), "Forced", 0.001
    end

    local startClock = os.clock()
    self.SearchDeadline = startClock + (timeBudget or Config.ThinkTimeLimit)
    self.LastYieldClock = startClock
    self.Aborted = false
    self.Nodes = 0

    local bestMove = legal[1]
    local secondMove = legal[2]
    local bestScore = 0
    local completedDepth = 1
    local moveScores = {}

    for d = 1, Config.MaxDepth do
        if shouldAbortFn and shouldAbortFn() then
            self.Aborted = true
            break
        end

        self:OrderMoves(legal, 1, bestMove and bestMove.uci or nil)
        local alpha = -30000
        local beta = 30000
        local iterBestM = legal[1]
        local iterBestSc = -30000
        local iterScores = {}

        for idx, m in ipairs(legal) do
            if shouldAbortFn and shouldAbortFn() then
                self.Aborted = true
                break
            end
            self:MakeMove(m, 1)
            local sc
            if idx == 1 or d <= 2 then
                sc = -self:PVSearch(d - 1, -beta, -alpha, 2, true)
            else
                sc = -self:PVSearch(d - 1, -alpha - 1, -alpha, 2, true)
                if not self.Aborted and sc > alpha then
                    sc = -self:PVSearch(d - 1, -beta, -alpha, 2, true)
                end
            end
            self:UnmakeMove(1)

            if self.Aborted then break end

            iterScores[m.uci] = sc
            if sc > iterBestSc then
                iterBestSc = sc
                iterBestM = m
            end
            if sc > alpha then
                alpha = sc
            end
        end

        if not self.Aborted then
            completedDepth = d
            bestMove = iterBestM
            bestScore = iterBestSc
            moveScores = iterScores

            table.sort(legal, function(a, b)
                return (moveScores[a.uci] or -99999) > (moveScores[b.uci] or -99999)
            end)
            bestMove = legal[1]
            secondMove = legal[2]

            if onDepthDone then
                pcall(onDepthDone, d, bestMove, bestScore, self.Nodes, os.clock() - startClock)
            end

            -- Stop early if forced checkmate found or >60% of time budget already used
            if math.abs(bestScore) >= 18000 or (os.clock() - startClock) >= (timeBudget * 0.58) then
                break
            end
        else
            break
        end
    end

    -- Extract Opponent Ponder Reply instantaneously via TT or 1-ply lookup
    local ponderMove = nil
    self:MakeMove(bestMove, 58)
    local childTT = TranspositionTable[self.Hash]
    local oppMoves = self:RootLegalMoves(-side)
    if childTT and childTT.bestUCI then
        for _, om in ipairs(oppMoves) do
            if om.uci == childTT.bestUCI then ponderMove = om; break end
        end
    end
    if not ponderMove and #oppMoves > 0 then
        self:OrderMoves(oppMoves, 2, nil)
        ponderMove = oppMoves[1]
    end
    self:UnmakeMove(58)

    local elapsed = os.clock() - startClock
    return bestMove, secondMove, ponderMove, bestScore, string.format("D%d (%.2fs)", completedDepth, elapsed), elapsed
end

function Engine:ParseSAN(san, side)
    san = string.gsub(string.gsub(san, "<[^>]+>", ""), "[+#!?%s]", "")
    if san == "" then return nil end
    local legal = self:RootLegalMoves(side)
    if san == "O-O" or san == "0-0" then
        for _, m in ipairs(legal) do if m.castle == "WK" or m.castle == "BK" then return m end end
    elseif san == "O-O-O" or san == "0-0-0" then
        for _, m in ipairs(legal) do if m.castle == "WQ" or m.castle == "BQ" then return m end end
    end
    local promo = string.find(san, "=") and (side * 5) or nil
    san = string.gsub(san, "=.[QRNB]?", "")
    local destSq = ToIdx(string.sub(san, -2))
    if not destSq then return nil end
    local fc = string.sub(san, 1, 1)
    local pt = (fc == "N" and 2) or (fc == "B" and 3) or (fc == "R" and 4) or (fc == "Q" and 5) or (fc == "K" and 6) or 1
    local dis = string.gsub(string.sub(san, 1, -3), "[NBRQKx]", "")
    for _, m in ipairs(legal) do
        if m.to == destSq and math.abs(m.piece) == pt and (not promo or m.promo == promo) then
            if dis == "" or string.find(Alg(m.from), dis, 1, true) then return m end
        end
    end
    return nil
end

