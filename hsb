local function hasColoredSkill(char)
    if not char then return false end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("Highlight") and obj.Enabled and obj.FillTransparency < 0.92 then
            local fc = obj.FillColor
            local oc = obj.OutlineColor
            local isWhite = (fc.R > 0.8 and fc.G > 0.8 and fc.B > 0.8)
            if not isWhite then
                if (fc.R > 0.68 and fc.G < 0.38) or (oc.R > 0.68 and oc.G < 0.38)
                    or (fc.B > 0.68 and fc.R < 0.42) then
                    return true
                end
            end
        end
    end
    return false
end

local function isRealSwordSwing(track, dist)
    if not track or not track.IsPlaying then return false end
    -- Đòn chém không bao giờ lặp lại (Looped == false) và có thời lượng từ 0.20s đến 1.55s
    if track.Looped or track.Length < 0.20 or track.Length > 1.55 or track.Speed <= 0.15 then
        return false
    end

    local prio = track.Priority
    if prio == Enum.AnimationPriority.Core
        or prio == Enum.AnimationPriority.Idle
        or prio == Enum.AnimationPriority.Movement then
        return false
    end

    local animId = track.Animation and track.Animation.AnimationId or ""
    if animId == "" or State.BaselineAnims[animId] then return false end

    local name = string.lower(track.Name or "")
    if string.find(name, "idle") or string.find(name, "walk") or string.find(name, "run")
        or string.find(name, "dash") or string.find(name, "dodge") or string.find(name, "jump")
        or string.find(name, "fall") or string.find(name, "block") or string.find(name, "guard")
        or string.find(name, "parry") or string.find(name, "hit") or string.find(name, "stun")
        or string.find(name, "hurt") or string.find(name, "equip") then
        State.BaselineAnims[animId] = true
        return false
    end

    -- Nếu hoạt ảnh phát khi đối thủ ở xa (> 18m), ghi nhận đó là động tác di chuyển/lướt và bỏ qua
    if dist > 18.0 then
        State.BaselineAnims[animId] = true
        return false
    end

    return true
end

local function isEnemyGuarding(enemyChar)
    if not enemyChar then return false end
    local hum = enemyChar:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    for k, v in pairs(enemyChar:GetAttributes()) do
        if v == true then
            local n = string.lower(k)
            if string.find(n, "block") or string.find(n, "guard") or string.find(n, "parry") then
                return true
            end
        end
    end
    for _, ch in ipairs(enemyChar:GetChildren()) do
        if ch:IsA("BoolValue") and ch.Value == true then
            local n = string.lower(ch.Name)
            if string.find(n, "block") or string.find(n, "guard") or string.find(n, "parry") then
                return true
            end
        end
    end

    local animator = hum:FindFirstChildOfClass("Animator") or hum
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if track.IsPlaying and track.WeightCurrent > 0.25 then
            local name = string.lower(track.Name or "")
            local prio = track.Priority
            if string.find(name, "block") or string.find(name, "guard") or string.find(name, "parry") then
                return true
            end
            -- Khi giữ kiếm thủ, hoạt ảnh ở tầng Action đứng im khung hình (Speed == 0) hoặc lặp lại khi đi chậm
            if (prio == Enum.AnimationPriority.Action or prio == Enum.AnimationPriority.Action2) then
                if track.Speed == 0 or (track.Looped and hum.WalkSpeed < 10.5) then
                    return true
                end
            end
        end
    end

    return false
end

-- Thực hiện ĐỠ ĐÒN ĐÚNG 1 LẦN (0.14s) rồi LẬP TỨC PHẢN CÔNG LẠI LUÔN (Không giữ thủ!)
local function executeSingleParryThenCounter(enemyChar, isColored)
    if not (Config.Mode1v1 or Config.Mode2v2) then return end
    if State.TargetDist > Config.ParryRange then return end

    local now = os.clock()

    -- Nếu địch dùng Skill màu sắc -> Lướt (Né) rồi đánh trả ngay
    if isColored then
        if now - State.LastDodgeTime >= 0.35 then
            State.LastDodgeTime = now
            sendAction("Dodge", "Tap")
            task.delay(0.14, function()
                if (Config.Mode1v1 or Config.Mode2v2) and State.TargetDist <= Config.AttackRange then
                    if isRageUltimateReady() and (os.clock() - State.LastUltTime > 0.6) then
                        State.LastUltTime = os.clock()
                        sendAction("Ultimate", "Tap")
                    else
                        sendAction("Light", "Tap")
                        State.LastLightTime = os.clock()
                    end
                end
            end)
        end
        return
    end

    -- Đòn đánh thường: Giơ kiếm lên đỡ đúng 0.14s -> Nhả nút đỡ -> Chém trả lại luôn!
    if now - State.LastParryTime >= 0.22 then
        State.LastParryTime = now
        State.ParryEndTime = now + Config.ParryHoldDuration
        State.IsCountering = true

        sendAction("Block", "Down")

        task.delay(Config.ParryHoldDuration, function()
            -- Bắt buộc nhả nút đỡ ra ngay, tuyệt đối không giữ lỳ
            sendAction("Block", "Up")

            if (Config.Mode1v1 or Config.Mode2v2) and State.Target and State.TargetDist <= Config.AttackRange then
                -- Nếu có sẵn Skill Nộ (Siêu cấp / [R]) thì xả luôn sau khi đỡ đòn!
                if isRageUltimateReady() and (os.clock() - State.LastUltTime > 0.6) then
                    State.LastUltTime = os.clock()
                    sendAction("Ultimate", "Tap")
                elseif isEnemyGuarding(State.Target) then
                    -- Nếu địch lập tức thu kiếm về thủ -> tung chiêu Phá Phòng Thủ (Nặng / M2)
                    State.LastHeavyTime = os.clock()
                    sendAction("Heavy", "Tap")
                else
                    -- Phản công nhanh bằng đòn đánh thường (ÁNH SÁNG / M1)
                    State.LastLightTime = os.clock()
                    sendAction("Light", "Tap")
                end
            end

            task.delay(0.08, function()
                State.IsCountering = false
            end)
        end)
    end
end

local function hookEnemy(enemyChar)
    if not enemyChar then return end
    local hum = enemyChar:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator") or hum
    if State.HookedAnimators[animator] then return end
    State.HookedAnimators[animator] = true

    animator.AnimationPlayed:Connect(function(track)
        if not (Config.Mode1v1 or Config.Mode2v2) then return end
        if enemyChar ~= State.Target then return end
        if State.ParriedTracks[track] then return end

        if isRealSwordSwing(track, State.TargetDist) then
            State.ParriedTracks[track] = true
            executeSingleParryThenCounter(enemyChar, hasColoredSkill(enemyChar))
        end
    end)
end

-- ============================================================================
-- 4. VÒNG LẶP CHIẾN ĐẤU CHÍNH (ĐỠ 1 NHỊP -> PHẢN CÔNG / PHÁ THỦ / XẢ SKILL NỘ)
-- ============================================================================

local function combatTick()
    if not (Config.Mode1v1 or Config.Mode2v2) then
        if State.IsBlocking then sendAction("Block", "Up") end
        State.StatusText = "Đang Tắt [OFF]"
        return
    end

    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHum or not myRoot or myHum.Health <= 0 then return end

    local enemy, dist = findTarget()
    if enemy ~= State.Target then
        State.Target = enemy
        State.LastEnemyHealth = nil
        if enemy then hookEnemy(enemy) end
    end
    State.TargetDist = dist

    if not enemy then
        if State.IsBlocking then sendAction("Block", "Up") end
        State.StatusText = Config.Mode1v1 and "1v1: Đang đợi đối thủ..." or "2v2: Đang tìm kẻ địch..."
        return
    end

    hookEnemy(enemy)
    local enemyHum = enemy:FindFirstChildOfClass("Humanoid")
    local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
    if not enemyHum or not enemyRoot then return end

    local now = os.clock()

    -- Đảm bảo nhả nút đỡ ngay khi hết nhịp 0.14s (chống kẹt nút thủ 100%)
    if State.IsBlocking and now >= State.ParryEndTime then
        sendAction("Block", "Up")
    end

    -- ========================================================================
    -- 1. PHÁT HIỆN ĐÁNH TRÚNG ĐỊCH (MÁU ĐỊCH TỤT) -> BẬT LUÔN SKILL NỘ (SIÊU CẤP)
    -- ========================================================================
    local currentHp = enemyHum.Health
    local enemyJustTookDamage = false
    if State.LastEnemyHealth ~= nil and currentHp < State.LastEnemyHealth then
        enemyJustTookDamage = true
        if dist <= 13.0 and isRageUltimateReady() and (now - State.LastUltTime > 0.5) then
            State.LastUltTime = now
            sendAction("Ultimate", "Tap")
        end
    end
    State.LastEnemyHealth = currentHp

    -- ========================================================================
    -- 2. KIỂM TRA ĐÒN CHÉM MỚI CỦA ĐỊCH (MỖI NHÁT CHÉM CHỈ ĐỠ ĐÚNG 1 LẦN!)
    -- ========================================================================
    local newAttackTrack = nil
    if not enemyJustTookDamage then
        local animator = enemyHum:FindFirstChildOfClass("Animator") or enemyHum
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            if not State.ParriedTracks[track] and isRealSwordSwing(track, dist) then
                if track.TimePosition <= 0.35 then
                    newAttackTrack = track
                    break
                end
            end
        end
    else
        -- Nếu địch vừa bị chém trúng, đánh dấu các hoạt ảnh bị choáng hiện tại để không nhận nhầm là địch chém
        local animator = enemyHum:FindFirstChildOfClass("Animator") or enemyHum
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            State.ParriedTracks[track] = true
        end
    end

    local coloredNow = hasColoredSkill(enemy)
    if newAttackTrack and dist <= Config.ParryRange then
        State.ParriedTracks[newAttackTrack] = true
        executeSingleParryThenCounter(enemy, coloredNow)
    elseif coloredNow and dist <= Config.ParryRange and (now - State.LastDodgeTime > 0.4) then
        executeSingleParryThenCounter(enemy, true)
    end

    -- ========================================================================
    -- 3. TỰ ĐI ĐẾN ĐỊCH & XOAY MẶT HƯỚNG VỀ ĐỊCH
    -- ========================================================================
    local myPos = myRoot.Position
    local enemyPos = enemyRoot.Position

    if dist <= 18.0 and dist > 0.5 and (now - State.LastDodgeTime > 0.18) then
        pcall(function()
            myRoot.CFrame = CFrame.lookAt(myPos, Vector3.new(enemyPos.X, myPos.Y, enemyPos.Z))
        end)
    end

    if now - State.LastMoveTime >= 0.05 then
        State.LastMoveTime = now
        if dist > Config.StopWalkRange and dist < 120 then
            local diff = myPos - enemyPos
            local flat = Vector3.new(diff.X, 0, diff.Z)
            local goal = enemyPos
            if flat.Magnitude > 0.1 then
                goal = enemyPos + (flat.Unit * (Config.StopWalkRange - 0.4))
            end
            myHum:MoveTo(goal)
        elseif dist <= Config.StopWalkRange then
            myHum:MoveTo(myPos)
        end
    end

    -- ========================================================================
    -- 4. TẤN CÔNG: ĐỊCH THỦ -> PHÁ PHÒNG THỦ (NẶNG/M2) | CÓ NỘ -> XẢ NỘ | CHÉM THƯỜNG
    -- ========================================================================
    local enemyBlocking = isEnemyGuarding(enemy)

    if not State.IsBlocking and not State.IsCountering and dist <= Config.AttackRange then
        -- Ưu tiên 1: Nếu có Skill Nộ (Siêu cấp / [R]) và địch đang không đỡ -> Xả Skill Nộ luôn!
        if isRageUltimateReady() and not enemyBlocking and (now - State.LastUltTime >= 0.55) then
            State.LastUltTime = now
            sendAction("Ultimate", "Tap")

        -- Ưu tiên 2: Nếu kẻ địch đang giơ kiếm THỦ -> Dùng chiêu PHÁ PHÒNG THỦ (Nặng / M2) ngay lập tức!
        elseif enemyBlocking then
            if now - State.LastHeavyTime >= 0.55 then
                State.LastHeavyTime = now
                sendAction("Heavy", "Tap")
            end

        -- Ưu tiên 3: Kẻ địch không thủ và không đang chém -> Đánh thường (ÁNH SÁNG / M1)
        elseif now - State.LastLightTime >= 0.26 then
            State.LastLightTime = now
            sendAction("Light", "Tap")
        end
    end

    local modeStr = Config.Mode1v1 and "1v1" or "2v2"
    local actStr = State.IsBlocking and "ĐỠ -> PHẢN CÔNG!"
        or (enemyBlocking and "ĐỊCH THỦ -> PHÁ GIÁP!"
        or (isRageUltimateReady() and "XẢ SKILL NỘ [R]!" or "Đang chém"))
    State.StatusText = string.format("[%s] %s (%.1fm) %s", modeStr, enemy.Name:sub(1, 8), dist, actStr)
end

