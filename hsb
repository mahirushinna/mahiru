-- 5. HÀM TÌM MỤC TIÊU & VẼ ĐƯỜNG NỐI 2D
-- ============================================================================
local function getTargetPart(character: Model, mode: string): BasePart?
	if mode == "Head" then
		return character:FindFirstChild("Head") :: BasePart?
	elseif mode == "Torso" then
		return (character:FindFirstChild("UpperTorso")
			or character:FindFirstChild("Torso")
			or character:FindFirstChild("HumanoidRootPart")) :: BasePart?
	end
	return nil
end

local function drawLine2D(lineFrame: Frame, fromPos: Vector2, toPos: Vector2)
	local delta = toPos - fromPos
	local distance = delta.Magnitude
	local midpoint = (fromPos + toPos) * 0.5
	local angle = math.deg(math.atan2(delta.Y, delta.X))

	lineFrame.Position = UDim2.fromOffset(midpoint.X, midpoint.Y)
	lineFrame.Size = UDim2.fromOffset(distance, 1.6)
	lineFrame.Rotation = angle
end

local function findClosestEnemyInFOVCircle(): (BasePart?, Vector2?)
	local partMode = State.Aim_TargetPart
	if partMode == "None" then partMode = "Head" end

	Camera = Workspace.CurrentCamera
	if not Camera then return nil, nil end

	local viewportCenter = Camera.ViewportSize * 0.5
	local maxRadius = getFOVRadiusPixels()
	local closestPart: BasePart? = nil
	local closestScreenPos: Vector2? = nil
	local shortestDist = maxRadius

	for _, player in ipairs(Players:GetPlayers()) do
		if isEnemy(player) and player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			local targetPart = getTargetPart(player.Character, partMode)

			if humanoid and humanoid.Health > 0 and targetPart then
				local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
				if onScreen and screenPoint.Z > 0 then
					local screenVec = Vector2.new(screenPoint.X, screenPoint.Y)
					local distFromCenter = (screenVec - viewportCenter).Magnitude
					if distFromCenter <= shortestDist then
						shortestDist = distFromCenter
						closestPart = targetPart
						closestScreenPos = screenVec
					end
				end
			end
		end
	end

	return closestPart, closestScreenPos
end

