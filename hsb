local SquareButtons = {}

-- Tự động tìm các ô a1..h8 trên giao diện RoChess
local function ScanBoardSquares()
    table.clear(SquareButtons)
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj:IsA("GuiObject") then
            local name = string.lower(obj.Name)
            if string.match(name, "^[a-h][1-8]$") and obj.Visible then
                SquareButtons[name] = obj
            end
        end
    end
end

-- Đọc danh sách nước đi SAN từ bảng lịch sử của RoChess
local function GetMoveListFromUI()
    local moves = {}
    local candidates = {}

    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local txt = string.gsub(obj.Text or "", "^%s*(.-)%s*$", "%1")
            -- Khớp ký hiệu nước đi chuẩn SAN (VD: d4, exd4, Nf3, Bxd7+, O-O)
            if string.match(txt, "^[NBRQK]?[a-h]?[1-8]?x?[a-h][1-8][=]?[NBRQ]?[+#]?$")
               or txt == "O-O" or txt == "O-O-O" then
                -- Loại trừ các nhãn tọa độ đơn lẻ (như ô a1..h8 nếu trùng) bằng cách kiểm tra kích thước/vị trí
                if obj.AbsoluteSize.X > 18 and obj.AbsolutePosition.Y > 300 then
                    table.insert(candidates, {
                        text = txt,
                        y = math.floor(obj.AbsolutePosition.Y / 8) * 8,
                        x = obj.AbsolutePosition.X
                    })
                end
            end
        end
    end

    table.sort(candidates, function(a, b)
        if math.abs(a.y - b.y) > 6 then
            return a.y < b.y
        end
        return a.x < b.x
    end)

    for _, item in ipairs(candidates) do
        table.insert(moves, item.text)
    end
    return moves
end

-- ==========================================
-- 3. TRÍ TUỆ NHÂN TẠO: STOCKFISH API + EVALUATION
-- ==========================================
local httpRequest = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request

local LastEval = 0

local function QueryStockfish(fen, depth)
    local encodedFEN = HttpService:UrlEncode(fen)
    local url = string.format("https://stockfish.online/api/s/v2.php?fen=%s&depth=%d", encodedFEN, depth)

    local success, response = pcall(function()
        if httpRequest then
            local res = httpRequest({Url = url, Method = "GET"})
            return res and res.Body
        else
            return game:HttpGet(url)
        end
    end)

    if success and response then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(response)
        end)
        if ok and data and data.success and data.bestmove then
            -- Format trả về: "bestmove e2e4 ponder e7e5"
            local bestMoveUCI = string.match(data.bestmove, "bestmove%s+([a-h][1-8][a-h][1-8][qrbn]?)")
            local evalScore = tonumber(data.evaluation) or 0
            local mateScore = data.mate
            return bestMoveUCI, evalScore, mateScore
        end
    end
    return nil, 0, nil
end

