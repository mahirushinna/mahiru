local function ScanRAM()
    if not getgc then return end
    pcall(function()
        local bestPly = -1
        for _, o in ipairs(getgc(true)) do
            if type(o) == "table" and not rawget(o, "_IsOurAI") then
                if type(rawget(o, "board")) == "table" and type(rawget(o, "ply")) == "number" and rawget(o, "kingSq") ~= nil then
                    if o.ply >= bestPly then
                        bestPly = o.ply
                        RAMState.BoardObj = o
                    end
                elseif type(rawget(o, "playMove")) == "function" and type(rawget(o, "makeMove")) == "function" then
                    RAMState.C2 = o
                end
            end
        end
    end)
end

local function IsVisibleDeep(obj)
    local cur = obj
    while cur and cur ~= PlayerGui do
        if (cur:IsA("GuiObject") and not cur.Visible) or (cur:IsA("LayerCollector") and not cur.Enabled) then
            return false
        end
        cur = cur.Parent
    end
    return cur == PlayerGui
end

local function GetBoardFrame()
    if RAMState.C2 then
        local bg = rawget(RAMState.C2, "bgFrame")
        if typeof(bg) == "Instance" and bg:IsA("GuiObject") and IsVisibleDeep(bg) and bg.AbsoluteSize.X >= 200 then
            return bg
        end
    end
    local best, bestChildren = nil, 0
    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if d:IsA("GuiObject") and not d:IsDescendantOf(GuiRoot) and IsVisibleDeep(d) then
            local sz = d.AbsoluteSize
            if sz.X >= 220 and sz.Y >= 220 and math.abs(sz.X - sz.Y) <= 18 then
                local c = #d:GetDescendants()
                if c > bestChildren then bestChildren = c; best = d end
            end
        end
    end
    return best
end

-- Reads visible move rows ("1. e4 e5", "2. d4 Bb4+", ..., "14. Re1") and stores them by move number in MoveCacheByPly!
local function UpdateMoveCacheFromUI(boardFrame)
    if not boardFrame then return 0 end
    local boardBot = boardFrame.AbsolutePosition.Y + boardFrame.AbsoluteSize.Y - 15
    local rowsByY = {}

    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and not d:IsDescendantOf(GuiRoot) and IsVisibleDeep(d) then
            local sc = d:FindFirstAncestorWhichIsA("ScrollingFrame")
            local inMovePanel = (sc and sc.AbsolutePosition.Y >= boardBot - 25) or (d.AbsolutePosition.Y >= boardBot and d.AbsoluteSize.Y < 45)
            if inMovePanel then
                local txt = string.gsub(string.gsub(d.Text, "<[^>]+>", ""), "^%s*(.-)%s*$", "%1")
                if txt ~= "" and d.AbsoluteSize.Y > 8 and d.AbsoluteSize.Y < 45 then
                    local yKey = math.floor((d.AbsolutePosition.Y + (sc and sc.CanvasPosition.Y or 0)) / 10) * 10
                    rowsByY[yKey] = rowsByY[yKey] or {}
                    table.insert(rowsByY[yKey], { t = txt, x = d.AbsolutePosition.X })
                end
            end
        end
    end

    local maxPlySeen = 0
    for _, items in pairs(rowsByY) do
        table.sort(items, function(a, b) return a.x < b.x end)
        local rowTokens = {}
        for _, it in ipairs(items) do
            for tk in string.gmatch(it.t, "%S+") do
                if #rowTokens == 0 or rowTokens[#rowTokens] ~= tk then
                    rowTokens[#rowTokens + 1] = tk
                end
            end
        end
        -- Check if row starts with move number like "1.", "2.", "14."
        if #rowTokens >= 2 then
            local mvNum = tonumber(string.match(rowTokens[1], "^(%d+)%.+$"))
            if mvNum and mvNum >= 1 and mvNum <= 200 then
                if mvNum == 1 and rowTokens[2] and not rowTokens[3] then
                    -- New game started on move 1! Clear old higher moves
                    for k in pairs(MoveCacheByPly) do
                        if k > 2 then MoveCacheByPly[k] = nil end
                    end
                end
                local wSAN = string.gsub(rowTokens[2], "[+#!?]", "")
                MoveCacheByPly[(mvNum - 1) * 2 + 1] = wSAN
                maxPlySeen = math.max(maxPlySeen, (mvNum - 1) * 2 + 1)
                if rowTokens[3] then
                    local bSAN = string.gsub(rowTokens[3], "[+#!?]", "")
                    MoveCacheByPly[(mvNum - 1) * 2 + 2] = bSAN
                    maxPlySeen = math.max(maxPlySeen, (mvNum - 1) * 2 + 2)
                else
                    MoveCacheByPly[(mvNum - 1) * 2 + 2] = nil
                end
            end
        end
    end
    return maxPlySeen
end

local function DetectTurnAndSide(boardFrame)
    if not boardFrame then return "NO_BOARD", 1 end
    local cy = boardFrame.AbsolutePosition.Y + boardFrame.AbsoluteSize.Y * 0.5
    local topY = boardFrame.AbsolutePosition.Y
    local topClock, botClock, badgeTurn = nil, nil, nil

    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if d:IsA("TextLabel") and not d:IsDescendantOf(GuiRoot) and IsVisibleDeep(d) then
            local t = string.lower(d.Text)
            if string.find(t, "to move") then
                badgeTurn = (d.AbsolutePosition.Y > cy) and "MY_TURN" or "OPP_TURN"
            end
            local tr = string.gsub(d.Text, "%s+", "")
            if string.match(tr, "^%d+:%d%d$") then
                if d.AbsolutePosition.Y < topY then topClock = d
                elseif d.AbsolutePosition.Y > cy then botClock = d end
            end
        end
    end

    if badgeTurn then return badgeTurn end
    if topClock and botClock then
        local bLum = (botClock.TextColor3.R + botClock.TextColor3.G + botClock.TextColor3.B) / 3
        local tLum = (topClock.TextColor3.R + topClock.TextColor3.G + topClock.TextColor3.B) / 3
        if bLum < 0.48 and tLum > 0.52 then return "MY_TURN"
        elseif tLum < 0.48 and bLum > 0.52 then return "OPP_TURN" end
        return "LIVE"
    end
    return "IDLE"
end

