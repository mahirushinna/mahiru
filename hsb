-- 1. BỘ BẮT NÚT CẢM ỨNG MOBILE (QUÉT CẢ LOCALIZEDTEXT LẪN TỌA ĐỘ MÀN HÌNH)
-- ============================================================================

local Keywords = {
    Block = { "chặn đòn", "chan don", "chặn", "block", "parry", "guard", "defend" },
    Light = { "ánh sáng", "anh sang", "light", "slash", "attack", "m1", "basic" },
    Heavy = { "nặng", "nang", "sơ cấp", "so cap", "heavy", "strong", "m2", "special", "finisher" },
    Dodge = { "né", "ne", "dodge", "dash", "roll", "step" },
}

local function matchAny(str, list)
    if type(str) ~= "string" or #str == 0 then return false end
    local s = string.lower(str)
    for _, w in ipairs(list) do
        if string.find(s, w, 1, true) then
            return true
        end
    end
    return false
end

local function findInteractiveButton(inst)
    if inst:IsA("GuiButton") then return inst end
    local parentBtn = inst:FindFirstAncestorWhichIsA("GuiButton")
    if parentBtn then return parentBtn end
    if inst.Parent then
        for _, sib in ipairs(inst.Parent:GetChildren()) do
            if sib:IsA("GuiButton") then return sib end
        end
        if inst.Parent:IsA("GuiObject") then
            return inst.Parent
        end
    end
    return nil
end

local function scanMobileButtons()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return 0 end

    local foundCount = 0
    for _, obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            -- Đọc cả Text gốc (tiếng Anh) lẫn LocalizedText (tiếng Việt trên màn hình)
            local rawText = obj.Text or ""
            local locText = ""
            pcall(function() locText = obj.LocalizedText or "" end)
            local objName = obj.Name or ""

            local targetGui = findInteractiveButton(obj)
            if targetGui and targetGui.Visible and targetGui.AbsoluteSize.X > 20 then
                for action, list in pairs(Keywords) do
                    if matchAny(rawText, list) or matchAny(locText, list) or matchAny(objName, list) or matchAny(targetGui.Name, list) then
                        State.Buttons[action] = targetGui
                    end
                end
            end
        end
    end

    for _, v in pairs(State.Buttons) do
        if v then foundCount = foundCount + 1 end
    end
    return foundCount
end

-- Hàm kích hoạt nút Mobile đa tầng: vừa bắn sự kiện Touch/Mouse, vừa giả lập chạm toạ độ thực
local function fireTouchElement(guiObj, isPress)
    if not guiObj or not guiObj.Parent then return false end

    local pos = guiObj.AbsolutePosition
    local size = guiObj.AbsoluteSize
    local inset = GuiService:GetGuiInset()
    local cx = pos.X + (size.X * 0.5)
    local cy = pos.Y + (size.Y * 0.5) + inset.Y

    -- Tầng 1: Kích hoạt trực tiếp các Signal của GuiButton (nếu Executor hỗ trợ firesignal)
    if typeof(firesignal) == "function" then
        pcall(function()
            if guiObj:IsA("GuiButton") then
                if isPress then
                    firesignal(guiObj.MouseButton1Down, cx, cy)
                    firesignal(guiObj.TouchTap)
                    firesignal(guiObj.MouseButton1Click)
                    firesignal(guiObj.Activated)
                else
                    firesignal(guiObj.MouseButton1Up, cx, cy)
                end
            end
        end)
    end

    -- Tầng 2: Giả lập cảm ứng Touch & Click ngay đúng tâm nút trên màn hình
    pcall(function()
        if typeof(VirtualInputManager.SendTouchEvent) == "function" then
            -- state: 0 = Begin, 2 = End
            VirtualInputManager:SendTouchEvent(1, isPress and 0 or 2, cx, cy)
        end
    end)
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, isPress, game, 1)
    end)

    return true
end

