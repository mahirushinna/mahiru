-- Caches the exact 8x8 Board Frame AND Move History Container so we NEVER spam PlayerGui:GetDescendants()!
local UICache = {
    BoardFrame = nil,
    MoveScrollContainer = nil,
    X = 0, Y = 0, W = 0, H = 0,
    CachedSide = nil,
    LastFullDiscovery = 0
}

local function GetExactChessBoardGeometry()
    if UICache.BoardFrame and UICache.BoardFrame.Parent and IsVisibleDeep(UICache.BoardFrame) then
        local p, s = UICache.BoardFrame.AbsolutePosition, UICache.BoardFrame.AbsoluteSize
        if s.X >= 200 and math.abs(s.X - s.Y) <= 12 then
            UICache.X, UICache.Y, UICache.W, UICache.H = p.X, p.Y, s.X, s.Y
            return UICache
        end
    end

    local now = os.clock()
    if now - UICache.LastFullDiscovery < 1.0 then
        return nil
    end
    UICache.LastFullDiscovery = now

    local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(400, 850)
    local bestFrame = nil
    local bestScore = -1

    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if d:IsA("GuiObject") and not d:IsDescendantOf(GuiRoot) and IsVisibleDeep(d) then
            local sz = d.AbsoluteSize
            local pos = d.AbsolutePosition
            if sz.X >= 210 and sz.Y >= 210 and math.abs(sz.X - sz.Y) <= 10 and sz.Y <= vp.Y * 0.72 and pos.Y >= 30 then
                local expectedTileW = sz.X / 8
                local tileMatches = 0
                for _, ch in ipairs(d:GetDescendants()) do
                    if ch:IsA("GuiObject") and ch.Visible then
                        local csz = ch.AbsoluteSize
                        if math.abs(csz.X - expectedTileW) <= 6 and math.abs(csz.Y - expectedTileW) <= 6 then
                            tileMatches += 1
                        end
                    end
                end
                local score = tileMatches * 10 + (#d:GetDescendants())
                if score > bestScore then
                    bestScore = score
                    bestFrame = d
                end
            end
        end
    end

    if bestFrame then
        UICache.BoardFrame = bestFrame
        UICache.CachedSide = nil
        local p, s = bestFrame.AbsolutePosition, bestFrame.AbsoluteSize
        UICache.X, UICache.Y, UICache.W, UICache.H = p.X, p.Y, s.X, s.Y

        -- Also locate and cache the Move History ScrollingFrame below the board!
        local boardBot = p.Y + s.Y - 12
        for _, d in ipairs(PlayerGui:GetDescendants()) do
            if d:IsA("ScrollingFrame") and not d:IsDescendantOf(GuiRoot) and IsVisibleDeep(d) then
                if d.AbsolutePosition.Y >= boardBot - 20 then
                    UICache.MoveScrollContainer = d
                    break
                end
            end
        end
        return UICache
    end

    return nil
end

local function DetectBoardOrientation(bGeo)
    if UICache.CachedSide then return UICache.CachedSide end
    if not bGeo or not bGeo.BoardFrame then return 1 end
    local bx, by, bw, bh = bGeo.X, bGeo.Y, bGeo.W, bGeo.H
    local rank1Y, rank8Y = nil, nil

    local rootToScan = bGeo.BoardFrame.Parent or PlayerGui
    for _, d in ipairs(rootToScan:GetDescendants()) do
        if d:IsA("TextLabel") and d.Visible then
            local pos = d.AbsolutePosition
            local sz = d.AbsoluteSize
            if sz.X < 36 and sz.Y < 36 and pos.X >= (bx - 28) and pos.X <= (bx + bw + 28) and pos.Y >= (by - 28) and pos.Y <= (by + bh + 28) then
                local txt = string.gsub(d.Text, "%s+", "")
                if txt == "1" then rank1Y = pos.Y
                elseif txt == "8" then rank8Y = pos.Y
                end
            end
        end
    end

    if rank1Y and rank8Y and math.abs(rank1Y - rank8Y) > (bh * 0.5) then
        UICache.CachedSide = (rank1Y > rank8Y) and 1 or -1
        return UICache.CachedSide
    end
    return 1
end

local PersistentMovesByPly = {}
local IgnoredWords = {
    draw = true, resign = true, abort = true, game = true, players = true,
    bullet = true, blitz = true, rapid = true, report = true, opponent = true
}

local function ScrapeMovesFast(bGeo)
    if not bGeo then return 0 end
    local realBoardBottomY = bGeo.Y + bGeo.H - 8
    local rawElements = {}

    -- Scan ONLY the cached MoveScrollContainer if available (10x faster than scanning all of PlayerGui!)
    local scanRoot = (UICache.MoveScrollContainer and UICache.MoveScrollContainer.Parent and IsVisibleDeep(UICache.MoveScrollContainer))
        and UICache.MoveScrollContainer
        or PlayerGui

    for _, d in ipairs(scanRoot:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible and not d:IsDescendantOf(GuiRoot) then
            local pos = d.AbsolutePosition
            local sz = d.AbsoluteSize
            if pos.Y >= realBoardBottomY - 20 and sz.Y >= 8 and sz.Y <= 44 then
                local clean = string.gsub(string.gsub(d.Text, "<[^>]+>", ""), "^%s*(.-)%s*$", "%1")
                if clean ~= "" and not IgnoredWords[string.lower(clean)] then
                    local sc = (scanRoot:IsA("ScrollingFrame") and scanRoot) or d:FindFirstAncestorWhichIsA("ScrollingFrame")
                    local canvasY = (pos.Y + sz.Y * 0.5) + (sc and sc.CanvasPosition.Y or 0)
                    rawElements[#rawElements + 1] = { text = clean, cy = canvasY, x = pos.X }
                end
            end
        end
    end

    table.sort(rawElements, function(a, b) return a.cy < b.cy end)

    local rows = {}
    for _, el in ipairs(rawElements) do
        local lastRow = rows[#rows]
        if not lastRow or math.abs(el.cy - lastRow.avgY) > 13 then
            rows[#rows + 1] = { avgY = el.cy, items = { el } }
        else
            table.insert(lastRow.items, el)
            local sumY = 0
            for _, it in ipairs(lastRow.items) do sumY += it.cy end
            lastRow.avgY = sumY / #lastRow.items
        end
    end

    local maxPly = 0
    local sequentialFallback = {}

    for _, row in ipairs(rows) do
        table.sort(row.items, function(a, b) return a.x < b.x end)
        local tokens = {}
        for _, it in ipairs(row.items) do
            for tk in string.gmatch(it.text, "%S+") do
                if #tokens == 0 or tokens[#tokens] ~= tk then
                    tokens[#tokens + 1] = tk
                end
            end
        end

        local rowMoveNum = nil
        local rowSANs = {}
        for _, tk in ipairs(tokens) do
            local numMatch = tonumber(string.match(tk, "^(%d+)%.+$"))
            if numMatch and numMatch >= 1 and numMatch <= 250 then
                rowMoveNum = numMatch
            else
                local stripped = string.gsub(tk, "[+#!?]", "")
                if
                    stripped == "O-O" or stripped == "O-O-O" or
                    string.match(stripped, "^[NBRQK]?[a-h]?[1-8]?x?[a-h][1-8]=?[QRNB]?$")
                then
                    rowSANs[#rowSANs + 1] = stripped
                    sequentialFallback[#sequentialFallback + 1] = stripped
                end
            end
        end

        if rowMoveNum and #rowSANs >= 1 then
            if rowMoveNum == 1 and #rowSANs == 1 then
                for k in pairs(PersistentMovesByPly) do
                    if k > 2 then PersistentMovesByPly[k] = nil end
                end
                UICache.CachedSide = nil
            end
            local wPly = (rowMoveNum - 1) * 2 + 1
            local bPly = (rowMoveNum - 1) * 2 + 2
            PersistentMovesByPly[wPly] = rowSANs[1]
            maxPly = math.max(maxPly, wPly)
            if rowSANs[2] then
                PersistentMovesByPly[bPly] = rowSANs[2]
                maxPly = math.max(maxPly, bPly)
            else
                PersistentMovesByPly[bPly] = nil
            end
        end
    end

    if maxPly == 0 and #sequentialFallback > 0 then
        for idx, san in ipairs(sequentialFallback) do
            PersistentMovesByPly[idx] = san
            maxPly = idx
        end
    end

    for k in pairs(PersistentMovesByPly) do
        if k > maxPly and maxPly > 0 then
            if maxPly <= 2 then
                PersistentMovesByPly[k] = nil
            else
                maxPly = math.max(maxPly, k)
            end
        end
    end

    return maxPly
end

