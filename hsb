local function ScanAndSpyRAMBoards()
    if not getgc then return end
    pcall(function()
        table.clear(RAMTracker.AllBoards)
        for _, obj in ipairs(getgc(true)) do
            if type(obj) == "table" and not rawget(obj, "_IsOurAI") then
                local brd = rawget(obj, "board")
                local ply = rawget(obj, "ply")
                local kingSq = rawget(obj, "kingSq")
                if type(brd) == "table" and type(ply) == "number" and kingSq ~= nil then
                    table.insert(RAMTracker.AllBoards, obj)
                    if ply == 0 and not RAMTracker.Calibrated then
                        CalibrateRAMBoardMap(brd)
                    end
                    -- Install passive spy on prototype #3 `makeMove` so we always lock the active match board!
                    local mt = getmetatable(obj)
                    local proto = type(mt) == "table" and (rawget(mt, "__index") or mt) or nil
                    if type(proto) == "table" and type(rawget(proto, "makeMove")) == "function" and not rawget(proto, "_V9Spy") then
                        rawset(proto, "_V9Spy", true)
                        local origMM = rawget(proto, "makeMove")
                        rawset(proto, "makeMove", function(self, ...)
                            if type(self) == "table" and rawget(self, "board") then
                                RAMTracker.ActiveBoard = self
                            end
                            return origMM(self, ...)
                        end)
                        Logger.Log("SPY", "Hooked passive spy onto #3 RAMBoard:makeMove!")
                    end
                end
            end
        end
    end)
end

-- Layer 2: Row-Clustering UI Move List Scraper (Below the REAL 8x8 Board Y!)
local PersistentMovesByPly = {}

local IgnoredWords = {
    draw = true, resign = true, abort = true, game = true, players = true,
    bullet = true, blitz = true, rapid = true, report = true, opponent = true
}

local function ScrapeMovesBelowRealBoard(bGeo)
    if not bGeo then return 0 end
    local realBoardBottomY = bGeo.Y + bGeo.H - 8
    local rawElements = {}

    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and not d:IsDescendantOf(GuiRoot) and IsVisibleDeep(d) then
            local pos = d.AbsolutePosition
            local sz = d.AbsoluteSize
            local sc = d:FindFirstAncestorWhichIsA("ScrollingFrame")
            local isBelowBoard = (sc and sc.AbsolutePosition.Y >= realBoardBottomY - 20) or (pos.Y >= realBoardBottomY and pos.Y <= realBoardBottomY + 280)

            if isBelowBoard and sz.Y >= 8 and sz.Y <= 44 then
                local clean = string.gsub(string.gsub(d.Text, "<[^>]+>", ""), "^%s*(.-)%s*$", "%1")
                if clean ~= "" and not IgnoredWords[string.lower(clean)] then
                    local canvasY = (pos.Y + sz.Y * 0.5) + (sc and sc.CanvasPosition.Y or 0)
                    table.insert(rawElements, {
                        text = clean,
                        cy = canvasY,
                        x = pos.X
                    })
                end
            end
        end
    end

    -- Sort top-to-bottom by canvasY
    table.sort(rawElements, function(a, b)
        return a.cy < b.cy
    end)

    -- Cluster elements into horizontal rows whenever their vertical centers are within 13px
    local rows = {}
    for _, el in ipairs(rawElements) do
        local lastRow = rows[#rows]
        if not lastRow or math.abs(el.cy - lastRow.avgY) > 13 then
            rows[#rows + 1] = { avgY = el.cy, items = { el } }
        else
            table.insert(lastRow.items, el)
            local sumY = 0
            for _, it in ipairs(lastRow.items) do sumY += it.cy end
            lastRow.avgY = sumY / #lastRow.items
        end
    end

    local maxPly = 0
    local sequentialFallback = {}

    for _, row in ipairs(rows) do
        table.sort(row.items, function(a, b) return a.x < b.x end)
        local tokens = {}
        for _, it in ipairs(row.items) do
            for tk in string.gmatch(it.text, "%S+") do
                if #tokens == 0 or tokens[#tokens] ~= tk then
                    tokens[#tokens + 1] = tk
                end
            end
        end

        local rowMoveNum = nil
        local rowSANs = {}
        for _, tk in ipairs(tokens) do
            local numMatch = tonumber(string.match(tk, "^(%d+)%.+$"))
            if numMatch and numMatch >= 1 and numMatch <= 250 then
                rowMoveNum = numMatch
            else
                local stripped = string.gsub(tk, "[+#!?]", "")
                if
                    stripped == "O-O" or stripped == "O-O-O" or
                    string.match(stripped, "^[NBRQK]?[a-h]?[1-8]?x?[a-h][1-8]=?[QRNB]?$")
                then
                    rowSANs[#rowSANs + 1] = stripped
                    sequentialFallback[#sequentialFallback + 1] = stripped
                end
            end
        end

        if rowMoveNum and #rowSANs >= 1 then
            if rowMoveNum == 1 and #rowSANs == 1 then
                -- Fresh game on Move 1: clear stale cached moves above ply 2
                for k in pairs(PersistentMovesByPly) do
                    if k > 2 then PersistentMovesByPly[k] = nil end
                end
            end
            local wPly = (rowMoveNum - 1) * 2 + 1
            local bPly = (rowMoveNum - 1) * 2 + 2
            PersistentMovesByPly[wPly] = rowSANs[1]
            maxPly = math.max(maxPly, wPly)
            if rowSANs[2] then
                PersistentMovesByPly[bPly] = rowSANs[2]
                maxPly = math.max(maxPly, bPly)
            else
                PersistentMovesByPly[bPly] = nil
            end
        end
    end

    -- Fallback if move numbers weren't in the same row cluster
    if maxPly == 0 and #sequentialFallback > 0 then
        for idx, san in ipairs(sequentialFallback) do
            PersistentMovesByPly[idx] = san
            maxPly = idx
        end
    end

    for k in pairs(PersistentMovesByPly) do
        if k > maxPly and maxPly > 0 then
            -- Keep earlier cached scrolled moves, only trim if a new shorter match reset
            if maxPly <= 2 then
                PersistentMovesByPly[k] = nil
            else
                maxPly = math.max(maxPly, k)
            end
        end
    end

    return maxPly
end

