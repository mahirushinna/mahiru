local Running = true
_G.RoChessV4Cleanup = function()
    Running = false
    if OurScreenGui and OurScreenGui.Parent then
        OurScreenGui:Destroy()
    end
end

task.spawn(DeepInspectGCAndRemotes)

-- Dedicated UI Log Flusher Loop (safe in executor thread)
task.spawn(function()
    while Running and task.wait(0.12) do
        ProcessNetQueue()
        if #Logger.PendingQueue > 0 then
            while #Logger.PendingQueue > 0 do
                local entry = table.remove(Logger.PendingQueue, 1)
                table.insert(Logger.Lines, string.format("[%s][%s] %s", entry.t, entry.c, entry.m))
                if #Logger.Lines > Logger.MaxLines then
                    table.remove(Logger.Lines, 1)
                end
            end
            Logger.Dirty = true
        end
        if Logger.Dirty and LogFrame.Visible then
            Logger.Dirty = false
            LogTextLabel.Text = Logger.GetText()
            LogScroll.CanvasPosition = Vector2.new(0, 99999)
        end
    end
end)

local LastSyncedSig = "__INIT__"
local LastTurnState = ""
local IsExecuting = false

task.spawn(function()
    while Running and task.wait(0.25) do
        local boardFrame = GetBoardFrame()
        if boardFrame and not IsExecuting then
            local turnState = DetectMatchAndTurnState(boardFrame)

            if turnState == "LOBBY_OR_ENDED" or turnState == "LOBBY_NO_CLOCKS" then
                LockedMatchSide = nil
                StatusLabel.Text = string.format(
                    "State: %s (Standby)\nHexRemote: %s | PacketLock: %s\nWaiting for match clocks...",
                    turnState,
                    HookState.HexRemote and HookState.HexRemote.Name or "Scanning",
                    HookState.MovePacketBuilder and "LOCKED" or "Auto-Sniffing"
                )
            else
                local sanList = ScrapeMoveListStrictlyBelowBoard(boardFrame)
                local currentSig = table.concat(sanList, " ")

                if currentSig ~= LastSyncedSig then
                    Engine:Reset()
                    OpponentProfile:Reset()
                    local applied = 0
                    for _, san in ipairs(sanList) do
                        local sideToMove = (applied % 2 == 0) and 1 or -1
                        local evalBefore = Engine:Evaluate(1.0)
                        local parsed = Engine:ParseSANMove(san, sideToMove)
                        if parsed then
                            Engine:MakeMove(parsed)
                            table.insert(Engine.MoveHistoryUCI, parsed.uci)
                            applied += 1
                            if LockedMatchSide and sideToMove ~= LockedMatchSide then
                                local evalAfter = -Engine:Evaluate(1.0)
                                local isAggro = (parsed.captured ~= 0) or Engine:IsInCheck(LockedMatchSide)
                                OpponentProfile:RecordMove(evalBefore - evalAfter, isAggro)
                            end
                        else
                            break
                        end
                    end
                    LastSyncedSig = currentSig
                    Logger.Push("SYNC", string.format("Synced %d moves (%s)", applied, currentSig ~= "" and currentSig or "Start"))
                end

                local mySide = DetectPlayerColor(boardFrame, turnState, Engine.Turn)
                if turnState ~= LastTurnState then
                    LastTurnState = turnState
                    Logger.Push("TURN", string.format("State=%s | Side=%s", turnState, mySide == 1 and "WHITE" or "BLACK"))
                end

                local recentHistory = table.concat(sanList, " ", math.max(1, #sanList - 3), #sanList)
                local isMyTurn = (turnState == "MY_TURN")

                if Config.AutoPlay and isMyTurn then
                    IsExecuting = true
                    local bestMove, score, meta = Engine:SelectBestMove(mySide)
                    if bestMove then
                        StatusLabel.Text = string.format(
                            "Side: %s | Turn: MY_TURN\nHook: %s\nHistory (%d): %s\nBest: %s (%+d) [%s]",
                            (mySide == 1) and "WHITE" or "BLACK",
                            HookState.LastHookSummary,
                            #Engine.MoveHistoryUCI,
                            (recentHistory ~= "" and recentHistory or "Start"),
                            bestMove.uci,
                            score,
                            meta
                        )
                        Logger.Push("AI", string.format("Move %s (%+d) [%s]", bestMove.uci, score, meta))
                        DispatchMovev4(bestMove, mySide)
                        task.wait(Config.PostMoveCooldown)
                    end
                    IsExecuting = false
                else
                    StatusLabel.Text = string.format(
                        "Side: %s | Turn: %s\nHook: %s\nHistory (%d): %s\nWaiting for turn...",
                        (mySide == 1) and "WHITE" or "BLACK",
                        turnState,
                        HookState.LastHookSummary,
                        #Engine.MoveHistoryUCI,
                        (recentHistory ~= "" and recentHistory or "Start")
                    )
                end
            end
        end
    end
end)
