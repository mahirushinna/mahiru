-- 1. BỘ MÁY CỜ VUA NỘI BỘ & XỬ LÝ FEN
-- ==========================================
local PieceValues = {
    p = -100, n = -320, b = -330, r = -500, q = -900, k = -20000,
    P = 100,  N = 320,  B = 330,  R = 500,  Q = 900,  K = 20000
}

local Files = {"a", "b", "c", "d", "e", "f", "g", "h"}
local FileToIndex = {a=1, b=2, c=3, d=4, e=5, f=6, g=7, h=8}

local function SquareToCoords(sq)
    local f = FileToIndex[string.sub(sq, 1, 1)]
    local r = tonumber(string.sub(sq, 2, 2))
    if not f or not r then return nil, nil end
    return 9 - r, f -- row (1=rank 8, 8=rank 1), col (1=file a, 8=file h)
end

local function CoordsToSquare(row, col)
    return Files[col] .. tostring(9 - row)
end

-- Khởi tạo bàn cờ chuẩn
local function CreateStartingBoard()
    return {
        {"r","n","b","q","k","b","n","r"},
        {"p","p","p","p","p","p","p","p"},
        {".",".",".",".",".",".",".","."},
        {".",".",".",".",".",".",".","."},
        {".",".",".",".",".",".",".","."},
        {".",".",".",".",".",".",".","."},
        {"P","P","P","P","P","P","P","P"},
        {"R","N","B","Q","K","B","N","R"}
    }
end

-- Chuyển ma trận bàn cờ sang chuỗi FEN
local function BoardToFEN(board, activeColor, moveCount)
    local rows = {}
    for r = 1, 8 do
        local empty = 0
        local rowStr = ""
        for c = 1, 8 do
            local p = board[r][c]
            if p == "." then
                empty = empty + 1
            else
                if empty > 0 then
                    rowStr = rowStr .. tostring(empty)
                    empty = 0
                end
                rowStr = rowStr .. p
            end
        end
        if empty > 0 then
            rowStr = rowStr .. tostring(empty)
        end
        table.insert(rows, rowStr)
    end
    return table.concat(rows, "/") .. string.format(" %s KQkq - 0 %d", activeColor, moveCount or 1)
end

-- Áp dụng nước đi SAN (ký hiệu đại số như "d4", "exd4", "Nf3", "O-O") lên bàn cờ
local function ApplySANMove(board, san, isWhite)
    san = string.gsub(san, "[+#!?]", "") -- Bỏ ký hiệu chiếu/biểu cảm
    if san == "O-O" then
        local r = isWhite and 8 or 1
        board[r][5] = "."
        board[r][8] = "."
        board[r][7] = isWhite and "K" or "k"
        board[r][6] = isWhite and "R" or "r"
        return
    elseif san == "O-O-O" then
        local r = isWhite and 8 or 1
        board[r][5] = "."
        board[r][1] = "."
        board[r][3] = isWhite and "K" or "k"
        board[r][4] = isWhite and "R" or "r"
        return
    end

    -- Kiểm tra phong cấp (VD: e8=Q)
    local promoPiece = nil
    local eqPos = string.find(san, "=")
    if eqPos then
        promoPiece = string.sub(san, eqPos + 1, eqPos + 1)
        promoPiece = isWhite and string.upper(promoPiece) or string.lower(promoPiece)
        san = string.sub(san, 1, eqPos - 1)
    end

    local targetSq = string.sub(san, -2)
    local tr, tc = SquareToCoords(targetSq)
    if not tr or not tc then return end

    local firstChar = string.sub(san, 1, 1)
    local pieceType = "P"
    local disambig = ""

    if string.match(firstChar, "[NBRQK]") then
        pieceType = firstChar
        local rest = string.sub(san, 2, -3)
        disambig = string.gsub(rest, "x", "")
    else
        pieceType = "P"
        local rest = string.sub(san, 1, -3)
        disambig = string.gsub(rest, "x", "")
    end

    local searchPiece = isWhite and pieceType or string.lower(pieceType)

    -- Tìm quân cờ hợp lệ trên bàn để di chuyển tới (tr, tc)
    local bestR, bestC = nil, nil
    for r = 1, 8 do
        for c = 1, 8 do
            if board[r][c] == searchPiece then
                local matchDisambig = true
                if #disambig > 0 then
                    local dFile = string.match(disambig, "[a-h]")
                    local dRank = string.match(disambig, "[1-8]")
                    if dFile and FileToIndex[dFile] ~= c then matchDisambig = false end
                    if dRank and (9 - tonumber(dRank)) ~= r then matchDisambig = false end
                end

                if matchDisambig then
                    local dr, dc = tr - r, tc - c
                    local adr, adc = math.abs(dr), math.abs(dc)
                    local canReach = false

                    if pieceType == "P" then
                        local dir = isWhite and -1 or 1
                        if dc == 0 and (dr == dir or (dr == 2 * dir and (r == 7 or r == 2))) and board[tr][tc] == "." then
                            canReach = true
                        elseif adc == 1 and dr == dir then
                            canReach = true
                        end
                    elseif pieceType == "N" then
                        canReach = (adr == 2 and adc == 1) or (adr == 1 and adc == 2)
                    elseif pieceType == "K" then
                        canReach = (adr <= 1 and adc <= 1)
                    elseif pieceType == "B" then
                        canReach = (adr == adc)
                    elseif pieceType == "R" then
                        canReach = (dr == 0 or dc == 0)
                    elseif pieceType == "Q" then
                        canReach = (adr == adc or dr == 0 or dc == 0)
                    end

                    -- Kiểm tra đường đi không bị cản cho B, R, Q
                    if canReach and (pieceType == "B" or pieceType == "R" or pieceType == "Q") then
                        local sr = dr == 0 and 0 or (dr / adr)
                        local sc = dc == 0 and 0 or (dc / adc)
                        local cr, cc = r + sr, c + sc
                        while cr ~= tr or cc ~= tc do
                            if board[cr][cc] ~= "." then
                                canReach = false
                                break
                            end
                            cr = cr + sr
                            cc = cc + sc
                        end
                    end

                    if canReach then
                        bestR, bestC = r, c
                        break
                    end
                end
            end
        end
        if bestR then break end
    end

    if bestR and bestC then
        -- Bắt tốt qua đường (En Passant)
        if pieceType == "P" and bestC ~= tc and board[tr][tc] == "." then
            board[bestR][tc] = "."
        end
        board[bestR][bestC] = "."
        board[tr][tc] = promoPiece or searchPiece
    end
end

