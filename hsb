-- 2. NHẬN DIỆN BÀN CỜ, MÀU QUÂN & CLICK CHÍNH XÁC 100%
-- =====================================================
local function DetectBoardAndOrientation()
    local bestBoard = nil
    local bestScore = 0
    local rank1Y, rank8Y = nil, nil

    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj:IsA("GuiObject") and obj.Visible then
            local sz = obj.AbsoluteSize
            local pos = obj.AbsolutePosition
            -- Khung bàn cờ của RoChess là hình vuông lớn nằm ở nửa trên màn hình
            if sz.X >= 240 and sz.X <= 750 and math.abs(sz.X - sz.Y) <= 16 and pos.Y >= 30 and pos.Y <= 250 then
                local childCount = #obj:GetDescendants()
                if childCount > bestScore then
                    bestScore = childCount
                    bestBoard = obj
                end
            end
        end
    end

    -- Quét nhãn tọa độ 1 và 8 trên bàn cờ để tự động biết cầm Trắng hay Đen
    local searchRoot = bestBoard or PlayerGui
    for _, lbl in ipairs(searchRoot:GetDescendants()) do
        if lbl:IsA("TextLabel") and lbl.Visible then
            local t = string.gsub(lbl.Text or "", "%s+", "")
            local y = lbl.AbsolutePosition.Y
            local x = lbl.AbsolutePosition.X
            if y >= 50 and y <= 520 and x <= 120 then
                if t == "1" then rank1Y = y end
                if t == "8" then rank8Y = y end
            end
        end
    end

    local playerColor = "w"
    if rank1Y and rank8Y then
        -- Nếu số 8 nằm thấp hơn số 1 (Y lớn hơn) -> Bàn cờ đang xoay về phía quân Đen
        playerColor = (rank8Y > rank1Y) and "b" or "w"
    end

    return bestBoard, playerColor
end

-- Click đa tầng: Gọi cả sự kiện GuiButton + Touch Mobile + Mouse Click tại tâm ô cờ
local function FireSquareClick(screenX, screenY, boardFrame)
    -- 1. Kích hoạt trực tiếp tín hiệu GuiObject tại tọa độ đó nếu Executor hỗ trợ
    if getconnections then
        local guiObjs = PlayerGui:GetGuiObjectsAtPosition(screenX, screenY)
        for _, g in ipairs(guiObjs) do
            if not g:IsDescendantOf( (gethui and gethui()) or game:GetService("CoreGui") ) then
                for _, sigName in ipairs({"MouseButton1Click", "MouseButton1Down", "MouseButton1Up", "Activated"}) do
                    local ok, sig = pcall(function() return g[sigName] end)
                    if ok and sig then
                        for _, conn in ipairs(getconnections(sig)) do
                            pcall(function() conn:Fire() end)
                        end
                    end
                end
            end
        end
    end

    -- 2. Gửi sự kiện click chuột & chạm màn hình chính xác vào tâm ô cờ
    local inset = GuiService:GetGuiInset()
    local vx, vy = screenX, screenY + inset.Y

    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(vx, vy, 0, true, game, 1)
        task.wait(0.04)
        VirtualInputManager:SendMouseButtonEvent(vx, vy, 0, false, game, 1)
    end)

    pcall(function()
        VirtualInputManager:SendTouchEvent(0, 0, vx, vy)
        task.wait(0.04)
        VirtualInputManager:SendTouchEvent(0, 2, vx, vy)
    end)
end

local function GetSquareScreenPosition(sq, boardFrame, playerColor)
    local r, c = SqToRC(sq) -- r: 1(rank 8)..8(rank 1), c: 1(file a)..8(file h)
    if not r or not c or not boardFrame then return nil, nil end

    -- Nếu tìm được trực tiếp GuiObject mang tên ô (a1..h8) thì lấy tâm của nó
    for _, obj in ipairs(boardFrame:GetDescendants()) do
        if obj:IsA("GuiObject") and obj.Visible and string.lower(obj.Name) == sq then
            return obj.AbsolutePosition.X + obj.AbsoluteSize.X / 2,
                   obj.AbsolutePosition.Y + obj.AbsoluteSize.Y / 2
        end
    end

    -- Tính toán hình học 8x8 dựa theo chiều bàn cờ (Trắng hoặc Đen)
    local visualRow, visualCol
    if playerColor == "w" then
        visualRow = r
        visualCol = c
    else
        visualRow = 9 - r
        visualCol = 9 - c
    end

    local bPos = boardFrame.AbsolutePosition
    local bSize = boardFrame.AbsoluteSize
    local tileW = bSize.X / 8
    local tileH = bSize.Y / 8

    local centerX = bPos.X + (visualCol - 0.5) * tileW
    local centerY = bPos.Y + (visualRow - 0.5) * tileH
    return centerX, centerY
end

local function ExecuteMoveOnBoard(uciMove, playerColor)
    if not uciMove or #uciMove < 4 then return false end
    local boardFrame, detectedColor = DetectBoardAndOrientation()
    if not boardFrame then return false end
    playerColor = detectedColor or playerColor

    local fromSq = string.sub(uciMove, 1, 2)
    local toSq = string.sub(uciMove, 3, 4)

    local fx, fy = GetSquareScreenPosition(fromSq, boardFrame, playerColor)
    local tx, ty = GetSquareScreenPosition(toSq, boardFrame, playerColor)

    if fx and fy and tx and ty then
        FireSquareClick(fx, fy, boardFrame)
        task.wait(0.14)
        FireSquareClick(tx, ty, boardFrame)

        -- Nếu là nước phong cấp (VD: e7e8q), click thêm lần nữa vào ô đích để chọn Hậu
        if #uciMove == 5 then
            task.wait(0.18)
            FireSquareClick(tx, ty, boardFrame)
        end
        return true
    end
    return false
end

