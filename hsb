    FAST_EG[-p] = table.create(64)
    local base = PIECE_VALUES[p]
    for sq = 1, 64 do
        local f = ((sq - 1) % 8) + 1
        local r = math.floor((sq - 1) / 8) + 1
        local wIdx = (8 - r) * 8 + f
        local bIdx = (r - 1) * 8 + f
        FAST_MG[p][sq] = base + RAW_MG[p][wIdx]
        FAST_EG[p][sq] = base + RAW_EG[p][wIdx]
        FAST_MG[-p][sq] = -(base + RAW_MG[p][bIdx])
        FAST_EG[-p][sq] = -(base + RAW_EG[p][bIdx])
    end
end

