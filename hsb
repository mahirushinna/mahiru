-- Kiểm tra xem một màu Color3 có phải màu xanh lá cây đặc trưng của đồng đội hay không
local function isGreenIndicatorColor(color)
    if not color then return false end
    -- Màu xanh lá cây trên tên đồng đội hoặc ô vuông xanh lá có kênh G cao vượt trội so với R và B
    return (color.G > 0.55) and (color.G > color.R * 1.4) and (color.G > color.B * 1.3)
end

local function hasGreenMarkerInInstance(rootInstance)
    if not rootInstance then return false end
    for _, desc in ipairs(rootInstance:GetDescendants()) do
        -- Bỏ qua chính GUI ESP của chúng ta
        if desc.Name == "MrDon_ESP_Tag" or (desc.Parent and desc.Parent.Name == "MrDon_ESP_Tag") then
            continue
        end

        if desc:IsA("TextLabel") or desc:IsA("TextButton") then
            if desc.Visible and isGreenIndicatorColor(desc.TextColor3) then
                return true
            end
        elseif desc:IsA("Frame") then
            if desc.Visible and desc.BackgroundTransparency < 0.95 and isGreenIndicatorColor(desc.BackgroundColor3) then
                return true
            end
        elseif desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
            if desc.Visible and desc.ImageTransparency < 0.95 and isGreenIndicatorColor(desc.ImageColor3) then
                return true
            end
        elseif desc:IsA("Highlight") then
            if desc.Enabled and (isGreenIndicatorColor(desc.FillColor) or isGreenIndicatorColor(desc.OutlineColor)) then
                return true
            end
        end
    end
    return false
end

local function isTeammate(player, character)
    if player == LocalPlayer then
        return true
    end

    -- 1. Kiểm tra Team mặc định của Roblox nếu game có phân chia Team
    if player and LocalPlayer.Team ~= nil and player.Team ~= nil and not player.Neutral then
        if player.Team == LocalPlayer.Team then
            return true
        end
    end

    -- 2. Kiểm tra BillboardGui / tên màu xanh lá hoặc hình vuông màu xanh lá gắn trên nhân vật
    if character and hasGreenMarkerInInstance(character) then
        return true
    end

    -- 3. Kiểm tra nếu tên người chơi xuất hiện với màu chữ xanh lá trong PlayerGui (HUD marcador của game)
    if player and LocalPlayer:FindFirstChild("PlayerGui") then
        for _, desc in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
            if desc:IsA("TextLabel") and desc.Visible then
                if (desc.Text == player.Name or desc.Text == player.DisplayName) and isGreenIndicatorColor(desc.TextColor3) then
                    return true
                end
            end
        end
    end

    return false
end

-- Lấy danh sách các mục tiêu hợp lệ (cả Player lẫn Bot trong trận đấu)
local function getPotentialTargets()
    local targets = {}
    local seenCharacters = {}

    -- Quét từ danh sách Players
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            seenCharacters[plr.Character] = true
            table.insert(targets, {
                Player = plr,
                Character = plr.Character,
                DisplayName = plr.DisplayName or plr.Name
            })
        end
    end

    -- Quét thêm các mô hình nhân vật (Bot như BurnerBot556, ThunderRobot3000) trong Workspace
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Parent and obj.Parent:IsA("Model") then
            local char = obj.Parent
            if char ~= LocalPlayer.Character and not seenCharacters[char] and char:FindFirstChild("Head") then
                seenCharacters[char] = true
                local plr = Players:GetPlayerFromCharacter(char)
                table.insert(targets, {
                    Player = plr,
                    Character = char,
                    DisplayName = plr and (plr.DisplayName or plr.Name) or char.Name
                })
            end
        end
    end

    return targets
end

