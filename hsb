-- 5. ZOBRIST HASHING & TRANSPOSITION TABLE
--------------------------------------------------------------------------------
local Zobrist = { PieceSq = {}, Side = 0x5F3759DF }
do
    local seed = 20261115
    local function NextRand()
        seed = bit32.band(seed * 1664525 + 1013904223, 0xFFFFFFFF)
        return seed
    end
    for p = -6, 6 do
        if p ~= 0 then
            Zobrist.PieceSq[p] = {}
            for sq = 1, 64 do
                Zobrist.PieceSq[p][sq] = NextRand()
            end
        end
    end
end

local TranspositionTable = {}

