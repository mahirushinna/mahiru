local function scan2v2Scoreboard()
    table.clear(State.ConfirmedEnemies2v2)
    table.clear(State.ConfirmedAllies2v2)

    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local cam = workspace.CurrentCamera
    if not pg or not cam then return end

    local halfW = cam.ViewportSize.X * 0.5

    -- Quét bảng tên VS ở phần trên màn hình (Y < 160):
    -- Bên trái (X < halfW) là phe mình, bên phải (X > halfW) là phe địch
    for _, lbl in ipairs(pg:GetDescendants()) do
        if lbl:IsA("TextLabel") and lbl.Visible and lbl.AbsolutePosition.Y < 160 then
            local txt = string.lower(lbl.Text or "")
            if #txt > 2 then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then
                        local uName = string.lower(plr.Name)
                        local dName = string.lower(plr.DisplayName)
                        if string.find(txt, uName, 1, true) or (#dName > 2 and string.find(txt, dName, 1, true)) then
                            if lbl.AbsolutePosition.X > halfW then
                                State.ConfirmedEnemies2v2[plr.Name] = true
                            else
                                State.ConfirmedAllies2v2[plr.Name] = true
                            end
                        end
                    end
                end
            end
        end
    end
end

local function hasGreenAllyRing(char)
    if not char then return false end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("ImageLabel") then
            local col = nil
            pcall(function()
                if obj:IsA("BasePart") and obj.Transparency < 0.85 then col = obj.Color
                elseif obj:IsA("Decal") or obj:IsA("ImageLabel") then col = obj.ImageColor3 end
            end)
            -- Vòng tròn xanh lá cây đặc trưng dưới chân đồng đội trong chế độ 2v2
            if col and col.G > 0.68 and col.R < 0.32 and col.B < 0.42 then
                return true
            end
        end
    end
    return false
end

local function acquireTarget()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, 999 end

    -- CHẾ ĐỘ 1V1: Tuyệt đối KHÔNG lọc đồng đội, khóa thẳng đối thủ gần nhất trong sàn đấu
    if Config.Mode1v1 then
        local nearestChar = nil
        local minDist = 999
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local c = plr.Character
                local h = c:FindFirstChildOfClass("Humanoid")
                local r = c:FindFirstChild("HumanoidRootPart")
                if h and h.Health > 0 and r then
                    local d = (r.Position - myRoot.Position).Magnitude
                    if d < minDist then
                        minDist = d
                        nearestChar = c
                    end
                end
            end
        end
        return nearestChar, minDist
    end

    -- CHẾ ĐỘ 2V2: Lọc chính xác đồng đội (bảng tên bên trái / vòng xanh dưới chân)
    scan2v2Scoreboard()
    local bestEnemy = nil
    local bestDist = 999

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local c = plr.Character
            local h = c:FindFirstChildOfClass("Humanoid")
            local r = c:FindFirstChild("HumanoidRootPart")
            if h and h.Health > 0 and r then
                local isAlly = false
                if State.ConfirmedEnemies2v2[plr.Name] then
                    isAlly = false
                elseif State.ConfirmedAllies2v2[plr.Name] or hasGreenAllyRing(c) then
                    isAlly = true
                end

                if not isAlly then
                    local d = (r.Position - myRoot.Position).Magnitude
                    if d < bestDist then
                        bestDist = d
                        bestEnemy = c
                    end
                end
            end
        end
    end

    return bestEnemy, bestDist
end

