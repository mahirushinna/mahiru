-- 4. TRÍ TUỆ NHÂN TẠO KÉP: STOCKFISH 16 + MINIMAX NỘI BỘ
-- =====================================================
local httpRequest = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request

local PieceScore = {
    P = 100, N = 320, B = 335, R = 500, Q = 920, K = 20000,
    p = -100, n = -320, b = -335, r = -500, q = -920, k = -20000
}

-- Bảng điểm vị trí trung tâm giúp AI nội bộ đánh cực kỳ chủ động
local function EvaluateBoardLocal(board)
    local score = 0
    for r = 1, 8 do
        for c = 1, 8 do
            local p = board[r][c]
            if p ~= "." then
                score = score + (PieceScore[p] or 0)
                local centerBonus = (4 - math.abs(4.5 - r)) * 6 + (4 - math.abs(4.5 - c)) * 6
                if IsWhitePiece(p) then
                    score = score + centerBonus
                else
                    score = score - centerBonus
                end
            end
        end
    end
    return score
end

-- AI dự phòng nội bộ (Alpha-Beta Pruning) đảm bảo luôn có nước đi hợp lệ ngay lập tức
local function GetLocalBestMove(board, isWhite, epSquare)
    local legal = GenerateLegalMoves(board, isWhite, epSquare)
    if #legal == 0 then return nil, 0 end

    -- Ưu tiên xét các nước ăn quân trước
    table.sort(legal, function(a, b)
        return (a.isCapture and 1 or 0) > (b.isCapture and 1 or 0)
    end)

    local bestMove = legal[1].uci
    local bestVal = isWhite and -999999 or 999999

    for _, m in ipairs(legal) do
        local nb = MakeRawMove(board, m.fr, m.fc, m.tr, m.tc, nil)
        local oppMoves = GenerateLegalMoves(nb, not isWhite, nil)
        local worstReply = isWhite and 999999 or -999999

        if #oppMoves == 0 then
            local kr, kc = FindKing(nb, not isWhite)
            if kr and IsSquareAttacked(nb, kr, kc, isWhite) then
                return m.uci, isWhite and 99.0 or -99.0 -- Nước chiếu hết ngay lập tức!
            end
            worstReply = 0
        else
            for _, om in ipairs(oppMoves) do
                local nb2 = MakeRawMove(nb, om.fr, om.fc, om.tr, om.tc, nil)
                local eval = EvaluateBoardLocal(nb2)
                if isWhite then
                    if eval < worstReply then worstReply = eval end
                else
                    if eval > worstReply then worstReply = eval end
                end
            end
        end

        if isWhite then
            if worstReply > bestVal then
                bestVal = worstReply
                bestMove = m.uci
            end
        else
            if worstReply < bestVal then
                bestVal = worstReply
                bestMove = m.uci
            end
        end
    end

    return bestMove, bestVal / 100
end

local function GetBestMoveAI(board, isWhite, epSquare, fullMove)
    local activeColor = isWhite and "w" or "b"
    local fen = BoardToFEN(board, activeColor, epSquare, fullMove)
    local legalMoves = GenerateLegalMoves(board, isWhite, epSquare)
    local legalSet = {}
    for _, m in ipairs(legalMoves) do
        legalSet[string.sub(m.uci, 1, 4)] = m.uci
    end

    -- 1. Truy vấn Stockfish 16 Cloud API
    local url = string.format("https://stockfish.online/api/s/v2.php?fen=%s&depth=%d", HttpService:UrlEncode(fen), Config.SearchDepth)
    local ok, body = pcall(function()
        if httpRequest then
            local res = httpRequest({Url = url, Method = "GET"})
            return res and res.Body
        end
        return game:HttpGet(url)
    end)

    if ok and body then
        local decOk, data = pcall(function() return HttpService:JSONDecode(body) end)
        if decOk and data and data.success and data.bestmove then
            local rawUCI = string.match(data.bestmove, "bestmove%s+([a-h][1-8][a-h][1-8][qrbn]?)")
            if rawUCI then
                local base4 = string.sub(rawUCI, 1, 4)
                if legalSet[base4] then
                    return rawUCI, tonumber(data.evaluation) or 0, data.mate
                end
            end
        end
    end

    -- 2. Nếu mạng lag hoặc API bận, dùng ngay Engine Alpha-Beta nội bộ
    local fallbackUCI, fallbackEval = GetLocalBestMove(board, isWhite, epSquare)
    return fallbackUCI, fallbackEval, nil
end

