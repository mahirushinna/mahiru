-- Cấu hình mặc định: Tự chơi 100% từ đầu đến cuối
local Config = {
    AutoPlay = true,
    SearchDepth = 14,
    MoveDelayMin = 0.35,
    MoveDelayMax = 0.75,
    RetryInterval = 1.15
}

local Files = {"a", "b", "c", "d", "e", "f", "g", "h"}
local FileMap = {a=1, b=2, c=3, d=4, e=5, f=6, g=7, h=8}

local function SqToRC(sq)
    local f = FileMap[string.sub(sq, 1, 1)]
    local r = tonumber(string.sub(sq, 2, 2))
    if not f or not r then return nil, nil end
    return 9 - r, f
end

local function RCToSq(r, c)
    return Files[c] .. tostring(9 - r)
end

-- =====================================================
-- 1. BỘ MÁY LUẬT CỜ VUA & SINH NƯỚC ĐI HỢP LỆ (LEGAL MOVES)
-- =====================================================
local function NewBoard()
    return {
        {"r","n","b","q","k","b","n","r"},
        {"p","p","p","p","p","p","p","p"},
        {".",".",".",".",".",".",".","."},
        {".",".",".",".",".",".",".","."},
        {".",".",".",".",".",".",".","."},
        {".",".",".",".",".",".",".","."},
        {"P","P","P","P","P","P","P","P"},
        {"R","N","B","Q","K","B","N","R"}
    }
end

local function CloneBoard(b)
    local nb = {}
    for r = 1, 8 do
        nb[r] = {}
        for c = 1, 8 do nb[r][c] = b[r][c] end
    end
    return nb
end

local function IsWhitePiece(p)
    return p ~= "." and string.upper(p) == p
end

local function IsColorPiece(p, isWhite)
    if p == "." then return false end
    return isWhite == IsWhitePiece(p)
end

local function FindKing(board, isWhite)
    local k = isWhite and "K" or "k"
    for r = 1, 8 do
        for c = 1, 8 do
            if board[r][c] == k then return r, c end
        end
    end
    return nil, nil
end

local function IsSquareAttacked(board, tr, tc, byWhite)
    -- Tốt tấn công
    local pawnDir = byWhite and 1 or -1 -- Hàng xuất phát của tốt tấn công tới tr
    local pawnChar = byWhite and "P" or "p"
    local pr = tr + pawnDir
    if pr >= 1 and pr <= 8 then
        if tc - 1 >= 1 and board[pr][tc - 1] == pawnChar then return true end
        if tc + 1 <= 8 and board[pr][tc + 1] == pawnChar then return true end
    end

    -- Mã tấn công
    local knightChar = byWhite and "N" or "n"
    local kMoves = {{-2,-1},{-2,1},{-1,-2},{-1,2},{1,-2},{1,2},{2,-1},{2,1}}
    for _, m in ipairs(kMoves) do
        local r, c = tr + m[1], tc + m[2]
        if r >= 1 and r <= 8 and c >= 1 and c <= 8 and board[r][c] == knightChar then
            return true
        end
    end

    -- Vua tấn công
    local kingChar = byWhite and "K" or "k"
    for dr = -1, 1 do
        for dc = -1, 1 do
            if dr ~= 0 or dc ~= 0 then
                local r, c = tr + dr, tc + dc
                if r >= 1 and r <= 8 and c >= 1 and c <= 8 and board[r][c] == kingChar then
                    return true
                end
            end
        end
    end

    -- Xe / Hậu (ngang dọc)
    local rookChar = byWhite and "R" or "r"
    local queenChar = byWhite and "Q" or "q"
    local ortho = {{-1,0},{1,0},{0,-1},{0,1}}
    for _, d in ipairs(ortho) do
        local r, c = tr + d[1], tc + d[2]
        while r >= 1 and r <= 8 and c >= 1 and c <= 8 do
            local p = board[r][c]
            if p ~= "." then
                if p == rookChar or p == queenChar then return true end
                break
            end
            r, c = r + d[1], c + d[2]
        end
    end

    -- Tượng / Hậu (chéo)
    local bishopChar = byWhite and "B" or "b"
    local diag = {{-1,-1},{-1,1},{1,-1},{1,1}}
    for _, d in ipairs(diag) do
        local r, c = tr + d[1], tc + d[2]
        while r >= 1 and r <= 8 and c >= 1 and c <= 8 do
            local p = board[r][c]
            if p ~= "." then
                if p == bishopChar or p == queenChar then return true end
                break
            end
            r, c = r + d[1], c + d[2]
        end
    end

    return false
end

local function MakeRawMove(board, fr, fc, tr, tc, promo)
    local nb = CloneBoard(board)
    local piece = nb[fr][fc]
    local pUpper = string.upper(piece)
    local isW = IsWhitePiece(piece)

    -- Bắt tốt qua đường
    if pUpper == "P" and fc ~= tc and nb[tr][tc] == "." then
        nb[fr][tc] = "."
    end

    -- Nhập thành
    if pUpper == "K" and math.abs(tc - fc) == 2 then
        if tc == 7 then
            nb[fr][6] = nb[fr][8]
            nb[fr][8] = "."
        elseif tc == 3 then
            nb[fr][4] = nb[fr][1]
            nb[fr][1] = "."
        end
    end

    nb[fr][fc] = "."
    if promo then
        nb[tr][tc] = isW and string.upper(promo) or string.lower(promo)
    elseif pUpper == "P" and (tr == 1 or tr == 8) then
        nb[tr][tc] = isW and "Q" or "q"
    else
        nb[tr][tc] = piece
    end
    return nb
end

local function GenerateLegalMoves(board, isWhite, epSquare)
    local moves = {}
    for r = 1, 8 do
        for c = 1, 8 do
            local p = board[r][c]
            if IsColorPiece(p, isWhite) then
                local pu = string.upper(p)
                local rawTargets = {}

                if pu == "P" then
                    local dir = isWhite and -1 or 1
                    local startRank = isWhite and 7 or 2
                    local nr = r + dir
                    if nr >= 1 and nr <= 8 then
                        if board[nr][c] == "." then
                            table.insert(rawTargets, {nr, c})
                            if r == startRank and board[r + 2 * dir][c] == "." then
                                table.insert(rawTargets, {r + 2 * dir, c})
                            end
                        end
                        for _, dc in ipairs({-1, 1}) do
                            local nc = c + dc
                            if nc >= 1 and nc <= 8 then
                                local tp = board[nr][nc]
                                if (tp ~= "." and not IsColorPiece(tp, isWhite)) or (epSquare and RCToSq(nr, nc) == epSquare) then
                                    table.insert(rawTargets, {nr, nc})
                                end
                            end
                        end
                    end
                elseif pu == "N" then
                    for _, m in ipairs({{-2,-1},{-2,1},{-1,-2},{-1,2},{1,-2},{1,2},{2,-1},{2,1}}) do
                        local nr, nc = r + m[1], c + m[2]
                        if nr >= 1 and nr <= 8 and nc >= 1 and nc <= 8 and not IsColorPiece(board[nr][nc], isWhite) then
                            table.insert(rawTargets, {nr, nc})
                        end
                    end
                elseif pu == "K" then
                    for dr = -1, 1 do
                        for dc = -1, 1 do
                            if dr ~= 0 or dc ~= 0 then
                                local nr, nc = r + dr, c + dc
                                if nr >= 1 and nr <= 8 and nc >= 1 and nc <= 8 and not IsColorPiece(board[nr][nc], isWhite) then
                                    table.insert(rawTargets, {nr, nc})
                                end
                            end
                        end
                    end
                    -- Nhập thành
                    local homeRow = isWhite and 8 or 1
                    local rookChar = isWhite and "R" or "r"
                    if r == homeRow and c == 5 and not IsSquareAttacked(board, homeRow, 5, not isWhite) then
                        if board[homeRow][8] == rookChar and board[homeRow][6] == "." and board[homeRow][7] == "." then
                            if not IsSquareAttacked(board, homeRow, 6, not isWhite) and not IsSquareAttacked(board, homeRow, 7, not isWhite) then
                                table.insert(rawTargets, {homeRow, 7})
                            end
                        end
                        if board[homeRow][1] == rookChar and board[homeRow][2] == "." and board[homeRow][3] == "." and board[homeRow][4] == "." then
                            if not IsSquareAttacked(board, homeRow, 4, not isWhite) and not IsSquareAttacked(board, homeRow, 3, not isWhite) then
                                table.insert(rawTargets, {homeRow, 3})
                            end
                        end
                    end
                else
                    local dirs = {}
                    if pu == "R" or pu == "Q" then
                        for _, d in ipairs({{-1,0},{1,0},{0,-1},{0,1}}) do table.insert(dirs, d) end
                    end
                    if pu == "B" or pu == "Q" then
                        for _, d in ipairs({{-1,-1},{-1,1},{1,-1},{1,1}}) do table.insert(dirs, d) end
                    end
                    for _, d in ipairs(dirs) do
                        local nr, nc = r + d[1], c + d[2]
                        while nr >= 1 and nr <= 8 and nc >= 1 and nc <= 8 do
                            local tp = board[nr][nc]
                            if tp == "." then
                                table.insert(rawTargets, {nr, nc})
                            else
                                if not IsColorPiece(tp, isWhite) then
                                    table.insert(rawTargets, {nr, nc})
                                end
                                break
                            end
                            nr, nc = nr + d[1], nc + d[2]
                        end
                    end
                end

                for _, tgt in ipairs(rawTargets) do
                    local tr, tc = tgt[1], tgt[2]
                    local nb = MakeRawMove(board, r, c, tr, tc, nil)
                    local kr, kc = FindKing(nb, isWhite)
                    if kr and not IsSquareAttacked(nb, kr, kc, not isWhite) then
                        local uci = RCToSq(r, c) .. RCToSq(tr, tc)
                        if pu == "P" and (tr == 1 or tr == 8) then
                            uci = uci .. "q"
                        end
                        table.insert(moves, {
                            fr = r, fc = c, tr = tr, tc = tc,
                            piece = pu, uci = uci,
                            isCapture = (board[tr][tc] ~= ".") or (pu == "P" and c ~= tc)
                        })
                    end
                end
            end
        end
    end
    return moves
end

-- Khớp ký hiệu SAN (VD: "e4", "exd5", "Nf3", "Ne5+", "Bxc6+") với danh sách nước đi hợp lệ
local function ApplyValidatedSAN(board, san, isWhite, epSquare)
    local clean = string.gsub(san, "[+#!?%s]", "")
    local legalMoves = GenerateLegalMoves(board, isWhite, epSquare)

    if clean == "O-O" or clean == "0-0" then
        for _, m in ipairs(legalMoves) do
            if m.piece == "K" and m.tc == 7 then
                return MakeRawMove(board, m.fr, m.fc, m.tr, m.tc, nil), nil, true
            end
        end
        return board, nil, false
    elseif clean == "O-O-O" or clean == "0-0-0" then
        for _, m in ipairs(legalMoves) do
            if m.piece == "K" and m.tc == 3 then
                return MakeRawMove(board, m.fr, m.fc, m.tr, m.tc, nil), nil, true
            end
        end
        return board, nil, false
    end

    local promo = nil
    local eqIdx = string.find(clean, "=")
    if eqIdx then
        promo = string.sub(clean, eqIdx + 1, eqIdx + 1)
        clean = string.sub(clean, 1, eqIdx - 1)
    end

    local targetSq = string.sub(clean, -2)
    local tr, tc = SqToRC(targetSq)
    if not tr or not tc then return board, nil, false end

    local firstChar = string.sub(clean, 1, 1)
    local pieceType = "P"
    local disambig = ""

    if string.match(firstChar, "[NBRQK]") then
        pieceType = firstChar
        disambig = string.gsub(string.sub(clean, 2, -3), "x", "")
    else
        pieceType = "P"
        disambig = string.gsub(string.sub(clean, 1, -3), "x", "")
    end

    for _, m in ipairs(legalMoves) do
        if m.piece == pieceType and m.tr == tr and m.tc == tc then
            local ok = true
            if #disambig > 0 then
                local df = string.match(disambig, "[a-h]")
                local dr = string.match(disambig, "[1-8]")
                if df and FileMap[df] ~= m.fc then ok = false end
                if dr and (9 - tonumber(dr)) ~= m.fr then ok = false end
            end
            if ok then
                local newEp = nil
                if pieceType == "P" and math.abs(m.tr - m.fr) == 2 then
                    newEp = RCToSq((m.fr + m.tr) / 2, m.fc)
                end
                return MakeRawMove(board, m.fr, m.fc, m.tr, m.tc, promo), newEp, true
            end
        end
    end

    return board, nil, false
end

local function BoardToFEN(board, activeColor, epSquare, fullMove)
    local rows = {}
    for r = 1, 8 do
        local empty = 0
        local s = ""
        for c = 1, 8 do
            local p = board[r][c]
            if p == "." then
                empty = empty + 1
            else
                if empty > 0 then s = s .. tostring(empty); empty = 0 end
                s = s .. p
            end
        end
        if empty > 0 then s = s .. tostring(empty) end
        table.insert(rows, s)
    end

    local castling = ""
    if board[8][5] == "K" then
        if board[8][8] == "R" then castling = castling .. "K" end
        if board[8][1] == "R" then castling = castling .. "Q" end
    end
    if board[1][5] == "k" then
        if board[1][8] == "r" then castling = castling .. "k" end
        if board[1][1] == "r" then castling = castling .. "q" end
    end
    if castling == "" then castling = "-" end

    return string.format("%s %s %s %s 0 %d", table.concat(rows, "/"), activeColor, castling, epSquare or "-", fullMove or 1)
end

