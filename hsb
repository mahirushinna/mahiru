local function ComputeSquareScreenCenter(boardFrame, sqIdx, mySide)
    local file, rank = IndexToFileRank(sqIdx)
    local col, row
    if mySide == 1 then
        col = file - 1; row = 8 - rank
    else
        col = 8 - file; row = rank - 1
    end
    local bPos = boardFrame.AbsolutePosition
    local bSize = boardFrame.AbsoluteSize
    local cellW, cellH = bSize.X / 8, bSize.Y / 8
    return math.floor(bPos.X + (col + 0.5) * cellW), math.floor(bPos.Y + (row + 0.5) * cellH)
end

-- Finds all interactive objects inside the Board hierarchy (INCLUDING the 100% Full-Board Hitbox!)
-- while strictly excluding Modals, Toasts, Overlays, and OurScreenGui!
local function GetBoardInteractiveTargetsAt(boardFrame, x, y)
    local targets = {}
    local seen = {}

    local function AddIfValid(obj)
        if not obj or seen[obj] or not obj:IsA("GuiObject") or not obj.Visible then return end
        if OurScreenGui and obj:IsDescendantOf(OurScreenGui) then return end
        local n = string.lower(obj.Name)
        if string.find(n, "modal") or string.find(n, "toast") or string.find(n, "overlay") or string.find(n, "topbar") then
            return
        end
        local pos = obj.AbsolutePosition
        local sz = obj.AbsoluteSize
        if x >= pos.X and x <= (pos.X + sz.X) and y >= pos.Y and y <= (pos.Y + sz.Y) then
            seen[obj] = true
            table.insert(targets, obj)
        end
    end

    for _, desc in ipairs(boardFrame:GetDescendants()) do
        AddIfValid(desc)
    end
    AddIfValid(boardFrame)
    if boardFrame.Parent and boardFrame.Parent:IsA("GuiObject") then
        AddIfValid(boardFrame.Parent)
    end

    table.sort(targets, function(a, b)
        return a.ZIndex > b.ZIndex
    end)

    return targets
end

-- Fires complete Click-to-Move AND Drag-and-Drop Input Lifecycle on Board Hitbox & UserInputService
local function FireBoardInputLifecycle(boardFrame, fx, fy, tx, ty, fromAlg, toAlg)
    if not getconnections then return 0 end
    local targetsSrc = GetBoardInteractiveTargetsAt(boardFrame, fx, fy)
    local targetsDst = GetBoardInteractiveTargetsAt(boardFrame, tx, ty)

    local inset = GuiService:GetGuiInset()
    local totalFired = 0
    local firedNames = {}

    local function MakeFakeInput(x, y, state, uType)
        return {
            UserInputType = uType,
            UserInputState = state,
            Position = Vector3.new(x, y, 0),
            Delta = Vector3.zero,
            KeyCode = Enum.KeyCode.Unknown
        }
    end

    local function TriggerStep(targets, x, y, isPress, isRelease)
        HookState.SpoofMouseActive = true
        HookState.SpoofX = x
        HookState.SpoofY = y + inset.Y

        for _, obj in ipairs(targets) do
            -- 1. GuiButton signals
            if isPress and obj:IsA("GuiButton") then
                for _, sigName in ipairs({ "Activated", "MouseButton1Down", "MouseButton1Click" }) do
                    local ok, conns = pcall(getconnections, obj[sigName])
                    if ok and conns and #conns > 0 then
                        for _, c in ipairs(conns) do
                            if c.Function then
                                pcall(task.spawn, c.Function, x, y)
                                pcall(task.spawn, c.Function)
                                totalFired += 1
                            end
                        end
                        firedNames[#firedNames + 1] = obj.Name .. "." .. sigName
                        break
                    end
                end
            end

            -- 2. InputBegan
            if isPress then
                local okB, connsB = pcall(getconnections, obj.InputBegan)
                if okB and connsB and #connsB > 0 then
                    local inMouse = MakeFakeInput(x, y, Enum.UserInputState.Begin, Enum.UserInputType.MouseButton1)
                    local inTouch = MakeFakeInput(x, y, Enum.UserInputState.Begin, Enum.UserInputType.Touch)
                    for _, c in ipairs(connsB) do
                        if c.Function then
                            pcall(task.spawn, c.Function, inMouse, false)
                            pcall(task.spawn, c.Function, inTouch, false)
                            totalFired += 1
                        end
                    end
                    firedNames[#firedNames + 1] = obj.Name .. ".InBegan"
                end
            end

            -- 3. InputEnded (Essential to complete tap or drop dragged piece!)
            if isRelease then
                local okE, connsE = pcall(getconnections, obj.InputEnded)
                if okE and connsE and #connsE > 0 then
                    local outMouse = MakeFakeInput(x, y, Enum.UserInputState.End, Enum.UserInputType.MouseButton1)
                    local outTouch = MakeFakeInput(x, y, Enum.UserInputState.End, Enum.UserInputType.Touch)
                    for _, c in ipairs(connsE) do
                        if c.Function then
                            pcall(task.spawn, c.Function, outMouse, false)
                            pcall(task.spawn, c.Function, outTouch, false)
                            totalFired += 1
                        end
                    end
                    firedNames[#firedNames + 1] = obj.Name .. ".InEnded"
                end
            end
        end

        -- 4. Also check UserInputService global InputBegan / InputEnded connections
        if isPress then
            local okU, uConns = pcall(getconnections, UserInputService.InputBegan)
            if okU and uConns then
                local inTouch = MakeFakeInput(x, y, Enum.UserInputState.Begin, Enum.UserInputType.Touch)
                for _, c in ipairs(uConns) do
                    if c.Function and (not isexecutorclosure or not isexecutorclosure(c.Function)) then
                        pcall(task.spawn, c.Function, inTouch, false)
                        totalFired += 1
                    end
                end
            end
        end
        if isRelease then
            local okU, uConns = pcall(getconnections, UserInputService.InputEnded)
            if okU and uConns then
                local outTouch = MakeFakeInput(x, y, Enum.UserInputState.End, Enum.UserInputType.Touch)
                for _, c in ipairs(uConns) do
                    if c.Function and (not isexecutorclosure or not isexecutorclosure(c.Function)) then
                        pcall(task.spawn, c.Function, outTouch, false)
                        totalFired += 1
                    end
                end
            end
        end
    end

    -- Step A: Press & Release on Source Square (`fromAlg`)
    TriggerStep(targetsSrc, fx, fy, true, true)
    task.wait(Config.SelectionHookDelay)

    -- Step B: Re-scan Destination Square (`toAlg`) and Press & Release
    targetsDst = GetBoardInteractiveTargetsAt(boardFrame, tx, ty)
    TriggerStep(targetsDst, tx, ty, true, true)

    HookState.SpoofMouseActive = false

    Logger.Push("SQ-V5", string.format("%s->%s Fired:%d [%s]",
        fromAlg, toAlg, totalFired, table.concat(firedNames, ", ")
    ))
    return totalFired
end

local function DispatchMovev5(move, mySide, legalMoveIdx)
    local fromAlg = IndexToAlgebraic(move.from)
    local toAlg = IndexToAlgebraic(move.to)
    local uci = fromAlg .. toAlg
    local promoStr = move.promo and "q" or nil
    local summary = {}

    -- Engine 1: Invoke #2 makeMove (Proto:false Controller/Module) directly with candidate signatures!
    if HookState.ControllerMakeMove2 then
        local fn2 = HookState.ControllerMakeMove2
        local tbl2 = HookState.ControllerTable2
        local activeRAM = GetActiveRAMBoard()

        -- Try calling #2 makeMove with both (fromAlg, toAlg, promo) and (uci) and (ramBoard, fromAlg, toAlg)
        pcall(function() fn2(fromAlg, toAlg, promoStr) end)
        pcall(function() fn2(uci) end)
        if tbl2 then
            pcall(function() fn2(tbl2, fromAlg, toAlg, promoStr) end)
        end
        if activeRAM then
            pcall(function() fn2(activeRAM, fromAlg, toAlg, promoStr) end)
            pcall(function() fn2(activeRAM, uci) end)
        end
        summary[#summary + 1] = "MM2:" .. uci
    end

    -- Engine 2: Check if any sibling function in ControllerTable2 handles square selection / move submission
    for k, fn in pairs(HookState.ControllerSiblings) do
        local kl = string.lower(k)
        if string.find(kl, "move") or string.find(kl, "play") or string.find(kl, "submit") then
            pcall(function() fn(fromAlg, toAlg, promoStr) end)
            pcall(function() fn(uci) end)
        elseif string.find(kl, "select") or string.find(kl, "click") or string.find(kl, "square") then
            pcall(function()
                fn(fromAlg)
                task.wait(0.05)
                fn(toAlg)
            end)
            pcall(function()
                fn(move.from)
                task.wait(0.05)
                fn(move.to)
            end)
            summary[#summary + 1] = "Sib:" .. k
        end
    end

    -- Engine 3: Full-Board Hitbox + UserInputService InputBegan/InputEnded Lifecycle Hook
    local boardFrame = GetBoardFrame()
    if boardFrame then
        local fx, fy = ComputeSquareScreenCenter(boardFrame, move.from, mySide)
        local tx, ty = ComputeSquareScreenCenter(boardFrame, move.to, mySide)
        local fired = FireBoardInputLifecycle(boardFrame, fx, fy, tx, ty, fromAlg, toAlg)
        summary[#summary + 1] = string.format("InHook(%d)", fired)
    end

    HookState.LastHookSummary = table.concat(summary, " + ")
end

