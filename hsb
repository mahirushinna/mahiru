local RenderConn = RunService.RenderStepped:Connect(function()
    if not Config.ESPEnabled then
        BestArrow:Hide(); AltArrow:Hide(); PonderArrow:Hide()
        EvalBg.Visible = false; BoardLockBox.Visible = false; DangerBox.Visible = false
        return
    end

    local bGeo = GetExactChessBoardGeometry()
    if not bGeo then
        BestArrow:Hide(); AltArrow:Hide(); PonderArrow:Hide()
        EvalBg.Visible = false; BoardLockBox.Visible = false; DangerBox.Visible = false
        return
    end

    -- Draw sleek calibration frame around the exact 8x8 board
    BoardLockBox.Size = UDim2.fromOffset(bGeo.W, bGeo.H)
    BoardLockBox.Position = UDim2.fromOffset(bGeo.X, bGeo.Y)
    BoardLockBox.Visible = true

    -- Highlight King in red if in check
    if RenderState.InCheckSq then
        local kx, ky, cw = ComputeExactSqCenter(bGeo, RenderState.InCheckSq, RenderState.Side)
        local bSz = math.floor(cw * 0.92)
        DangerBox.Size = UDim2.fromOffset(bSz, bSz)
        DangerBox.Position = UDim2.fromOffset(kx - bSz * 0.5, ky - bSz * 0.5)
        DangerBox.Visible = true
    else
        DangerBox.Visible = false
    end

    -- Strictly hide arrows while AI is still calculating!
    if not RenderState.Ready or not RenderState.Best then
        BestArrow:Hide(); AltArrow:Hide(); PonderArrow:Hide()
        return
    end

    local mySide = RenderState.Side

    -- 1. Render #1 Best Move Arrow (Green)
    local bm = RenderState.Best
    local fx, fy, cw = ComputeExactSqCenter(bGeo, bm.from, mySide)
    local tx, ty = ComputeExactSqCenter(bGeo, bm.to, mySide)
    local bestTag = string.format("%s (%+.1f)", bm.san or bm.uci, RenderState.Score / 100)
    BestArrow:Draw(fx, fy, tx, ty, cw, bestTag)

    -- 2. Render #2 Alternative Move Arrow (Cyan)
    if Config.ShowAltArrow and RenderState.Alt then
        local am = RenderState.Alt
        local afx, afy = ComputeExactSqCenter(bGeo, am.from, mySide)
        local atx, aty = ComputeExactSqCenter(bGeo, am.to, mySide)
        local altTag = string.format("#2 %s", am.san or am.uci)
        AltArrow:Draw(afx, afy, atx, aty, cw * 0.88, altTag)
    else
        AltArrow:Hide()
    end

    -- 3. Render Opponent Ponder / Threat Arrow (Orange)
    if Config.ShowPonderArrow and RenderState.Ponder then
        local pm = RenderState.Ponder
        local pfx, pfy = ComputeExactSqCenter(bGeo, pm.from, mySide)
        local ptx, pty = ComputeExactSqCenter(bGeo, pm.to, mySide)
        local pTag = "Opp: " .. (pm.san or pm.uci)
        PonderArrow:Draw(pfx, pfy, ptx, pty, cw * 0.82, pTag)
    else
        PonderArrow:Hide()
    end

    -- 4. Update Docked Evaluation Bar (Exact height of the 8x8 board!)
    if Config.ShowEvalBar then
        EvalBg.Size = UDim2.fromOffset(8, bGeo.H)
        EvalBg.Position = UDim2.fromOffset(math.max(2, bGeo.X - 12), bGeo.Y)
        EvalBg.Visible = true
        local pawns = RenderState.Score / 100
        local ratio = math.clamp(0.5 + 0.5 * math.tanh(pawns / 4.0), 0.05, 0.95)
        EvalFill.Size = UDim2.new(1, 0, ratio, 0)
        EvalFill.BackgroundColor3 = (pawns >= 0) and Color3.fromRGB(105, 225, 95) or Color3.fromRGB(235, 85, 85)
        EvalText.Text = ( math.abs(RenderState.Score) >= 9000 ) and (RenderState.Score > 0 and "M+" or "M-") or string.format("%+.1f", pawns)
    else
        EvalBg.Visible = false
    end
end)

