local function createToggleButton(parent, labelText, orderIndex, configKey)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -16, 0, 38)
    btn.Position = UDim2.new(0, 8, 0, 32 + (orderIndex - 1) * 46)
    btn.BackgroundColor3 = Color3.fromRGB(45, 50, 62)
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 12
    btn.TextColor3 = Color3.fromRGB(220, 225, 235)
    btn.Text = labelText .. ": TẮT"
    btn.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local function updateVisual()
        local state = Config[configKey]
        if state then
            btn.BackgroundColor3 = Color3.fromRGB(0, 165, 95)
            btn.Text = labelText .. ": BẬT"
        else
            btn.BackgroundColor3 = Color3.fromRGB(45, 50, 62)
            btn.Text = labelText .. ": TẮT"
        end
    end

    btn.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        updateVisual()
    end)

    updateVisual()
    return btn
end

