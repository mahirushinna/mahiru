-- Scans GC for:
--   1) #2 makeMove (Proto:false, Consts:[type, number, string, char, tostring, q, r, b, n]) & its table/upvalues
--   2) #3 RAM Board Instances ({board, side, ply, castling, ep, kingSq, fullmove})
--   3) Packet Sender functions containing constants "xb3" or ("b1" and "ply")
local function DeepScanRoChessMemory()
    table.clear(HookState.RAMBoards3)
    table.clear(HookState.PacketSenderFns)
    table.clear(HookState.ControllerSiblings)

    for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
        if desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction") then
            if string.match(desc.Name, "^[0-9a-fA-F]+$") and #desc.Name >= 6 then
                HookState.HexRemote = HookState.HexRemote or desc
            end
        end
    end

    if not getgc then
        Logger.Push("WARN", "Executor missing getgc()!")
        return
    end

    pcall(function()
        for _, obj in ipairs(getgc(true)) do
            if type(obj) == "table" and not rawget(obj, "_IsOurAIEngine") and obj ~= HookState and obj ~= Logger then
                -- Check if this is a live #3 RAM Board Instance!
                local brd = rawget(obj, "board")
                local side = rawget(obj, "side")
                local ply = rawget(obj, "ply")
                local kingSq = rawget(obj, "kingSq")
                if type(brd) == "table" and side ~= nil and type(ply) == "number" and kingSq ~= nil then
                    table.insert(HookState.RAMBoards3, obj)
                    local mt = getmetatable(obj)
                    if type(mt) == "table" then
                        HookState.BoardPrototype3 = rawget(mt, "__index") or mt
                    end
                end

                -- Check if this table has `makeMove`
                local mm = rawget(obj, "makeMove")
                if type(mm) == "function" then
                    local isProto = (rawget(obj, "__index") == obj)
                    if not isProto then
                        -- This is Table #2 (Proto:false Controller/Module)!
                        HookState.ControllerTable2 = obj
                        HookState.ControllerMakeMove2 = mm

                        local keyNames = {}
                        for k, v in pairs(obj) do
                            keyNames[#keyNames + 1] = tostring(k) .. "(" .. type(v) .. ")"
                            if type(v) == "function" then
                                HookState.ControllerSiblings[tostring(k)] = v
                            end
                        end
                        Logger.Push("TBL2", "Controller #2 Keys: [" .. table.concat(keyNames, ", ") .. "]")

                        -- Inspect #2 makeMove parameter info & upvalues
                        if debug and debug.getinfo then
                            local okI, info = pcall(debug.getinfo, mm)
                            if okI and info then
                                Logger.Push("MM2-INFO", string.format("numparams=%s vararg=%s", tostring(info.numparams), tostring(info.is_vararg)))
                            end
                        end
                        if debug and debug.getupvalues then
                            local okU, uvs = pcall(debug.getupvalues, mm)
                            if okU and uvs then
                                local uvDesc = {}
                                for uk, uv in pairs(uvs) do
                                    uvDesc[#uvDesc + 1] = tostring(uk) .. "=" .. SerializeVal(uv, 0)
                                    if type(uv) == "function" then
                                        HookState.ControllerSiblings["uv_" .. tostring(uk)] = uv
                                    elseif type(uv) == "table" and rawget(uv, "board") and rawget(uv, "ply") then
                                        table.insert(HookState.RAMBoards3, uv)
                                    end
                                end
                                Logger.Push("MM2-UV", "Upvals: " .. table.concat(uvDesc, " | "))
                            end
                        end

                        -- Install transparent spy wrapper on Table2.makeMove to log exact arguments when manual move occurs!
                        if not rawget(obj, "_SpyInstalled") then
                            rawset(obj, "_SpyInstalled", true)
                            local origMM2 = mm
                            rawset(obj, "makeMove", function(...)
                                local a = { ... }
                                local d = {}
                                for i = 1, #a do d[#d + 1] = SerializeVal(a[i], 0) end
                                Logger.Push("SPY-MM2", "makeMove called with (" .. table.concat(d, ", ") .. ")")
                                return origMM2(...)
                            end)
                        end
                    else
                        HookState.BoardPrototype3 = obj
                    end
                end

            elseif type(obj) == "function" and islclosure and islclosure(obj) and (not isexecutorclosure or not isexecutorclosure(obj)) then
                if debug and debug.getconstants then
                    local okC, consts = pcall(debug.getconstants, obj)
                    if okC and consts then
                        local hasXb3, hasB1, hasPly, hasTs = false, false, false, false
                        local cList = {}
                        for _, c in pairs(consts) do
                            if type(c) == "string" then
                                if c == "xb3" then hasXb3 = true
                                elseif c == "b1" then hasB1 = true
                                elseif c == "ply" then hasPly = true
                                elseif c == "ts" then hasTs = true
                                end
                                if #c > 0 and #c <= 20 then
                                    cList[#cList + 1] = c
                                end
                            end
                        end
                        if hasXb3 or (hasB1 and hasPly) or (hasB1 and hasTs) then
                            table.insert(HookState.PacketSenderFns, obj)
                            Logger.Push("PKT-FN", "Found Move Sender Fn! Consts:[" .. table.concat(cList, ", ") .. "]")
                            if debug.getupvalues then
                                local okU, uvs = pcall(debug.getupvalues, obj)
                                if okU and uvs then
                                    local uvDump = {}
                                    for uk, uv in pairs(uvs) do
                                        uvDump[#uvDump + 1] = tostring(uk) .. "=" .. SerializeVal(uv, 0)
                                        if type(uv) == "table" and rawget(uv, "board") and rawget(uv, "ply") then
                                            table.insert(HookState.RAMBoards3, uv)
                                        end
                                    end
                                    Logger.Push("PKT-UV", "Sender Upvals: " .. table.concat(uvDump, " | "))
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    -- Log methods on BoardPrototype3 (#3) if discovered
    if HookState.BoardPrototype3 then
        local protoMethods = {}
        for k, v in pairs(HookState.BoardPrototype3) do
            if type(v) == "function" then
                protoMethods[#protoMethods + 1] = tostring(k)
            end
        end
        Logger.Push("PROTO3", "Methods: [" .. table.concat(protoMethods, ", ") .. "]")
    end

    Logger.Push("SCAN", string.format("Tbl2:%s | RAMBoards:%d | PktFns:%d",
        HookState.ControllerMakeMove2 and "FOUND" or "None",
        #HookState.RAMBoards3,
        #HookState.PacketSenderFns
    ))
end

