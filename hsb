end

Logger.Log("INIT", "v9 VIP Loaded. Locking onto exact 8x8 board...")
task.spawn(ScanAndSpyRAMBoards)

local LastBoardSig = ""
local Busy = false

task.spawn(function()
    while Running and task.wait(0.18) do
        local bGeo = GetExactChessBoardGeometry()
        if bGeo and not Busy then
            -- 1. Detect Board Orientation from physical rank/file labels ("1".."8", "a".."h")
            local autoSide = DetectBoardOrientationFromLabels(bGeo)
            local mySide = 1
            if Config.SideMode == "WHITE" then
                mySide = 1
            elseif Config.SideMode == "BLACK" then
                mySide = -1
            else
                mySide = autoSide or RenderState.Side or 1
            end
            RenderState.Side = mySide

            -- 2. Scrape Move History below the REAL 8x8 board Y!
            local maxPly = ScrapeMovesBelowRealBoard(bGeo)
            Engine:Reset()
            local applied = 0

            for ply = 1, maxPly do
                local san = PersistentMovesByPly[ply]
                if not san then break end
                local m = Engine:ParseSAN(san, (ply % 2 == 1) and 1 or -1)
                if m then
                    Engine:Step(m)
                    table.insert(Engine.Hist, m.uci)
                    applied += 1
                else
                    Logger.Log("SAN-WARN", string.format("Ply %d (%s) parse mismatch", ply, tostring(san)))
                    break
                end
            end

            -- Check if either King is currently in check
            if Engine:InCheck(Engine.Side) then
                RenderState.InCheckSq = Engine:FindKing(Engine.Side)
            else
                RenderState.InCheckSq = nil
            end

            local sig = Engine:Signature() .. "|S:" .. tostring(mySide)
            if sig ~= LastBoardSig or RenderState.ForceRecalc then
                RenderState.ForceRecalc = false
                LastBoardSig = sig

                -- Immediately hide arrows while AI runs multi-depth simulations
                RenderState.Ready = false
                BestArrow:Hide(); AltArrow:Hide(); PonderArrow:Hide()

                Busy = true
                local calcSide = Engine.Side
                local isMyTurn = (calcSide == mySide)

                local bestM, altM, ponderM, sc, meta = Engine:AnalyzePosition(calcSide, function(d, maxD, pv, curSc, nodes)
                    Status.Text = string.format(
                        "Board: %dx%d | Side: %s | Ply: %d\n⚡ Analyzing Depth %d/%d...\nPV: %s (%+.2f) | %d nodes\n(Arrows appear once calculation locks)",
                        math.floor(bGeo.W), math.floor(bGeo.H),
                        mySide == 1 and "WHITE" or "BLACK",
                        applied, d, maxD, tostring(pv), curSc / 100, nodes
                    )
                end)

                if bestM then
                    RenderState.Best = bestM
                    RenderState.Alt = altM
                    RenderState.Ponder = ponderM
                    RenderState.Score = isMyTurn and sc or -sc
                    RenderState.Meta = meta
                    RenderState.Ready = Config.ESPEnabled

                    local recentSAN = {}
                    for p = math.max(1, applied - 3), applied do
                        if PersistentMovesByPly[p] then
                            recentSAN[#recentSAN + 1] = PersistentMovesByPly[p]
                        end
                    end

                    Status.Text = string.format(
                        "Side: %s (%s) | Ply: %d | %s\n#1 Best: %s (%s) [%+.2f]\n#2 Alt: %s | Opp Reply: %s\nMoves: %s (%d nodes)",
                        mySide == 1 and "WHITE" or "BLACK",
                        Config.SideMode,
                        applied,
                        isMyTurn and "YOUR TURN" or "OPPONENT TURN",
                        bestM.san or bestM.uci, bestM.uci, RenderState.Score / 100,
                        altM and (altM.san or altM.uci) or "--",
                        ponderM and (ponderM.san or ponderM.uci) or "--",
                        #recentSAN > 0 and table.concat(recentSAN, " ") or "Start",
                        Engine.Nodes
                    )

                    Logger.Log("AI", string.format("Ply %d -> #1:%s (%+.2f) #2:%s [%s]",
                        applied,
                        bestM.san or bestM.uci,
                        RenderState.Score / 100,
                        altM and (altM.san or altM.uci) or "--",
                        meta
                    ))
                end
                Busy = false
            end
        end
    end
end)
