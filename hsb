local LockedMatchSide = nil

local function DetectPlayerColor(boardFrame, turnState, engineTurn)
    if turnState == "MY_TURN" then
        LockedMatchSide = engineTurn
        return engineTurn
    elseif turnState == "OPPONENT_TURN" then
        LockedMatchSide = -engineTurn
