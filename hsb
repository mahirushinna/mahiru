-- 6. VÒNG LẶP TỰ CHƠI & PHÂN TÍCH LỖI ĐỐI THỦ (START TO FINISH)
-- =====================================================
local LastProcessedKey = ""
local LastEval = 0

task.spawn(function()
    while task.wait(0.35) do
        local boardFrame, myColor = DetectBoardAndOrientation()
        if boardFrame then
            local moveList = UpdateMoveHistoryFromUI()
            local board = NewBoard()
            local epSquare = nil
            local validPlyCount = 0

            for i, san in ipairs(moveList) do
                local isWhiteTurn = (i % 2 == 1)
                local nextBoard, nextEp, ok = ApplyValidatedSAN(board, san, isWhiteTurn, epSquare)
                if ok then
                    board = nextBoard
                    epSquare = nextEp
                    validPlyCount = i
                else
                    break
                end
            end

            local activeColor = (validPlyCount % 2 == 0) and "w" or "b"
            local stateKey = string.format("%s_%d_%s", myColor, validPlyCount, moveList[validPlyCount] or "start")

            if stateKey ~= LastProcessedKey then
                local isWhiteNext = (activeColor == "w")
                local fullMove = math.floor(validPlyCount / 2) + 1
                local bestMove, evalScore, mateScore = GetBestMoveAI(board, isWhiteNext, epSquare, fullMove)

                if bestMove then
                    local evalStr = mateScore and ("#" .. tostring(mateScore)) or string.format("%+.2f", evalScore)
                    StatusLbl.Text = string.format(
                        "Quân bạn: %s | Lượt: %s (Đánh giá: %s)\nNước đi AI: %s -> %s",
                        myColor == "w" and "TRẮNG" or "ĐEN",
                        activeColor == "w" and "Trắng" or "Đen",
                        evalStr,
                        string.sub(bestMove, 1, 2),
                        string.sub(bestMove, 3, 4)
                    )

                    -- Phân tích nước đi vừa rồi của đối thủ
                    if validPlyCount > 0 and activeColor == myColor then
                        local gain = (myColor == "w") and (evalScore - LastEval) or (LastEval - evalScore)
                        local oppMove = moveList[validPlyCount] or "?"
                        if mateScore then
                            AnalysisLbl.Text = string.format("🔥 Đối thủ đi %s -> Đã có chuỗi CHIẾU HẾT! Khai thác: %s", oppMove, bestMove)
                            AnalysisLbl.TextColor3 = Color3.fromRGB(80, 255, 130)
                        elseif gain >= 2.2 then
                            AnalysisLbl.Text = string.format("🔥 BLUNDER từ đối thủ (%s)! Trừng phạt ngay: %s", oppMove, bestMove)
                            AnalysisLbl.TextColor3 = Color3.fromRGB(80, 255, 130)
                        elseif gain >= 0.9 then
                            AnalysisLbl.Text = string.format("⚠️ Đối thủ đi yếu (%s). Chiếm ưu thế bằng: %s", oppMove, bestMove)
                            AnalysisLbl.TextColor3 = Color3.fromRGB(255, 215, 90)
                        else
                            AnalysisLbl.Text = string.format("Đối thủ vừa đi %s -> AI đang ép thế trận bằng %s", oppMove, bestMove)
                            AnalysisLbl.TextColor3 = Color3.fromRGB(185, 220, 255)
                        end
                    end
                    LastEval = evalScore

                    -- Nếu đến lượt bạn và đang bật AutoPlay -> Tự động đi quân và kiểm tra xác nhận
                    if Config.AutoPlay and activeColor == myColor then
                        local delayTime = Config.MoveDelayMin + math.random() * (Config.MoveDelayMax - Config.MoveDelayMin)
                        task.wait(delayTime)
                        ExecuteMoveOnBoard(bestMove, myColor)

                        -- Đợi ngắn xem nước đi đã được ghi nhận chưa; nếu chưa thì thử lại ở vòng lặp kế tiếp
                        task.wait(Config.RetryInterval)
                        local updatedMoves = UpdateMoveHistoryFromUI()
                        if #updatedMoves > validPlyCount then
                            LastProcessedKey = stateKey
                        end
                    else
                        LastProcessedKey = stateKey
                    end
                end
            end
        end
    end
end)
