local function createToggleButton(parent: Frame, labelText: string, initialValue: boolean, onToggle: (boolean) -> ()): (TextButton, (boolean) -> ())
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 36)
	btn.Font = Enum.Font.GothamMedium
	btn.TextSize = 11
	btn.TextWrapped = true
	btn.AutoButtonColor = true
	btn.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = btn

	local current = initialValue

	local function updateVisual(state: boolean)
		current = state
		if state then
			btn.BackgroundColor3 = Color3.fromRGB(0, 155, 110)
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			btn.Text = labelText .. ": BẬT"
		else
			btn.BackgroundColor3 = Color3.fromRGB(40, 44, 56)
			btn.TextColor3 = Color3.fromRGB(185, 190, 205)
			btn.Text = labelText .. ": TẮT"
		end
	end

	updateVisual(initialValue)

	btn.Activated:Connect(function()
		updateVisual(not current)
		onToggle(current)
	end)

	return btn, updateVisual
end

