-- 3. HỆ THỐNG ESP (CHỈ ĐỊNH VỊ ĐỊCH)
-- ==========================================
local function updateCharacterESP(targetData)
    local char = targetData.Character
    local plr = targetData.Player
    if not char then return end

    local head = char:FindFirstChild("Head")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local rootPart = char:FindFirstChild("HumanoidRootPart") or head

    local existingEsp = head and head:FindFirstChild("MrDon_ESP_Tag")
    local anyEspActive = Config.ESP_Name or Config.ESP_Health or Config.ESP_Distance

    -- Nếu tắt toàn bộ ESP, mục tiêu đã chết, hoặc mục tiêu là ĐỒNG ĐỘI -> Ẩn/Xóa ESP
    if not anyEspActive or not head or not humanoid or humanoid.Health <= 0 or isTeammate(plr, char) then
        if existingEsp then
            existingEsp.Enabled = false
        end
        return
    end

    -- Tạo mới BillboardGui nếu chưa có
    if not existingEsp then
        existingEsp = Instance.new("BillboardGui")
        existingEsp.Name = "MrDon_ESP_Tag"
        existingEsp.Adornee = head
        existingEsp.Size = UDim2.new(0, 180, 0, 65)
        existingEsp.StudsOffset = Vector3.new(0, 2.6, 0)
        existingEsp.AlwaysOnTop = true
        existingEsp.Parent = head

        local textLabel = Instance.new("TextLabel")
        textLabel.Name = "InfoLabel"
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.TextColor3 = Color3.fromRGB(255, 65, 65) -- Màu đỏ nổi bật cho kẻ địch
        textLabel.TextStrokeTransparency = 0.2
        textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        textLabel.Font = Enum.Font.GothamBold
        textLabel.TextSize = 13
        textLabel.Parent = existingEsp
    end

    existingEsp.Enabled = true
    local infoLabel = existingEsp:FindFirstChild("InfoLabel")
    if infoLabel then
        local lines = {}

        if Config.ESP_Name then
            table.insert(lines, tostring(targetData.DisplayName))
        end

        if Config.ESP_Health then
            local hp = math.floor(humanoid.Health)
            local maxHp = math.floor(humanoid.MaxHealth)
            table.insert(lines, string.format("Máu: %d / %d", hp, maxHp))
        end

        if Config.ESP_Distance and rootPart then
            local myPos = Camera.CFrame.Position
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                myPos = LocalPlayer.Character.HumanoidRootPart.Position
            end
            local dist = math.floor((rootPart.Position - myPos).Magnitude)
            table.insert(lines, string.format("Khoảng cách: %dm", dist))
        end

        infoLabel.Text = table.concat(lines, "\n")
    end
end

