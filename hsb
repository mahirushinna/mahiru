local function ComputeExactSqCenter(bGeo, sqIdx, mySide)
    local f, r = FR(sqIdx)
    local col = (mySide == 1) and (f - 1) or (8 - f)
    local row = (mySide == 1) and (8 - r) or (r - 1)
    local cw = bGeo.W / 8
    local ch = bGeo.H / 8
    return math.floor(bGeo.X + (col + 0.5) * cw), math.floor(bGeo.Y + (row + 0.5) * ch), cw
end

