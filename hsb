-- 3. BỘ ĐỌC LỊCH SỬ NƯỚC ĐI CHỐNG TRÔI KHI CUỘN (SCROLL-SAFE)
-- =====================================================
local PersistentMoves = {} -- Lưu trữ theo số thứ tự ply: PersistentMoves[1] = "e4", [2] = "d5", ...

local function IsValidSANToken(txt)
    if txt == "O-O" or txt == "O-O-O" or txt == "0-0" or txt == "0-0-0" then return true end
    return string.match(txt, "^[NBRQK]?[a-h]?[1-8]?x?[a-h][1-8][=]?[NBRQ]?[+#!?]*$") ~= nil
end

local function UpdateMoveHistoryFromUI()
    local turnNumbers = {}
    local moveTokens = {}

    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Visible then
            local txt = string.gsub(obj.Text or "", "^%s*(.-)%s*$", "%1")
            local pos = obj.AbsolutePosition
            local sz = obj.AbsoluteSize

            -- Khu vực bảng lịch sử nước đi nằm bên dưới bàn cờ (Y > 420)
            if pos.Y > 420 and sz.Y >= 10 and sz.Y <= 60 then
                local numMatch = string.match(txt, "^(%d+)%.$")
                if numMatch then
                    table.insert(turnNumbers, {
                        turn = tonumber(numMatch),
                        y = pos.Y,
                        x = pos.X
                    })
                elseif IsValidSANToken(txt) and sz.X > 16 then
                    table.insert(moveTokens, {
                        san = txt,
                        y = pos.Y,
                        x = pos.X
                    })
                end
            end
        end
    end

    -- Nếu không có bất kỳ nước đi nào trên UI (Ván mới bắt đầu) -> Xóa bộ nhớ cũ
    if #moveTokens == 0 then
        if #PersistentMoves > 0 then
            table.clear(PersistentMoves)
        end
        return PersistentMoves
    end

    -- Ghép từng nước đi (Trắng cột trái, Đen cột phải) vào đúng dòng số thứ tự lượt (1., 2., 3. ...)
    if #turnNumbers > 0 then
        table.sort(turnNumbers, function(a, b) return a.turn < b.turn end)

        -- Nếu trên UI chỉ có "1." và chỉ có 1 nước đi -> Reset ván mới
        if #turnNumbers == 1 and turnNumbers[1].turn == 1 and #moveTokens <= 2 and #PersistentMoves > 2 then
            table.clear(PersistentMoves)
        end

        for _, tInfo in ipairs(turnNumbers) do
            local rowMoves = {}
            for _, m in ipairs(moveTokens) do
                if math.abs(m.y - tInfo.y) <= 14 and m.x > tInfo.x then
                    table.insert(rowMoves, m)
                end
            end
            table.sort(rowMoves, function(a, b) return a.x < b.x end)

            local whitePly = (tInfo.turn - 1) * 2 + 1
            local blackPly = whitePly + 1

            if rowMoves[1] then
                PersistentMoves[whitePly] = rowMoves[1].san
            end
            if rowMoves[2] then
                PersistentMoves[blackPly] = rowMoves[2].san
            elseif PersistentMoves[blackPly] and tInfo.turn == turnNumbers[#turnNumbers].turn then
                PersistentMoves[blackPly] = nil
            end
        end
    else
        -- Dự phòng nếu không tìm thấy nhãn số thứ tự lượt
        table.sort(moveTokens, function(a, b)
            if math.abs(a.y - b.y) > 10 then return a.y < b.y end
            return a.x < b.x
        end)
        for i, m in ipairs(moveTokens) do
            PersistentMoves[i] = m.san
        end
    end

    -- Chuẩn hóa mảng liên tục 1..N
    local cleanList = {}
    local idx = 1
    while PersistentMoves[idx] do
        table.insert(cleanList, PersistentMoves[idx])
        idx = idx + 1
    end
    return cleanList
end

