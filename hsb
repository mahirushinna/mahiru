-- 3. BỘ DỰNG FEN TỪ LỊCH SỬ UCI CỦA SESSION (PHỤC VỤ CLOUD STOCKFISH/LICHESS)
local Files = {"a", "b", "c", "d", "e", "f", "g", "h"}
local FileMap = {a=1, b=2, c=3, d=4, e=5, f=6, g=7, h=8}

local function SqToRC(sq)
    local f = FileMap[string.sub(sq, 1, 1)]
    local r = tonumber(string.sub(sq, 2, 2))
    if not f or not r then return nil, nil end
    return 9 - r, f
end

local function RCToSq(r, c)
    return Files[c] .. tostring(9 - r)
end

local function BuildFEN(startFen, ucis)
    local fenStr = startFen or "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
    local parts = string.split(fenStr, " ")
    local rowsRaw = string.split(parts[1], "/")
    local board = {}

    for r = 1, 8 do
        board[r] = {}
        local col = 1
        local rStr = rowsRaw[r] or "8"
        for i = 1, #rStr do
            local ch = string.sub(rStr, i, i)
            local n = tonumber(ch)
            if n then
                for _ = 1, n do board[r][col] = "."; col = col + 1 end
            else
                board[r][col] = ch; col = col + 1
            end
        end
    end

    local whiteTurn = (parts[2] ~= "b")
    local castling = parts[3] or "KQkq"
    local epSquare = parts[4] or "-"

    for _, uci in ipairs(ucis or {}) do
        local fromSq = string.sub(uci, 1, 2)
        local toSq = string.sub(uci, 3, 4)
        local promo = string.sub(uci, 5, 5)
        local fr, fc = SqToRC(fromSq)
        local tr, tc = SqToRC(toSq)

        if fr and tr then
            local p = board[fr][fc]
            local pu = string.upper(p)
            local isW = (p ~= "." and pu == p)

            if pu == "P" and fc ~= tc and board[tr][tc] == "." then
                board[fr][tc] = "."
            end
            if pu == "K" and math.abs(tc - fc) == 2 then
                if tc == 7 then board[fr][6] = board[fr][8]; board[fr][8] = "."
                elseif tc == 3 then board[fr][4] = board[fr][1]; board[fr][1] = "." end
            end

            if pu == "K" then
                castling = isW and string.gsub(castling, "[KQ]", "") or string.gsub(castling, "[kq]", "")
            end
            if fromSq == "a1" or toSq == "a1" then castling = string.gsub(castling, "Q", "") end
            if fromSq == "h1" or toSq == "h1" then castling = string.gsub(castling, "K", "") end
            if fromSq == "a8" or toSq == "a8" then castling = string.gsub(castling, "q", "") end
            if fromSq == "h8" or toSq == "h8" then castling = string.gsub(castling, "k", "") end
            if castling == "" then castling = "-" end

            epSquare = (pu == "P" and math.abs(tr - fr) == 2) and RCToSq((fr + tr) / 2, fc) or "-"
            board[fr][fc] = "."
            if promo and promo ~= "" then
                board[tr][tc] = isW and string.upper(promo) or string.lower(promo)
            else
                board[tr][tc] = p
            end
        end
        whiteTurn = not whiteTurn
    end

    local outRows = {}
    for r = 1, 8 do
        local empty = 0
        local s = ""
        for c = 1, 8 do
            local p = board[r][c]
            if p == "." then
                empty = empty + 1
            else
                if empty > 0 then s = s .. tostring(empty); empty = 0 end
                s = s .. p
            end
        end
        if empty > 0 then s = s .. tostring(empty) end
        table.insert(outRows, s)
    end

    local side = whiteTurn and "w" or "b"
    local fullMove = math.floor(#(ucis or {}) / 2) + 1
    return string.format("%s %s %s %s 0 %d", table.concat(outRows, "/"), side, castling, epSquare, fullMove)
end

-- 4. HỆ THỐNG AI ĐA LÕI: VORTEXBOT + BOT.ANALYSE + STOCKFISH 16 CLOUD (NON-BLOCKING)
local httpRequest = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request

local function FetchCloudMoveAsync(fen, depth, timeoutSec)
    local done = false
    local resultMove, resultScore, resultMate, resultSource = nil, 0, nil, nil

    task.spawn(function()
        local enc = HttpService:UrlEncode(fen)
        local url = string.format("https://stockfish.online/api/s/v2.php?fen=%s&depth=%d", enc, math.min(depth, 15))
        local ok, body = pcall(function()
            if httpRequest then
                local r = httpRequest({Url = url, Method = "GET"})
                return r and r.Body
            end
            return game:HttpGet(url)
        end)
        if not done and ok and body then
            local decOk, data = pcall(function() return HttpService:JSONDecode(body) end)
            if decOk and data and data.success and data.bestmove then
                local m = string.match(data.bestmove, "bestmove%s+([a-h][1-8][a-h][1-8][qrbn]?)")
                if m then
                    resultMove = m
                    resultScore = tonumber(data.evaluation) or 0
                    resultMate = data.mate
                    resultSource = "Stockfish 16"
                    done = true
                end
            end
        end
    end)

    local t0 = os.clock()
    while not done and (os.clock() - t0) < timeoutSec do
        task.wait(0.03)
    end
    done = true
    return resultMove, resultScore, resultMate, resultSource
end

local function ComputeBestMove(session)
    local startFen = session.startFen or "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
    local moves = table.clone(session.ucis or {})

    -- Ưu tiên 1: VortexBot.analyse (Server Engine Bridge của RoChess - Chuẩn 100% luật game, trả về res.best)
    if VortexBot and typeof(VortexBot.analyse) == "function" then
        local ok, res = pcall(VortexBot.analyse, startFen, moves, CFG.ThinkSeconds, CFG.MaxDepth)
        if ok and type(res) == "table" and type(res.best) == "string" and #res.best >= 4 then
            local cpScore = (tonumber(res.score) or 0) / 100
            local d = tonumber(res.depth) or CFG.MaxDepth
            return res.best, cpScore, res.mate, string.format("VortexBot D%d", d)
        end
    end

    -- Ưu tiên 2: Stockfish 16 Cloud (Có giới hạn timeout 1.15s để không bao giờ treo máy)
    local fen = BuildFEN(startFen, moves)
    local sfMove, sfScore, sfMate, sfSrc = FetchCloudMoveAsync(fen, 14, CFG.CloudTimeout)
    if sfMove then
        return sfMove, sfScore, sfMate, sfSrc
    end

    -- Ưu tiên 3: Bot.analyse nội bộ của RoChess (Trả về res.best ngay cả khi mất mạng)
    if Bot and typeof(Bot.analyse) == "function" then
        local ok, res = pcall(Bot.analyse, startFen, moves, CFG.ThinkSeconds, CFG.MaxDepth)
        if ok and type(res) == "table" and type(res.best) == "string" and #res.best >= 4 then
            local cpScore = (tonumber(res.score) or 0) / 100
            local d = tonumber(res.depth) or CFG.MaxDepth
            return res.best, cpScore, res.mate, string.format("RoChess Engine D%d", d)
        end
    end

    -- Ưu tiên 4: VortexBot.think / Bot.think trực tiếp
    if VortexBot and typeof(VortexBot.think) == "function" then
        local ok, uci = pcall(VortexBot.think, startFen, moves, CFG.ThinkSeconds, CFG.MaxDepth)
        if ok and type(uci) == "string" and #uci >= 4 then
            return uci, 0, nil, "VortexBot Think"
        end
    end
    if Bot and typeof(Bot.think) == "function" then
        local ok, uci = pcall(Bot.think, startFen, moves, CFG.ThinkSeconds, CFG.MaxDepth)
        if ok and type(uci) == "string" and #uci >= 4 then
            return uci, 0, nil, "RoChess Think"
        end
    end

    return nil, 0, nil, "None"
end

-- 5. VẼ MŨI TÊN ESP TRÊN BÀN CỜ & ĐI QUÂN TRỰC TIẾP QUA MODULE ROCHESS
local function DrawBoardArrow(uci)
    if not CFG.DrawArrow or not uci or #uci < 4 then return end
    pcall(function()
        if App.board and typeof(App.board.setArrow) == "function" then
            local fromIdx = Engine.algToIndex64(string.sub(uci, 1, 2))
            local toIdx = Engine.algToIndex64(string.sub(uci, 3, 4))
            if fromIdx and toIdx then
                App.board:setArrow("hint", fromIdx, toIdx, Color3.fromRGB(45, 235, 115), 0.15)
            end
        end
    end)
end

local function ExecuteMoveNative(session, uci)
    if not session or not uci or #uci < 4 then return false end
    local beforePly = #(session.ucis or {})

    -- Đồng bộ viewPly về nước hiện tại nếu đang xem lại lịch sử
    pcall(function()
        if session.viewPly and session.viewPly ~= beforePly then
            session.viewPly = beforePly
        end
    end)

    local fromSq = string.sub(uci, 1, 2)
    local toSq = string.sub(uci, 3, 4)
    local promoChar = string.lower(string.sub(uci, 5, 5) or "")
    local promo = PROMO_CODE[promoChar]

    local fromIdx = Engine.algToIndex64(fromSq)
    local toIdx = Engine.algToIndex64(toSq)
    if not fromIdx or not toIdx then return false end

    -- Cách 1: Gọi chuẩn App.onBoardMove(from, to, promo, false) của RoChess!
    pcall(function()
        App.onBoardMove(fromIdx, toIdx, promo, false)
    end)
    task.wait(0.06)
    if #(session.ucis or {}) > beforePly then return true end

    -- Cách 2: Gọi trực tiếp session:playMove(uci)
    pcall(function()
        if typeof(session.playMove) == "function" then
            session:playMove(uci)
        end
    end)
    task.wait(0.06)
    if #(session.ucis or {}) > beforePly then return true end

    -- Cách 3: Gọi App.playMove(uci)
    pcall(function()
        if typeof(App.playMove) == "function" then
            App.playMove(uci)
        end
    end)
    task.wait(0.06)

    return #(session.ucis or {}) > beforePly
end

