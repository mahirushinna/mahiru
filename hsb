-- 1. HỆ THỐNG BẤM NÚT THUẦN MOBILE (KHÔNG GỌI PHÍM PC GÂY MẤT NÚT CẢM ỨNG)
-- ============================================================================

local ButtonKeywords = {
    Block    = { "chặn đòn", "chan don", "chặn", "block", "parry", "guard" },
    Light    = { "ánh sáng", "anh sang", "tấn công nhẹ", "light", "slash", "m1" },
    Heavy    = { "nặng", "nang", "tấn công mạnh", "heavy", "strong", "m2" },
    Dodge    = { "né", "ne", "dodge", "dash", "lướt" },
    Ultimate = { "siêu cấp", "sieu cap", "sơ cấp", "kỹ năng tối thượng", "ultimate", "ult" },
}

local function containsKeyword(str, list)
    if type(str) ~= "string" or str == "" then return false end
    local lower = string.lower(str)
    for _, kw in ipairs(list) do
        if string.find(lower, kw, 1, true) then
            return true
        end
    end
    return false
end

local function resolveGuiButton(inst)
    if inst:IsA("GuiButton") then return inst end
    local up = inst:FindFirstAncestorWhichIsA("GuiButton")
    if up then return up end
    if inst.Parent then
        for _, child in ipairs(inst.Parent:GetChildren()) do
            if child:IsA("GuiButton") then return child end
        end
    end
    return nil
end

local function refreshTouchButtons()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return end

    for _, desc in ipairs(pg:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("TextButton") then
            local raw = desc.Text or ""
            local loc = ""
            pcall(function() loc = desc.LocalizedText or "" end)

            local btn = resolveGuiButton(desc)
            if btn and btn.AbsoluteSize.X > 18 then
                for action, kwList in pairs(ButtonKeywords) do
                    if containsKeyword(raw, kwList) or containsKeyword(loc, kwList) or containsKeyword(btn.Name, kwList) then
                        State.Buttons[action] = btn
                    end
                end
            end
        end
    end
end

-- Chỉ kích hoạt tín hiệu nội bộ của nút cảm ứng, tuyệt đối không gọi SendKeyEvent / SendMouseButtonEvent
local function triggerMobileButton(action, pressMode)
    local btn = State.Buttons[action]
    if not btn or not btn.Parent then
        refreshTouchButtons()
        btn = State.Buttons[action]
    end
    if not btn or not btn.Visible then return false end

    -- Tạo InputObject chuẩn Touch để truyền vào InputBegan / InputEnded của nút game
    local fakeTouchBegin = {
        UserInputType = Enum.UserInputType.Touch,
        UserInputState = Enum.UserInputState.Begin,
        KeyCode = Enum.KeyCode.Unknown,
    }
    local fakeTouchEnd = {
        UserInputType = Enum.UserInputType.Touch,
        UserInputState = Enum.UserInputState.End,
        KeyCode = Enum.KeyCode.Unknown,
    }

    if typeof(firesignal) == "function" then
        pcall(function()
            if pressMode == "Down" then
                firesignal(btn.InputBegan, fakeTouchBegin)
                firesignal(btn.MouseButton1Down, 0, 0)
            elseif pressMode == "Up" then
                firesignal(btn.InputEnded, fakeTouchEnd)
                firesignal(btn.MouseButton1Up, 0, 0)
            else
                firesignal(btn.InputBegan, fakeTouchBegin)
                firesignal(btn.MouseButton1Down, 0, 0)
                firesignal(btn.TouchTap)
                firesignal(btn.MouseButton1Click)
                firesignal(btn.Activated)
                task.delay(0.035, function()
                    pcall(function()
                        firesignal(btn.InputEnded, fakeTouchEnd)
                        firesignal(btn.MouseButton1Up, 0, 0)
                    end)
                end)
            end
        end)
    end

    -- Kết hợp getconnections để gọi thẳng hàm callback của nút trong script game
    if typeof(getconnections) == "function" then
        pcall(function()
            if pressMode ~= "Up" then
                for _, conn in ipairs(getconnections(btn.MouseButton1Down)) do conn:Fire() end
                for _, conn in ipairs(getconnections(btn.Activated)) do conn:Fire() end
                for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do conn:Fire() end
                for _, conn in ipairs(getconnections(btn.TouchTap)) do conn:Fire() end
            end
            if pressMode == "Up" then
                for _, conn in ipairs(getconnections(btn.MouseButton1Up)) do conn:Fire() end
            end
        end)
    end

    return true
end

local function isUltimateAvailable()
    local btn = State.Buttons.Ultimate
    if not btn or not btn.Parent then
        refreshTouchButtons()
        btn = State.Buttons.Ultimate
    end
    return (btn ~= nil and btn.Visible and btn.AbsoluteSize.X > 20)
end

-- ============================================================================
-- 2. NHẬN DIỆN ĐỒNG ĐỘI TRONG 2V2 (LỌC BẢNG VS TRÊN ĐẦU + VÒNG XANH DƯỚI CHÂN)
-- ============================================================================

local function updateTeammates2v2()
    table.clear(State.TeammateNames)
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return end

    local cam = workspace.CurrentCamera
    local screenW = cam and cam.ViewportSize.X or 800
    local halfW = screenW * 0.48

    -- Trên thanh máu 2v2 (như ở Video 3), đồng đội luôn nằm cùng cột bên TRÁI màn hình với LocalPlayer
    for _, lbl in ipairs(pg:GetDescendants()) do
        if lbl:IsA("TextLabel") and lbl.Visible and lbl.AbsolutePosition.Y < 140 then
            local txt = string.lower(lbl.Text or "")
            if lbl.AbsolutePosition.X < halfW then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then
                        local pName = string.lower(plr.Name)
                        local dName = string.lower(plr.DisplayName)
                        if string.find(txt, pName, 1, true) or string.find(txt, dName, 1, true) then
                            State.TeammateNames[plr.Name] = true
                        end
                    end
                end
            end
        end
    end
end

local function isTeammate(plr, char)
    if not plr or not char then return false end
    if State.TeammateNames[plr.Name] then return true end
    if plr.Team ~= nil and LocalPlayer.Team ~= nil and plr.Team == LocalPlayer.Team then return true end

    local myTeamAttr = LocalPlayer:GetAttribute("Team") or (LocalPlayer.Character and LocalPlayer.Character:GetAttribute("Team"))
    local theirTeamAttr = plr:GetAttribute("Team") or char:GetAttribute("Team")
    if myTeamAttr ~= nil and theirTeamAttr ~= nil and myTeamAttr == theirTeamAttr then
        return true
    end

    -- Kiểm tra vòng tròn xanh lá cây dưới chân đồng đội trong 2v2 (Video 3 giây 0:00 - 0:04)
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("Decal") or obj:IsA("ImageLabel") or obj:IsA("Highlight") then
            local col = nil
            pcall(function()
                if obj:IsA("Highlight") and obj.Enabled then col = obj.OutlineColor
                elseif obj:IsA("BasePart") and obj.Transparency < 0.9 then col = obj.Color
                elseif obj:IsA("Decal") or obj:IsA("ImageLabel") then col = obj.ImageColor3 end
            end)
            if col and col.G > 0.65 and col.R < 0.35 and col.B < 0.45 then
                local n = string.lower(obj.Name)
                if string.find(n, "team") or string.find(n, "ally") or string.find(n, "ring") or string.find(n, "marker") or string.find(n, "circle") then
                    return true
                end
            end
        end
    end

    return false
end

-- ============================================================================
-- 3. BỘ BẮT ĐÒN ĐÁNH SIÊU TỐC 0MS (ANIMATIONPLAYED + TIA MÀU SKILL SIÊU CẤP)
-- ============================================================================

local function isLocomotionOrIdleTrack(track)
    if not track then return true end
    local prio = track.Priority
    if prio == Enum.AnimationPriority.Core
        or prio == Enum.AnimationPriority.Idle
        or prio == Enum.AnimationPriority.Movement then
        return true
    end

    local name = string.lower(track.Name or "")
    if string.find(name, "idle") or string.find(name, "walk") or string.find(name, "run")
        or string.find(name, "sprint") or string.find(name, "jump") or string.find(name, "fall")
        or string.find(name, "dash") or string.find(name, "dodge") or string.find(name, "stun")
        or string.find(name, "hit") or string.find(name, "hurt") or string.find(name, "block")
        or string.find(name, "guard") or string.find(name, "parry") or string.find(name, "equip") then
        return true
    end

    -- Các hoạt ảnh lặp liên tục (Looped) hoặc dài > 2.4s là đứng yên / chạy / giữ khiên
    if track.Looped or track.Length > 2.4 or track.Length <= 0.12 then
        return true
    end

    return false
end

-- Kiểm tra xem đối thủ có đang phát sáng màu (Đỏ / Vàng / Tím / Xanh) của Đòn Nặng hoặc Skill Siêu Cấp không
local function checkColoredSkillEffect(char)
    if not char then return false end

    for k, v in pairs(char:GetAttributes()) do
        if v == true then
            local kl = string.lower(k)
            if string.find(kl, "heavy") or string.find(kl, "ult") or string.find(kl, "skill")
                or string.find(kl, "unblock") or string.find(kl, "special") then
                return true
            end
        end
    end

    for _, desc in ipairs(char:GetDescendants()) do
        if desc:IsA("Highlight") and desc.Enabled then
            local fc = desc.FillColor
            local oc = desc.OutlineColor
            -- Phát hiện hiệu ứng viền/thân phát sáng màu đỏ rực, vàng cam hoặc tím (như ở 0:59 Video 3, 0:18 Video 4, 0:59 Video 5)
            local isWhite = (fc.R > 0.8 and fc.G > 0.8 and fc.B > 0.8) and (oc.R > 0.8 and oc.G > 0.8 and oc.B > 0.8)
            if not isWhite and (desc.FillTransparency < 0.95 or desc.OutlineTransparency < 0.95) then
                if (fc.R > 0.6 and fc.G < 0.45) or (oc.R > 0.6 and oc.G < 0.45)
                    or (fc.B > 0.65 and fc.G < 0.4) or (fc.R > 0.7 and fc.G > 0.5 and fc.B < 0.25) then
                    return true
                end
            end
        elseif (desc:IsA("Trail") or desc:IsA("Beam")) and desc.Enabled then
            local seq = desc.Color
            if seq and #seq.Keypoints > 0 then
                local kp = seq.Keypoints[1].Value
                -- Tia kiếm thường có màu trắng/xám bạc; tia kiếm kỹ năng có màu sắc đậm (Đỏ, Xanh, Tím, Vàng)
                local maxC = math.max(kp.R, kp.G, kp.B)
                local minC = math.min(kp.R, kp.G, kp.B)
                if (maxC - minC) > 0.38 then
                    return true
                end
            end
        elseif desc:IsA("ParticleEmitter") and desc.Enabled then
            local n = string.lower(desc.Name)
            if string.find(n, "heavy") or string.find(n, "ult") or string.find(n, "red") or string.find(n, "flash") or string.find(n, "glint") or string.find(n, "charge") then
                return true
            end
        end
    end

    return false
end

-- Hàm phản xạ tức thì (chạy ngay lập tức trong 0ms khi đối thủ vừa bắt đầu hoạt ảnh vung kiếm)
local function onEnemySwingDetected(enemyChar, isColoredSkill)
    if not Config.Enabled then return end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local enemyRoot = enemyChar and enemyChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not enemyRoot then return end

    local dist = (enemyRoot.Position - myRoot.Position).Magnitude
    if dist > Config.ParryRange then return end

    local now = os.clock()
    State.LastSwingTimestamp = now
    State.EnemyAttacking = true

    -- Ngắt đòn đánh thường của mình ngay để ưu tiên phòng thủ
    triggerMobileButton("Light", "Up")

    -- NẾU ĐỊCH DÙNG SKILL SIÊU CẤP / ĐÒN CÓ MÀU SẮC -> DÙNG NÚT LƯỚT (NÉ) CHỨ KHÔNG ĐỠ THƯỜNG
    if (isColoredSkill or checkColoredSkillEffect(enemyChar)) and Config.DodgeColoredSkill then
        State.EnemyColoredSkill = true
        if now - State.LastDodgeTimestamp >= 0.25 then
            State.LastDodgeTimestamp = now
            triggerMobileButton("Block", "Up")
            triggerMobileButton("Dodge", "Tap")
            -- Sau khi lướt né đòn màu của địch -> lập tức chém trả
            task.delay(0.14, function()
                State.EnemyColoredSkill = false
                State.EnemyAttacking = false
                if Config.Enabled and State.TargetDist <= Config.AttackRange then
                    triggerMobileButton("Light", "Tap")
                end
            end)
        end
        return
    end

    -- NẾU LÀ ĐÒN CHÉM THƯỜNG -> LẬP TỨC CHẶN ĐÒN (PARRY) NGAY TỪ PHÁT ĐẦU TIÊN & ĐÁNH TRẢ
    if now - State.LastParryTimestamp >= 0.10 then
        State.LastParryTimestamp = now
        State.BlockReleaseTime = now + 0.19
        triggerMobileButton("Block", "Down")

        -- Đánh trả ngay sau khi đỡ đòn
        task.delay(0.18, function()
            if os.clock() >= State.BlockReleaseTime then
                triggerMobileButton("Block", "Up")
            end
            State.EnemyAttacking = false
            if Config.Enabled and State.Target and State.TargetDist <= Config.AttackRange and not State.EnemyBlocking then
                triggerMobileButton("Light", "Tap")
                State.LastAttackTimestamp = os.clock()
            end
        end)
    end
end

-- Gắn bộ nghe sự kiện AnimationPlayed trực tiếp lên đối thủ để phản ứng trong 0ms (không đợi vòng lặp)
local function hookEnemyAnimator(enemyChar)
    if not enemyChar then return end
    local hum = enemyChar:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator") or hum
    if State.HookedAnimators[animator] then return end
    State.HookedAnimators[animator] = true

    animator.AnimationPlayed:Connect(function(track)
        if not Config.Enabled then return end
        if enemyChar ~= State.Target then return end
        if not isLocomotionOrIdleTrack(track) then
            -- Kiểm tra ngay và kiểm tra lại sau 30ms phòng trường hợp hiệu ứng màu gắn trễ 1 frame
            local coloredNow = checkColoredSkillEffect(enemyChar)
            onEnemySwingDetected(enemyChar, coloredNow)
            if not coloredNow then
                task.delay(0.03, function()
                    if checkColoredSkillEffect(enemyChar) and Config.DodgeColoredSkill then
                        onEnemySwingDetected(enemyChar, true)
                    end
                end)
            end
        end
    end)
end

-- ============================================================================
-- 4. NHẬN DIỆN CHính XÁC KHI ĐỊCH GIƠ KIẾM ĐỠ ĐÒN (KHÔNG BÁO ẢO)
-- ============================================================================

local function isEnemyActuallyBlocking(enemyChar)
    if not enemyChar then return false end
    local hum = enemyChar:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    -- 1. Kiểm tra Attributes / BoolValue rõ ràng
    for k, v in pairs(enemyChar:GetAttributes()) do
        if v == true then
            local kl = string.lower(k)
            if string.find(kl, "block") or string.find(kl, "guard") or string.find(kl, "parry") then
                return true
            end
        end
    end
    for _, obj in ipairs(enemyChar:GetChildren()) do
        if obj:IsA("BoolValue") and obj.Value == true then
            local nl = string.lower(obj.Name)
            if string.find(nl, "block") or string.find(nl, "guard") or string.find(nl, "parry") then
                return true
            end
        end
    end

    -- 2. Kiểm tra hoạt ảnh giữ thế kiếm đỡ (chỉ tính khi Speed == 0 hoặc Looped ở tầng Action và nhân vật đi chậm)
    local animator = hum:FindFirstChildOfClass("Animator") or hum
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if track.IsPlaying and track.WeightCurrent > 0.25 then
            local name = string.lower(track.Name or "")
            local prio = track.Priority
            if string.find(name, "block") or string.find(name, "guard") or string.find(name, "parry") then
                return true
            end
            if (prio == Enum.AnimationPriority.Action or prio == Enum.AnimationPriority.Action2) then
                if track.Speed == 0 or (track.Looped and hum.WalkSpeed < 10) then
                    return true
                end
            end
        end
    end

    return false
end

-- ============================================================================
-- 5. TÌM MỤC TIÊU CHUẨN (1V1 & 2V2) + TỰ ĐI ĐẾN ĐỊCH + COMBO SIÊU CẤP
-- ============================================================================

local function findBestEnemy()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, 999 end

    updateTeammates2v2()

    local bestChar = nil
    local minDist = 999

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root and not isTeammate(plr, char) then
                local d = (root.Position - myRoot.Position).Magnitude
                if d < minDist then
                    minDist = d
                    bestChar = char
                end
            end
        end
    end

    return bestChar, minDist
end

local function mainTick()
    if not Config.Enabled then
        State.StatusText = "V3 Đang Tắt [OFF]"
        return
    end

    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHum or not myRoot or myHum.Health <= 0 then return end

    local enemy, dist = findBestEnemy()
    if enemy ~= State.Target then
        State.Target = enemy
        State.LastEnemyHealth = nil
        if enemy then hookEnemyAnimator(enemy) end
    end
    State.TargetDist = dist

    if not enemy then
        State.StatusText = "Đang tìm địch (đã lọc đồng đội)..."
        return
    end

    hookEnemyAnimator(enemy)
    local enemyHum = enemy:FindFirstChildOfClass("Humanoid")
    local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
    if not enemyHum or not enemyRoot then return end

    local now = os.clock()

    -- ========================================================================
    -- A. PHÁT HIỆN ĐÁNH TRÚNG ĐỊCH 1 CÁI (ĐỊCH KHÔNG ĐỠ ĐƯỢC) -> XẢ SIÊU CẤP LUÔN
    -- ========================================================================
    local currentEnemyHp = enemyHum.Health
    if State.LastEnemyHealth ~= nil then
        if currentEnemyHp < State.LastEnemyHealth and dist <= 13.5 then
            -- Máu địch vừa tụt (đánh trúng kiếm, địch không đỡ được!)
            if Config.AutoUltimateOnHit and isUltimateAvailable() and (now - State.LastUltTimestamp > 0.5) then
                State.LastUltTimestamp = now
                triggerMobileButton("Block", "Up")
                triggerMobileButton("Ultimate", "Tap")
            end
        end
    end
    State.LastEnemyHealth = currentEnemyHp

    -- ========================================================================
    -- B. KIỂM TRA ĐÒN CÓ MÀU SẮC / ĐỊCH VUNG KIẾM / ĐỊCH ĐỠ ĐÒN MỖI FRAME
    -- ========================================================================
    local hasColoredSkill = checkColoredSkillEffect(enemy)
    local isBlocking = isEnemyActuallyBlocking(enemy)
    State.EnemyBlocking = isBlocking

    -- Kiểm tra bổ sung các track đang chạy ở frame đầu (0.01 -> 0.45s)
    local isSwingingNow = false
    local animator = enemyHum:FindFirstChildOfClass("Animator") or enemyHum
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if track.IsPlaying and track.WeightCurrent > 0.2 and not isLocomotionOrIdleTrack(track) then
            if track.TimePosition <= math.min(0.45, track.Length * 0.72) then
                isSwingingNow = true
                break
            end
        end
    end

    if hasColoredSkill and dist <= Config.ParryRange then
        onEnemySwingDetected(enemy, true)
    elseif isSwingingNow and dist <= Config.ParryRange then
        onEnemySwingDetected(enemy, false)
    end

    -- Nếu địch đang giơ kiếm đỡ đòn -> Dừng đánh ngay lập tức để chờ địch chém trả
    if isBlocking and Config.StopOnEnemyBlock and not isSwingingNow then
        State.HoldFireUntil = now + 0.14
        triggerMobileButton("Light", "Up")
    end

    -- ========================================================================
    -- C. TỰ ĐỘNG ĐI ĐẾN ĐỊCH (KHÔNG ẢNH HƯỞNG ĐỠ ĐÒN / NÉ ĐÒN)
    -- ========================================================================
    if Config.AutoWalk and dist > Config.StopWalkDistance and dist < 85 then
        -- Hướng về phía đối thủ nhưng giữ khoảng cách dừng chuẩn (5.8 studs) để kiếm chạm tới mà không bị lố
        local dir = (enemyRoot.Position - myRoot.Position)
        local flatDir = Vector3.new(dir.X, 0, dir.Z)
        if flatDir.Magnitude > 0.1 then
            local unitDir = flatDir.Unit
            local goalPos = enemyRoot.Position - (unitDir * (Config.StopWalkDistance - 0.5))
            myHum:MoveTo(goalPos)
        end
    elseif Config.AutoWalk and dist <= Config.StopWalkDistance then
        -- Đã vào tầm kiếm -> dừng bước để tập trung đỡ đòn & chém
        myHum:MoveTo(myRoot.Position)
    end

    -- ========================================================================
    -- D. TỰ ĐỘNG CHÉM KHI ĐỊCH HỞ SƯỜN TRONG TẦM KIẾM
    -- ========================================================================
    local isDefendingNow = (now < State.BlockReleaseTime) or (now - State.LastDodgeTimestamp < 0.20)
    if not isDefendingNow and not isBlocking and not isSwingingNow and not hasColoredSkill then
        if dist <= Config.AttackRange and now >= State.HoldFireUntil and (now - State.LastAttackTimestamp >= 0.24) then
            State.LastAttackTimestamp = now
            triggerMobileButton("Light", "Tap")
        end
    end

    -- Cập nhật dòng trạng thái trên HUD
    local stateTag = hasColoredSkill and "SKILL MÀU->NÉ!"
        or (isSwingingNow and "ĐỊCH CHÉM->ĐỠ!"
        or (isBlocking and "ĐỊCH ĐỠ->DỪNG"
        or (isUltimateAvailable() and "SIÊU CẤP SẴN SÀNG" or "Đang áp sát")))
    State.StatusText = string.format("%s | %.1fm | %s", enemy.Name:sub(1, 10), dist, stateTag)
end

