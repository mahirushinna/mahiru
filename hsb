local ButtonKeywords = {
    Block    = { "chặn đòn", "chan don", "chặn", "block", "parry", "guard" },
    Light    = { "ánh sáng", "anh sang", "tấn công nhẹ", "light", "slash", "m1" },
    Heavy    = { "nặng", "nang", "tấn công mạnh", "heavy", "strong", "m2" },
    Dodge    = { "né", "ne", "dodge", "dash", "lướt" },
    Ultimate = { "siêu cấp", "sieu cap", "sơ cấp", "kỹ năng tối thượng", "ultimate", "ult" },
}

local function matchKeyword(text, kwList)
    if type(text) ~= "string" or text == "" then return false end
    local lower = string.lower(text)
    for _, kw in ipairs(kwList) do
        if string.find(lower, kw, 1, true) then
            return true
        end
    end
    return false
end

local function findClickableContainer(inst)
    if inst:IsA("GuiButton") then return inst end
    local btnAncestor = inst:FindFirstAncestorWhichIsA("GuiButton")
    if btnAncestor then return btnAncestor end
    if inst.Parent and inst.Parent:IsA("GuiObject") then
        for _, child in ipairs(inst.Parent:GetChildren()) do
            if child:IsA("GuiButton") then return child end
        end
        return inst.Parent
    end
    return nil
end

local function scanGameButtons()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return end

    for _, desc in ipairs(pg:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("TextButton") then
            local rawText = desc.Text or ""
            local locText = ""
            pcall(function() locText = desc.LocalizedText or "" end)

            local container = findClickableContainer(desc)
            if container and container.Visible and container.AbsoluteSize.X > 18 then
                for action, kwList in pairs(ButtonKeywords) do
                    if matchKeyword(rawText, kwList) or matchKeyword(locText, kwList) or matchKeyword(container.Name, kwList) then
                        State.Buttons[action] = container
                    end
                end
            end
        end
    end
end

-- Bắt RemoteEvent tự động để gửi lệnh trực tiếp khi có sẵn
if typeof(hookmetamethod) == "function" and typeof(getnamecallmethod) == "function" then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if not checkcaller() and (method == "FireServer" or method == "InvokeServer") then
            local rName = string.lower(self.Name or "")
            local args = { ... }
            local arg1 = type(args[1]) == "string" and string.lower(args[1]) or ""

            if string.find(rName, "light") or string.find(rName, "slash") or string.find(rName, "m1") or string.find(rName, "attack")
                or string.find(arg1, "light") or string.find(arg1, "slash") or string.find(arg1, "m1") then
                State.CapturedRemotes.Light = { Remote = self, Method = method, Args = args }
            elseif string.find(rName, "heavy") or string.find(rName, "m2") or string.find(arg1, "heavy") or string.find(arg1, "m2") then
                State.CapturedRemotes.Heavy = { Remote = self, Method = method, Args = args }
            elseif string.find(rName, "ult") or string.find(rName, "skill") or string.find(arg1, "ult") then
                State.CapturedRemotes.Ultimate = { Remote = self, Method = method, Args = args }
            end
        end
        return oldNamecall(self, ...)
    end)
end

local function fireButtonSignalOnly(guiObj, isDown)
    if not guiObj or not guiObj.Parent then return false end

    if typeof(firesignal) == "function" then
        pcall(function()
            if guiObj:IsA("GuiButton") then
                if isDown then
                    firesignal(guiObj.MouseButton1Down, 0, 0)
                    firesignal(guiObj.TouchTap)
                    firesignal(guiObj.MouseButton1Click)
                    firesignal(guiObj.Activated)
                else
                    firesignal(guiObj.MouseButton1Up, 0, 0)
                end
            end
        end)
    end

    if typeof(getconnections) == "function" then
        pcall(function()
            local sig = isDown and guiObj.MouseButton1Down or guiObj.MouseButton1Up
            if sig then
                for _, conn in ipairs(getconnections(sig)) do
                    pcall(function() conn:Fire() end)
                end
            end
            if isDown and guiObj:IsA("GuiButton") then
                for _, conn in ipairs(getconnections(guiObj.Activated)) do
                    pcall(function() conn:Fire() end)
                end
                for _, conn in ipairs(getconnections(guiObj.MouseButton1Click)) do
                    pcall(function() conn:Fire() end)
                end
            end
        end)
    end
    return true
end

-- Hàm chạm nhanh vào tâm nút Mobile (chỉ gọi đúng 1 lần khi ra đòn, tuyệt đối không gọi lặp mỗi frame)
local function tapMobileGuiCenter(guiObj)
    if not guiObj or not guiObj.Parent or not guiObj.Visible then return end
    local pos = guiObj.AbsolutePosition
    local size = guiObj.AbsoluteSize
    local inset = GuiService:GetGuiInset()
    local cx = pos.X + (size.X * 0.5)
    local cy = pos.Y + (size.Y * 0.5) + inset.Y

    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
        task.delay(0.025, function()
            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
        end)
    end)
end

local function triggerAction(action, stateMode)
    if GuiService.MenuIsOpen then return end
    if not State.Buttons[action] or not State.Buttons[action].Parent then
        scanGameButtons()
    end
    local btn = State.Buttons[action]

    if action == "Block" then
        if stateMode == "Down" then
            State.IsBlocking = true
            fireButtonSignalOnly(btn, true)
            pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game) end)
        elseif stateMode == "Up" then
            if State.IsBlocking then
                State.IsBlocking = false
                fireButtonSignalOnly(btn, false)
                pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end)
            end
        end

    elseif action == "Dodge" then
        -- Nhả Chặn đòn trước khi Lướt (Né)
        if State.IsBlocking then
            State.IsBlocking = false
            fireButtonSignalOnly(State.Buttons.Block, false)
            pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end)
        end
        fireButtonSignalOnly(btn, true)
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
            task.delay(0.04, function()
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
                fireButtonSignalOnly(btn, false)
            end)
        end)

    elseif action == "Ultimate" then
        local cap = State.CapturedRemotes.Ultimate
        if cap and cap.Remote and cap.Remote.Parent then
            pcall(function() cap.Remote:FireServer(unpack(cap.Args)) end)
        end
        fireButtonSignalOnly(btn, true)
        if btn and btn.Visible then
            tapMobileGuiCenter(btn)
        end
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
            task.delay(0.04, function()
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                fireButtonSignalOnly(btn, false)
            end)
        end)

    elseif action == "Light" then
        local cap = State.CapturedRemotes.Light
        if cap and cap.Remote and cap.Remote.Parent then
            pcall(function() cap.Remote:FireServer(unpack(cap.Args)) end)
        end
        local myChar = LocalPlayer.Character
        local tool = myChar and myChar:FindFirstChildOfClass("Tool")
        if tool then pcall(function() tool:Activate() end) end

        fireButtonSignalOnly(btn, true)
        if btn and btn.Visible then
            tapMobileGuiCenter(btn)
        end
        task.delay(0.03, function()
            fireButtonSignalOnly(btn, false)
        end)

    elseif action == "Heavy" then
        local cap = State.CapturedRemotes.Heavy
        if cap and cap.Remote and cap.Remote.Parent then
            pcall(function() cap.Remote:FireServer(unpack(cap.Args)) end)
        end
        fireButtonSignalOnly(btn, true)
        if btn and btn.Visible then
            tapMobileGuiCenter(btn)
        end
        task.delay(0.03, function()
            fireButtonSignalOnly(btn, false)
        end)
    end
end

local function isUltimateReady()
    local btn = State.Buttons.Ultimate
    if not btn or not btn.Parent then
        scanGameButtons()
        btn = State.Buttons.Ultimate
    end
    if btn and btn.Visible and btn.AbsoluteSize.X > 18 then
        return true
    end
    -- Kiểm tra thêm dòng chữ "[R] Kỹ năng tối thượng" trên giao diện
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pg then
        for _, lbl in ipairs(pg:GetDescendants()) do
            if lbl:IsA("TextLabel") and lbl.Visible then
                local t = string.lower(lbl.Text or "")
                if string.find(t, "kỹ năng tối thượng", 1, true) or string.find(t, "siêu cấp", 1, true) then
                    return true
                end
            end
        end
    end
    return false
end

