            local turnState = DetectMatchAndTurnState(boardFrame)

            if turnState == "NOT_IN_LIVE_GAME" or turnState == "WAITING_FOR_MATCH" or turnState == "NO_BOARD" then
                LockedMatchSide = nil
                LastRAMPly = -1
                ClockHistory.LastChangedSide = nil
                StatusLabel.Text = string.format(
