-- 6. VÒNG LẶP GIÁM SÁT TRẬN ĐẤU
-- ==========================================
local LastMoveCount = -1

task.spawn(function()
    while task.wait(0.5) do
        local moves = GetMoveListFromUI()
        local moveCount = #moves

        if moveCount ~= LastMoveCount then
            LastMoveCount = moveCount
            local board = CreateStartingBoard()
            for i, san in ipairs(moves) do
                ApplySANMove(board, san, (i % 2 == 1))
            end

            local activeColor = (moveCount % 2 == 0) and "w" or "b"
            local fullMoveNumber = math.floor(moveCount / 2) + 1
            local fen = BoardToFEN(board, activeColor, fullMoveNumber)

            local bestMove, evalScore, mateScore = QueryStockfish(fen, Config.SearchDepth)
            CurrentBestMove = bestMove

            if bestMove then
                local evalText = mateScore and ("Chiếu hết sau " .. tostring(mateScore) .. " nước!") or string.format("%+.2f", evalScore)
                StatusLabel.Text = string.format(
                    "Lượt: %s | Đánh giá: %s\nNước tối ưu: %s -> %s",
                    activeColor == "w" and "Trắng" or "Đen",
                    evalText,
                    string.sub(bestMove, 1, 2),
                    string.sub(bestMove, 3, 4)
                )

                -- Phát hiện lỗi (Blunder/Mistake) của đối thủ dựa trên độ lệch điểm Eval
                local evalDelta = (Config.PlayerColor == "w") and (evalScore - LastEval) or (LastEval - evalScore)
                if moveCount > 0 and activeColor == Config.PlayerColor then
                    if evalDelta >= 2.5 or (mateScore and ((Config.PlayerColor == "w" and mateScore > 0) or (Config.PlayerColor == "b" and mateScore < 0))) then
                        BlunderLabel.Text = string.format("🔥 Đối thủ vừa đi BLUNDER (%s)! Trừng phạt bằng %s!", moves[#moves], bestMove)
                        BlunderLabel.TextColor3 = Color3.fromRGB(80, 255, 120)
                    elseif evalDelta >= 1.0 then
                        BlunderLabel.Text = string.format("⚠️ Đối thủ đi sai lầm (%s). Khai thác bằng %s", moves[#moves], bestMove)
                        BlunderLabel.TextColor3 = Color3.fromRGB(255, 210, 90)
                    else
                        BlunderLabel.Text = "Phân tích đối thủ: Nước đi chuẩn, giữ thế trận chắc."
                        BlunderLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
                    end
                end
                LastEval = evalScore

                -- Tự động đánh nếu đến lượt của bạn
                if Config.AutoPlay and activeColor == Config.PlayerColor then
                    local delayTime = Config.MinDelay + math.random() * (Config.MaxDelay - Config.MinDelay)
                    task.wait(delayTime)
                    ExecuteUCIMove(bestMove)
                end
            end
        end
    end
end)
