    arrow.TargetBox.BackgroundTransparency = 0.66
    arrow.TargetBox.BorderSizePixel = 0
    arrow.TargetBox.ZIndex = zBase
    arrow.TargetBox.Visible = false
    Instance.new("UICorner", arrow.TargetBox).CornerRadius = UDim.new(0, 6)
    local ts = Instance.new("UIStroke", arrow.TargetBox)
    ts.Color = mainColor; ts.Thickness = 2.4; ts.Transparency = 0.1

    arrow.Shaft = Instance.new("Frame", Overlay)
    arrow.Shaft.BackgroundColor3 = mainColor
    arrow.Shaft.BackgroundTransparency = trans
    arrow.Shaft.BorderSizePixel = 0
    arrow.Shaft.AnchorPoint = Vector2.new(0.5, 0.5)
    arrow.Shaft.ZIndex = zBase + 1
    arrow.Shaft.Visible = false
    Instance.new("UICorner", arrow.Shaft).CornerRadius = UDim.new(0, 4)

    -- Two Crisp Angled Wing Edges for a Razor-Sharp Arrowhead Outline
    arrow.LeftWing = Instance.new("Frame", Overlay)
    arrow.LeftWing.BackgroundColor3 = mainColor
    arrow.LeftWing.BackgroundTransparency = trans
    arrow.LeftWing.BorderSizePixel = 0
    arrow.LeftWing.AnchorPoint = Vector2.new(0.5, 0.5)
    arrow.LeftWing.ZIndex = zBase + 3
    arrow.LeftWing.Visible = false
    Instance.new("UICorner", arrow.LeftWing).CornerRadius = UDim.new(1, 0)

    arrow.RightWing = Instance.new("Frame", Overlay)
    arrow.RightWing.BackgroundColor3 = mainColor
    arrow.RightWing.BackgroundTransparency = trans
    arrow.RightWing.BorderSizePixel = 0
    arrow.RightWing.AnchorPoint = Vector2.new(0.5, 0.5)
    arrow.RightWing.ZIndex = zBase + 3
    arrow.RightWing.Visible = false
    Instance.new("UICorner", arrow.RightWing).CornerRadius = UDim.new(1, 0)

    -- 12 Micro-Slices to fill the triangular arrowhead smoothly without staircase steps
    arrow.HeadFill = {}
    for i = 1, 12 do
        local s = Instance.new("Frame", Overlay)
        s.BackgroundColor3 = mainColor
        s.BackgroundTransparency = trans
        s.BorderSizePixel = 0
        s.AnchorPoint = Vector2.new(0.5, 0.5)
        s.ZIndex = zBase + 2
        s.Visible = false
        arrow.HeadFill[i] = s
    end

    -- Floating SAN + Eval Tag Pill right near the destination square
    arrow.Badge = Instance.new("TextLabel", Overlay)
    arrow.Badge.Size = UDim2.fromOffset(64, 18)
    arrow.Badge.AnchorPoint = Vector2.new(0.5, 0.5)
    arrow.Badge.BackgroundColor3 = badgeBgColor
    arrow.Badge.BackgroundTransparency = 0.08
    arrow.Badge.Font = Enum.Font.GothamBold
    arrow.Badge.TextSize = 10
    arrow.Badge.TextColor3 = Color3.new(1, 1, 1)
    arrow.Badge.ZIndex = zBase + 5
    arrow.Badge.Visible = false
    Instance.new("UICorner", arrow.Badge).CornerRadius = UDim.new(0, 5)
    local bs = Instance.new("UIStroke", arrow.Badge)
    bs.Color = mainColor; bs.Thickness = 1.3

    function arrow:Hide()
        self.OriginBox.Visible = false
        self.TargetBox.Visible = false
        self.Shaft.Visible = false
        self.LeftWing.Visible = false
        self.RightWing.Visible = false
        self.Badge.Visible = false
        for i = 1, 12 do self.HeadFill[i].Visible = false end
    end

    function arrow:Draw(fx, fy, tx, ty, cellW, badgeText)
        local dx, dy = tx - fx, ty - fy
        local dist = math.sqrt(dx * dx + dy * dy)
        if dist < 4 then self:Hide(); return end

        local ux, uy = dx / dist, dy / dist
        local px, py = -uy, ux -- Perpendicular unit vector
        local angDeg = math.deg(math.atan2(dy, dx))

        local boxSz = math.floor(cellW * 0.88)
        self.OriginBox.Size = UDim2.fromOffset(boxSz, boxSz)
        self.OriginBox.Position = UDim2.fromOffset(fx - boxSz * 0.5, fy - boxSz * 0.5)
        self.OriginBox.Visible = true

        self.TargetBox.Size = UDim2.fromOffset(boxSz, boxSz)
        self.TargetBox.Position = UDim2.fromOffset(tx - boxSz * 0.5, ty - boxSz * 0.5)
        self.TargetBox.Visible = true

        local headLen = math.clamp(cellW * 0.48, 15, 30)
        local headHalfW = math.clamp(cellW * 0.28, 9, 18)
        local shaftThk = math.clamp(cellW * 0.21, 7, 13)
        local startPad = cellW * 0.10
        local shaftLen = math.max(4, dist - headLen * 0.85 - startPad)

        self.Shaft.Size = UDim2.fromOffset(shaftLen, shaftThk)
        self.Shaft.Position = UDim2.fromOffset(fx + ux * (startPad + shaftLen * 0.5), fy + uy * (startPad + shaftLen * 0.5))
        self.Shaft.Rotation = angDeg
        self.Shaft.Visible = true

        -- Base of arrowhead
        local baseX = tx - ux * headLen
        local baseY = ty - uy * headLen

        -- Left and Right corners of the triangle base
        local leftCornerX = baseX + px * headHalfW
        local leftCornerY = baseY + py * headHalfW
        local rightCornerX = baseX - px * headHalfW
        local rightCornerY = baseY - py * headHalfW

        -- Position LeftWing (from tip to leftCorner) & RightWing (from tip to rightCorner)
        local wingLen = math.sqrt(headLen * headLen + headHalfW * headHalfW)
        local wingThk = math.max(3, shaftThk * 0.35)

        local ldx, ldy = leftCornerX - tx, leftCornerY - ty
        self.LeftWing.Size = UDim2.fromOffset(wingLen, wingThk)
        self.LeftWing.Position = UDim2.fromOffset((tx + leftCornerX) * 0.5, (ty + leftCornerY) * 0.5)
        self.LeftWing.Rotation = math.deg(math.atan2(ldy, ldx))
        self.LeftWing.Visible = true

        local rdx, rdy = rightCornerX - tx, rightCornerY - ty
        self.RightWing.Size = UDim2.fromOffset(wingLen, wingThk)
        self.RightWing.Position = UDim2.fromOffset((tx + rightCornerX) * 0.5, (ty + rightCornerY) * 0.5)
        self.RightWing.Rotation = math.deg(math.atan2(rdy, rdx))
        self.RightWing.Visible = true

        -- 12 Micro-slices filling the triangle interior
        local nSlices = #self.HeadFill
        local stepLen = headLen / nSlices
        for i = 1, nSlices do
            local t = (i - 0.5) / nSlices
            local w = math.max(2, (headHalfW * 2) * (1.0 - t))
            local sl = self.HeadFill[i]
            sl.Size = UDim2.fromOffset(stepLen + 1.5, w)
            sl.Position = UDim2.fromOffset(baseX + ux * (t * headLen), baseY + uy * (t * headLen))
            sl.Rotation = angDeg
            sl.Visible = true
        end

        if Config.ShowMoveBadges and badgeText and badgeText ~= "" then
            self.Badge.Text = badgeText
            local textW = math.max(46, #badgeText * 6.5 + 10)
            self.Badge.Size = UDim2.fromOffset(textW, 18)
            self.Badge.Position = UDim2.fromOffset(tx, ty - cellW * 0.48)
            self.Badge.Visible = true
        else
            self.Badge.Visible = false
        end
    end

    return arrow
end

