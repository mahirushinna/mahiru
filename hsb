local Running = true
_G.RoChessV3Cleanup = function()
    Running = false
    if inputCaptureConn then pcall(function() inputCaptureConn:Disconnect() end) end
    if OurScreenGui and OurScreenGui.Parent then
        OurScreenGui:Destroy()
    end
end

task.spawn(ScanGameForHooks)

local LastSyncedSig = "__INIT__"
local LastTurnState = ""
local IsExecuting = false

task.spawn(function()
    while Running and task.wait(0.22) do
        local boardFrame = GetBoardFrame()
        if boardFrame and not IsExecuting then
            local sanList = ScrapeMoveListStrictlyBelowBoard(boardFrame)
            local currentSig = table.concat(sanList, " ")

            if #sanList == 0 and LastSyncedSig ~= "" then
                LockedMatchSide = nil
            end

            if currentSig ~= LastSyncedSig then
                Engine:Reset()
                OpponentProfile:Reset()
                local applied = 0
                local failedSAN = nil

                for _, san in ipairs(sanList) do
                    local sideToMove = (applied % 2 == 0) and 1 or -1
                    local evalBefore = Engine:Evaluate(1.0)
                    local parsed = Engine:ParseSANMove(san, sideToMove)
                    if parsed then
                        Engine:MakeMove(parsed)
                        table.insert(Engine.MoveHistoryUCI, parsed.uci)
                        applied += 1
                    else
                        failedSAN = san
                        break
                    end
                end

                LastSyncedSig = currentSig
                Logger:Add("SYNC", string.format("Synced %d/%d moves (%s)%s",
                    applied, #sanList, currentSig ~= "" and currentSig or "Start",
                    failedSAN and (" [ERR SAN: " .. failedSAN .. "]") or ""
                ))
            end

            local turnState = DetectTurnAndMatchState(boardFrame)
            local mySide = DetectPlayerColor(boardFrame, turnState, Engine.Turn)

            if turnState ~= LastTurnState then
                LastTurnState = turnState
                Logger:Add("STATE", string.format("TurnState=%s | DetectedSide=%s | EngineTurn=%s",
                    turnState, mySide == 1 and "WHITE" or "BLACK", Engine.Turn == 1 and "WHITE" or "BLACK"
                ))
            end

            local isActuallyMyTurn = (turnState == "MY_TURN") or (turnState == "UNKNOWN" and Engine.Turn == mySide and #sanList > 0)
            local recentHistory = table.concat(sanList, " ", math.max(1, #sanList - 3), #sanList)

            if Config.AutoPlay and isActuallyMyTurn and turnState ~= "INACTIVE_OR_MODAL" then
                IsExecuting = true
                local bestMove, score, meta = Engine:SelectBestMove(mySide)
                if bestMove then
                    StatusLabel.Text = string.format(
                        "Side: %s | State: %s\nHook: %s\nHistory (%d): %s\nBest: %s (%+d) [%s | %d nodes]",
                        (mySide == 1) and "WHITE" or "BLACK",
                        turnState,
                        HookState.LastHookSummary,
                        #Engine.MoveHistoryUCI,
                        (recentHistory ~= "" and recentHistory or "Start"),
                        bestMove.uci,
                        score,
                        meta,
                        Engine.NodesSearched
                    )
                    Logger:Add("AI", string.format("Playing %s (%+d) [%s]", bestMove.uci, score, meta))
                    DispatchMoveHooks(bestMove, mySide)
                    task.wait(Config.PostMoveCooldown)
                end
                IsExecuting = false
            else
                StatusLabel.Text = string.format(
                    "Side: %s | State: %s\nHook: %s\nHistory (%d): %s\nWaiting for active turn...",
                    (mySide == 1) and "WHITE" or "BLACK",
                    turnState,
                    HookState.LastHookSummary,
                    #Engine.MoveHistoryUCI,
                    (recentHistory ~= "" and recentHistory or "Start")
                )
            end
        end
    end
end)
