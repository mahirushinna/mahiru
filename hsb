local OurScreenGui = nil

-- Checks if `guiObj` AND all its ancestors up to PlayerGui are actually visible!
-- Fixes the video_1.mp4 bug where hidden lobby labels ("Searching for opponent...") kept .Visible == true!
local function IsTrulyVisible(guiObj)
    if not guiObj or not guiObj:IsA("GuiObject") then return false end
    local cur = guiObj
    while cur and cur ~= PlayerGui do
        if cur:IsA("GuiObject") and not cur.Visible then
            return false
        elseif cur:IsA("LayerCollector") and not cur.Enabled then
            return false
        end
        cur = cur.Parent
    end
    return cur == PlayerGui
end

local function GetBoardFrame()
    -- Priority 1: Use Controller #2.bgFrame if available and truly visible!
    if HookState.Controller2 then
        local bg = rawget(HookState.Controller2, "bgFrame")
        if typeof(bg) == "Instance" and bg:IsA("GuiObject") and IsTrulyVisible(bg) and bg.AbsoluteSize.X >= 200 then
            return bg
        end
    end

    -- Priority 2: Scan truly visible square frames
    local candidates = {}
    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if desc:IsA("GuiObject") and (not OurScreenGui or not desc:IsDescendantOf(OurScreenGui)) and IsTrulyVisible(desc) then
            local sz = desc.AbsoluteSize
            if sz.X >= 220 and sz.Y >= 220 and math.abs(sz.X - sz.Y) <= 18 then
                local n = string.lower(desc.Name)
                if not string.find(n, "modal") and not string.find(n, "overlay") and not string.find(n, "toast") then
                    local childCount = #desc:GetDescendants()
                    if childCount >= 16 then
                        table.insert(candidates, { frame = desc, children = childCount, area = sz.X * sz.Y })
                    end
                end
            end
        end
    end
    table.sort(candidates, function(a, b)
        if a.children ~= b.children then return a.children > b.children end
        return a.area > b.area
    end)
    return candidates[1] and candidates[1].frame or nil
end

local function GetActiveRAMBoard()
    if HookState.BoundRAMBoard and type(rawget(HookState.BoundRAMBoard, "board")) == "table" then
        return HookState.BoundRAMBoard
    end
    -- Fallback: check if any upvalue of SquareClickFns holds a RAMBoard
    if debug and debug.getupvalues then
        for _, fn in ipairs(HookState.SquareClickFns) do
            local ok, uvs = pcall(debug.getupvalues, fn)
            if ok and uvs then
                for _, uv in pairs(uvs) do
                    if type(uv) == "table" and rawget(uv, "board") and rawget(uv, "kingSq") then
                        HookState.BoundRAMBoard = uv
                        return uv
                    end
                end
            end
        end
    end
    return HookState.AllRAMBoards[1]
end

local ClockHistory = {
    TopText = "",
    BottomText = "",
    LastChangedSide = nil
}

-- Determines if we are in a live match and whose turn it is (100% immune to hidden Lobby labels!)
local function DetectMatchAndTurnState(boardFrame)
    -- 1. Check Controller2.inLiveGame() first!
    if HookState.Controller2 and type(rawget(HookState.Controller2, "inLiveGame")) == "function" then
        local ok, inGame = pcall(rawget(HookState.Controller2, "inLiveGame"))
        if ok and inGame == false then
            return "NOT_IN_LIVE_GAME"
        end
    end

    if not boardFrame then return "NO_BOARD" end
    local boardCenterY = boardFrame.AbsolutePosition.Y + (boardFrame.AbsoluteSize.Y * 0.5)
    local boardTopY = boardFrame.AbsolutePosition.Y

    local topClockLbl, bottomClockLbl = nil, nil
    local explicitBadgeTurn = nil
    local hasDrawOrResignOrAbort = false

    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and (not OurScreenGui or not desc:IsDescendantOf(OurScreenGui)) then
            if IsTrulyVisible(desc) then
                local rawTxt = desc.Text
                local t = string.lower(rawTxt)

                if t == "draw" or t == "resign" or string.find(t, "abort") then
                    hasDrawOrResignOrAbort = true
                end

                if string.find(t, "to move") then
                    explicitBadgeTurn = (desc.AbsolutePosition.Y > boardCenterY) and "MY_TURN" or "OPPONENT_TURN"
                end

                local trimmed = string.gsub(rawTxt, "%s+", "")
                if string.match(trimmed, "^%d+:%d%d$") then
                    if desc.AbsolutePosition.Y < boardTopY then
                        topClockLbl = desc
                    elseif desc.AbsolutePosition.Y > boardCenterY then
                        bottomClockLbl = desc
                    end
                end
            end
        end
    end

    if not topClockLbl or not bottomClockLbl then
        return "WAITING_FOR_MATCH"
    end

    if explicitBadgeTurn then
        return explicitBadgeTurn
    end

    -- Compare TextColor3 luminance of Bottom Clock vs Top Clock:
    -- In video_1.mp4: Active clock pill has dark text (R,G,B ~ 0.1) on white background; inactive has white text (R,G,B ~ 0.9)!
    local botCol = bottomClockLbl.TextColor3
    local topCol = topClockLbl.TextColor3
    local botLum = (botCol.R + botCol.G + botCol.B) / 3
    local topLum = (topCol.R + topCol.G + topCol.B) / 3

    if botLum < 0.48 and topLum > 0.52 then
        return "MY_TURN"
    elseif topLum < 0.48 and botLum > 0.52 then
        return "OPPONENT_TURN"
    end

    -- Fallback: Track which clock string ("2:59", "2:58") ticked most recently
    if bottomClockLbl.Text ~= ClockHistory.BottomText then
        ClockHistory.BottomText = bottomClockLbl.Text
        ClockHistory.LastChangedSide = "MY_TURN"
    end
    if topClockLbl.Text ~= ClockHistory.TopText then
        ClockHistory.TopText = topClockLbl.Text
        ClockHistory.LastChangedSide = "OPPONENT_TURN"
    end

    if ClockHistory.LastChangedSide then
        return ClockHistory.LastChangedSide
    end

    return hasDrawOrResignOrAbort and "LIVE_TURN_BY_PLY" or "WAITING_FOR_MATCH"
end

-- Scrapes move tokens ("e4", "d5", etc.) if the Game history tab is visible
local function ScrapeAllMovesScrollProof(boardFrame)
    if not boardFrame then return {} end
    local boardBottomY = boardFrame.AbsolutePosition.Y + boardFrame.AbsoluteSize.Y - 12
    local rawTokens = {}

    for _, desc in ipairs(PlayerGui:GetDescendants()) do
        if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and (not OurScreenGui or not desc:IsDescendantOf(OurScreenGui)) then
            if IsTrulyVisible(desc) then
                local scrollAncestor = desc:FindFirstAncestorWhichIsA("ScrollingFrame")
                local isBottomPanel = false
                local sortY = desc.AbsolutePosition.Y

                if scrollAncestor and scrollAncestor.AbsolutePosition.Y >= boardBottomY - 20 then
                    isBottomPanel = true
                    sortY = desc.AbsolutePosition.Y + scrollAncestor.CanvasPosition.Y
                elseif desc.AbsolutePosition.Y >= boardBottomY and desc.AbsoluteSize.Y > 8 and desc.AbsoluteSize.Y < 45 then
                    isBottomPanel = true
                end

                if isBottomPanel then
                    local clean = string.gsub(desc.Text, "<[^>]+>", "")
                    clean = string.gsub(clean, "^%s*(.-)%s*$", "%1")
                    for token in string.gmatch(clean, "%S+") do
                        if not string.match(token, "^%d+%.+$") then
                            local stripped = string.gsub(token, "[+#!?]", "")
                            if
                                stripped == "O-O" or stripped == "O-O-O" or
                                string.match(stripped, "^[NBRQK]?[a-h]?[1-8]?x?[a-h][1-8]=?[QRNB]?$")
                            then
                                table.insert(rawTokens, {
                                    san = stripped,
                                    rowY = math.floor(sortY / 8) * 8,
                                    colX = desc.AbsolutePosition.X
                                })
                            end
                        end
                    end
                end
            end
        end
    end

    table.sort(rawTokens, function(a, b)
        if math.abs(a.rowY - b.rowY) > 10 then return a.rowY < b.rowY end
        return a.colX < b.colX
    end)

    local deduped = {}
    for _, item in ipairs(rawTokens) do
        local prev = deduped[#deduped]
        if not prev or prev.san ~= item.san or math.abs(prev.colX - item.colX) > 15 or math.abs(prev.rowY - item.rowY) > 12 then
            table.insert(deduped, item)
        end
    end

    local result = {}
    for _, item in ipairs(deduped) do
        table.insert(result, item.san)
    end
    return result
end

-- Synchronizes AIEngine directly from RoChess's live #3 RAMBoard (works even when [Players] tab hides move list!)
local PieceCharMap = {
    P = 1, N = 2, B = 3, R = 4, Q = 5, K = 6,
    p = -1, n = -2, b = -3, r = -4, q = -5, k = -6
}

local function SyncEngineFromRAMBoard(aiEngine, ramBoard)
    if not ramBoard or type(ramBoard.board) ~= "table" then return false end
    local rb = ramBoard.board
    local converted = table.create(64, 0)
    local nonZero = 0

    for sq = 1, 64 do
        local v = rb[sq] or rb[sq - 1]
        local mapped = 0
        if type(v) == "number" and v ~= 0 then
            if v >= -6 and v <= 6 then
                mapped = v
            elseif v >= 1 and v <= 12 then
                mapped = (v <= 6) and v or -(v - 6)
            elseif v >= 9 and v <= 22 then
                local pType = bit32.band(v, 7)
                local isBlack = (bit32.band(v, 16) ~= 0) or (v >= 17)
                mapped = isBlack and -pType or pType
            end
        elseif type(v) == "string" and PieceCharMap[v] then
            mapped = PieceCharMap[v]
        end
        if mapped ~= 0 then nonZero += 1 end
        converted[sq] = mapped
    end

    if nonZero < 2 then return false end

    -- Check orientation using kingSq or rank sums so Rank 1 is always White's home rank
    local rank1Sum, rank8Sum = 0, 0
    for f = 1, 8 do
        rank1Sum += converted[f]
        rank8Sum += converted[56 + f]
    end
    if rank1Sum < 0 and rank8Sum > 0 then
        local flipped = table.create(64, 0)
        for r = 1, 8 do
            for f = 1, 8 do
                flipped[SqIndex(f, r)] = converted[SqIndex(f, 9 - r)]
            end
        end
        converted = flipped
    end

    for i = 1, 64 do
        aiEngine.Squares64[i] = converted[i]
    end

    if type(ramBoard.ply) == "number" then
        aiEngine.ActiveSide = (ramBoard.ply % 2 == 0) and 1 or -1
    end
    return true
end

--------------------------------------------------------------------------------
-- 7. SAFE VERIFIED MOVE DISPATCHER v6 (CONTROLLER #2 + PLY VERIFICATION)
--------------------------------------------------------------------------------
local function DispatchMoveV6(move)
    local fromAlg = IndexToAlgebraic(move.from)
    local toAlg = IndexToAlgebraic(move.to)
    local uci = fromAlg .. toAlg
    local promoStr = move.promo and "q" or nil

    local ramBoard = GetActiveRAMBoard()
    local plyBefore = (ramBoard and type(ramBoard.ply) == "number") and ramBoard.ply or -1

    local function DidMoveSucceed()
        if ramBoard and type(ramBoard.ply) == "number" and plyBefore >= 0 then
            return ramBoard.ply > plyBefore
        end
        return false
    end

    local c2 = HookState.Controller2
    local pm = HookState.OrigPlayMove or (c2 and rawget(c2, "playMove"))
    local mm = HookState.OrigMakeMove or (c2 and rawget(c2, "makeMove"))

    if not c2 or (not pm and not mm) then
        Logger.Push("WARN", "Controller #2 not bound yet! Running scan...")
        ScanRoChessMemoryV6()
        c2 = HookState.Controller2
        pm = HookState.OrigPlayMove
        mm = HookState.OrigMakeMove
    end

    -- Candidate Execution Strategies (All using clean strings/numbers - NEVER passing tables as squares!)
    local strategies = {
        {
            name = "C2.makeMove(fromAlg,toAlg,promo)",
            run = function()
                if mm then mm(fromAlg, toAlg, promoStr) end
            end
        },
        {
            name = "C2.playMove(fromAlg,toAlg,promo)",
            run = function()
                if pm then pm(fromAlg, toAlg, promoStr) end
            end
        },
        {
            name = "C2.selectedSq+playMove(toAlg)",
            run = function()
                if c2 and pm then
                    rawset(c2, "selectedSq", fromAlg)
                    pm(toAlg, promoStr)
                end
            end
        },
        {
            name = "C2.makeMove(fromIdx,toIdx,promo)",
            run = function()
                if mm then mm(move.from, move.to, promoStr) end
            end
        },
        {
            name = "C2.playMove(fromIdx,toIdx,promo)",
            run = function()
                if pm then pm(move.from, move.to, promoStr) end
            end
        }
    }

    -- If a strategy already succeeded on a previous turn, run ONLY that locked strategy first!
    if HookState.LockedMethodName then
        for _, st in ipairs(strategies) do
            if st.name == HookState.LockedMethodName then
                local ok, err = pcall(st.run)
                task.wait(0.08)
                if ok and DidMoveSucceed() then
                    HookState.LastHookSummary = "LOCKED:" .. st.name
                    Logger.Push("EXEC-OK", st.name .. " -> " .. uci)
                    return true
                end
            end
        end
    end

    -- Otherwise test each clean strategy sequentially and stop the instant `ramBoard.ply` increments!
    for _, st in ipairs(strategies) do
        local ok, err = pcall(st.run)
        if not ok then
            Logger.Push("STRAT-ERR", st.name .. ": " .. tostring(err))
        end
        task.wait(0.08)
        if DidMoveSucceed() then
            HookState.LockedMethodName = st.name
            HookState.LastHookSummary = "LOCKED:" .. st.name
            Logger.Push("LOCK-OK", "Verified & Locked " .. st.name .. " on move " .. uci .. "!")
            return true
        end
    end

    HookState.LastHookSummary = "Tried 5 C2 Strategies (" .. uci .. ")"
    Logger.Push("EXEC-TRY", "Tried C2 strategies for " .. uci .. " (ply=" .. tostring(plyBefore) .. ")")
    return false
end

