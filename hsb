-- Tính bán kính vòng tròn Aim (pixel) từ độ Aim (40° -> 360°)
local function getFOVRadiusPixels(): number
	Camera = Workspace.CurrentCamera
	local vp = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
	local minDim = math.min(vp.X, vp.Y)
	local t = math.clamp((State.Aim_Degree - 40) / (360 - 40), 0, 1)
	local minRadius = minDim * 0.08
	local maxRadius = math.max(vp.X, vp.Y) * 0.65
	return minRadius + (maxRadius - minRadius) * t
end

