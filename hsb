local function SerializeVal(v, depth)
    depth = depth or 0
    if depth > 2 then return "..." end
    if type(v) == "string" then
        return '"' .. v .. '"'
    elseif type(v) == "number" or type(v) == "boolean" then
        return tostring(v)
    elseif typeof(v) == "Instance" then
        return v.ClassName .. ":" .. v.Name
    elseif type(v) == "table" then
        if rawget(v, "_IsOurAIEngine") then return "OurAIEngine" end
        if rawget(v, "board") and rawget(v, "kingSq") then
            return string.format("RAMBoard(ply=%s,side=%s)", tostring(rawget(v, "ply")), tostring(rawget(v, "side")))
        end
        local parts = {}
        local c = 0
        for k, val in pairs(v) do
            c += 1
            if c <= 6 then
                parts[#parts + 1] = tostring(k) .. "=" .. SerializeVal(val, depth + 1)
            end
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

-- Safe passive __namecall packet logger (NEVER alters or blocks game calls)
if hookmetamethod and getnamecallmethod then
